---
import fs from 'node:fs';
// PLACEHOLDER: client must confirm the coupon code, the offer and how staff redeem it.
const coupon = { code: 'FEEDFURSAT', note: 'Show this code to the Fursat team to claim your treat.' };
const hasImg = fs.existsSync('public/assets/ask-mascot-sm.webp');
const wa = 'https://wa.me/919059670033?text=' + encodeURIComponent('Hi Fursat! I fed the elephant. My coupon code is ' + coupon.code);
---
<aside class="ms" id="ms" aria-label="Fursat mascot" data-code={coupon.code}>
  <p class="ms-bubble" id="ms-bubble" hidden>Click me for your special offer!</p>
  <div class="ms-panel" id="ms-panel" role="region" aria-label="Feed the elephant" aria-live="polite" hidden>
    <div class="ms-feed" id="ms-feed">
      <p class="ms-say" id="ms-say">Feed me with a Fursat drink and food!</p>
      <div class="ms-row">
        <button class="ms-chip" type="button" data-feed="drink" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h12l-1.5 16h-9zM7 9h10"/></svg><span>Drink</span></button>
        <button class="ms-chip" type="button" data-feed="food" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="7"/><path d="M12 6V4M8 13h8"/></svg><span>Food</span></button>
      </div>
    </div>
    <div class="ms-ticket" id="ms-ticket" hidden>
      <p class="ms-tk-h">Your Fursat coupon</p>
      <p class="ms-code" id="ms-code">{coupon.code}</p>
      <p class="ms-note">{coupon.note}</p>
      <div class="ms-row"><button class="ms-copy" id="ms-copy" type="button">Copy code</button><a class="ms-wa" href={wa} target="_blank" rel="noopener">Send on WhatsApp</a></div>
    </div>
  </div>
  <button class="ms-body" id="ms-body" type="button" aria-expanded="false" aria-controls="ms-panel" aria-label="Feed the Fursat elephant for a special offer">
    <span class="ms-beat"><span class="ms-tilt" id="ms-tilt">
      {hasImg ? <><img class="ms-p ms-idle" src="/assets/ask-mascot-sm.webp" alt="" width="256" height="256" decoding="async" /><img class="ms-p ms-chew" src="/assets/ask-mascot-chew-sm.webp" alt="" width="256" height="256" decoding="async" /><img class="ms-p ms-cheer" src="/assets/ask-mascot-cheer-sm.webp" alt="" width="256" height="256" decoding="async" /></> :
      <svg viewBox="0 0 120 120" aria-hidden="true"><ellipse class="e1" cx="22" cy="58" rx="20" ry="26"/><ellipse class="e1" cx="98" cy="58" rx="20" ry="26"/><circle class="e2" cx="60" cy="62" r="34"/><path class="tr" d="M60 74c0 16-2 26 8 32" fill="none" stroke-width="14" stroke-linecap="round"/><path class="cr" d="M38 36l7-16 8 10 7-14 7 14 8-10 7 16z"/><rect class="sg" x="36" y="52" width="20" height="13" rx="6"/><rect class="sg" x="64" y="52" width="20" height="13" rx="6"/><path class="sg2" d="M56 57h8" stroke-width="3"/><path class="sm" d="M50 78q10 8 20 0" fill="none" stroke-width="3" stroke-linecap="round"/></svg>}
    </span></span>
  </button>
  <a class="ms-badge" href="/ask">Ask Fursat</a>
</aside>
<style is:global>
:root{--ms-skin:#D9A88F;--ms-ear:#C98E74;--ms-dark:#1A1608;--ms-gold:#E0A63C;--ms-cream:#F4ECDA;--ms-field:#17200F;--ms-ease:cubic-bezier(.16,1,.3,1)}
.ms{position:fixed;right:max(12px,env(safe-area-inset-right));bottom:calc(env(safe-area-inset-bottom,0px) + var(--ms-bottom,88px));z-index:40;display:grid;justify-items:end;gap:8px;perspective:640px}
.ms-body{all:unset;box-sizing:border-box;display:block;width:88px;height:88px;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;border-radius:50%}
.ms-body:focus-visible,.ms-badge:focus-visible,.ms-chip:focus-visible,.ms-copy:focus-visible,.ms-wa:focus-visible{outline:2px solid var(--ms-gold);outline-offset:3px}
.ms-beat{display:block;width:100%;height:100%;transform-origin:50% 100%;animation:ms-beat 1.7s infinite}
.ms-tilt{display:block;width:100%;height:100%;transform:rotateY(var(--ry,0deg)) rotateX(var(--rx,0deg));transition:transform .2s var(--ms-ease)}
.ms-tilt{display:grid}
.ms-tilt>*{grid-area:1/1}
.ms-p{opacity:0;transition:opacity .15s var(--ms-ease)}
.ms-idle{opacity:1}
.ms-body[data-pose="chew"] .ms-idle,.ms-body[data-pose="cheer"] .ms-idle{opacity:0}
.ms-body[data-pose="chew"] .ms-chew,.ms-body[data-pose="cheer"] .ms-cheer{opacity:1}
.ms-body[data-pose="chew"] .ms-tilt{animation:ms-chew .3s var(--ms-ease) 3}
.ms-body[data-pose="cheer"] .ms-tilt{animation:ms-hop .6s var(--ms-ease) 2}
@keyframes ms-chew{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(2px) rotate(-3deg) scale(1.03,.97)}}
@keyframes ms-hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-12px) scale(.97,1.04)}70%{transform:translateY(0) scale(1.04,.96)}}
.ms-star{position:absolute;left:50%;top:40%;width:10px;height:10px;margin:-5px 0 0 -5px;background:var(--ms-gold);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);pointer-events:none;animation:ms-star .9s var(--ms-ease) forwards}
@keyframes ms-star{from{opacity:1;transform:translate(0,0) scale(.5)}to{opacity:0;transform:translate(var(--sx),var(--sy)) scale(1.1)}}
.ms-body{position:relative}
.ms-tilt svg,.ms-tilt img{display:block;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 8px color-mix(in srgb,var(--ms-dark) 40%,transparent))}
.ms .e1{fill:var(--ms-ear)}.ms .e2,.ms .tr{fill:var(--ms-skin)}.ms .tr{stroke:var(--ms-skin)}.ms .cr{fill:var(--ms-gold)}.ms .sg{fill:var(--ms-dark)}.ms .sg2{stroke:var(--ms-dark)}.ms .sm{stroke:var(--ms-dark)}
@keyframes ms-beat{0%,60%,100%{transform:translateZ(0) scale(1);animation-timing-function:cubic-bezier(.16,1,.3,1)}12%{transform:translateZ(46px) scale(1.14)}26%{transform:translateZ(0) scale(1)}38%{transform:translateZ(30px) scale(1.09)}}
.ms.is-open .ms-beat{animation-play-state:paused}
.ms-body.is-munch .ms-tilt{animation:ms-munch .4s var(--ms-ease)}
@keyframes ms-munch{0%{transform:scale(1)}40%{transform:scale(1.12,.88)}100%{transform:scale(1)}}
.ms-badge{display:block;padding:8px 16px;border-radius:999px;background:var(--ms-gold);color:var(--ms-dark);font:700 .875rem/1.2 var(--sans,"Manrope",system-ui,sans-serif);text-decoration:none;box-shadow:0 6px 16px color-mix(in srgb,var(--ms-dark) 35%,transparent);touch-action:manipulation;transition:transform .15s var(--ms-ease),background-color .15s var(--ms-ease)}
.ms-badge:active,.ms-chip:active,.ms-copy:active,.ms-wa:active{transform:scale(.97)}
.ms-bubble{margin:0;max-width:200px;padding:12px 16px;border-radius:16px 16px 4px 16px;background:var(--ms-field);color:var(--ms-cream);border:1px solid var(--ms-gold);font:500 1rem/1.3 var(--serif,"Playfair Display",Georgia,serif);animation:ms-pop .45s var(--ms-ease) backwards}
@keyframes ms-pop{from{opacity:0;transform:scale(.95) translateY(8px)}}
.ms-panel{width:min(296px,calc(100vw - 24px));padding:16px;border-radius:20px;background:var(--ms-field);color:var(--ms-cream);border:1px solid var(--ms-gold);box-shadow:0 16px 32px color-mix(in srgb,var(--ms-dark) 45%,transparent);animation:ms-pop .35s var(--ms-ease) backwards}
.ms-panel[hidden],.ms-bubble[hidden],.ms-ticket[hidden],.ms-feed[hidden]{display:none}
.ms-say,.ms-tk-h{margin:0 0 12px;font:500 1.0625rem/1.3 var(--serif,"Playfair Display",Georgia,serif)}
.ms-row{display:flex;gap:8px;flex-wrap:wrap}
.ms-chip,.ms-copy,.ms-wa{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--ms-gold);background:transparent;color:var(--ms-cream);font:600 .9375rem/1 var(--sans,"Manrope",system-ui,sans-serif);cursor:pointer;text-decoration:none;touch-action:manipulation;transition:transform .15s var(--ms-ease),background-color .15s var(--ms-ease),color .15s var(--ms-ease)}
.ms-chip svg{width:20px;height:20px}
.ms-chip[aria-pressed="true"]{background:var(--ms-gold);color:var(--ms-dark)}
.ms-ticket{position:relative;padding:16px;border-radius:12px;background:var(--ms-cream);color:var(--ms-dark);animation:ms-ticket .7s var(--ms-ease) backwards;-webkit-mask:radial-gradient(circle 8px at 0 50%,#0000 98%,#000) left/51% 100% no-repeat,radial-gradient(circle 8px at 100% 50%,#0000 98%,#000) right/51% 100% no-repeat;mask:radial-gradient(circle 8px at 0 50%,#0000 98%,#000) left/51% 100% no-repeat,radial-gradient(circle 8px at 100% 50%,#0000 98%,#000) right/51% 100% no-repeat}
@keyframes ms-ticket{from{clip-path:inset(0 0 100% 0);transform:translateY(-8px)}to{clip-path:inset(0);transform:none}}
.ms-ticket .ms-tk-h{margin-bottom:4px}
.ms-code{margin:0 0 8px;padding:8px 12px;border:1px dashed var(--ms-dark);border-radius:8px;text-align:center;font:800 1.5rem/1.2 var(--sans,"Manrope",system-ui,sans-serif);user-select:all}
.ms-note{margin:0 0 12px;font:500 .875rem/1.4 var(--sans,"Manrope",system-ui,sans-serif)}
.ms-ticket .ms-copy,.ms-ticket .ms-wa{border-color:var(--ms-dark);color:var(--ms-dark)}
.ms-ticket .ms-copy{background:var(--ms-dark);color:var(--ms-cream)}
@media(hover:hover){.ms-badge:hover{background:var(--ms-cream)}.ms-chip:hover{background:var(--ms-gold);color:var(--ms-dark)}.ms-wa:hover{background:var(--ms-dark);color:var(--ms-cream)}}
@media(min-width:900px){.ms-body{width:120px;height:120px}}
@media(prefers-reduced-motion:reduce){.ms-beat,.ms-body.is-munch .ms-tilt,.ms-ticket,.ms-body[data-pose] .ms-tilt,.ms-star{animation:none}.ms-star{display:none}.ms-tilt{transition:none}.ms-bubble,.ms-panel{animation-name:ms-fade;animation-duration:.2s}@keyframes ms-fade{from{opacity:0}}}
</style>
<script is:inline src="/js/mascot.js"></script>
