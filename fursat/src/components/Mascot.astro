---
import fs from 'node:fs';
// PLACEHOLDER: client must confirm the coupon code, the offer and how staff redeem it.
const coupon = { code: 'FEEDFURSAT', note: 'Show this code to the Fursat team to claim your treat.' };
const hasImg = fs.existsSync('public/assets/ask-mascot-md.webp');
const wa = 'https://wa.me/919059670033?text=' + encodeURIComponent('Hi Fursat! I fed the elephant. My coupon code is ' + coupon.code);
const iDrink = '<path d="M5 4h14l-7 8z"/><path d="M12 12v7M8 20h8M13.5 7.5 17 2"/>';
const iFood = '<path d="M4 16a8 8 0 0 1 16 0z"/><path d="M3 19.5h18"/><circle cx="12" cy="5.5" r="1.3"/>';
---
<section class="ms" id="ms" aria-label="Ask Fursat mascot" data-code={coupon.code}>
  <p class="ms-bubble" id="ms-bubble">Click me for your <em>special offer</em>!</p>
  <div class="ms-stage">
    <div class="ms-float"><div class="ms-live">
    <button class="ms-body" id="ms-body" type="button" aria-expanded="false" aria-controls="ms-panel" aria-label="Feed the Fursat elephant for a special offer">
      <span class="ms-tilt" id="ms-tilt">
        {hasImg ? <><img class="ms-p ms-idle" src="/assets/ask-mascot-md.webp" alt="" width="400" height="400" decoding="async" /><img class="ms-p ms-chew" src="/assets/ask-mascot-chew-md.webp" alt="" width="400" height="400" decoding="async" /><img class="ms-p ms-cheer" src="/assets/ask-mascot-cheer-md.webp" alt="" width="400" height="400" decoding="async" /></> :
        <svg viewBox="0 0 120 120" aria-hidden="true"><ellipse class="e1" cx="22" cy="58" rx="20" ry="26"/><ellipse class="e1" cx="98" cy="58" rx="20" ry="26"/><circle class="e2" cx="60" cy="62" r="34"/><path class="tr" d="M60 74c0 16-2 26 8 32" fill="none" stroke-width="14" stroke-linecap="round"/><path class="cr" d="M38 36l7-16 8 10 7-14 7 14 8-10 7 16z"/><rect class="sg" x="36" y="52" width="20" height="13" rx="6"/><rect class="sg" x="64" y="52" width="20" height="13" rx="6"/><path class="sg2" d="M56 57h8" stroke-width="3"/><path class="sm" d="M50 78q10 8 20 0" fill="none" stroke-width="3" stroke-linecap="round"/></svg>}
      </span>
      <span class="ms-dot" id="ms-dot" aria-hidden="true">1</span>
    </button>
    <a class="ms-sign" href="/ask" aria-label="Ask Fursat: find a dish for your mood"><span class="ms-sign-t"><span class="ms-ask">Ask</span><span class="ms-fur" translate="no">Fursat</span></span></a>
    </div></div>
    <i class="ms-spark ms-s1" aria-hidden="true"></i><i class="ms-spark ms-s2" aria-hidden="true"></i><i class="ms-spark ms-s3" aria-hidden="true"></i>
  </div>
  <div class="ms-panel" id="ms-panel" role="region" aria-label="Feed the elephant" aria-live="polite" hidden>
    <div class="ms-feed" id="ms-feed">
      <p class="ms-say" id="ms-say">Feed me with a <em translate="no">Fursat</em> drink and food!</p>
      <div class="ms-row">
        <button class="ms-chip" type="button" data-feed="drink" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iDrink}></svg><span>Drink</span></button>
        <button class="ms-chip" type="button" data-feed="food" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iFood}></svg><span>Food</span></button>
      </div>
      <p class="ms-steps" aria-hidden="true"><i id="ms-s1"></i><i id="ms-s2"></i></p>
    </div>
    <div class="ms-ticket" id="ms-ticket" hidden>
      <p class="ms-tk-h">Your <em translate="no">Fursat</em> coupon</p>
      <p class="ms-code" id="ms-code" translate="no">{coupon.code}</p>
      <p class="ms-note">{coupon.note}</p>
      <div class="ms-acts"><button class="ms-copy" id="ms-copy" type="button">Copy code</button><a class="ms-wa" href={wa} target="_blank" rel="noopener">WhatsApp</a></div>
      <button class="ms-res" type="button" data-open="book">Reserve a table</button>
    </div>
  </div>
</section>
<style is:global>
:root{--ms-skin:#D9A88F;--ms-ear:#C98E74;--ms-dark:#1A1608;--ms-gold:#E0A63C;--ms-cream:#F4ECDA;--ms-field:#17200F;--ms-rust:#C94716;--ms-ease:cubic-bezier(.16,1,.3,1);--ms-size:170px;--ms-ask:calc(var(--ms-size)*.4)}
.ms{position:relative;display:grid;justify-items:center;gap:12px;padding:0 var(--pad,clamp(20px,5vw,84px)) clamp(56px,8vw,104px);margin-top:-56px;background:var(--rl-bg,var(--ms-field));color:var(--rl-ink,var(--ms-cream));perspective:640px;overflow-x:clip}
.ms-stage{position:relative;display:block;width:var(--ms-size);height:var(--ms-size)}
.js .ms:not(.is-in) .ms-stage{opacity:0}
.ms.is-in .ms-stage{animation:ms-rise 1.1s var(--ms-ease) backwards}
@keyframes ms-rise{0%{opacity:0;transform:translateY(64px) scale(.84)}60%{opacity:1}}
.ms-body{all:unset;box-sizing:border-box;position:relative;display:block;width:var(--ms-size);height:var(--ms-size);cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;border-radius:50%}
.ms-body::before{content:"";position:absolute;inset:-14%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--ms-gold) 45%,transparent),transparent 66%);animation:ms-glow 3.8s ease-in-out infinite;pointer-events:none}
.ms-body:focus-visible,.ms-sign:focus-visible,.ms-chip:focus-visible,.ms-copy:focus-visible,.ms-wa:focus-visible,.ms-res:focus-visible{outline:2px solid var(--ms-gold);outline-offset:3px}
.ms-float,.ms-live,.ms-tilt{position:relative;display:block;width:100%;height:100%}
.ms-float{transform-origin:50% 100%;animation:ms-float 3.8s ease-in-out infinite}
.ms-live{transform-origin:50% 100%;animation:ms-live 8s ease-in-out infinite}
.ms-tilt{display:grid;transform:rotateY(var(--ry,0deg)) rotateX(var(--rx,0deg));transition:transform .2s var(--ms-ease)}
.ms-tilt>*{grid-area:1/1}
.ms-p{opacity:0;transition:opacity .15s var(--ms-ease)}
.ms-idle{opacity:1}
.ms-body[data-pose="chew"] .ms-idle,.ms-body[data-pose="cheer"] .ms-idle{opacity:0}
.ms-body[data-pose="chew"] .ms-chew,.ms-body[data-pose="cheer"] .ms-cheer{opacity:1}
.ms-body[data-pose="chew"] .ms-tilt{animation:ms-chew .3s var(--ms-ease) 3}
.ms-body[data-pose="cheer"] .ms-tilt{animation:ms-hop .6s var(--ms-ease) 2}
.ms-tilt svg,.ms-tilt img{display:block;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 8px 8px color-mix(in srgb,var(--ms-dark) 40%,transparent))}
.ms .e1{fill:var(--ms-ear)}.ms .e2,.ms .tr{fill:var(--ms-skin)}.ms .tr{stroke:var(--ms-skin)}.ms .cr{fill:var(--ms-gold)}.ms .sg{fill:var(--ms-dark)}.ms .sg2{stroke:var(--ms-dark)}.ms .sm{stroke:var(--ms-dark)}
.ms.is-open .ms-live{animation-play-state:paused}
@keyframes ms-float{0%,100%{transform:translateY(0) scale(1,1)}50%{transform:translateY(-7px) scale(1.012,1.026)}}
@keyframes ms-live{0%{transform:rotate(-1.6deg)}28%{transform:rotate(1.6deg)}54%{transform:rotate(-1.6deg)}58%{transform:translateY(0) scale(1.05,.94) rotate(0)}64%{transform:translateY(-18px) scale(.97,1.05) rotate(-5deg)}70%{transform:translateY(0) scale(1.05,.95) rotate(0)}75%{transform:rotate(6deg)}81%{transform:rotate(-5deg)}87%{transform:rotate(3deg)}93%,100%{transform:rotate(-1.6deg)}}
@keyframes ms-glow{0%,100%{opacity:.45;transform:scale(.94)}50%{opacity:.9;transform:scale(1.04)}}
@keyframes ms-chew{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(2px) rotate(-3deg) scale(1.03,.97)}}
@keyframes ms-hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-12px) scale(.97,1.04)}70%{transform:translateY(0) scale(1.04,.96)}}
.ms-spark,.ms-star{position:absolute;width:12px;height:12px;background:var(--ms-gold);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);pointer-events:none}
.ms-spark{opacity:0;animation:ms-twinkle 2.8s ease-in-out infinite}
.ms-s1{left:2px;top:14%}.ms-s2{right:0;top:6%;width:9px;height:9px;animation-delay:-.9s}.ms-s3{right:6px;top:52%;width:8px;height:8px;animation-delay:-1.8s}
@keyframes ms-twinkle{0%,100%{opacity:0;transform:scale(.4) rotate(0)}45%{opacity:1;transform:scale(1) rotate(45deg)}70%{opacity:0;transform:scale(.5) rotate(90deg)}}
.ms-star{left:50%;top:40%;margin:-5px 0 0 -5px;width:10px;height:10px;animation:ms-star .9s var(--ms-ease) forwards}
@keyframes ms-star{from{opacity:1;transform:translate(0,0) scale(.5)}to{opacity:0;transform:translate(var(--sx),var(--sy)) scale(1.1)}}
.ms-dot{position:absolute;right:2px;top:6px;z-index:2;display:grid;place-items:center;min-width:24px;height:24px;border-radius:12px;background:var(--ms-rust);color:var(--ms-cream);border:2px solid var(--ms-field);font:800 .75rem/1 var(--sans,"Manrope",system-ui,sans-serif)}
.ms-dot::after{content:"";position:absolute;inset:-2px;border-radius:12px;border:2px solid var(--ms-rust);animation:ms-ping 2s ease-out infinite}
.ms-dot[hidden]{display:none}
@keyframes ms-ping{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(1.9)}}
.ms-sign{position:absolute;left:50%;top:84%;z-index:3;display:grid;place-items:center;width:var(--ms-ask);height:var(--ms-ask);margin:calc(var(--ms-ask)/-2) 0 0 calc(var(--ms-ask)/-2);border-radius:50%;background:var(--ms-field);border:2px solid var(--ms-gold);box-shadow:0 0 14px color-mix(in srgb,var(--ms-gold) 45%,transparent),0 6px 12px color-mix(in srgb,var(--ms-dark) 45%,transparent);text-decoration:none;touch-action:manipulation;transition:background-color .15s var(--ms-ease)}
.ms.is-in .ms-sign{animation:ms-signin .7s var(--ms-ease) .6s backwards,ms-beat 1.15s ease-in-out 1.3s infinite}
.ms-sign::before,.ms-sign::after{content:"";position:absolute;border-radius:50%;pointer-events:none}
.ms-sign::before{inset:-6px;border:2.5px dotted var(--ms-gold);animation:ms-bulb 1.4s steps(1) infinite}
.ms-sign::after{inset:-2px;border:2px solid var(--ms-gold);opacity:0}
.ms.is-in .ms-sign::after{animation:ms-ripple 1.15s ease-out 1.3s infinite}
@keyframes ms-bulb{0%{opacity:1}50%{opacity:.3}}
@keyframes ms-signin{from{opacity:0;transform:scale(.2) rotate(-20deg)}}
@keyframes ms-beat{0%,52%,100%{transform:scale(1)}12%{transform:scale(1.2)}24%{transform:scale(.97)}36%{transform:scale(1.12)}}
@keyframes ms-ripple{0%{opacity:.75;transform:scale(1)}45%,100%{opacity:0;transform:scale(1.9)}}
.ms-sign-t{display:grid;justify-items:center;gap:calc(var(--ms-ask)*.03);line-height:1;text-align:center}
.ms-ask{color:var(--ms-cream);font:700 calc(var(--ms-ask)*.15)/1 "Poppins","Poppins Fallback",var(--sans,"Manrope",system-ui,sans-serif);letter-spacing:.06em;text-transform:uppercase}
.ms-fur{color:var(--ms-gold);font:italic 700 calc(var(--ms-ask)*.235)/1 var(--serif,"Playfair Display",Georgia,serif)}
.ms-bubble{position:relative;margin:0 0 8px;max-width:260px;padding:12px 16px;border-radius:18px;background:var(--ms-field);color:var(--ms-cream);border:1.5px solid var(--ms-gold);box-shadow:0 0 16px color-mix(in srgb,var(--ms-gold) 30%,transparent);font:italic 600 1.0625rem/1.3 var(--serif,"Playfair Display",Georgia,serif);text-align:center;cursor:pointer;animation:ms-nudge 2.4s ease-in-out infinite}
.js .ms:not(.is-in) .ms-bubble{opacity:0;animation:none}
.ms.is-in .ms-bubble{animation:ms-pop .5s var(--ms-ease) .35s backwards,ms-nudge 2.4s ease-in-out .9s infinite}
.ms-bubble em{color:var(--ms-gold);font-weight:700}
.ms-bubble::after{content:"";position:absolute;left:50%;margin-left:-7px;bottom:-8px;width:14px;height:14px;background:var(--ms-field);border-right:1.5px solid var(--ms-gold);border-bottom:1.5px solid var(--ms-gold);transform:rotate(45deg)}
@keyframes ms-pop{from{opacity:0;transform:scale(.95) translateY(8px)}}
@keyframes ms-nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.ms-panel{width:min(340px,100%);scroll-margin-bottom:132px;padding:16px;border-radius:20px;background:var(--ms-field);color:var(--ms-cream);border:1.5px solid var(--ms-gold);box-shadow:0 16px 32px color-mix(in srgb,var(--ms-dark) 45%,transparent);animation:ms-pop .35s var(--ms-ease) backwards}
.ms-panel[hidden],.ms-bubble[hidden],.ms-ticket[hidden],.ms-feed[hidden],.ms-dot[hidden]{display:none}
.ms-say,.ms-tk-h{margin:0 0 12px;font:italic 600 1.125rem/1.3 var(--serif,"Playfair Display",Georgia,serif)}
.ms-say em,.ms-tk-h em{color:var(--ms-gold);font-weight:700}
.ms-row{display:flex;gap:8px}
.ms-chip{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 14px;border-radius:999px;border:1.5px solid var(--ms-gold);background:transparent;color:var(--ms-cream);font:700 .9375rem/1 var(--sans,"Manrope",system-ui,sans-serif);cursor:pointer;touch-action:manipulation;transition:transform .15s var(--ms-ease),background-color .15s var(--ms-ease),color .15s var(--ms-ease)}
.ms-chip svg{width:22px;height:22px;flex:none}
.ms-chip[aria-pressed="true"]{background:var(--ms-gold);color:var(--ms-dark)}
.ms-chip:active,.ms-copy:active,.ms-wa:active,.ms-res:active{transform:scale(.97)}
.ms-steps{display:flex;justify-content:center;gap:6px;margin:12px 0 0}
.ms-steps i{width:8px;height:8px;border-radius:50%;background:color-mix(in srgb,var(--ms-cream) 25%,transparent);transition:background-color .15s var(--ms-ease)}
.ms-steps i.on{background:var(--ms-gold)}
.ms-fly{position:fixed;left:0;top:0;z-index:60;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--ms-gold);color:var(--ms-dark);pointer-events:none;will-change:transform}
.ms-fly svg{width:26px;height:26px}
.ms-ticket{position:relative;padding:16px 16px 14px;border-radius:14px;background:var(--ms-cream);color:var(--ms-dark);animation:ms-ticket .6s var(--ms-ease) backwards}
.ms-ticket::before,.ms-ticket::after{content:"";position:absolute;top:58px;width:18px;height:18px;border-radius:50%;background:var(--ms-field)}
.ms-ticket::before{left:-9px}.ms-ticket::after{right:-9px}
@keyframes ms-ticket{from{clip-path:inset(0 0 100% 0);transform:translateY(-8px)}to{clip-path:inset(0);transform:none}}
.ms-ticket .ms-tk-h{margin:0 0 20px;text-align:center;font-size:1.0625rem}
.ms-ticket .ms-tk-h em{color:var(--ms-rust)}
.ms-code{margin:0 0 10px;padding:12px 8px;border:2px dashed var(--ms-dark);border-radius:10px;text-align:center;font:800 1.5rem/1 var(--sans,"Manrope",system-ui,sans-serif);letter-spacing:.06em;user-select:all;-webkit-user-select:all;animation:ms-stamp .45s var(--ms-ease) .25s backwards}
@keyframes ms-stamp{from{opacity:0;transform:scale(1.15)}}
.ms-note{margin:0 0 12px;text-align:center;font:500 .875rem/1.4 var(--sans,"Manrope",system-ui,sans-serif)}
.ms-acts{display:flex;gap:8px;margin:0 0 8px}
.ms-copy,.ms-wa,.ms-res{flex:1;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 12px;border-radius:999px;border:1.5px solid var(--ms-dark);font:700 .9375rem/1 var(--sans,"Manrope",system-ui,sans-serif);text-decoration:none;cursor:pointer;touch-action:manipulation;transition:transform .15s var(--ms-ease),background-color .15s var(--ms-ease),color .15s var(--ms-ease)}
.ms-copy{background:var(--ms-dark);color:var(--ms-cream)}
.ms-wa{background:transparent;color:var(--ms-dark)}
.ms-res{width:100%;background:var(--ms-gold);border-color:var(--ms-gold);color:var(--ms-dark)}
@media(hover:hover){.ms-sign:hover{background:var(--ms-gold)}.ms-sign:hover .ms-ask,.ms-sign:hover .ms-fur{color:var(--ms-dark)}.ms-chip:hover{background:var(--ms-gold);color:var(--ms-dark)}.ms-wa:hover{background:var(--ms-dark);color:var(--ms-cream)}.ms-res:hover{background:var(--ms-cream);border-color:var(--ms-dark)}}
@media(min-width:900px){:root{--ms-size:220px}.ms-bubble{max-width:300px;font-size:1.25rem}}
@media(prefers-reduced-motion:reduce){.ms-body::before,.ms-float,.ms-live,.ms-sign,.ms-sign::before,.ms-bubble,.ms-dot::after,.ms-ticket,.ms-code,.ms-body[data-pose] .ms-tilt,.ms-star,.ms.is-in .ms-stage,.ms.is-in .ms-sign,.ms.is-in .ms-bubble{animation:none}.ms-sign::after{display:none}.js .ms:not(.is-in) .ms-stage,.js .ms:not(.is-in) .ms-bubble{opacity:1}.ms-spark,.ms-star{display:none}.ms-body::before{opacity:.6}.ms-tilt{transition:none}.ms-panel{animation-name:ms-fade;animation-duration:.2s}@keyframes ms-fade{from{opacity:0}}}
</style>
<script is:inline src="/js/mascot.js"></script>
