---
import Base from '../layouts/Base.astro';
import SvgDefs from '../components/SvgDefs.astro';
import Hero from '../components/Hero.astro';
import Reels from '../components/Reels.astro';
import Mascot from '../components/Mascot.astro';
import Sparkles from '../components/Sparkles.astro';
import BookingDialog from '../components/BookingDialog.astro';
import StickyBar from '../components/StickyBar.astro';
import PicksTray from '../components/PicksTray.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import LegalBar from '../components/LegalBar.astro';
import LegalDialog from '../components/LegalDialog.astro';
import IntroHeli from '../components/IntroHeli.astro';
import IntroLogo from '../components/IntroLogo.astro';
import IntroGate from '../components/IntroGate.astro';
import IntroCaption from '../components/IntroCaption.astro';
import Wizard from '../components/Wizard.astro';
import VoiceButton from '../components/VoiceButton.astro';
---
<Base>
<a class="skip" href="#main">Skip to main content</a>
<SvgDefs />
<main id="main" tabindex="-1">
<Hero />
<Reels />
</main>
<Mascot />
<Sparkles />
<BookingDialog />
<StickyBar />
<PicksTray />
<MenuOverlay />
<LegalBar />
<LegalDialog />
<IntroHeli />
<IntroLogo />
<IntroGate />
<IntroCaption />
<Wizard />
<VoiceButton />
<script is:inline src="/js/01.js"></script>
<script is:inline src="/js/02.js"></script>
<script is:inline src="/js/03.js"></script>
<script is:inline src="/js/04.js"></script>
<script is:inline src="/js/05.js"></script>
<script is:inline src="/js/06.js"></script>
<script is:inline src="/js/07.js"></script>
<script is:inline src="/js/08.js"></script>
<script is:inline src="/js/09.js"></script>
<script is:inline id="fx-js" src="/js/10.js"></script>
<script is:inline src="/js/11.js"></script>
<script is:inline src="/js/12.js"></script>
<script is:inline src="/js/13.js"></script>
<script is:inline src="/js/14.js"></script>
