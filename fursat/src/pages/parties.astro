---
import Base from '../layouts/Base.astro';
const WA = 'https://wa.me/919059670033?text=' + encodeURIComponent('Hi Fursat! I would like to plan a party.');
---
<Base>
<a class="skip" href="#pp-main">Skip to main content</a>
<div class="pp">
  <header class="pp-hd">
    <a class="pp-logo" href="/" aria-label="Fursat home"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c1.9 2.1 2.7 3.9 2.7 5.8 0 1.9-1.1 3.3-2.7 4.2-1.6-.9-2.7-2.3-2.7-4.2 0-1.9.8-3.7 2.7-5.8Z" fill="#C9983F"/><path d="M3.6 8.2c2.6-.5 4.8.4 5.8 2.6-.4 1.7-1.8 2.8-3.7 2.9-1.6-.2-2.6-2.2-2.1-5.5ZM20.4 8.2c-2.6-.5-4.8.4-5.8 2.6.4 1.7 1.8 2.8 3.7 2.9 1.6-.2 2.6-2.2 2.1-5.5Z" fill="#A97C2C"/><path d="M11.4 21.6c-.3-3.3-2.2-5.4-7-5.6.2 3.4 2.9 5.4 7 5.6ZM12.6 21.6c.3-3.3 2.2-5.4 7-5.6-.2 3.4-2.9 5.4-7 5.6Z" fill="#1F4129"/></svg><span translate="no">FURSAT</span></a>
    <nav aria-label="Fursat"><a href="/">Home</a><a href="/ask">Ask Fursat</a></nav>
    <a class="pp-cta" href={WA} target="_blank" rel="noopener">Reserve a Table</a>
  </header>

  <main id="pp-main" tabindex="-1">
    <section class="pp-hero">
      <p class="pp-script" aria-hidden="true">celebrate with</p>
      <img class="pp-mascot" src="/assets/ask-mascot-md.webp" width="360" height="360" alt="" decoding="async">
      <h1>Plan the party, we will plate it.</h1>
      <p class="pp-lead">Tell us the occasion and the guest count. Pick a package and see the estimate as you go.</p>
      <div class="pp-occ" id="pp-occ" role="group" aria-label="What are you celebrating?"></div>
    </section>

    <section class="pp-panel" aria-label="Guest count">
      <label for="pp-n"><span>How many guests?</span><output for="pp-n"><b id="pp-nv">30</b> guests</output></label>
      <input id="pp-n" type="range" min="10" max="200" step="5" value="30">
      <p class="pp-ribbon" id="pp-ribbon" hidden>Sample prices shown. Final packages are confirmed with the Fursat team on WhatsApp.</p>
    </section>

    <section class="pp-cards" id="pp-cards" role="radiogroup" aria-label="Party packages"><noscript><p>Party packages start from ₹925 per person. Message us on WhatsApp for the full list.</p></noscript></section>
  </main>

  <aside class="pp-sum" id="pp-sum" aria-live="polite">
    <div><strong id="pp-sn">Pick a package</strong><span id="pp-sub">Slide the guests, choose a package</span></div>
    <b id="pp-est"></b>
    <a class="pp-go" id="pp-go" href={WA} target="_blank" rel="noopener">Plan it on WhatsApp</a>
  </aside>
</div>
<script is:inline src="/js/parties.js" defer></script>
</Base>
<style is:global>
@font-face{font-family:"Newsreader";src:url(/assets/fonts/newsreader-latin-400-normal.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Sacramento";src:url(/assets/fonts/sacramento-latin-400-normal.woff2) format("woff2");font-weight:400;font-display:swap}
@property --a{syntax:"<angle>";inherits:false;initial-value:0deg}
:root{--pg:#1F4129;--pgd:#142B1B;--pgold:#C9983F;--pgl:#A97C2C;--pink:#1F2A21;--pm:#66685A;--pcream:#F7F0DF;--pline:#DCCFAE;--pe:cubic-bezier(.23,1,.32,1);--ps:70 50 15}
html,body{background:#F2EBDB;overflow:auto;height:auto}
.pp{min-height:100svh;padding:0 clamp(16px,5vw,64px) 150px;color:var(--pink);font:400 1rem/1.5 "Manrope",system-ui,sans-serif;background:radial-gradient(900px 480px at 85% -5%,rgb(201 152 63/.18),transparent 70%),radial-gradient(700px 420px at 0 30%,rgb(31 65 41/.1),transparent 70%),#F2EBDB}
.pp-hd{display:flex;align-items:center;gap:20px;max-width:1100px;margin:0 auto;padding:16px 0;min-height:64px}
.pp-logo{display:flex;align-items:center;gap:8px;color:var(--pg);text-decoration:none;font:500 1.35rem/1 "Newsreader",Georgia,serif;letter-spacing:.12em}.pp-logo svg{width:28px;height:28px}
.pp-hd nav{display:flex;gap:6px;margin-left:12px}.pp-hd nav a{padding:12px 12px;font:400 .9rem/1 "Newsreader",Georgia,serif;color:var(--pink);text-decoration:none;border-radius:999px}
.pp-cta,.pp-go{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;border-radius:999px;background:var(--pg);color:var(--pcream);font:400 .9rem/1 "Newsreader",Georgia,serif;text-decoration:none;transition:transform .16s var(--pe),background-color .15s var(--pe)}
.pp-cta:active,.pp-go:active,.pp-occ button:active{transform:scale(.97)}
.pp a:focus-visible,.pp button:focus-visible,.pp input:focus-visible{outline:2px solid var(--pgl);outline-offset:3px}
.pp-hero,.pp-panel,.pp-cards{max-width:1100px;margin:0 auto}
.pp-hero{padding:clamp(28px,6vw,64px) 0 8px;position:relative}
.pp-script{margin:0 0 -.1em;font:400 clamp(2.4rem,6vw,3.6rem)/1 "Sacramento",cursive;color:var(--pgold)}
.pp h1{margin:0;max-width:14ch;font:400 clamp(2.6rem,8vw,5.2rem)/1.02 "Newsreader",Georgia,serif;letter-spacing:-.015em;color:var(--pg);text-wrap:balance}
.pp-mascot{position:absolute;right:0;top:clamp(10px,3vw,40px);width:min(34vw,340px);height:auto;pointer-events:none;animation:pp-float 6s cubic-bezier(.77,0,.175,1) infinite alternate}
.pp-lead{max-width:44ch;margin:18px 0 22px;color:#4A5446;font-size:1.0625rem}
.pp-occ{display:flex;flex-wrap:wrap;gap:10px}
.pp-occ button{min-height:44px;padding:0 20px;border:0;border-radius:999px;background:#EEE7D3;color:var(--pink);font:400 .9rem/1 "Manrope",system-ui,sans-serif;cursor:pointer;box-shadow:0 3px 9px rgb(var(--ps)/.12);transition:transform .16s var(--pe),background-color .15s var(--pe),color .15s var(--pe)}
.pp-occ button[aria-pressed=true]{background:var(--pg);color:var(--pcream)}
.pp-panel{margin-top:30px;padding:22px clamp(18px,3vw,30px);border-radius:28px;background:rgb(252 249 238/.8);border:1px solid var(--pline);box-shadow:0 10px 30px rgb(var(--ps)/.1)}
.pp-panel label{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;font:400 1.25rem/1.2 "Newsreader",Georgia,serif;color:var(--pg)}
.pp-panel output{font:400 .95rem "Manrope",system-ui,sans-serif;color:var(--pm);font-variant-numeric:tabular-nums}.pp-panel output b{font:500 1.6rem "Newsreader",Georgia,serif;color:var(--pg)}
#pp-n{--p:20%;width:100%;height:32px;margin:0;appearance:none;-webkit-appearance:none;background:transparent;cursor:pointer;touch-action:pan-y}
#pp-n::-webkit-slider-runnable-track{height:6px;border-radius:6px;background:linear-gradient(90deg,var(--pgold) var(--p),#E4D9BC var(--p))}
#pp-n::-moz-range-track{height:6px;border-radius:6px;background:linear-gradient(90deg,var(--pgold) var(--p),#E4D9BC var(--p))}
#pp-n::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;margin-top:-10px;border-radius:50%;background:var(--pg);border:4px solid var(--pcream);box-shadow:0 3px 10px rgb(var(--ps)/.35);transition:transform .15s var(--pe)}
#pp-n::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--pg);border:4px solid var(--pcream);box-shadow:0 3px 10px rgb(var(--ps)/.35)}
#pp-n:active::-webkit-slider-thumb{transform:scale(1.12)}
.pp-ribbon{margin:12px 0 0;font-size:.8125rem;color:var(--pgl)}
.pp-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:20px;margin-top:26px;perspective:1000px}
.pc{--a:0deg;position:relative;display:flex;flex-direction:column;padding:0;text-align:left;border:2px solid transparent;border-radius:26px;background:linear-gradient(#F8F3E4,#F8F3E4) padding-box,linear-gradient(#E4D9BC,#E4D9BC) border-box;color:inherit;cursor:pointer;overflow:hidden;box-shadow:0 8px 22px rgb(var(--ps)/.14);transform:perspective(900px) rotateX(var(--ry,0deg)) rotateY(var(--rx,0deg));transition:transform .25s var(--pe),box-shadow .25s var(--pe);touch-action:manipulation;font:inherit;animation:pp-in .6s var(--pe) backwards}
.pc:nth-child(2){animation-delay:.08s}.pc:nth-child(3){animation-delay:.16s}
.pc::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(220px circle at var(--gx,50%) var(--gy,0%),rgb(255 252 240/.55),transparent 70%);opacity:0;transition:opacity .2s}
.pc.on{background:linear-gradient(#FBF7EA,#FBF7EA) padding-box,conic-gradient(from var(--a),var(--pgold),var(--pg),var(--pgold),#E3B55E,var(--pgold)) border-box;animation:pp-spin 6s linear infinite;box-shadow:0 14px 34px rgb(var(--ps)/.24)}
.pc-img{display:block;aspect-ratio:16/9;overflow:hidden;background:var(--pgd)}.pc-img img{width:100%;height:100%;object-fit:cover;transition:scale .6s var(--pe)}
.pc-rec{position:absolute;left:12px;top:12px;padding:7px 12px;border-radius:999px;background:#FBF7EA;color:var(--pg);font:500 .75rem/1 "Manrope",system-ui,sans-serif;box-shadow:0 3px 10px rgb(var(--ps)/.2)}
.pc-b{display:flex;flex-direction:column;gap:6px;padding:18px 20px 20px}
.pc-tag{font-size:.8125rem;color:var(--pgl)}.pc-n{font:400 1.75rem/1.1 "Newsreader",Georgia,serif;color:var(--pg)}
.pc-p{font:500 1.35rem/1.2 "Newsreader",Georgia,serif;color:var(--pg);font-variant-numeric:tabular-nums}.pc-p small{font:400 .8125rem "Manrope",system-ui,sans-serif;color:var(--pm)}
.pc ul{margin:8px 0 6px;padding:0;list-style:none;display:grid;gap:7px}.pc li{position:relative;padding-left:22px;font-size:.9rem;color:#3F4A3F}
.pc li::before{content:"";position:absolute;left:2px;top:.5em;width:10px;height:6px;border-left:2px solid var(--pgold);border-bottom:2px solid var(--pgold);transform:rotate(-45deg) translateY(-30%)}
.pc-min{font-size:.78rem;color:var(--pm)}
.pp-sum{position:fixed;left:50%;bottom:max(14px,env(safe-area-inset-bottom));z-index:20;width:min(760px,calc(100% - 24px));display:flex;align-items:center;gap:14px;padding:12px 12px 12px 22px;border-radius:999px;background:rgb(247 240 223/.88);-webkit-backdrop-filter:blur(16px) saturate(1.3);backdrop-filter:blur(16px) saturate(1.3);border:1px solid var(--pline);box-shadow:0 14px 36px rgb(var(--ps)/.28);transform:translateX(-50%)}
.pp-sum div{display:flex;flex-direction:column;min-width:0;flex:1}.pp-sum strong{font:400 1.1rem/1.2 "Newsreader",Georgia,serif;color:var(--pg)}.pp-sum span{font-size:.78rem;color:var(--pm);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pp-sum b{font:500 1.35rem/1 "Newsreader",Georgia,serif;color:var(--pg);font-variant-numeric:tabular-nums;white-space:nowrap}.pp-sum .pp-go{margin:0;white-space:nowrap}
.pp-err{padding:24px}
@keyframes pp-float{to{transform:translateY(-10px) rotate(1.5deg)}}
@keyframes pp-in{from{opacity:0;transform:translateY(16px)}}
@keyframes pp-spin{to{--a:360deg}}
@keyframes pp-rev{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@supports(animation-timeline:view()){.pp-panel{animation:pp-rev linear both;animation-timeline:view();animation-range:entry 0% entry 60%}}
@media(hover:hover){.pp-cta:hover,.pp-go:hover{background:var(--pgd)}.pp-occ button:hover{background:#E6DCC0}.pp-occ button[aria-pressed=true]:hover{background:var(--pgd)}.pc:hover{box-shadow:0 14px 34px rgb(var(--ps)/.22)}.pc:hover::after{opacity:1}.pc:hover .pc-img img{scale:1.05}.pp-hd nav a:hover{background:rgb(201 152 63/.16)}}
@media(max-width:640px){.pp-mascot{width:34vw;top:0;opacity:.95}.pp-hd nav{display:none}.pp-cta{padding:0 16px}.pp-sum{padding-left:16px;gap:10px;border-radius:28px}.pp-sum b{font-size:1.1rem}.pp-sum .pp-go{padding:0 14px;font-size:.82rem}}
@media(prefers-reduced-motion:reduce){.pc,.pc.on,.pp-panel,.pp-mascot{animation:none!important}.pc,.pc-img img,.pp-cta,.pp-go,.pp-occ button{transition:none!important}.pc.on{background:linear-gradient(#FBF7EA,#FBF7EA) padding-box,linear-gradient(var(--pgold),var(--pgold)) border-box}}
</style>
