.as-prog{position:fixed;left:0;top:0;height:3px;width:100%;z-index:60;background:var(--as-gold,#C9983F);transform-origin:0 50%;transform:scaleX(0);pointer-events:none}
@supports(animation-timeline:scroll()){.as-prog{animation:as-prog linear both;animation-timeline:scroll(root)}@keyframes as-prog{to{transform:scaleX(1)}}}
html.fx2 .ac:not(.in){opacity:0;translate:0 28px}
html.fx2 .ac{transition:opacity .8s var(--as-ease),translate .8s var(--as-ease)}
.as-reserve,.ac-go{will-change:translate}
@media(prefers-reduced-motion:reduce){html.fx2 .ac:not(.in){opacity:1;translate:0 0}.as-prog{display:none}}

/* ---- UPDATE 14: leaf-plate results (renamed .pk -> .mc: .pk is a fixed overlay in 05.css and hid every result) ---- */
.rs.pre .mc,.rs.pre .rs-h{opacity:0}
.rs-list{grid-template-columns:repeat(3,minmax(0,1fr));gap:calc(var(--u)*34) calc(var(--u)*26);align-items:start}
.mc{--c1:#1F4129;--c2:#3A6B46;position:relative;display:flex;flex-direction:column;min-width:0}
.mc[data-t="1"]{--c1:#4B5A22;--c2:#7F9440}
.mc[data-t="2"]{--c1:#82381F;--c2:#B8602F}
.mc[data-t="3"]{--c1:#8A6322;--c2:#C9983F}
.mc-fig{position:relative}
.mc-img{position:relative;aspect-ratio:10/9;overflow:hidden;border-radius:50% 5% 50% 5%;background:var(--c1);isolation:isolate}
.mc:nth-child(even) .mc-img{border-radius:5% 50% 5% 50%}
.mc-img img{display:block;width:100%;height:100%;object-fit:cover}
.mc-ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--as-cream);background:radial-gradient(60% 60% at 30% 25%,rgb(255 255 255/.16),transparent 70%),linear-gradient(150deg,var(--c2),var(--c1))}
.mc-ph svg{width:34%;height:34%;opacity:.92}
.mc-seal{position:absolute;bottom:0;left:calc(var(--u)*8);translate:0 34%;display:grid;place-items:center;align-content:center;width:max(54px,calc(var(--u)*66));height:max(54px,calc(var(--u)*66));border-radius:50%;background:linear-gradient(150deg,#F0CB78,#C9983F);color:#1B2A15;box-shadow:0 calc(var(--u)*6) calc(var(--u)*14) rgb(var(--as-sh)/.28),inset 0 0 0 2px rgb(255 248 224/.55);font-family:var(--as-serif);line-height:1;text-align:center}
.mc:nth-child(even) .mc-seal{left:auto;right:calc(var(--u)*8);translate:0 34%}
.mc-seal b{font-weight:500;font-size:max(16px,calc(var(--u)*18))}
.mc-seal small{font:600 max(9px,calc(var(--u)*8.5))/1 var(--as-sans);letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px}
.mc-b{display:flex;flex-direction:column;gap:calc(var(--u)*7);padding:calc(var(--u)*30) calc(var(--u)*4) 0}
.mc-n{display:flex;align-items:flex-start;gap:8px;margin:0;font:400 max(19px,calc(var(--u)*21))/1.18 var(--as-serif);color:var(--as-green);text-wrap:balance}
.mc-vg{flex:none;width:13px;height:13px;margin-top:.32em;border:1.5px solid currentColor;border-radius:3px;display:grid;place-items:center}
.mc-vg::after{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.mc-vg.is-veg{color:#2E7D32}.mc-vg.is-nv{color:#B3261E}
.mc-m{margin:0;font:400 max(13px,calc(var(--u)*12.5))/1.45 var(--as-sans);color:#4A5446}
.mc-w{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:2px 0 0;padding:0}
.mc-w li{padding:4px 10px;border-radius:999px;background:var(--as-chip);color:var(--as-green);font:500 max(12px,calc(var(--u)*11))/1.2 var(--as-sans)}
@media(hover:hover){.mc-img img,.mc-ph svg{transition:scale .6s var(--as-ease)}.mc:hover .mc-img img,.mc:hover .mc-ph svg{scale:1.05}}
@media(prefers-reduced-motion:reduce){.mc-img img,.mc-ph svg{transition:none}.rs.pre .mc,.rs.pre .rs-h{opacity:1}}
/* header: icons and type must always be visible */
.hd svg{display:block;flex:none;overflow:visible}
.hd-bg{opacity:1!important;background:rgb(247 240 223/.94)}
.hd-cta svg{width:max(14px,calc(var(--u)*13));height:max(14px,calc(var(--u)*13))}
.hd-logo,.hd-logo svg{color:var(--as-green)}
.hd-links a,.hd-t{color:var(--as-ink)}
.hd-cta,.hd-cta svg{color:var(--as-cream)}
.hd-logo span,.hd-links a,.hd-cta{font-family:var(--as-serif);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
@media(max-width:759px){
  .hd-logo svg{width:26px;height:26px}.hd-cta{font-size:.875rem}
  .rs-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 14px}
  .mc-seal{width:50px;height:50px;left:6px;translate:0 30%}.mc:nth-child(even) .mc-seal{left:auto;right:6px;translate:0 30%}
  .mc-seal b{font-size:1rem}
  .mc-b{padding:24px 2px 0}.mc-n{font-size:1.125rem}.mc-m{font-size:.8125rem}
}
@media(max-width:339px){.rs-list{grid-template-columns:minmax(0,1fr)}}

/* ---- UPDATE 17: Ask-first hero. One grid: heading + Ask card top-left, photo slideshow right. No absolute canvas, no overlaps. ---- */
.as-hero{position:relative;z-index:1;height:auto;padding:clamp(92px,8.5vw,112px) clamp(16px,4vw,56px) clamp(28px,3.5vw,48px);box-sizing:border-box}
.as-art{position:relative;width:auto;max-width:1280px;height:auto;margin:0 auto;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:0 clamp(20px,3.2vw,48px);align-items:stretch}
.as-left{position:relative;z-index:3;display:flex;flex-direction:column;gap:clamp(18px,2vw,26px);min-width:0}
.as-sp-tl{display:none}
.as-intro{position:static;left:auto;top:auto;width:auto}
.as-eyebrow{font-size:.6875rem;white-space:normal}
.as-h{margin:12px 0 0;font:400 clamp(2.4rem,4.2vw,3.6rem)/1.04 var(--as-serif)}
.as-h span{display:block;white-space:normal}
.as-rule{margin:14px 0 10px}.as-rule svg{width:20px;height:20px}.as-rule span{width:70px}
.as-sub{max-width:36ch;font:400 1rem/1.5 var(--as-sans)}
/* the Ask card */
.ac{position:relative;width:auto;height:auto;max-width:none;margin:0;padding:clamp(40px,3.4vw,48px) clamp(18px,2.4vw,32px) 12px;border-radius:44px 22px 44px 44px;background:#F7F2E2;border:1px solid #E4D9BC;box-shadow:0 16px 36px rgb(var(--as-sh)/.2);text-align:center}
.ac-bg,.ac-decor{display:none}
.ac-title{position:relative;left:auto;top:auto;width:auto;display:flex;flex-direction:column;align-items:center}
.ac-ask{position:absolute;left:calc(50% - 9.25rem);top:-1.5rem;font-size:4rem}
.ac-name{margin-top:1.15rem;font-size:2.5rem;padding-left:.16em}
.ac-cap{font-size:.6875rem}
.ac-form{position:relative;left:auto;top:auto;width:auto;height:58px;margin-top:22px;padding:0 6px 0 20px;gap:10px}
.ac-lead{width:24px;height:24px}.ac-input{font-size:.9375rem}.ac-go{width:44px;height:44px}
.ac-chips{position:relative;left:auto;top:auto;width:auto;gap:10px;margin-top:16px}
.ac-chips li.ac-br,.ac-skip{display:none!important}
.ac-chips button{height:44px;padding:0 18px;gap:10px;font-size:.875rem;margin-bottom:0}
.ac-chips svg.ci{width:26px;height:26px;min-width:26px;margin-left:-6px;padding:5px}
.ac-tabs{position:relative;left:auto;bottom:auto;width:auto;flex-wrap:wrap;margin-top:8px}
.ac-tabs button{font-size:.8125rem}
/* photo: always inside its own stacking context, always behind the text */
.as-photo{position:relative;z-index:0;isolation:isolate;left:auto;top:auto;right:auto;height:auto;min-height:clamp(440px,44vw,600px);margin:0;border-radius:120px 44px 44px 44px;overflow:hidden;background:var(--as-photo);box-shadow:0 18px 40px rgb(var(--as-sh)/.22)}
.as-photo img.sl,.as-photo img.sl-d{position:absolute;inset:0;left:0;top:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:44% 50%}
.as-photo img.sl-d{object-position:50% 50%}
.as-photo img.sl:not(.sl-d){animation:as-settle 1.5s var(--as-ease) backwards}
.as-ctl{left:16px;right:auto;top:auto;bottom:16px;justify-content:flex-start}
/* results: clean menu cards, same size for every dish */
.as-main{padding-bottom:clamp(120px,14vw,200px)}
.as-main:has(.rs:not([hidden])){padding-bottom:clamp(120px,14vw,200px)}
.rs{width:min(1120px,calc(100% - 32px));max-width:none;margin:clamp(8px,2vw,24px) auto 0}
.rs-h{padding-left:0;margin-bottom:20px}.rs-h span{max-width:26em}
.rs-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px;align-items:stretch}
.mc{display:grid;grid-template-columns:92px minmax(0,1fr) auto;align-items:center;column-gap:16px;padding:12px 18px 12px 12px;background:#FBF7EA;border:1px solid #E6DBBE;border-radius:22px;box-shadow:0 6px 18px rgb(var(--as-sh)/.08)}
.mc-fig{display:contents}
.mc-img,.mc:nth-child(even) .mc-img{grid-column:1;grid-row:1;width:92px;height:92px;aspect-ratio:1;border-radius:16px}
.mc-ph svg{width:44%;height:44%}
.mc-b{grid-column:2;grid-row:1;padding:0;gap:6px;min-width:0}
.mc-n{font-size:1.125rem;line-height:1.2}
.mc-m{font-size:.8125rem}
.mc-w li{padding:3px 9px;font-size:.75rem}
.rs-list .mc:nth-child(n) .mc-seal{grid-column:3;grid-row:1;position:static;left:auto;right:auto;translate:none;width:auto;height:auto;display:flex;flex-direction:column;align-items:flex-end;background:none;box-shadow:none;border-radius:0;color:var(--as-green);padding-left:4px;text-align:right}
.mc-seal b{font-size:1.25rem}
.mc-seal small{margin:0 0 2px;color:var(--as-mute)}
@media(min-width:760px){.ac-chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ac-chips[hidden]{display:none}.ac-chips li{display:block}.ac-chips button{width:100%;justify-content:center;padding:0 10px;gap:8px;white-space:normal;line-height:1.2;text-align:left}}
@media(max-width:959px){
  .as-art{grid-template-columns:minmax(0,1fr);gap:22px}
  .as-photo{min-height:0;aspect-ratio:4/3.3}
}
@media(max-width:759px){
  .as-intro{order:0}.ac{order:1}
  .as-hero{padding:80px 14px 20px}.as-eyebrow{letter-spacing:.22em}.ac-input{font-size:.8125rem}
  .as-sp-tl{display:none}
  .as-h{font-size:clamp(2.2rem,10.5vw,3rem)}
  .as-sub{font-size:.9375rem}
  .ac{padding:36px 14px 10px;border-radius:40px 20px 40px 40px}
  .ac-ask{left:calc(50% - 7.75rem);top:-1.35rem;font-size:3.4rem}
  .ac-name{font-size:2.1rem;margin-top:.9rem}
  .ac-form{height:56px;margin-top:18px;padding:0 6px 0 16px}
  .ac-chips button{font-size:.8125rem;padding:0 14px}
  .as-photo{border-radius:80px 32px 32px 32px}
  .as-ctl{left:12px;right:12px;bottom:12px;justify-content:space-between;padding:4px 4px 4px 14px}
  .as-capn{display:none}
  .rs{width:calc(100% - 28px)}
  .rs-list{grid-template-columns:minmax(0,1fr);gap:12px}
  .mc{grid-template-columns:72px minmax(0,1fr) auto;column-gap:12px;padding:10px 14px 10px 10px}
  .mc-img,.mc:nth-child(even) .mc-img{width:72px;height:72px;border-radius:14px}
  .mc-n{font-size:1.0625rem}
}
@media(prefers-reduced-motion:reduce){.as-photo img.sl:not(.sl-d){animation:none}}
