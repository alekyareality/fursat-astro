<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol></svg>
<AskHeader client:load wa={WA} />
<div class="as">
  <section class="as-hero" aria-label="Fursat">
    <div class="as-art">
      <div class="as-photo" id="as-photo" role="group" aria-roledescription="carousel" aria-label="Fursat photos"><picture><source media="(max-width:759px)" type="image/webp" srcset={A + 'hero-m640.webp 640w, ' + A + 'hero-m900.webp 900w'} sizes="100vw"><img class="sl on" src={A + 'hero.webp'} width="2124" height="1065" alt="Fursat’s elephant host in a gold crown and sunglasses, resting his chin on a marble table in the café" fetchpriority="high" decoding="async"></picture>
      {dishes.map((d) => <img class="sl sl-d" src={'/assets/' + d[1] + '.webp'} width="900" height="514" alt={d[2]} loading="lazy" decoding="async" />)}
      <div class="as-ctl">
        <p class="as-capn" id="as-capn">{names[0]}</p>
        <div class="as-dots" role="group" aria-label="Choose a photo">{names.map((n, i) => <button class="as-dot" type="button" data-n={n} aria-label={`Photo ${i + 1}: ${n}`} aria-current={i === 0 ? 'true' : 'false'}><i></i></button>)}</div>
        <button class="as-sb" id="as-prev" type="button" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button class="as-sb" id="as-next" type="button" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <button class="as-sb" id="as-pz" type="button" aria-label="Pause slideshow" aria-pressed="false"><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.500v14H7zM13.500 5H17v14h-3.500z"/></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.500v13l11-6.500z"/></svg></button>
      </div>
    </div>
      <svg class="as-paper" viewBox="0 0 896 540" aria-hidden="true"><path d="M0 -2H649L647.1 3 645.1 6 643.0 9 640.9 12 638.6 15 636.3 18 633.8 21 631.1 24 628.1 27 624.9 30 621.3 33 617.4 36 613.1 39 608.3 42 603.1 45 597.7 48 592.0 51 585.8 54 579.3 57 572.7 60 566.0 63 559.0 66 551.9 69 544.8 72 537.7 75 530.6 78 523.5 81 516.7 84 510.1 87 503.7 90 497.5 93 491.7 96 486.2 99 480.9 102 476.0 105 471.5 108 467.3 111 463.4 114 459.8 117 456.5 120 453.5 123 450.7 126 448.1 129 445.7 132 443.4 135 441.3 138 439.3 141 437.5 144 435.9 147 434.3 150 432.9 153 431.6 156 430.5 159 429.4 162 428.5 165 427.8 168 427.2 171 426.7 174 426.3 177 426.1 180 426.1 183 426.1 186 426.1 189 426.1 192 426.2 195 426.4 198 426.6 201 426.9 204 427.1 207 427.3 210 427.5 213 427.5 216 427.5 219 427.3 222 427.0 225 426.7 228 426.1 231 425.4 234 424.4 237 423.3 240 422.1 243 420.7 246 419.2 249 417.6 252 415.9 255 414.2 258 412.4 261 410.6 264 408.8 267 407.0 270 405.2 273 403.5 276 402.0 279 400.5 282 399.1 285 397.5 288 395.9 291 394.2 294 392.4 297 390.4 300 388.3 303 386.0 306 383.5 309 380.8 312 377.7 315 374.2 318 370.5 321 366.5 324 362.2 327 357.7 330 352.8 333 347.6 336 341.9 339 335.6 342 329.0 345 322.2 348 315.2 351 307.9 354 300.4 357 292.9 360 285.6 363 278.2 366 270.8 369 263.2 372 256.0 375 249.0 378 241.1 381 230.9 384 215.4 387 195.0 390L190 398 139 412 111 427 0 442Z"/><path d="M783 537 784 533 800 526 816 521 832 518 848 516 864 516 880 517 898 517V540H783Z"/></svg>
      <span class="as-lobex" aria-hidden="true"></span>
      <span class="as-blobx" aria-hidden="true"></span>
      <img class="as-blob" src={A + 'blob.webp'} width="310" height="250" alt="" decoding="async">
      <img class="as-sp as-sp-tl" src={A + 'sprig-tl.webp'} width="100" height="106" alt="" decoding="async">
      <img class="as-sp as-sp-gd" src={A + 'sprig-gold.webp'} width="48" height="84" alt="" decoding="async">
      <div class="as-intro">
        <p class="as-eyebrow">Good food <i aria-hidden="true">&bull;</i> Slow moments <i aria-hidden="true">&bull;</i> Together</p>
        <h1 class="as-h"><span>What are you</span> <span>in the mood for?</span></h1>
        <p class="as-rule" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#i-sprig"/></svg><span></span></p>
        <p class="as-sub">Tell Fursat how you feel and we will find the dish.</p>
      </div>
    </div>
  </section>

  <main id="ask-main" tabindex="-1" class="as-main">
    <section class="ac" id="ask-fursat" aria-label="Ask Fursat, your food companion">
      <svg class="ac-bg" viewBox="0 0 667 416" preserveAspectRatio="none" aria-hidden="true"><defs><radialGradient id="acg" cx="50%" cy="55%" r="65%"><stop offset="0" stop-color="#F8F2E2"/><stop offset="1" stop-color="#F3EEDA"/></radialGradient></defs><path d="M48.0,0.5 60.0,0.5 72.0,0.5 84.0,0.6 96.0,0.7 108.0,0.7 120.0,0.9 132.0,1.0 144.0,1.4 156.0,2.3 168.0,3.3 180.0,3.9 192.0,4.0 204.0,4.0 216.0,4.0 228.0,4.0 240.0,4.1 252.0,4.6 264.0,5.4 276.0,6.4 288.0,7.3 300.0,8.4 312.0,9.7 324.0,11.0 336.0,12.2 348.0,13.4 360.0,14.7 372.0,15.9 384.0,17.0 396.0,18.0 408.0,19.0 420.0,20.0 432.0,20.9 444.0,21.7 456.0,22.4 468.0,23.1 480.0,23.8 492.0,24.5 504.0,25.1 516.0,25.8 528.0,26.5 540.0,27.5 552.0,28.8 564.0,30.3 576.0,31.9 588.0,33.6 600.0,35.3 612.0,37.2 624.0,39.1 631.6,40.1 636.7,40.8 641.7,42.2 646.5,44.3 650.9,47.0 654.9,50.2 658.5,54.0 661.5,58.3 663.9,62.9 665.6,67.7 666.6,72.8 667.0,78.0 666.9,373.1 666.0,379.4 664.3,385.4 661.8,391.2 658.6,396.5 654.6,401.4 650.0,405.7 644.9,409.3 639.3,412.2 633.4,414.3 627.3,415.6 621.0,416.0 48.5,415.9 41.4,414.9 34.6,413.0 28.1,410.2 22.0,406.5 16.5,402.0 11.7,396.8 7.6,391.0 4.3,384.7 1.9,378.0 0.5,371.1 0.0,364.0 0.1,45.7 1.0,39.2 2.8,32.9 5.4,26.9 8.8,21.3 12.9,16.2 17.7,11.8 23.1,8.0 28.9,5.0 35.0,2.8 41.5,1.4 48.0,1.0Z" fill="url(#acg)" stroke="#FBF7EA" stroke-opacity=".9" stroke-width="1.5"/></svg>
      <img class="ac-decor" src={A + 'card-decor.webp'} width="1334" height="832" alt="" decoding="async">
      <h2 class="ac-title"><span class="ac-ask" aria-hidden="true">ask</span><span class="ac-name" translate="no">FURSAT</span><span class="ac-cap">Your food companion</span></h2>
      <div class="ac-form" role="search">
        <svg class="ac-lead" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mark"/></svg>
        <label class="ac-sr" for="af-q">Tell Fursat what you feel like eating</label>
        <input class="ac-input" id="af-q" type="text" placeholder="Something spicy under 400" enterkeyhint="search" maxlength="120" autocomplete="off">
        <button class="ac-mic" id="af-mic" type="button" aria-label="Speak your mood" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg></button>
        <button class="ac-go" id="af-send" type="button" aria-label="Ask"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
      </div>
      <ul class="ac-chips" data-for="food" aria-label="Try one of these">
        <li><button type="button" data-mood={chips.food[0][0]}><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><use href={"#" + chips.food[0][1]}/></svg>{chips.food[0][0]}</button></li>
        <li><button type="button" data-mood={chips.food[1][0]}><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><use href={"#" + chips.food[1][1]}/></svg>{chips.food[1][0]}</button></li>
        <li class="ac-br" aria-hidden="true"></li>
        <li class="ac-skip"><a class="ac-skipchip" href="#as-results"><span>Skip to main content</span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a></li>
        <li><button type="button" data-mood={chips.food[2][0]}><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><use href={"#" + chips.food[2][1]}/></svg>{chips.food[2][0]}</button></li>
        <li class="ac-br" aria-hidden="true"></li>
        <li><button type="button" data-mood={chips.food[3][0]}><svg class="ci" viewBox="0 0 24 24" aria-hidden="true"><use href={"#" + chips.food[3][1]}/></svg>{chips.food[3][0]}</button></li>
      </ul>
      <ul class="ac-chips" data-for="drinks" aria-label="Try one of these" hidden>{chips.drinks.map(([t]) => <li><button type="button" data-mood={t}>{t}</button></li>)}</ul>
      <div class="ac-tabs" role="group" aria-label="Choose a menu"><span class="ac-ind" aria-hidden="true"></span><button type="button" data-tab="food" aria-pressed="true">Food</button><button type="button" data-tab="drinks" aria-pressed="false">Drinks</button><button type="button" data-tab="sree" aria-pressed="false">Sreemukhi’s Special</button></div>
    </section>
    <section class="rs" id="as-results" aria-live="polite" hidden></section>
  </main>
  <img class="as-bowl" src={A + 'bowl.webp'} width="440" height="178" alt="" decoding="async" loading="lazy">
  <img class="as-endg" src={A + 'end-green.webp'} width="256" height="174" alt="" decoding="async" loading="lazy">
</div>
<style is:global>
@font-face{font-family:"Newsreader";src:url(/assets/fonts/newsreader-latin-400-normal.woff2) format("woff2");font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:"Newsreader";src:url(/assets/fonts/newsreader-latin-500-normal.woff2) format("woff2");font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:"Sacramento";src:url(/assets/fonts/sacramento-latin-400-normal.woff2) format("woff2");font-weight:400;font-style:normal;font-display:swap}
:root{--as-paper:#F2EBDB;--as-chip:#EEE7D3;--as-field:#FCF9EE;--as-green:#1F4129;--as-green-deep:#142B1B;--as-leaf:#5C6B2E;--as-ink:#1F2A21;--as-mute:#66685A;--as-gold:#C9983F;--as-gold-hi:#E3B55E;--as-gold-lo:#A97C2C;--as-line:#DCCFAE;--as-cream:#F7F0DF;--as-photo:#2B2216;--as-edge:rgb(49,66,41);--as-sh:70 50 15;--as-serif:"Newsreader","Playfair Display",Georgia,serif;--as-sans:var(--sans,"Manrope",system-ui,sans-serif);--as-script:"Sacramento","Snell Roundhand",cursive;--as-ease:cubic-bezier(.16,1,.3,1);--u:min(calc(100vw / 896),1.6px);--bleed:max(0px,calc((100vw - 896 * var(--u)) / 2))}
html:has(.as),body:has(.as){overflow-x:clip;background:var(--as-paper)}
.as{position:relative;min-height:100svh;overflow-x:clip;background:var(--as-paper);color:var(--as-ink);font-family:var(--as-sans)}
:where(.as) svg{display:block}
.as a:focus-visible,.as button:focus-visible,.as input:focus-visible{outline:2px solid var(--as-green);outline-offset:3px}
.as-hero{position:relative;z-index:1;height:calc(var(--u)*540)}
.as-art{position:relative;width:calc(var(--u)*896);height:100%;margin:0 auto}
.as-photo{position:absolute;left:0;top:0;right:calc(var(--bleed)*-1);height:calc(var(--u)*536);overflow:hidden;background:var(--as-photo)}
.as-photo img{position:absolute;left:calc(var(--u)*180.9);top:calc(var(--u)*-0.0);width:calc(var(--u)*1062.0);height:auto;max-width:none}
.as-paper{position:absolute;left:0;top:0;width:calc(var(--u)*896);height:calc(var(--u)*540);fill:var(--as-paper)}
.as-lobex{position:absolute;left:100%;top:calc(var(--u)*516);width:var(--bleed);height:calc(var(--u)*24);background:var(--as-paper)}
.as-blobx{position:absolute;right:100%;top:calc(var(--u)*429);width:var(--bleed);height:calc(var(--u)*181);background:var(--as-edge)}
.as-blob{position:absolute;left:0;top:calc(var(--u)*380);width:calc(var(--u)*310);height:auto}
.as-sp{position:absolute;z-index:2;pointer-events:none;height:auto}
.as-sp-tl{left:0;top:0;width:calc(var(--u)*100)}
