---
import site from '../data/site.json';
// story.astro - Fursat Brand Story, Values & Heritage
// Reference layout: Cinder & Dew editorial cafe/bar system (Slide 1 & 2)
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import '../styles/fk-tokens.css';
---
<Base
  title="Our Story — Fursat Kitchen | Bar | Madhapur, Hyderabad"
  description="The story behind Fursat — a space born from the love of unhurried moments, good food and great company. Meet the team and the philosophy that drives us."
  canonical="https://fursatind.in/story/"
  ogImage="https://fursatind.in/assets/fursat_space_13.webp"
  ogImageAlt="Fursat — the story behind Madhapur's beloved kitchen and bar"
>
  <SiteHeader active="story" />

  <main class="st-page" id="main">
    <!-- ── 1. Editorial Hero Split ──────────────────────────────────────── -->
    <section class="st-hero">
      <div class="st-container">
        <div class="st-hero-grid">
          <div class="st-hero-text">
            <span class="st-kicker">OUR ESSENCE</span>
            <h1 class="st-title mot-headline">
              The Meaning of Fursat
              <svg class="st-leaf-flourish" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2-11 5 4-2 9-1 11-1-3 2-6 4-5 1z" />
              </svg>
            </h1>
            <p class="st-sub">
              In a world constantly running against the clock, <em>Fursat</em> (फ़ुर्सत) is the rare luxury of unhurried time. The quiet joy of pausing with friends, watching the ice melt slowly in a coupe glass, and savoring food that was never rushed.
            </p>
            <div class="st-hero-actions">
              <a href="/reserve" class="st-btn-olive">Reserve a Table →</a>
              <a href="#narrative" class="st-btn-ghost">Read Our Story ↓</a>
            </div>
          </div>

          <div class="st-hero-visual">
            <div class="st-wave-frame">
              <img
                src="/assets/interior/fursat_space_02.webp"
                alt="Fursat lounge seating corner with peach cushions, marble table and ficus tree"
                class="st-frame-img mot-reveal-img"
                width="720"
                height="900"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2. Split Narrative & Dark Quote Box ────────────────────────── -->
    <section class="st-narrative" id="narrative">
      <div class="st-container">
        <div class="st-split-grid">
          <div class="st-narrative-text">
            <span class="st-kicker">UNHURRIED HOSPITALITY</span>
            <h2>Where Time Slows Down</h2>
            <p>
              Born at Capital Park, Madhapur, Fursat was created as a sanctuary amidst Hyderabad's high-octane IT hub. We designed every square foot—from the warm acoustics and handcrafted velvet booths to the open charcoal pits—so that you never feel prompted to check your watch.
            </p>
            <p>
              Whether it’s a spontaneous post-work drink, an intimate family anniversary, or a grand banquet feast, our team serves with the heartfelt generosity that defines genuine Deccan hospitality.
            </p>
          </div>

          <!-- Dark forest quote card (derived from Reference Slide 1 bottom card) -->
          <div class="st-quote-card">
            <span class="st-quote-mark" aria-hidden="true">“</span>
            <p class="st-quote-body">
              We don’t just serve meals; we protect your moments of pause.
            </p>
            <div class="st-quote-footer">
              <span class="st-quote-author">— The Fursat Culinary &amp; Hospitality Team</span>
              <svg class="st-quote-leaf" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2-11 5 4-2 9-1 11-1-3 2-6 4-5 1z" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 3. Core Values Grid ────────────────────────────────────────── -->
    <section class="st-values">
      <div class="st-container">
        <div class="st-sec-head text-center">
          <span class="st-kicker">WHAT DRIVES US</span>
          <h2 class="st-sec-title">
            <span class="st-leaf-side" aria-hidden="true">❧</span>
            Our Pillars of Craft
            <span class="st-leaf-side st-leaf-flip" aria-hidden="true">❧</span>
          </h2>
        </div>

        <div class="st-values-grid">
          <div class="st-val-card">
            <div class="st-val-top">
              <span class="st-val-num">01</span>
              <span class="st-val-tag">Pillar One</span>
            </div>
            <h3>Patience Over Pace</h3>
            <p>Slow marinations, whole-spice reductions, and slow-simmered nalli curries. We never cut corners in our kitchen.</p>
          </div>

          <div class="st-val-card">
            <div class="st-val-top">
              <span class="st-val-num">02</span>
              <span class="st-val-tag">Pillar Two</span>
            </div>
            <h3>Thoughtful Ingredients</h3>
            <p>Cold-pressed oils, single-estate Arabica coffee, pure ghee, and zero artificial coloring in our curries or cocktails.</p>
          </div>

          <div class="st-val-card">
            <div class="st-val-top">
              <span class="st-val-num">03</span>
              <span class="st-val-tag">Pillar Three</span>
            </div>
            <h3>Spaces for Every Mood</h3>
            <p>A sunlit café for reading and remote work, a high-energy bar for celebrations, and a royal banquet for lifetime milestones.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 4. Space Gallery Strip ────────────────────────────────────── -->
    <section class="st-gallery" aria-label="Fursat spaces gallery">
      <div class="st-container st-gal-header-wrap">
        <span class="st-kicker">ATMOSPHERE &amp; SPACES</span>
        <h2 class="st-gal-title">Corners Designed for Lingering</h2>
      </div>
      <div class="st-gallery-scroll">
        <div class="st-gal-item">
          <img src="/assets/interior/fursat_space_13.webp" alt="Fursat Café wall signage with orange elephant emblem" class="st-gal-img" width="400" height="280" />
          <span class="st-gal-caption">Café Lounge</span>
        </div>
        <div class="st-gal-item">
          <img src="/assets/interior/fursat_space_16.webp" alt="Houndstooth armchairs and woven rattan screen partitions" class="st-gal-img" width="400" height="280" />
          <span class="st-gal-caption">Acoustic Nooks</span>
        </div>
        <div class="st-gal-item">
          <img src="/assets/interior/fursat_space_19.webp" alt="Fursat Kitchen and Bar illuminated circular emblem wall" class="st-gal-img" width="400" height="280" />
          <span class="st-gal-caption">Craft Bar Area</span>
        </div>
        <div class="st-gal-item">
          <img src="/assets/interior/fursat_space_07.webp" alt="Dining hall with dark wood tables and royal blue bucket armchairs" class="st-gal-img" width="400" height="280" />
          <span class="st-gal-caption">Main Dining Hall</span>
        </div>
        <div class="st-gal-item">
          <img src="/assets/interior/fursat_space_03.webp" alt="Partitioned dining room with vertical rattan screens and chevron panels" class="st-gal-img" width="400" height="280" />
          <span class="st-gal-caption">Heritage Enclaves</span>
        </div>
      </div>
    </section>

    <!-- ── 5. Legal & Business Information Box ───────────────────────── -->
    <section class="st-legal">
      <div class="st-container">
        <div class="st-legal-box">
          <div class="st-legal-header">
            <span class="st-kicker">GOVERNANCE &amp; DISCLOSURE</span>
            <h2>Official Business Information</h2>
            <p class="st-legal-intro">Operating details and regulatory information for Fursat Kitchen | Bar.</p>
          </div>

          <div class="st-info-grid">
            <div class="st-ig-item">
              <b>Operating Brand Name</b>
              <span>Fursat Kitchen | Bar (Café, Bar &amp; Banquets)</span>
            </div>
            <div class="st-ig-item">
              <b>Registered Legal Entity</b>
              <span>Alekya Reality / Fursat Hospitality LLP</span>
            </div>
            <div class="st-ig-item">
              <b>FSSAI License Number</b>
              <span>Pending official release / available upon request at venue</span>
            </div>
            <div class="st-ig-item">
              <b>Registered Address</b>
              <span>Level 3, Capital Park Building, Image Gardens Road, VIP Hills, Silicon Valley, Madhapur, Hyderabad, Telangana 500081</span>
            </div>
            <div class="st-ig-item">
              <b>Operating Hours</b>
              <span>Open 7 Days a Week: {site.hours.display}</span>
            </div>
            <div class="st-ig-item">
              <b>Official Contact</b>
              <span>+91 90596 70033 / +91 98483 60033 · hello@fursatind.in</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <MascotOfferModal />
  <SiteFooter />
  <MobileBar active="story" />
  <script is:inline src="/js/motion-kit.js"></script>
</Base>

<style is:global>
  /* ── Page Shell ────────────────────────────────────────────────────────── */
  .st-page {
    background-color: var(--color-fk-cream, #F2EEE4);
    color: var(--color-fk-ink, #34311E);
    font-family: var(--font-fk-sans, "Manrope", system-ui, sans-serif);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .st-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }

  .st-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fk-olive, #393D1A);
    display: inline-block;
    margin-bottom: 12px;
  }

  /* ── 1. Hero ───────────────────────────────────────────────────────────── */
  .st-hero {
    padding: clamp(60px, 8vw, 110px) 0 clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--color-fk-line, #DCD5C3);
  }

  .st-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .st-hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 60px;
    }
  }

  .st-title {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--color-fk-ink, #34311E);
    margin: 0 0 20px;
    position: relative;
    text-wrap: balance;
  }

  .st-leaf-flourish {
    display: inline-block;
    width: 28px;
    height: 28px;
    color: var(--color-fk-olive, #393D1A);
    vertical-align: middle;
    margin-left: 8px;
  }

  .st-sub {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--color-fk-muted, #5C644E);
    line-height: 1.65;
    margin: 0 0 32px;
    max-width: 58ch;
  }

  .st-sub em {
    color: var(--color-fk-olive, #393D1A);
    font-style: italic;
    font-weight: 600;
  }

  .st-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .st-btn-olive {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 28px;
    border-radius: var(--radius-fk-pill, 9999px);
    background-color: var(--color-fk-olive, #393D1A);
    color: #FAF7F0;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(57, 61, 26, 0.22);
    transition: background-color 0.16s ease, transform 0.16s ease;
  }

  .st-btn-olive:hover {
    background-color: var(--color-fk-olive-dark, #242E1B);
    transform: translateY(-2px);
  }

  .st-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: var(--radius-fk-pill, 9999px);
    border: 1.5px solid var(--color-fk-line, #DCD5C3);
    background: transparent;
    color: var(--color-fk-ink, #34311E);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }

  .st-btn-ghost:hover {
    border-color: var(--color-fk-olive, #393D1A);
    transform: translateY(-2px);
  }

  /* Organic fluid wave frame matching reference design */
  .st-hero-visual {
    display: flex;
    justify-content: center;
  }

  .st-wave-frame {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 4.8;
    border-radius: var(--radius-fk-organic, 42% 58% 70% 30% / 45% 45% 55% 55%);
    overflow: hidden;
    border: 2px solid var(--color-fk-line, #DCD5C3);
    box-shadow: 0 20px 48px rgba(36, 45, 28, 0.12);
    transform: translateZ(0);
    animation: st-wave-float 6s ease-in-out infinite alternate;
  }

  @keyframes st-wave-float {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  .st-frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── 2. Split Narrative & Quote ────────────────────────────────────────── */
  .st-narrative {
    padding: clamp(60px, 8vw, 100px) 0;
  }

  .st-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .st-split-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
    }
  }

  .st-narrative-text h2 {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-fk-ink, #34311E);
    margin: 4px 0 16px;
    line-height: 1.15;
  }

  .st-narrative-text p {
    font-size: 1.05rem;
    color: var(--color-fk-muted, #5C644E);
    line-height: 1.68;
    margin: 0 0 18px;
  }

  /* Dark forest quote card (from Reference Slide 1 bottom card) */
  .st-quote-card {
    background-color: var(--color-fk-quote, #4A4527);
    color: var(--color-fk-paper-light, #F7F4E3);
    border-radius: var(--radius-fk-lg, 28px);
    padding: clamp(32px, 5vw, 48px);
    box-shadow: 0 16px 40px rgba(36, 45, 28, 0.16);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .st-quote-mark {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: 3.6rem;
    line-height: 0.8;
    color: var(--color-fk-gold, #E0A63C);
    margin-bottom: 8px;
    display: block;
  }

  .st-quote-body {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: #FAF7F0;
    margin: 0 0 24px;
    font-style: italic;
  }

  .st-quote-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(247, 244, 227, 0.2);
    padding-top: 14px;
  }

  .st-quote-author {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(247, 244, 227, 0.85);
    letter-spacing: 0.04em;
  }

  .st-quote-leaf {
    width: 20px;
    height: 20px;
    color: var(--color-fk-gold, #E0A63C);
    flex-shrink: 0;
  }

  /* ── 3. Core Values Grid ────────────────────────────────────────────────── */
  .st-values {
    padding: clamp(60px, 8vw, 100px) 0;
    background-color: #ECE5D5;
    border-top: 1px solid var(--color-fk-line, #DCD5C3);
    border-bottom: 1px solid var(--color-fk-line, #DCD5C3);
  }

  .st-sec-title {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-fk-ink, #34311E);
    margin: 0 0 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .st-leaf-side {
    color: var(--color-fk-olive, #393D1A);
    font-size: 1.8rem;
  }

  .st-leaf-flip {
    transform: scaleX(-1);
  }

  .st-values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .st-val-card {
    background-color: var(--color-fk-paper, #F4EDDD);
    border: 1px solid var(--color-fk-line, #DCD5C3);
    border-radius: var(--radius-fk-md, 20px);
    padding: 32px 26px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 28px rgba(36, 45, 28, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .st-val-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(36, 45, 28, 0.1);
  }

  .st-val-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .st-val-num {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-fk-olive, #393D1A);
    line-height: 1;
  }

  .st-val-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 3px 10px;
    border-radius: var(--radius-fk-pill, 9999px);
    background-color: rgba(57, 61, 26, 0.08);
    color: var(--color-fk-olive, #393D1A);
  }

  .st-val-card h3 {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: 1.35rem;
    color: var(--color-fk-ink, #34311E);
    margin: 0 0 10px;
  }

  .st-val-card p {
    font-size: 0.95rem;
    color: var(--color-fk-muted, #5C644E);
    line-height: 1.55;
    margin: 0;
  }

  /* ── 4. Space Gallery Strip ────────────────────────────────────────────── */
  .st-gallery {
    padding: clamp(50px, 7vw, 90px) 0;
    overflow: hidden;
  }

  .st-gal-header-wrap {
    margin-bottom: 24px;
  }

  .st-gal-title {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--color-fk-ink, #34311E);
    margin: 0;
  }

  .st-gallery-scroll {
    display: flex;
    gap: 18px;
    padding: 0 clamp(16px, 4vw, 40px) 16px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-fk-line, #DCD5C3) transparent;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .st-gallery-scroll::-webkit-scrollbar {
    height: 4px;
  }

  .st-gallery-scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-fk-line, #DCD5C3);
    border-radius: 999px;
  }

  .st-gal-item {
    flex: 0 0 clamp(260px, 32vw, 380px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    scroll-snap-align: start;
  }

  .st-gal-img {
    width: 100%;
    height: clamp(200px, 24vw, 280px);
    object-fit: cover;
    border-radius: var(--radius-fk-md, 20px);
    border: 1px solid var(--color-fk-line, #DCD5C3);
    box-shadow: 0 10px 24px rgba(36, 45, 28, 0.08);
    display: block;
    transition: transform 0.3s ease;
  }

  .st-gal-item:hover .st-gal-img {
    transform: scale(1.02);
  }

  .st-gal-caption {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-fk-olive, #393D1A);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── 5. Legal & Business Disclosure Box ─────────────────────────────────── */
  .st-legal {
    padding: clamp(50px, 7vw, 90px) 0 clamp(60px, 8vw, 110px);
  }

  .st-legal-box {
    background-color: var(--color-fk-paper, #F4EDDD);
    border: 1px solid var(--color-fk-line, #DCD5C3);
    border-radius: var(--radius-fk-xl, 36px);
    padding: clamp(32px, 5vw, 54px);
    box-shadow: 0 16px 40px rgba(36, 45, 28, 0.08);
  }

  .st-legal-header h2 {
    font-family: var(--font-fk-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--color-fk-ink, #34311E);
    margin: 4px 0 8px;
  }

  .st-legal-intro {
    font-size: 0.95rem;
    color: var(--color-fk-muted, #5C644E);
    margin: 0 0 32px;
  }

  .st-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .st-info-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .st-ig-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(57, 61, 26, 0.12);
  }

  .st-ig-item b {
    font-size: 0.75rem;
    color: var(--color-fk-olive, #393D1A);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .st-ig-item span {
    font-size: 0.95rem;
    color: var(--color-fk-ink, #34311E);
    line-height: 1.5;
  }

  /* ── Prefers-reduced-motion fallback ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
