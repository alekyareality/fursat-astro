---
import InstaFollow from '../components/InstaFollow.astro';
import site from '../data/site.json';
// story.astro v4 — About / Our Story (mock-about.png). Hybrid: textless background art (public/assets/bg/about-*,
// scripts/prep-bg.py) carries the carved plaster, frames, plates and green band; live HTML on top in stage units.
// Real photos clipped into the traced frame holes. Motion: src/scripts/fk-motion.ts (Anime.js + Motion).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import HyWindows from '../components/hybrid/HyWindows.astro';
import aDesk from '../../scripts/bg-specs/about-desk.out.json';
import aPhone from '../../scripts/bg-specs/about-phone.out.json';
import '../styles/fk-tokens.css';

// TODO(client): founder / story line (not shown until the client provides one).
// TODO(client): FSSAI licence number and GSTIN in site.json legal.* — the rows appear automatically once filled.
// Real facts only (handoff §3/§4). Values still TODO(client) in site.json are not shown.
const real = (v?: string) => !!v && !v.startsWith('TODO');
const address = `Capital Park, ${site.address.line2}, ${site.address.state} ${site.address.pin}`;
const legalRows = [
  { k: 'Brand', v: 'Fursat Kitchen | Bar' },
  { k: 'Address', v: address },
  { k: 'Hours', v: site.hours.display },
  { k: 'Phone', v: site.phone },
  ...(real(site.legal.fssai) ? [{ k: 'FSSAI licence', v: site.legal.fssai }] : []),
  ...(real(site.legal.gstin) ? [{ k: 'GSTIN', v: site.legal.gstin }] : []),
];

// Red elephant silhouette traced from the real logo (/assets/c86f49db5a.webp), viewBox 0 0 140 176
const elephant = 'M109.5 10.2 L108.2 10.8 L100.2 6.0 L94.5 5.0 L93.2 4.0 L81.5 4.0 L70.5 8.0 L64.0 13.2 L61.0 18.5 L60.0 24.2 L62.8 30.5 L66.5 33.8 L68.2 33.8 L69.5 34.8 L76.2 34.8 L81.8 31.2 L83.5 27.2 L81.2 24.0 L79.5 24.0 L76.2 27.0 L73.5 27.0 L71.8 25.2 L71.8 22.5 L75.5 18.8 L79.5 16.8 L88.2 16.8 L92.5 18.8 L98.0 25.5 L98.0 32.2 L95.0 37.5 L88.2 44.0 L73.5 52.0 L68.2 56.0 L65.0 56.5 L64.5 58.0 L55.0 67.5 L54.0 71.2 L52.0 72.5 L51.0 74.5 L51.0 76.2 L48.0 83.5 L48.0 98.2 L50.8 104.2 L50.2 105.5 L52.0 106.2 L52.8 107.2 L52.2 108.5 L57.5 112.8 L69.5 118.8 L72.2 118.8 L73.5 119.8 L80.2 119.8 L81.5 118.8 L84.5 119.5 L85.5 117.8 L88.2 116.8 L91.8 113.2 L91.8 111.5 L92.8 110.2 L92.8 105.5 L94.5 104.0 L96.0 106.5 L96.0 114.2 L95.0 115.5 L95.0 117.2 L89.2 123.0 L85.5 124.0 L82.2 126.0 L66.5 126.0 L65.2 125.0 L62.5 125.0 L56.5 122.0 L55.5 120.2 L54.2 120.8 L50.2 118.0 L43.8 110.2 L40.2 102.0 L38.5 102.0 L29.5 107.0 L24.2 112.0 L20.2 114.2 L20.5 116.0 L14.0 123.5 L5.2 139.2 L7.2 140.8 L13.2 138.0 L14.0 138.5 L12.2 141.2 L13.0 142.5 L13.0 150.2 L12.0 151.5 L12.0 160.2 L13.0 161.5 L13.0 166.2 L12.2 167.5 L14.0 168.5 L14.5 170.8 L35.2 170.8 L35.8 163.5 L36.8 162.2 L36.8 160.5 L39.8 157.2 L41.5 157.5 L42.5 155.8 L48.2 155.8 L53.0 160.5 L52.2 162.5 L54.0 163.5 L54.5 170.8 L74.2 170.8 L74.8 161.5 L76.8 158.2 L78.2 157.0 L79.5 157.5 L80.5 155.8 L86.2 155.8 L90.0 158.2 L92.0 161.5 L92.5 170.8 L117.8 170.2 L117.8 168.5 L116.8 167.2 L116.8 159.5 L115.8 158.2 L115.8 142.5 L116.8 141.2 L116.8 133.5 L117.8 132.2 L117.8 127.5 L119.8 125.2 L119.2 122.8 L125.8 114.2 L128.8 108.2 L128.8 106.5 L130.8 103.2 L130.8 101.5 L133.8 94.2 L133.8 90.5 L135.5 89.5 L134.8 88.2 L134.8 84.5 L136.5 82.5 L135.8 81.2 L135.8 64.5 L136.5 63.2 L134.8 61.2 L134.8 57.5 L135.5 56.2 L133.8 55.2 L132.8 48.5 L128.8 39.2 L129.5 37.2 L127.8 36.2 L121.8 24.5Z';

const P = {
  entrance: { src: '/assets/interior/tour-entrance.webp', alt: 'The Fursat entrance corridor: an elephant mural on the wall that reads Fursat, Aur Kuch Nahi, with potted plants along the glass', w: 1050, h: 1400, pos: '50% 62%', eager: true },
  dining: { src: '/assets/interior/fursat_space_07.webp', alt: 'The Fursat dining hall with dark wood tables, blue velvet chairs and patterned screens', w: 1920, h: 2560, pos: '50% 60%' },
  lounge: { src: '/assets/interior/tour-lounge.webp', alt: 'The lounge seating at Fursat', w: 1050, h: 1400, pos: '50% 45%' },
};
const values = [
  { t: 'Exceptional Food', l: 'Authentic flavours, crafted with care.', i: '<path d="M3 20a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1Z"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4"/><path d="M10 4h4"/>' },
  { t: 'Warm Hospitality', l: 'A welcoming space for everyone.', i: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { t: 'Memorable Experiences', l: 'Dining, celebrations and more.', i: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>' },
  { t: 'Togetherness', l: 'Good food brings us closer.', i: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>' },
];
const plateD = [{ x: 142, y: 1075 }, { x: 378, y: 1075 }, { x: 620, y: 1075 }, { x: 860, y: 1075 }];
const plateM = [{ x: 303, y: 2083 }, { x: 703, y: 2083 }, { x: 303, y: 2378 }, { x: 703, y: 2378 }];
---

<Base
  title="Our Story — Fursat Kitchen | Bar | Madhapur, Hyderabad"
  description="Fursat is a café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. A celebration of food, people and togetherness."
  canonical="https://fursatind.in/story/"
  ogImage="https://fursatind.in/assets/interior/tour-entrance.webp"
  ogImageAlt="The entrance corridor at Fursat with the elephant mural and the Fursat, Aur Kuch Nahi wall"
>
  <SiteHeader active="story" variant="plaster" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('fx-pre'); setTimeout(function () { document.documentElement.classList.remove('fx-pre'); }, 3500); }</script>

  <main class="st" id="main">
    <section class="hy st-stage" aria-labelledby="st-h1">
      <HyWindows data={aDesk} photos={[P.dining, P.entrance, P.lounge]} view="d" />
      <HyWindows data={aPhone} photos={[P.dining, P.entrance, P.lounge]} view="m" />

      <div class="st-hero" data-fx-hero>
        <p class="hy-kicker" data-fx-step>About Us</p>
        <h1 class="hy-h1 st-h1" id="st-h1" data-fx-step data-fx-words>Our <span class="hl">Story</span></h1>
        <p class="st-sub" data-fx-step>A celebration of food, people and togetherness.</p>
        <div class="hy-orn st-orn" data-fx-step aria-hidden="true"><i></i><svg viewBox="0 0 140 176"><path d={elephant} /></svg><i></i></div>
      </div>

      <div class="st-craft" data-fx-reveal>
        <h2 class="hy-h2 st-h2"><span>Crafted for</span> <span class="hl">Good Times</span></h2>
        <p class="hy-lead">FURSAT is more than a restaurant. It&rsquo;s a place where flavours, conversations and celebrations come together.</p>
        <p class="hy-lead">A café, a kitchen, a bar and banquet spaces under one roof at Capital Park, Madhapur. Come for a coffee, stay for dinner, bring everyone for the celebration.</p>
        <svg class="hy-orn--draw st-rule" viewBox="0 0 260 24" aria-hidden="true" data-fx-draw><path d="M2 12 H120" /><path d="M128 12 C132 6 138 6 142 12 C138 18 132 18 128 12 Z" /></svg>
        <p class="st-tag">Fursat, aur kuch nahi!</p>
      </div>

      <h2 class="st-vh">Our Values</h2>
      <ul class="st-values" data-fx-pop aria-label="Our values">
        {values.map((v, i) => (
          <li class="st-val" style={`--x:${plateD[i].x};--y:${plateD[i].y};--mx:${plateM[i].x};--my:${plateM[i].y}`} data-fx-tilt>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.i} />
            <h3>{v.t}</h3>
            <p>{v.l}</p>
          </li>
        ))}
      </ul>

      <div class="st-band" data-fx-reveal>
        <h2 class="st-bh">FURSAT &mdash; Where Good Food<br />Creates <em>Great Memories.</em></h2>
        <svg class="hy-orn--draw st-band-orn" viewBox="0 0 260 24" aria-hidden="true" data-fx-draw>
          <path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /><path d="M110 12 C116 6 122 6 126 12 M150 12 C144 6 138 6 134 12" />
        </svg>
      </div>
    </section>

    <section class="st-legal-wrap" aria-labelledby="st-lh">
      <div class="fk-emboss st-legal">
        <h2 id="st-lh">Business information</h2>
        <dl>
          {legalRows.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}
        </dl>
      </div>
    </section>
  </main>

<InstaFollow handle="fursatind.in" />
  <MascotOfferModal />
  <SiteFooter />
  <MobileBar active="story" />
  <script>import '../scripts/fk-motion';</script>
</Base>

<style is:global>
  .st { background: #10261a; color: var(--fk-ink); font-family: var(--fk-sans); overflow-x: clip; }
  .st :where(h1, h2, h3, p, ul, dl, dd, figure) { margin: 0; padding: 0; }
  .st :where(ul) { list-style: none; }
  .st { --st-label: #74501a; }
  .st-stage { aspect-ratio: 1000 / 1500; background: url(/assets/bg/about-desk-0.webp) top / 100% auto no-repeat #f6e6d1; }

  .st-hero { z-index: 3; left: calc(72 * var(--u)); top: calc(168 * var(--u)); width: calc(390 * var(--u)); display: grid; gap: calc(16 * var(--u)); }
  .st-h1 { font-size: calc(88 * var(--u)); white-space: nowrap; }
  .st-sub { font: 400 calc(25 * var(--u)) / 1.3 var(--fk-serif); color: #1b3a26; max-width: calc(330 * var(--u)); }
  .st-orn { width: calc(270 * var(--u)); margin-top: calc(8 * var(--u)); }
  .st-orn svg { fill: #c0291f; }

  .st-craft { z-index: 3; left: calc(570 * var(--u)); top: calc(560 * var(--u)); width: calc(390 * var(--u)); display: grid; gap: calc(14 * var(--u)); justify-items: start; }
  .st-h2 { font-size: calc(40 * var(--u)); line-height: 1.04; margin-bottom: calc(6 * var(--u)); }
  .st-h2 span { display: block; }
  .st-h2 .hl { font-size: calc(56 * var(--u)); }
  .st-craft .hy-lead { font-size: clamp(12.5px, calc(15 * var(--u)), 1.2rem); line-height: 1.58; }
  .st-rule { width: calc(150 * var(--u)); min-width: 100px; margin-top: calc(4 * var(--u)); }
  .st-tag { font: italic 500 calc(25 * var(--u)) / 1.2 var(--fk-serif); color: #1b3a26; }

  .st-vh { z-index: 3; left: 0; width: 100%; top: calc(918 * var(--u)); text-align: center; font: 500 calc(36 * var(--u)) / 1.1 var(--fk-serif); color: #1b3a26; }
  .st-values { z-index: 3; inset: 0; pointer-events: none; }
  .st-val { position: absolute; left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); width: calc(176 * var(--u)); height: calc(176 * var(--u)); translate: -50% -50%; border-radius: 50%; display: grid; place-content: center; justify-items: center; text-align: center; gap: calc(6 * var(--u)); padding: 0 calc(14 * var(--u)); pointer-events: auto; }
  .st-val svg { width: calc(38 * var(--u)); min-width: 20px; height: auto; fill: none; stroke: #1b3a26; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .st-val h3 { font: 500 calc(18 * var(--u)) / 1.12 var(--fk-serif); color: #1b3a26; text-wrap: balance; }
  .st-val p { font: 400 max(10px, calc(12.5 * var(--u))) / 1.4 var(--fk-sans); color: #4a4232; max-width: calc(140 * var(--u)); }

  .st-band { z-index: 3; left: calc(40 * var(--u)); width: calc(620 * var(--u)); top: calc(1286 * var(--u)); display: grid; justify-items: center; gap: calc(18 * var(--u)); text-align: center; }
  .st-bh { font: italic 500 calc(38 * var(--u)) / 1.2 var(--fk-serif); color: #fbf3e6; }
  .st-bh em { color: #e8c27a; }
  .st-band-orn { width: calc(240 * var(--u)); }

  .st-legal-wrap { background: #10261a; padding: clamp(24px, 3vw, 40px) 6vw clamp(48px, 6vw, 88px); }
  .st-legal { margin: 0 auto; max-width: 44rem; border-radius: 24px; padding: 1.6rem 1.9rem 1.5rem; color: var(--fk-ink); background: #f8ead8; box-shadow: 0 0 0 1px rgba(214, 170, 90, .5), 0 0 0 6px #f1dfc3, 0 22px 40px rgba(0, 0, 0, .35), inset 0 2px 3px #fff; }
  .st-legal h2 { font: 500 1.2rem/1.2 var(--fk-serif); color: #1b3a26; margin-bottom: .8rem; }
  .st-legal dl { display: grid; gap: .55rem; }
  .st-legal dl > div { display: grid; grid-template-columns: 7.2rem 1fr; gap: .8rem; align-items: baseline; }
  .st-legal dt { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--st-label); }
  .st-legal dd { font-size: .9rem; line-height: 1.5; }

  @media (max-width: 767px) {
    .st-stage { aspect-ratio: 1000 / 2961.1; background-image: url(/assets/bg/about-phone-0.webp); }
    .st-hero { left: calc(64 * var(--u)); top: calc(186 * var(--u)); width: calc(440 * var(--u)); gap: calc(10 * var(--u)); }
    .st-hero .hy-kicker { font-size: 12px; letter-spacing: .14em; }
    .st-h1 { font-size: calc(84 * var(--u)); }
    .st-sub, .st-orn { display: none; }
    .st-craft { left: calc(64 * var(--u)); top: calc(1130 * var(--u)); width: calc(872 * var(--u)); gap: calc(22 * var(--u)); }
    .st-h2 { font-size: calc(70 * var(--u)); }
    .st-h2 span { display: inline; }
    .st-h2 .hl { font-size: calc(70 * var(--u)); }
    .st-craft .hy-lead { font-size: 13.5px; line-height: 1.55; }
    .st-tag { font-size: calc(56 * var(--u)); }
    .st-vh { top: calc(1880 * var(--u)); font-size: calc(64 * var(--u)); }
    .st-val { left: calc(var(--mx) * var(--u)); top: calc(var(--my) * var(--u)); width: calc(290 * var(--u)); height: calc(290 * var(--u)); gap: 2px; padding: 0 calc(12 * var(--u)); }
    .st-val svg { min-width: 18px; width: calc(48 * var(--u)); }
    .st-val h3 { font-size: 14px; line-height: 1.15; }
    .st-val p { display: none; }
    .st-band { left: calc(40 * var(--u)); width: calc(920 * var(--u)); top: calc(2706 * var(--u)); gap: 8px; }
    .st-bh { font-size: calc(58 * var(--u)); }
    .st-band-orn { width: calc(440 * var(--u)); }
    .st-legal-wrap { padding: 16px 16px 48px; }
    .st-legal dl > div { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
