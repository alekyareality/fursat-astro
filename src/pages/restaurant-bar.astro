---
import site from '../data/site.json';
// restaurant-bar.astro — Fursat Bar & Kitchen (P6 restyle: shared ExperienceLayout on the baked plaster stage).
// Content is the page's existing copy, cocktails, prices and dish photos. Removed per handoff §4: the weekly
// live-music section (not confirmed) and "reserve instantly" (bookings are requests confirmed on WhatsApp).
import Base from '../layouts/Base.astro';
import ExperienceLayout from '../components/experience/ExperienceLayout.astro';
---
<Base
  title="Restaurant & Bar — Fursat Kitchen | Bar | Madhapur"
  description="Fursat's signature restaurant and craft bar. Modern Indian cuisine, handcrafted cocktails and curated spirits in a warm, vibrant setting in Madhapur, Hyderabad."
  canonical="https://fursatind.in/restaurant-bar/"
  ogImage="https://fursatind.in/assets/fursat_space_03.webp"
  ogImageAlt="Fursat Restaurant & Bar — craft cocktails and Indian kitchen"
>
  <ExperienceLayout
    insta="fursatsocialclub"
    active="restaurant-bar"
    kicker="Craft mixology & culinary intention"
    h1a="The Bar & Kitchen"
    h1b="at Fursat"
    lead="Where slow afternoons melt into electric evenings. Barrel-aged spirits, artisanal cocktails, and live charcoal kebabs crafted for Hyderabad’s most discerning palates."
    ctas={[
      { label: 'Reserve a Table', href: '/reserve', primary: true, book: true },
      { label: 'Signature Cocktails', href: '#cocktails' },
    ]}
    hero={{ src: '/assets/interior/bar-front.webp', alt: 'The bar at Fursat Kitchen | Bar', w: 1200, h: 1600, pos: '50% 50%' }}
    pillars={[
      { icon: 'cocktail', title: 'Artisanal Mixology', line: 'Botanical syrups infused in-house. 21+.' },
      { icon: 'flame', title: 'From the Charcoal Pit', line: 'Meats marinated for 24 hours.' },
      { icon: 'glass', title: 'Zero-Proof Elixirs', line: 'Mocktails as crafted as the cocktails.' },
      { icon: 'menu', title: 'Vegetarian & Jain', line: 'Paneer Tikka to Veg Biryani.' },
    ]}
    momentsA="Bold Flavors from the"
    momentsB="Royal Tandoor"
    momentsText="Our culinary philosophy centers on patience. Whole spices stone-pounded daily, meats marinated for 24 hours in aged curd and secret Deccan herbs, slow-roasted over fragrant charcoal."
    momentsCta={{ label: 'View Full Food Menu', href: '/menu' }}
    big={{ src: '/assets/dishes/angaraa_chicken_tikka_.webp', alt: 'Angaraa Chicken Tikka', w: 1200, h: 1200 }}
    top={{ src: '/assets/dishes/tandoori_prawns_.webp', alt: 'Tandoori Prawns', w: 1200, h: 1200 }}
    bottom={{ src: '/assets/dishes/dsc03308.webp', alt: 'Fursat Signature Kebab', w: 1200, h: 1200 }}
    cardsId="cocktails"
    cardsKicker="Artisanal mixology (21+)"
    cardsTitle="Signature Sips & Spirits"
    cards={[
      { tag: 'Cocktail Special', name: 'Life Fursat Bhai', price: '₹629', text: 'Single-estate vodka, French elderflower liqueur, cold-pressed green apple, and crisp citric wash.' },
      { tag: 'Deccan Inspired', name: 'Gongura Muchatlu', price: '₹629', text: 'Sorrel leaf extract, charred green chilli tincture, fine grain vodka, rimmed with roasted cumin sea salt.' },
      { tag: 'Zero-Proof Elixir', name: 'Fursat Rahasyam', price: '₹299', text: 'Barman’s secret mocktail creation: botanical citrus blend, star anise smoke, and pomegranate pearls.' },
      { tag: 'Smoky Classic', name: "Nizam's Old Fashioned", price: '₹675', text: 'Aged Bourbon, Kashmiri saffron bitters, demerara reduction, smoked with dry apple wood chips.' },
    ]}
    faqTitle="Frequently Asked Questions"
    faq={[
      { q: 'What is the minimum age policy for the bar?', a: 'Alcoholic beverage service is strictly restricted to guests aged 21 and above, as per Telangana excise regulations. Valid government ID may be requested.' },
      { q: 'Do you take table reservations in advance?', a: `Yes. We recommend requesting a table ahead, especially for weekend dinner slots (Friday to Sunday). We are open ${site.hours.display}. Send a request online or on WhatsApp and we confirm it on WhatsApp.` },
      { q: 'Are vegetarian and Jain options available?', a: 'Absolutely. Fursat offers an extensive pure-vegetarian selection including Paneer Tikka, Tandoori Broccoli, Dal Makhani, Veg Biryani, and Jain-customizable preparations.' },
    ]}
  />
</Base>
