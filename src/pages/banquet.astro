---
// banquet.astro - The Royal Banquet Hall at Fursat
// Hero, photos, capacity specs, event packages, sample menu & enquiry form
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
---
<Base
  title="Banquet Hall — Fursat Kitchen | Bar | Madhapur Events"
  description="Host your wedding, corporate event, or milestone celebration at Fursat's grand banquet hall in Madhapur. Packages from ₹925 per person. Up to 300 guests."
  canonical="https://fursatind.in/banquet/"
  ogImage="https://fursatind.in/assets/venue/banquet/banquet-tables-05.webp"
  ogImageAlt="Fursat Banquet Hall — grand event space in Madhapur Hyderabad"
  preloadImages={[
    {
      href: '/assets/interior/fursat_space_18-m480.webp',
      media: '(max-width: 480px)',
      type: 'image/webp'
    },
    {
      href: '/assets/interior/fursat_space_18-m720.webp',
      media: '(min-width: 481px) and (max-width: 767px)',
      type: 'image/webp'
    }
  ]}
>
  <SiteHeader active="banquet" variant="plaster" />

  <main class="bq-page" id="main">
    <!-- Hero Section -->
    <section class="bq-hero">
      <div class="bq-hero-bg">
        <picture class="bq-hero-pic">
          <source media="(max-width: 480px)" type="image/webp" srcset="/assets/venue/banquet/banquet-tables-05-480.webp" />
          <source media="(max-width: 767px)" type="image/webp" srcset="/assets/venue/banquet/banquet-tables-05-720.webp" />
          <source media="(min-width: 768px)" type="image/webp" srcset="/assets/venue/banquet/banquet-tables-05-720.webp 720w, /assets/venue/banquet/banquet-tables-05.webp 1200w" sizes="100vw" />
          <img src="/assets/venue/banquet/banquet-tables-05-720.webp" alt="The Fursat banquet hall set with long red and gold tables" class="bq-hero-img" width="720" height="900" fetchpriority="high" decoding="async" />
        </picture>
        <div class="bq-hero-overlay"></div>
      </div>
      <div class="bq-hero-content">
        <span class="bq-kicker">ROYAL CELEBRATIONS & CORPORATE GALAS</span>
        <h1 class="bq-title mot-headline">The Grand Banquet at Fursat</h1>
        <p class="bq-sub">
          A pillarless, acoustics-tuned luxury celebration venue at Capital Park, Madhapur. Accommodating 50 to 350 guests with bespoke royal buffets, state-of-the-art AV, and dedicated banquet concierges.
        </p>
        <div class="bq-hero-actions">
          <a href="#enquire" class="bq-btn-gold">Enquire for Dates & Rates</a>
          <a href="#packages" class="bq-btn-ghost">View Banquet Packages</a>
        </div>
      </div>
    </section>

    <!-- Venue Capacity & Specs -->
    <section class="bq-specs">
      <div class="bq-container">
        <div class="bq-specs-grid">
          <div class="bq-spec-box">
            <span class="bq-spec-val">350</span>
            <span class="bq-spec-lbl">Max Floating Capacity</span>
          </div>
          <div class="bq-spec-box">
            <span class="bq-spec-val">220</span>
            <span class="bq-spec-lbl">Round-Table Seating</span>
          </div>
          <div class="bq-spec-box">
            <span class="bq-spec-val">4K</span>
            <span class="bq-spec-lbl">Dual Laser Projection & AV</span>
          </div>
          <div class="bq-spec-box">
            <span class="bq-spec-val">100%</span>
            <span class="bq-spec-lbl">Valet Parking & Lift Access</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Photo Gallery -->
    <section class="bq-gallery">
      <div class="bq-container">
        <div class="bq-sec-head text-center">
          <span class="bq-kicker">VENUE AMBIANCE</span>
          <h2 class="bq-sec-title mot-headline">Elegance in Every Detail</h2>
        </div>

        <div class="bq-gal-grid">
          <div class="bq-gal-card">
            <img src="/assets/venue/banquet/banquet-stage-01-720.webp" srcset="/assets/venue/banquet/banquet-stage-01-720.webp 720w, /assets/venue/banquet/banquet-stage-01.webp 1200w" sizes="(max-width: 767px) 100vw, 33vw" alt="The banquet stage and screen with covered chairs" class="mot-reveal-img" loading="lazy" decoding="async" width="720" height="540" />
            <div class="bq-gal-tag">Main Banquet Floor</div>
          </div>
          <div class="bq-gal-card">
            <img src="/assets/venue/banquet/banquet-hall-02-720.webp" srcset="/assets/venue/banquet/banquet-hall-02-720.webp 720w, /assets/venue/banquet/banquet-hall-02.webp 1200w" sizes="(max-width: 767px) 100vw, 33vw" alt="Banquet seating under the Fursat sign" class="mot-reveal-img" loading="lazy" decoding="async" width="720" height="540" />
            <div class="bq-gal-tag">Grand Dinner Seating</div>
          </div>
          <div class="bq-gal-card">
            <img src="/assets/interior/fursat_space_14-720.webp" srcset="/assets/interior/fursat_space_14-720.webp 720w, /assets/interior/fursat_space_14.webp 1920w" sizes="(max-width: 767px) 100vw, 33vw" alt="Cocktail Counter" class="mot-reveal-img" loading="lazy" decoding="async" width="720" height="540" />
            <div class="bq-gal-tag">Private Banquet Bar</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Packages Section -->
    <section class="bq-packages" id="packages">
      <div class="bq-container">
        <div class="bq-sec-head text-center">
          <span class="bq-kicker">CURATED EXPERIENCES</span>
          <h2 class="bq-sec-title mot-headline">All-Inclusive Banquet Packages</h2>
          <p class="bq-sec-desc">Per-guest packages. We share the final quote on WhatsApp.</p>
        </div>

        <div class="bq-pkg-grid">
          <!-- Silver Package -->
          <div class="bq-pkg-card">
            <div class="bq-pkg-head">
              <span class="bq-pkg-badge">CLASSIC</span>
              <h3>Silver Feast</h3>
              <div class="bq-pkg-price">₹925 <span>/ guest + taxes</span></div>
            </div>
            <ul class="bq-pkg-features">
              <li>2 Veg & 2 Non-Veg Welcome Starters</li>
              <li>1 Soup & 2 Salads</li>
              <li>2 Veg & 2 Non-Veg Curries</li>
              <li>Dum Biryani (Chicken & Veg)</li>
              <li>Assorted Tandoori Roti & Naan</li>
              <li>2 Handcrafted Desserts</li>
              <li>Standard Stage & Ambient Audio</li>
            </ul>
            <a href="#enquire" class="bq-pkg-btn">Select Silver</a>
          </div>

          <!-- Gold Package (Featured) -->
          <div class="bq-pkg-card featured">
            <div class="bq-pkg-ribbon">MOST POPULAR</div>
            <div class="bq-pkg-head">
              <span class="bq-pkg-badge">ROYAL</span>
              <h3>Gold Celebrations</h3>
              <div class="bq-pkg-price">₹1,150 <span>/ guest + taxes</span></div>
            </div>
            <ul class="bq-pkg-features">
              <li>3 Veg & 3 Non-Veg Starters (incl. Kebabs)</li>
              <li>2 Soups & 4 Gourmet Salads</li>
              <li>3 Veg & 3 Non-Veg Curries (Mutton Nalli Curry)</li>
              <li>Fursat Signature Gosht & Veg Dum Biryani</li>
              <li>Live Tandoor & Naan Counter</li>
              <li>3 Desserts (incl. Ice Cream Counter)</li>
              <li>Pro DJ, Party Lights & Projector</li>
            </ul>
            <a href="#enquire" class="bq-pkg-btn featured">Select Gold</a>
          </div>

          <!-- Platinum Package -->
          <div class="bq-pkg-card">
            <div class="bq-pkg-head">
              <span class="bq-pkg-badge">LUXURY</span>
              <h3>Platinum Gala</h3>
              <div class="bq-pkg-price">₹1,450 <span>/ guest + taxes</span></div>
            </div>
            <ul class="bq-pkg-features">
              <li>4 Veg & 4 Non-Veg Starters (Prawns & Fish)</li>
              <li>Live Chaat / Dim Sum Station</li>
              <li>Slow-cooked Royal Mutton Rogan Josh</li>
              <li>Hyderabadi Dum Gosht Biryani & Joha Pulao</li>
              <li>Gourmet Dessert Spread (Lotus Biscoff + Halwa)</li>
              <li>Mocktail Bar Counter & Welcome Drinks</li>
              <li>Customized Theme Decor & Valet Coordination</li>
            </ul>
            <a href="#enquire" class="bq-pkg-btn">Select Platinum</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Enquiry Form Section -->
    <section class="bq-enquiry" id="enquire">
      <div class="bq-container bq-enquiry-wrap">
        <div class="bq-enquiry-card">
          <div class="bq-eq-head">
            <span class="bq-kicker">RESERVE YOUR DATE</span>
            <h2>Banquet Booking & Date Check</h2>
            <p>Tell us about your celebration and we will share availability and a quotation.</p>
          </div>

          <form class="bq-form" id="bq-form" action="https://wa.me/919059670033" target="_blank" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like to enquire about the banquet hall:" novalidate>
            <p class="bq-req">Fields marked * are required.</p>
            <div class="bq-form-row">
              <div class="bq-form-field">
                <label for="eq-name">Full name <span aria-hidden="true">*</span></label>
                <input type="text" id="eq-name" name="name" autocomplete="name" maxlength="40" data-l="Name" data-v="text" aria-required="true" aria-describedby="eq-name-e" data-msg="Please enter your name." placeholder="e.g. Rajesh Kumar" />
                <p class="bq-err" id="eq-name-e" role="alert"></p>
              </div>
              <div class="bq-form-field">
                <label for="eq-phone">Mobile / WhatsApp number <span aria-hidden="true">*</span></label>
                <input type="tel" id="eq-phone" name="phone" autocomplete="tel-national" inputmode="numeric" maxlength="14" data-l="Phone" data-v="phone" aria-required="true" aria-describedby="eq-phone-e" placeholder="e.g. 98483 60033" />
                <p class="bq-err" id="eq-phone-e" role="alert"></p>
              </div>
            </div>
            <div class="bq-form-row">
              <div class="bq-form-field">
                <label for="eq-event">Occasion</label>
                <select id="eq-event" name="occasion" data-l="Occasion">
                  <option value="Birthday Party">Birthday Celebration</option>
                  <option value="Wedding / Reception">Wedding / Sangeet / Reception</option>
                  <option value="Corporate Gathering">Corporate Gala / Seminar</option>
                  <option value="Anniversary">Anniversary Celebration</option>
                  <option value="Kitty / Social">Kitty Party / Family Reunion</option>
                </select>
              </div>
              <div class="bq-form-field">
                <label for="eq-guests">Approx. guest count <span aria-hidden="true">*</span></label>
                <input type="number" id="eq-guests" name="guests" inputmode="numeric" min="30" max="400" data-l="Guests" data-v="count" aria-required="true" aria-describedby="eq-guests-e" placeholder="e.g. 100" />
                <p class="bq-err" id="eq-guests-e" role="alert"></p>
              </div>
            </div>
            <div class="bq-form-row">
              <div class="bq-form-field">
                <label for="eq-date">Preferred date <span aria-hidden="true">*</span></label>
                <input type="date" id="eq-date" name="date" data-l="Date" data-v="date" aria-required="true" aria-describedby="eq-date-e" />
                <p class="bq-err" id="eq-date-e" role="alert"></p>
              </div>
              <div class="bq-form-field">
                <label for="eq-package">Interested package (optional)</label>
                <select id="eq-package" name="package" data-l="Package">
                  <option value="Gold Package (₹1150/pax)">Gold Celebrations (₹1,150/pax)</option>
                  <option value="Silver Package (₹925/pax)">Silver Feast (₹925/pax)</option>
                  <option value="Platinum Package (₹1450/pax)">Platinum Gala (₹1,450/pax)</option>
                  <option value="Customized Menu">Customized Menu Requirements</option>
                </select>
              </div>
            </div>
            <button type="submit" class="bq-submit-btn">
              <span>Send Enquiry via WhatsApp / Call</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <p class="bq-direct-call">
              Prefer calling directly? Reach our Banquet desk at <a href="tel:+919059670033">+91 90596 70033</a> or <a href="tel:+919848360033">+91 98483 60033</a>.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bq-faq">
      <div class="bq-container bq-faq-inner">
        <h2 class="bq-sec-title text-center">Banquet FAQs</h2>
        <div class="bq-faq-list">
          <details class="bq-faq-item">
            <summary>What is the advance payment to lock a banquet date?</summary>
            <p>A 30% advance deposit secures your date on the Fursat banquet calendar. The remaining balance is payable on or before the day of the event.</p>
          </details>
          <details class="bq-faq-item">
            <summary>Is outside decor or photography permitted?</summary>
            <p>Yes, you are welcome to bring your preferred decorator or photographer. We also have seasoned in-house empanelled vendors with attractive bundled pricing.</p>
          </details>
          <details class="bq-faq-item">
            <summary>Can alcohol be served at private banquet events?</summary>
            <p>Yes! We have full bar license support. For private banquet bookings, we can provide liquor packages or coordinate special event permits (Form-24).</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <MascotOfferModal />
  <SiteFooter />
<MobileBar active="celebrate" />
<script is:inline src="/js/motion-kit.js"></script>
<script>
  const form = document.querySelector('form[data-wa-form]');
  if (form) {
    const fields = Array.from(form.querySelectorAll('input, select'));
    const digits = (v) => { let x = v.replace(/\D/g, ''); if (x.length > 10 && x.startsWith('91')) x = x.slice(2); if (x.length === 11 && x[0] === '0') x = x.slice(1); return x; };
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const errOf = (el) => document.getElementById(el.getAttribute('aria-describedby') || '');
    const check = (el) => {
      const v = el.value.trim(), t = el.dataset.v;
      if (t === 'text') return v.length < 2 ? el.dataset.msg : '';
      if (t === 'phone') return /^[6-9]\d{9}$/.test(digits(v)) ? '' : 'Please enter a valid 10-digit mobile number.';
      if (t === 'count') { const n = Number(v), lo = Number(el.min), hi = Number(el.max); return n >= lo && n <= hi ? '' : 'Please enter ' + lo + ' to ' + hi + ' guests.'; }
      if (t === 'date') return v && v >= today() ? '' : 'Please choose today or a later date.';
      return '';
    };
    const show = (el, msg) => { const e = errOf(el); if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); if (e) e.textContent = msg; };
    const dateEl = form.querySelector('input[type="date"]');
    if (dateEl) dateEl.min = today();
    fields.forEach((el) => {
      if (!el.dataset.v) return;
      el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
      el.addEventListener('change', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let first = null;
      fields.forEach((el) => { if (!el.dataset.v) return; const m = check(el); show(el, m); if (m && !first) first = el; });
      if (first) { first.focus(); return; }
      const lines = [form.dataset.waIntro];
      fields.forEach((el) => {
        const t = el.dataset.v; let v = el.value.trim();
        if (t === 'phone') { const x = digits(v); v = '+91 ' + x.slice(0, 5) + ' ' + x.slice(5); }
        else if (t === 'date') v = new Date(v + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        else if (el.tagName === 'SELECT') v = el.selectedOptions[0].textContent.trim();
        lines.push('\u2022 ' + el.dataset.l + ': ' + v);
      });
      window.open('https://wa.me/919059670033?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
    });
  }
</script>
</Base>

<style is:global>
  .bq-page {
    background: transparent;
    color: #1f2a1a;
    font-family:var(--fk-sans)}
  .bq-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px)}
  .bq-hero {
    position: relative;
    min-height: 75vh;
    display: flex;
    align-items: center;
    padding: clamp(60px, 10vw, 120px) clamp(16px, 4vw, 40px);
    overflow: hidden}
  .bq-hero-bg {
    position: absolute;
    inset: 0}
  .bq-hero-pic {
    display: block;
    width: 100%;
    height: 100%}
  .bq-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover}
  .bq-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(238,212,178,.97) 0%, rgba(238,212,178,.9) 42%, rgba(238,212,178,.35) 75%, rgba(238,212,178,.1) 100%)}
  .bq-hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px}
  .bq-kicker {
    font-size: 0.8125rem;
    font-weight:600;
    letter-spacing: 0.16em;
    color: #74501a;
    display: block;
    margin-bottom: 12px}
  .bq-title {
    font-family:var(--fk-serif);
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    font-weight: 600;
    line-height: 1.1;
    color: #1f2a1a;
    margin: 0 0 20px}
  .bq-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #4a4232;
    line-height: 1.6;
    margin: 0 0 32px}
  .bq-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px}
  .bq-btn-gold {
    padding: 14px 28px;
    border-radius: 999px;
    background: var(--fk-action-bg);
    color: #fbf3e6;
    font-weight:600;
    text-decoration: none;
    transition: background 0.16s ease, transform 0.16s ease;border-color:var(--fk-action-rim);box-shadow:var(--fk-action-shadow);color:var(--fk-action-fg)}
  .bq-btn-gold:hover {
    background: #fffaf2;
    transform: translateY(-2px)}
  .bq-btn-ghost {
    padding: 14px 26px;
    border-radius: 999px;
    background: rgba(255,250,242,0.87);
    border: 1px solid rgba(201,154,67,0.60);
    color: #1f2a1a;
    font-weight: 700;
    text-decoration: none}

  /* Specs Bar */
  .bq-specs {
    background: #efd8b8;
    border-top: 1px solid rgba(201,154,67,0.40);
    border-bottom: 1px solid rgba(201,154,67,0.40);
    padding: 32px 0}
  .bq-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    text-align: center}
  .bq-spec-val {
    font-family:var(--fk-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: #74501a;
    display: block;
    line-height: 1;
    margin-bottom: 6px}
  .bq-spec-lbl {
    font-size: 0.85rem;
    color: #4a4232;
    font-weight: 600}

  /* Gallery */
  .bq-gallery {
    padding: clamp(60px, 8vw, 100px) 0;
    background: transparent}
  .bq-sec-title {
    font-family:var(--fk-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #1f2a1a;
    margin: 0 0 36px}
  .bq-gal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px}
  .bq-gal-card {
    position: relative;
    height: 320px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(201,154,67,0.50)}
  .bq-gal-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease}
  .bq-gal-card:hover img {
    transform: scale(1.05)}
  .bq-gal-tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(251,243,231,.92);
    backdrop-filter: blur(8px);
    border: 1px solid #d6aa5a;
    color: #74501a;
    font-size: 0.8125rem;
    font-weight: 700}

  /* Packages */
  .bq-packages {
    padding: clamp(60px, 8vw, 110px) 0;
    background: #efd8b8}
  .bq-pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px}
  .bq-pkg-card {
    background: rgba(255,250,242,0.71);
    border: 1.5px solid rgba(201,154,67,0.50);
    border-radius: 24px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease}
  .bq-pkg-card.featured {
    border-color: #d6aa5a;
    background: rgba(214,170,90,0.14);
    box-shadow: 0 16px 40px rgba(90,60,20,0.20), 0 0 25px rgba(201,154,67,0.12)}
  .bq-pkg-card:hover {
    transform: translateY(-5px)}
  .bq-pkg-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--fk-action-bg);
    color: #fbf3e6;
    font-size: 0.75rem;
    font-weight:600;
    letter-spacing: 0.1em;
    padding: 4px 14px;
    border-radius: 999px;border-color:var(--fk-action-rim);box-shadow:var(--fk-action-shadow);color:var(--fk-action-fg)}
  .bq-pkg-badge {
    font-size: 0.75rem;
    font-weight:600;
    color: #74501a;
    letter-spacing: 0.08em}
  .bq-pkg-head h3 {
    font-family:var(--fk-serif);
    font-size: 1.6rem;
    color: #1f2a1a;
    margin: 4px 0 12px}
  .bq-pkg-price {
    font-size: 2rem;
    font-weight:600;
    color: #74501a}
  .bq-pkg-price span {
    font-size: 0.85rem;
    color: #4a4232;
    font-weight: 500}
  .bq-pkg-features {
    list-style: none;
    padding: 0;
    margin: 24px 0 32px;
    display: flex;
