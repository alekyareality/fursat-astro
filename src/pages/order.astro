---
// order.astro - Online Ordering (Phase 2 Preview & Menu Explorer)
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
---
<Base
  title="Order Online — Fursat Kitchen | Bar | Madhapur"
  description="Order Fursat's signature dishes and drinks for delivery or pickup. Quick online ordering via WhatsApp. Fresh kitchen food to your doorstep in Madhapur."
  canonical="https://fursatind.in/order/"
  ogImage="https://fursatind.in/assets/fursat_space_10.webp"
  ogImageAlt="Fursat — order food and drinks online from Madhapur"
>
  <SiteHeader active="order" />

  <main class="od-page" id="main">

    <!-- Hero Banner -->
    <section class="od-hero">
      <div class="od-hero-bg" aria-hidden="true"></div>
      <div class="od-hero-inner">
        <span class="od-pill">DIRECT ORDERING — COMING SOON</span>
        <h1 class="od-hero-title mot-headline">Order Fursat. Direct. Fresh.</h1>
        <p class="od-hero-sub">Zero aggregator markups · Handi-sealed biryanis · Live kitchen tracking</p>
        <div class="od-hero-actions">
          <a href="https://wa.me/919059670033?text=Hi%20Fursat!%20I%20would%20like%20to%20place%20a%20takeaway%20order.&utm_source=website&utm_medium=cta&utm_campaign=order" target="_blank" rel="noopener" class="od-wa-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.3C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
            Order Takeaway on WhatsApp
          </a>
          <a href="/menu" class="od-menu-btn">Browse Full Menu</a>
        </div>
      </div>
    </section>

    <div class="od-container">
      <div class="od-hero-card">
        <span class="od-pill">CURRENT OPTIONS</span>
        <h2 class="od-title">Order With Us Today</h2>
        <p class="od-sub">
          We are currently integrating with our in-house POS and kitchen display system to bring you seamless doorstep delivery, live order tracking, and UPI one-tap payments.
        </p>

        <div class="od-action-box">
          <h3>Need Takeaway or Large Catering Today?</h3>
          <p>You can browse our digital menu and place a direct takeaway order with our kitchen team via WhatsApp.</p>
          <div class="od-btns">
            <a href="https://wa.me/919059670033?text=Hi%20Fursat!%20I%20would%20like%20to%20place%20a%20takeaway%20order.&utm_source=website&utm_medium=cta&utm_campaign=order" target="_blank" rel="noopener" class="od-btn-gold">
              <span>Order Takeaway on WhatsApp</span>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.3C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
            </a>
            <a href="/menu" class="od-btn-ghost">View Full Menu & Pricing</a>
          </div>
        </div>

        <!-- Highlights of what's coming in Phase 2 -->
        <div class="od-features">
          <div class="od-feat-item">
            <b>⚡ Zero Aggregator Markups</b>
            <span>Direct kitchen-to-doorstep prices with exclusive resident discounts.</span>
          </div>
          <div class="od-feat-item">
            <b>🍲 Tamper-Proof Handi Packaging</b>
            <span>Biryanis and curries sealed in heat-retaining food-grade clay handis.</span>
          </div>
          <div class="od-feat-item">
            <b>📲 Instant UPI & Card Checkout</b>
            <span>Quick order repeat, live rider GPS tracking, and contactless payment.</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
<MobileBar active="" />
<script is:inline src="/js/motion-kit.js"></script>
</Base>

<style is:global>
  /* Hero */
  .od-hero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .od-hero-bg {
    position: absolute;
    inset: 0;
    background: url('/assets/interior/fursat_space_10.webp') center/cover no-repeat;
    filter: brightness(0.3);
  }
  .od-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(70px,10vw,120px) clamp(16px,4vw,40px);
    text-align: center;
  }
  .od-hero-title {
    font-family: var(--serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2.6rem,6vw,4.5rem);
    color: #F4ECDA;
    margin: 12px 0 16px;
    line-height: 1.1;
  }
  .od-hero-sub {
    font-size: 1.1rem;
    color: rgba(244,236,218,0.8);
    margin: 0 0 28px;
  }
  .od-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .od-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 32px;
    border-radius: 999px;
    background: #25D366;
    color: #0D1308;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 6px 24px rgba(37,211,102,0.4);
  }
  .od-wa-btn svg { width: 20px; height: 20px; }
  .od-menu-btn {
    padding: 15px 32px;
    border-radius: 999px;
    background: rgba(244,236,218,0.08);
    border: 1.5px solid rgba(224,166,60,0.5);
    color: #E0A63C;
    font-weight: 700;
    text-decoration: none;
  }

  .od-page {
    background: #17200F;
    color: #F4ECDA;
    padding-bottom: clamp(60px, 8vw, 100px);
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
  }
  .od-container {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(40px,6vw,80px) clamp(16px, 4vw, 40px) 0;
  }
  .od-hero-card {
    background: #12190B;
    border: 2px solid rgba(224, 166, 60, 0.4);
    border-radius: 28px;
    padding: clamp(32px, 5vw, 56px);
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }
  .od-pill {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(224, 166, 60, 0.15);
    border: 1px solid #E0A63C;
    color: #E0A63C;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .od-title {
    font-family: var(--serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #F4ECDA;
    margin: 0 0 14px;
    line-height: 1.15;
  }
  .od-sub {
    font-size: 1.05rem;
    color: rgba(244, 236, 218, 0.8);
    line-height: 1.6;
    margin: 0 auto 36px;
    max-width: 660px;
  }
  .od-action-box {
    background: rgba(244, 236, 218, 0.04);
    border: 1px solid rgba(224, 166, 60, 0.3);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 36px);
    margin-bottom: 40px;
  }
  .od-action-box h3 {
    font-family: var(--serif, "Playfair Display", Georgia, serif);
    font-size: 1.45rem;
    color: #E0A63C;
    margin: 0 0 8px;
  }
  .od-action-box p {
    font-size: 0.95rem;
    color: rgba(244, 236, 218, 0.75);
    margin: 0 0 24px;
  }
  .od-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .od-btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    background: #25D366;
    color: #0D1308;
    font-weight: 800;
    text-decoration: none;
  }
  .od-btn-gold svg { width: 18px; height: 18px; }
  .od-btn-ghost {
    padding: 14px 26px;
    border-radius: 999px;
    background: rgba(244, 236, 218, 0.08);
    border: 1px solid rgba(224, 166, 60, 0.4);
    color: #F4ECDA;
    font-weight: 700;
    text-decoration: none;
  }
  .od-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    text-align: left;
    border-top: 1px solid rgba(244, 236, 218, 0.1);
    padding-top: 32px;
  }
  .od-feat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .od-feat-item b {
    font-size: 0.95rem;
    color: #E0A63C;
  }
  .od-feat-item span {
    font-size: 0.85rem;
    color: rgba(244, 236, 218, 0.7);
    line-height: 1.4;
  }
</style>
