---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import SvgDefs from '../components/SvgDefs.astro';
import Hero from '../components/Hero.astro';
import HomeSeason from '../components/home/HomeSeason.astro';
import HomeNews from '../components/home/HomeNews.astro';
import HomeSpaces from '../components/home/HomeSpaces.astro';
import HomeCelebrate from '../components/home/HomeCelebrate.astro';
import HomeStory from '../components/home/HomeStory.astro';
import HomeVisit from '../components/home/HomeVisit.astro';
import HomeShared from '../components/home/HomeShared.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import PanoramicViewer from '../components/PanoramicViewer.astro';
import Reels from '../components/Reels.astro';
import Mascot from '../components/Mascot.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import Sparkles from '../components/Sparkles.astro';
import BookingDialog from '../components/BookingDialog.astro';
import StickyBar from '../components/StickyBar.astro';
import PicksTray from '../components/PicksTray.astro';
import LegalBar from '../components/LegalBar.astro';
import LegalDialog from '../components/LegalDialog.astro';
import IntroHeli from '../components/IntroHeli.astro';
import IntroLogo from '../components/IntroLogo.astro';
import IntroGate from '../components/IntroGate.astro';
import IntroCaption from '../components/IntroCaption.astro';
import Wizard from '../components/Wizard.astro';
import VoiceButton from '../components/VoiceButton.astro';
// TODO(client): 15% / FURSAT15 offer not confirmed; hidden until the client confirms.
const OFFER_ENABLED = false;
---
<Base
  title="Fursat Kitchen | Bar – Café, Bar & Banquet, Madhapur"
  description="Fursat Kitchen | Bar in Madhapur, Hyderabad — a vibrant café, kitchen, bar and banquet space. Dine, drink & celebrate."
  canonical="https://fursatind.in/"
  ogImage="https://fursatind.in/assets/fursat_space_01.webp"
  ogImageAlt="Fursat Kitchen | Bar interior — warm luxury dining in Madhapur"
  preloadImage={{
    href: '/assets/51db3af80d.webp',
    type: 'image/webp'
  }}
>
<a class="skip" href="#main">Skip to main content</a>
<SiteHeader active="home" />
<SvgDefs />
<main id="main" tabindex="-1">
<Hero />

<!-- ── Offer Strip ──────────────────────────────────────────────────── -->
<div class="hm-offer-strip" hidden={!OFFER_ENABLED} style={OFFER_ENABLED ? undefined : "display:none"}>
  <span class="hm-os-fire">🔥</span>
  <span class="hm-os-text">Lunch Offer: <strong>Flat 15% OFF</strong></span>
  <span class="hm-os-pill">Code: FURSAT15</span>
  <span class="hm-os-time">Terms apply, confirm on WhatsApp</span>
  <a href="/reserve" class="hm-os-cta">Reserve Now →</a>
</div>

<MarqueeStrip />

<HomeSeason />
<HomeNews />

<PanoramicViewer />
<HomeSpaces />
<HomeCelebrate />
<Reels />
<HomeStory />
<HomeVisit />
<HomeShared />
<Mascot />
</main>
<MascotOfferModal />
<SiteFooter />
<Sparkles />
<BookingDialog />
<StickyBar />
<PicksTray />
<LegalBar />
<LegalDialog />
<IntroHeli />
<IntroLogo />
<IntroGate />
<IntroCaption />
<Wizard />
<VoiceButton />
<script is:inline defer src="/js/01.js"></script>
<script is:inline defer src="/js/02.js"></script>
<script is:inline defer src="/js/03.js"></script>
<script is:inline defer src="/js/04.js"></script>
<script is:inline defer src="/js/05.js"></script>
<script is:inline defer src="/js/06.js"></script>
<script is:inline defer src="/js/07.js"></script>
<script is:inline defer src="/js/08.js"></script>
<script is:inline defer src="/js/09.js"></script>
<script is:inline defer id="fx-js" src="/js/10.js"></script>
<script is:inline defer src="/js/11.js"></script>
<script is:inline defer src="/js/12.js"></script>
<script is:inline defer src="/js/13.js"></script>
<script is:inline defer src="/js/14.js"></script>
<script is:inline defer src="/js/15.js"></script>
<script is:inline defer src="/js/16.js"></script>
<script is:inline defer src="/js/17.js"></script>
<script is:inline defer src="/js/18.js"></script>
<script is:inline defer src="/js/19.js"></script>
<MobileBar active="home" />
<script is:inline src="/js/motion-kit.js"></script>
</Base>
<style is:global>
/* ── Hero: first screen only (dish cards now live in their own section) ── */
.fx-p { font-size: calc(12.5px / var(--u)); line-height: 1.4; }
@media (max-width: 899px) { .fx-p { font-size: 16px; } .fxhero .pill, .fxhero .fx-ghost { height: 44px; font-size: 15px; } }

/* ── Hero corner: music + video pause ── */
.hx-ctl { position: absolute; top: calc(16px / var(--u)); right: calc(16px / var(--u)); z-index: 8; display: flex; align-items: center; gap: calc(8px / var(--u)); pointer-events: auto; }
.hx-ctl .snd, .hx-ctl .vz, .hx-ctl .fx-pv { min-height: calc(44px / var(--u)); height: calc(44px / var(--u)); touch-action: manipulation; }
.hx-ctl .snd { padding: 0 calc(18px / var(--u)) 0 calc(14px / var(--u)); font-size: calc(15px / var(--u)); gap: calc(8px / var(--u)); border-width: 1px; }
.hx-ctl .snd .vz-eq { height: calc(18px / var(--u)); gap: calc(2.5px / var(--u)); }
.hx-ctl .snd .vz-eq i { width: calc(3px / var(--u)); }
.hx-ctl .vz, .hx-ctl .fx-pv { width: calc(44px / var(--u)); padding: 0; justify-content: center; display: inline-grid; place-items: center; border-radius: 50%; }
.hx-ctl .vz .vz-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.hx-ctl .vz .vz-eq { height: calc(18px / var(--u)); }
.hx-ctl .fx-pv { border: 1px solid var(--pv-line, rgba(42,37,20,.35)); background: var(--pv-bg, rgba(250,245,233,.92)); color: var(--pv-ink, #2A2514); cursor: pointer; }
.hx-ctl .fx-pv svg { width: calc(18px / var(--u)); height: calc(18px / var(--u)); }
.hx-ctl button:focus-visible { outline: 2px solid #C94716; outline-offset: 3px; }
@media (max-width: 899px) {
  .hx-ctl { top: 10px; right: 10px; gap: 8px; }
  .hx-ctl .snd, .hx-ctl .vz, .hx-ctl .fx-pv { min-height: 44px; height: 44px; }
  .hx-ctl .snd { padding: 0 14px 0 12px; font-size: 14px; gap: 8px; }
  .hx-ctl .snd .vz-eq { height: 16px; gap: 2.5px; }
  .hx-ctl .snd .vz-eq i { width: 3px; }
  .hx-ctl .vz, .hx-ctl .fx-pv { width: 44px; }
  .hx-ctl .vz .vz-eq { height: 16px; }
  .hx-ctl .fx-pv svg { width: 18px; height: 18px; }
}

/* ── v5.9.1 H1: desktop hero, real-pixel sizes inside the scaled 1536x1024 canvas (--r = 1 screen px in canvas units) ── */
#vz { display: none !important; } /* hero keeps one music control (#snd) + pause (#fxpv); the intro-voice mute button shows only while the intro runs (html.lock) */
html.lock #vz { display: inline-flex !important; left: 18px; right: auto; top: calc(env(safe-area-inset-top, 0px) + 84px); z-index: 2147482999; min-width: 44px; min-height: 44px; justify-content: center; }
html.lock #vz .vz-t { display: inline; }
#vz:focus-visible { outline: 2px solid #C94716; outline-offset: 3px; }
@media (min-width: 900px) {
  .fxhero { --r: calc(1 / var(--u)); height: calc(336px * var(--u) + 340px); }
  .hx-ctl { top: calc(22px + 16px * var(--r)); }
  .fxhero .fx-leaf { -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent); mask-image: linear-gradient(180deg, #000 55%, transparent); }
  .fxhero .fx-eye { top: calc(98px - 8px * var(--r)); font-size: calc(13px * var(--r)); line-height: calc(18px * var(--r)); letter-spacing: .14em; }
  .fxhero .fx-p { font-size: calc(17px * var(--r)) !important; line-height: calc(26px * var(--r)) !important; }
  .fxhero .fx-btns { left: 130px; top: calc(336px + 58px * var(--r)); width: max-content; height: calc(44px * var(--r)); display: flex; gap: calc(12px * var(--r)); }
  .fxhero .pill, .fxhero .fx-ghost { position: relative; left: auto; top: auto; width: auto; height: 100%; padding: 0 calc(22px * var(--r)); gap: calc(8px * var(--r)); border-radius: calc(22px * var(--r)); font: 600 calc(15px * var(--r)) / 1 var(--sans); white-space: nowrap; }
  .fxhero .pill svg, .fxhero .fx-ghost svg { width: calc(14px * var(--r)); height: calc(14px * var(--r)); }
  .fxhero .fx-info { left: calc(130px + var(--ex, 0) * .14px); top: calc(336px + 118px * var(--r)); width: auto; max-width: none; padding: calc(8px * var(--r)) calc(18px * var(--r)) calc(8px * var(--r)) calc(14px * var(--r)); border-radius: calc(14px * var(--r)); gap: calc(12px * var(--r)); }
  .fxhero .fi-d { width: calc(9px * var(--r)); height: calc(9px * var(--r)); }
  .fxhero .fi-a { gap: calc(2px * var(--r)); }
  .fxhero .fi-a b { font-size: calc(15px * var(--r)); line-height: calc(20px * var(--r)); }
  .fxhero .fi-a small { font-size: calc(13px * var(--r)); line-height: calc(17px * var(--r)); }
  .fxhero .fx-igcol { left: calc(130px + var(--ex, 0) * .14px); top: calc(336px + 190px * var(--r)); width: calc(min(520px, 42.6vw) * var(--r)); height: auto; }
  .fxhero .fx-igcol-h { font-size: calc(13px * var(--r)); line-height: calc(18px * var(--r)); margin: 0 0 calc(6px * var(--r)); }
  .fxhero .fx-igtrk { gap: calc(8px * var(--r)) calc(10px * var(--r)); }
  .fxhero .fx-igcol .igx-i { height: calc(46px * var(--r)); grid-template-columns: calc(30px * var(--r)) 1fr; column-gap: calc(10px * var(--r)); padding: 0 calc(12px * var(--r)); border-radius: calc(14px * var(--r)); }
  .fxhero .igx-ic { width: calc(30px * var(--r)); height: calc(30px * var(--r)); }
  .fxhero .igx-ic svg { width: calc(16px * var(--r)); height: calc(16px * var(--r)); }
  .fxhero .igx-i b { font-size: calc(14px * var(--r)); line-height: calc(18px * var(--r)); }
  .fxhero .igx-i small { font-size: calc(12px * var(--r)); line-height: calc(15px * var(--r)); }
}

@media (min-width: 900px) and (max-width: 1279px) { .fxhero .fx-olive-l { top: auto; bottom: 0; width: 64px; height: 96px; } }
.ms{position:fixed;right:clamp(10px,2vw,28px);bottom:clamp(64px,9vh,96px);margin:0;padding:0;background:none;width:auto;z-index:40;--ms-size:clamp(120px,16vw,200px)}

/* ── Offer Strip ── */
.hm-offer-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px 20px;
  background: linear-gradient(135deg, #1A1200 0%, #2A1E00 100%);
  border-top: 1px solid rgba(224,166,60,0.3);
  border-bottom: 1px solid rgba(224,166,60,0.3);
  padding: 14px clamp(16px,4vw,40px);
  font-family: var(--sans,"Manrope",system-ui,sans-serif);
}
.hm-os-fire { font-size: 1.3rem; }
.hm-os-text { color: #F4ECDA; font-size: 0.95rem; }
.hm-os-text strong { color: #E0A63C; }
.hm-os-pill {
  background: rgba(224,166,60,0.15);
  border: 1px solid #E0A63C;
  color: #E0A63C;
  padding: 3px 12px;
  border-radius: 999px;
  font-size: 0.8125rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}
.hm-os-time { color: rgba(244,236,218,0.65); font-size: 0.875rem; }
.hm-os-cta {
  background: #E0A63C;
  color: #12190B;
  padding: 7px 20px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.875rem;
  text-decoration: none;
  transition: transform 0.15s ease;
}
.hm-os-cta:hover { transform: translateY(-1px); }
</style>
