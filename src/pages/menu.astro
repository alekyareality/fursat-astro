---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import foodData from '../data/food.json';
import drinksData from '../data/drinks.json';
import featured from '../data/menu-featured.json';
import { FOOD_GROUPS, DRINK_GROUPS, CHIPS, ICONS, type Group } from '../components/menu/menuGroups';
import { money } from '../components/menu/cart';
import '../styles/menu-v2.css';

// ── Types ────────────────────────────────────────────────────────────────────
type Raw = {
  name: string; section: string; description?: string; price: number | null;
  veg?: boolean; spicy?: boolean; chefSpecial?: boolean; image?: string; alc?: boolean;
  price30ml?: number; priceGlass?: number | null; priceBottle?: number; priceBucket?: number;
  price500ml?: number; price330ml?: number; pricePitcher?: number; priceTower?: number;
  note?: string;
};
type Item = Raw & { kind: 'food' | 'drink' };
type Section = { section: string; items: Item[] };

const food: Section[] = (foodData as { section: string; items: Raw[] }[]).map((s) => ({ section: s.section, items: s.items.map((i) => ({ ...i, kind: 'food' as const })) }));
const drinks: Section[] = (drinksData as { section: string; items: Raw[] }[]).map((s) => ({ section: s.section, items: s.items.map((i) => ({ ...i, kind: 'drink' as const })) }));
const byName = new Map<string, Section>();
[...food, ...drinks].forEach((s) => byName.set(s.section, s));

// Build gates: every section sits in exactly one group, every group section exists.
for (const [list, groups] of [[food, FOOD_GROUPS], [drinks, DRINK_GROUPS]] as [Section[], Group[]][]) {
  const used = groups.flatMap((g) => g.sections);
  const missing = list.map((s) => s.section).filter((n) => !used.includes(n));
  const ghost = used.filter((n) => !list.some((s) => s.section === n));
  if (missing.length || ghost.length) throw new Error(`menu groups out of sync. unassigned: ${missing.join(', ')} unknown: ${ghost.join(', ')}`);
}

const all: Item[] = [...food, ...drinks].flatMap((s) => s.items);
const totalItems = all.length;
const foodCount = food.reduce((n, s) => n + s.items.length, 0);
const drinkCount = totalItems - foodCount;

const find = (name: string, kind: 'food' | 'drink') => {
  const hit = all.find((i) => i.name === name && i.kind === kind);
  if (!hit) throw new Error(`menu-featured.json: "${name}" not found in ${kind} data`);
  return hit;
};
const drink = find(featured.featuredDrink.name, 'drink');
const picks = featured.chefPicks.map((p) => find(p.name, 'food'));
const moreShakes = (byName.get(drink.section)?.items ?? []).filter((i) => i.name !== drink.name && i.price != null).slice(0, 4);

// ── Helpers ──────────────────────────────────────────────────────────────────
const titleCase = (s: string) => (s === s.toUpperCase() && /[A-Z]/.test(s) ? s.toLowerCase().replace(/(^|[\s(/&-])([a-z])/g, (_m, a, b) => a + b.toUpperCase()) : s);
const slug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const VARIANTS: [keyof Raw, string][] = [['price30ml', '30 ml'], ['priceGlass', 'Glass'], ['price330ml', '330 ml'], ['price500ml', '500 ml'], ['pricePitcher', 'Pitcher'], ['priceBucket', 'Bucket'], ['priceTower', 'Tower'], ['priceBottle', 'Bottle']];
const variants = (i: Item) => VARIANTS.filter(([k]) => typeof i[k] === 'number').map(([k, l]) => ({ label: l, value: i[k] as number }));
const mainLabel = (i: Item) => (i.price != null ? variants(i).find((v) => v.value === i.price)?.label : undefined);
const groupSections = (g: Group) => g.sections.map((n) => byName.get(n)!).filter(Boolean);
const groupCount = (g: Group) => groupSections(g).reduce((n, s) => n + s.items.length, 0);
const groupSub = (g: Group) => (g.sections.length > 1 ? `${g.sections[0]} & more` : `${groupCount(g)} items`);
const addAttrs = (i: Item) => {
  const lab = mainLabel(i);
  return {
    'data-add': '', 'data-n': titleCase(i.name) + (lab ? ` (${lab})` : ''), 'data-p': String(i.price ?? ''),
    'data-c': i.section, 'data-k': i.kind, 'data-v': i.veg ? 'v' : 'n', ...(i.alc ? { 'data-a': '1' } : {}),
  };
};
const vegMark = (veg?: boolean) => (veg ? 'mv-vm mv-vm--v' : 'mv-vm mv-vm--n');

// ── SEO: Menu / MenuSection / MenuItem schema (same text and prices as the visible list) ──
// TODO(client): Peri Peri Cottage Cheese Sandwich (395 vs 240) and Sriracha Paneer Tikka Burger prices are untouched.
const SITE = 'https://fursatind.in';
const itemLd = (i: Item) => {
  const vs = variants(i);
  const offers = vs.length > 1
    ? vs.map((v) => ({ '@type': 'Offer', name: v.label, price: v.value, priceCurrency: 'INR' }))
    : i.price != null ? { '@type': 'Offer', price: i.price, priceCurrency: 'INR' } : undefined;
  return {
    '@type': 'MenuItem', name: titleCase(i.name),
    ...(i.description ? { description: i.description } : {}),
    ...(offers ? { offers } : {}),
    ...(i.veg ? { suitableForDiet: 'https://schema.org/VegetarianDiet' } : {}),
    ...(i.image ? { image: SITE + i.image } : {}),
  };
};
const menuLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { name: 'Fursat Kitchen Menu', list: food, id: 'food' },
    { name: 'Fursat Bar Menu', list: drinks, id: 'drinks' },
  ].map(({ name, list, id }) => ({
    '@type': 'Menu', '@id': `${SITE}/menu/#${id}`, name, url: `${SITE}/menu/#mv-${id}`, inLanguage: 'en-IN',
    provider: { '@id': `${SITE}/#restaurant` },
    hasMenuSection: list.map((sec) => ({ '@type': 'MenuSection', name: sec.section, hasMenuItem: sec.items.map(itemLd) })),
  })),
};
const ldItems = menuLd['@graph'].reduce((n, m) => n + m.hasMenuSection.reduce((k, sec) => k + sec.hasMenuItem.length, 0), 0);
if (ldItems !== totalItems) throw new Error(`menu schema item count ${ldItems} != ${totalItems}`);
---

<Base
  title="Menu | Fursat Kitchen | Bar, Madhapur, Hyderabad"
  description={`The Fursat menu: ${foodCount} kitchen dishes and ${drinkCount} bar drinks, cocktails, whisky, wine, mocktails, shakes and coffee. Build your picks and send them on WhatsApp.`}
  canonical="https://fursatind.in/menu/"
  ogImage="https://fursatind.in/assets/fursat_space_07.webp"
  ogImageAlt="Fursat Kitchen | Bar dining room"
  preloadImages={[
    { href: '/assets/menu/hero-bar-1400.webp', media: '(min-width: 721px)' },
    { href: '/assets/menu/hero-table-1400.webp', media: '(min-width: 721px)' },
  ]}
>
  <SiteHeader active="menu" />

  <main class="mv" id="main" data-side="drinks">
    <section class="mv-stage" aria-label="Menu overview">
      <!-- Toolbar -->
      <div class="mv-tools">
        <label class="mv-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="mv-q" type="search" placeholder="Search the menu…" autocomplete="off" enterkeyhint="search" aria-label="Search the menu" />
        </label>
        <div class="mv-diet" role="group" aria-label="Dietary filters">
          <button class="mv-pill" type="button" data-diet="veg" aria-pressed="false"><i class="mv-dot mv-dot--v"></i>Veg</button>
          <button class="mv-pill" type="button" data-diet="nonveg" aria-pressed="false"><i class="mv-dot mv-dot--n"></i>Non-veg</button>
          <button class="mv-pill" type="button" data-diet="spicy" aria-pressed="false"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3c-1 3-4 4-6 4C8 7 5 9 5 13c0 4 3 7 7 7 5 0 8-4 8-9 0-3-1-6-3-8z"/></svg>Spicy</button>
        </div>
        <button class="mv-pill mv-age-pill" type="button" id="mv-age-open" aria-haspopup="dialog">21+ <span aria-hidden="true">ⓘ</span><span class="mv-sr"> bar menu age notice</span></button>
      </div>

      <!-- Split hero (Take B: framed windows) -->
      <div class="mv-hero" id="mv-hero">
        <article class="mv-win mv-win--bar">
          <div class="mv-win-ph"><img src="/assets/menu/hero-bar-1400.webp" srcset="/assets/menu/hero-bar-800.webp 800w, /assets/menu/hero-bar-1400.webp 1400w" sizes="(max-width:720px) 100vw, 50vw" width="1400" height="1074" alt="The Fursat bar: backlit hexagon shelves of bottles beside the glowing Fursat sign" fetchpriority="high" decoding="async" /></div>
          <span class="mv-sweep" aria-hidden="true"></span>
          <div class="mv-win-cap">
            <span class="mv-eyebrow">The Bar</span>
            <h2 class="mv-hl">Sip. Socialize. <span>Unwind.</span></h2>
            <button class="mv-btn" type="button" data-side-go="drinks">Explore Drinks <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          </div>
        </article>
        <article class="mv-win mv-win--table">
          <div class="mv-win-ph"><img src="/assets/menu/hero-table-1400.webp" srcset="/assets/menu/hero-table-800.webp 800w, /assets/menu/hero-table-1400.webp 1400w" sizes="(max-width:720px) 100vw, 50vw" width="1400" height="1008" alt="A Fursat lounge corner with a cream sofa, two leather chairs and a round table" loading="lazy" decoding="async" /></div>
          <span class="mv-sweep" aria-hidden="true"></span>
          <div class="mv-win-cap">
            <span class="mv-eyebrow">The Table</span>
            <h2 class="mv-hl">Dine. Delight. <span>Repeat.</span></h2>
            <button class="mv-btn" type="button" data-side-go="food">Explore Food <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          </div>
        </article>
      </div>

      <!-- Rail + featured + chef's pick -->
      <div class="mv-grid">
        <nav class="mv-card mv-rail" aria-label="Menu categories">
          {[{ side: 'drinks', groups: DRINK_GROUPS }, { side: 'food', groups: FOOD_GROUPS }].map(({ side, groups }) => (
            <ul class="mv-rail-list" data-rail={side} hidden={side !== 'drinks'}>
              {groups.map((g, k) => (
                <li>
                  <button class:list={['mv-rw', { 'is-on': k === 0 }]} type="button" data-go={g.id} data-side-of={side}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[g.icon]} />
                    <span><b>{g.label}</b><small>{groupSub(g)}</small></span>
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </nav>

        <section class="mv-card mv-feat" aria-labelledby="mv-feat-name">
          <div class="mv-feat-ph">
            <img src={featured.featuredDrink.image} alt={featured.featuredDrink.imageAlt} width="1200" height="1637" loading="lazy" decoding="async" />
          </div>
          <div class="mv-feat-txt">
            <span class="mv-lab">Featured drink</span>
            <h3 class="mv-nm" id="mv-feat-name">{titleCase(drink.name)}</h3>
            <p class="mv-meta"><span class={vegMark(drink.veg)} role="img" aria-label={drink.veg ? 'Vegetarian' : 'Non-vegetarian'}></span>{drink.section}</p>
            <div class="mv-chef-row">
              <p class="mv-price num">{money(drink.price!)}</p>
              <button class="mv-btn mv-btn--cream" type="button" {...addAttrs(drink)} data-img={featured.featuredDrink.image}>Add to Picks <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
            <div class="mv-more">
              <div class="mv-more-top"><span class="mv-more-h">More from {drink.section}</span><button class="mv-link" type="button" data-go="d-shakes" data-side-of="drinks">See all →</button></div>
              <ul>
                {moreShakes.map((s) => (
                  <li><span>{titleCase(s.name)}</span><b class="num">{money(s.price!)}</b></li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <section class="mv-card mv-chef" aria-label="Chef's picks">
          <div class="mv-chef-main">
            <span class="mv-ghost" aria-hidden="true">{picks[0].name[0]}</span>
            <span class="mv-lab">Chef's pick</span>
            <h3 class="mv-nm">{titleCase(picks[0].name)}</h3>
            <p class="mv-meta">
              <span class={vegMark(picks[0].veg)} role="img" aria-label={picks[0].veg ? 'Vegetarian' : 'Non-vegetarian'}></span>{picks[0].veg ? 'Vegetarian' : 'Non-vegetarian'}
              {picks[0].spicy && <span class="mv-spice">Spicy</span>}
              <span class="mv-sec-name">{picks[0].section}</span>
            </p>
            <div class="mv-chef-row">
              <p class="mv-price num">{money(picks[0].price!)}</p>
              <button class="mv-btn" type="button" {...addAttrs(picks[0])}>Add to Picks <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
          </div>
          <div class="mv-chef-second">
            <span class="mv-orn" aria-hidden="true"><b></b></span>
            <div class="mv-chef-2in">
              <div>
                <span class="mv-lab">Also a chef's pick</span>
                <h4 class="mv-nm2">{titleCase(picks[1].name)}</h4>
                <p class="mv-meta">
                  <span class={vegMark(picks[1].veg)} role="img" aria-label={picks[1].veg ? 'Vegetarian' : 'Non-vegetarian'}></span>{picks[1].veg ? 'Vegetarian' : 'Non-vegetarian'}
                  {picks[1].spicy && <span class="mv-spice">Spicy</span>}
                  <span class="mv-sec-name">{picks[1].section}</span>
                </p>
              </div>
              <div class="mv-chef-row">
                <p class="mv-price mv-price--sm num">{money(picks[1].price!)}</p>
                <button class="mv-btn mv-btn--sm" type="button" {...addAttrs(picks[1])}>Add to Picks <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Chips + picks bar -->
      <div class="mv-bar">
        <div class="mv-chips" role="group" aria-label="Jump to a category">
          {CHIPS.map((c, k) => (
            <button class:list={['mv-chip', { 'is-on': k === 0 }]} type="button" data-chip={c.to ?? 'all'} data-side-of={c.side}>{c.label}</button>
          ))}
        </div>
        <div class="mv-picks" id="mv-picks" data-count="0">
          <div class="mv-picks-bar" id="mv-picks-bar">
            <button class="mv-picks-btn" type="button" id="mv-picks-toggle" aria-expanded="false" aria-controls="mv-picks-panel">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" id="mv-bag"><path d="M5 8h14l-1 12H6L5 8zM9 8a3 3 0 0 1 6 0"/></svg>
              <span class="mv-picks-lbl">Your Picks (<b class="num" id="mv-cnt">0</b>)</span>
            </button>
            <span class="mv-sep" aria-hidden="true"></span>
            <a class="mv-wa" id="mv-wa" href="#" aria-disabled="true" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2z"/></svg>
              <span class="mv-wa-txt"><span class="mv-wa-long">Send on </span>WhatsApp</span><span class="mv-wa-arr" aria-hidden="true">→</span>
            </a>
          </div>
          <!-- Collapsed form while the page scrolls: bag + count. Pointer-only; the bar above holds the real controls. -->
          <span class="mv-picks-mini" id="mv-picks-mini" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" id="mv-bag-mini"><path d="M5 8h14l-1 12H6L5 8zM9 8a3 3 0 0 1 6 0"/></svg>
            <b class="num" id="mv-cnt-mini">0</b>
          </span>
          <div class="mv-picks-panel" id="mv-picks-panel" hidden>
            <ul id="mv-picks-list"></ul>
            <div class="mv-picks-foot"><span>Subtotal <b class="num" id="mv-sub">₹0</b> <small>taxes extra</small></span><button type="button" class="mv-link" id="mv-clear">Clear all</button></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Full menu: every item server-rendered (works without JS) -->
    <section class="mv-list" aria-label="Full menu" id="mv-list">
      <div class="mv-sticky" id="mv-sticky">
        <div class="mv-sticky-in">
          <div class="mv-seg" role="group" aria-label="Food or drinks">
            <button class="mv-seg-b is-on" type="button" data-side-go="food" data-seg="food">Food</button>
            <button class="mv-seg-b" type="button" data-side-go="drinks" data-seg="drinks">Drinks</button>
          </div>
          {[{ side: 'food', groups: FOOD_GROUPS }, { side: 'drinks', groups: DRINK_GROUPS }].map(({ side, groups }) => (
            <div class="mv-schips" data-schips={side} hidden={side !== 'food'}>
              {groups.map((g) => (<button class="mv-schip" type="button" data-go={g.id} data-side-of={side}>{g.label}</button>))}
            </div>
          ))}
          <p class="mv-count num" id="mv-count" role="status" aria-live="polite"></p>
        </div>
      </div>
      <div class="mv-list-in">
        {[{ side: 'food', title: 'The Table', blurb: `${foodCount} dishes`, groups: FOOD_GROUPS }, { side: 'drinks', title: 'The Bar', blurb: `${drinkCount} drinks`, groups: DRINK_GROUPS }].map(({ side, title, blurb, groups }) => (
          <div class="mv-side" id={`mv-${side}`} data-side-block={side}>
            <header class="mv-side-h"><h2>{title}</h2><span>{blurb}</span></header>
            {groups.map((g) => (
              <div class="mv-grp" id={`g-${g.id}`} data-group={g.id}>
                <h3 class="mv-grp-h">{g.label}<span class="num">{groupCount(g)}</span></h3>
                {groupSections(g).map((sec) => (
                  <section class="mv-sec" id={`s-${slug(sec.section)}`}>
                    {g.sections.length > 1 && <p class="mv-sec-h">{sec.section}</p>}
                    <ul class="mv-items">
                      {sec.items.map((i) => (
                        <li class="mv-item" data-row data-sec={i.section} data-veg={i.veg ? '1' : '0'} data-spicy={i.spicy ? '1' : '0'} data-text={`${titleCase(i.name)} ${i.description ?? ''} ${i.section}`.toLowerCase()} {...(i.image ? { 'data-img': i.image } : {})}>
                          <div class="mv-item-main">
                            <span class={vegMark(i.veg)} role="img" aria-label={i.veg ? 'Vegetarian' : 'Non-vegetarian'}></span>
                            <div>
                              <h4 class="mv-item-name"><button class="mv-open" type="button" aria-haspopup="dialog" inert><span class="mv-iname">{titleCase(i.name)}</span></button>{i.chefSpecial && <em class="mv-chefmark">Chef's special</em>}{i.spicy && <em class="mv-spice">Spicy</em>}</h4>
                              {i.description && <p class="mv-idesc">{i.description}</p>}
                              {i.note && <p class="mv-note">{i.note}</p>}
                            </div>
                          </div>
                          <div class="mv-item-buy">
                            <span class="mv-item-price num">
                              {variants(i).length > 1
                                ? variants(i).map((v) => <span><small>{v.label}</small> {money(v.value)}</span>)
                                : i.price != null ? money(i.price) : '—'}
                            </span>
                            {i.price != null && (
                              <button class="mv-add" type="button" aria-label={`Add ${titleCase(i.name)} to picks`} {...addAttrs(i)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            ))}
          </div>
        ))}
        <p class="mv-empty" id="mv-empty" hidden>No dish found. Try “biryani”, or clear the filters.</p>
        <p class="mv-fine">Prices in ₹, taxes extra.</p>
      </div>
    </section>

    <!-- Dish detail sheet (phones). Native dialog: focus trap, Esc and inert background come with it. -->
    <dialog class="mv-sheet" id="mv-sheet" aria-labelledby="mv-sheet-name" aria-describedby="mv-sheet-desc">
      <div class="mv-sheet-panel" id="mv-sheet-panel">
        <div class="mv-sheet-drag" id="mv-sheet-drag">
          <span class="mv-sheet-grab" aria-hidden="true"></span>
          <div class="mv-sheet-ph" id="mv-sheet-ph"></div>
        </div>
        <button class="mv-sheet-x" type="button" id="mv-sheet-x" aria-label="Close dish details"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        <div class="mv-sheet-scroll">
          <p class="mv-lab" id="mv-sheet-sec"></p>
          <h2 class="mv-nm" id="mv-sheet-name"></h2>
          <p class="mv-meta" id="mv-sheet-tags"></p>
          <p class="mv-sheet-desc" id="mv-sheet-desc"></p>
          <p class="mv-note" id="mv-sheet-note"></p>
          <p class="mv-sheet-price num" id="mv-sheet-price"></p>
        </div>
        <div class="mv-sheet-foot">
          <button class="mv-btn" type="button" id="mv-sheet-add" data-add data-nofly>
            <span class="mv-ic" aria-hidden="true">
              <svg class="mv-ic-a" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
              <svg class="mv-ic-b" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            </span>
            <span>Add to Picks</span>
          </button>
          <p class="mv-sheet-status" id="mv-sheet-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </dialog>
  </main>

  <!-- Cursor photo reveal (desktop, rows that have a real photo) -->
  <div class="mv-reveal" id="mv-reveal" aria-hidden="true"><img alt="" width="220" height="160" decoding="async" /></div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(menuLd)}></script>

