---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PicksTray from '../components/PicksTray.astro';
import foodData from '../data/food.json';
import drinksData from '../data/drinks.json';

// ── Types ────────────────────────────────────────────────────────────────────
type MenuItem = {
  name: string;
  section: string;
  description?: string;
  price: number | null;
  veg?: boolean;
  spicy?: boolean;
  chefSpecial?: boolean;
  image?: string;
  alc?: boolean;
  price30ml?: number;
  priceBottle?: number;
  priceGlass?: number | null;
  priceBucket?: number;
  price500ml?: number;
  price330ml?: number;
  pricePitcher?: number;
  priceTower?: number;
  subCategory?: string;
  note?: string;
  kind: 'food' | 'drink';
};

type MenuSection = {
  section: string;
  items: MenuItem[];
};

// ── Strict Photo Exclusion List (Per AGENTS.md rule) ──────────────────────────
// Never show these files as dishes: fursat_.webp, fursat_1_.webp, dsc08946.webp, dsc05389.webp, pandu_mirchi_kodi_kebab.webp
const excludedDishImages = new Set([
  'fursat_.webp',
  'fursat_1_.webp',
  'dsc08946.webp',
  'dsc05389.webp',
  'pandu_mirchi_kodi_kebab.webp',
]);

function getValidDishImage(img?: string): string | null {
  if (!img) return null;
  const basename = img.split('/').pop() || '';
  if (excludedDishImages.has(basename)) return null;
  return img;
}

function slugify(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

// ── Category Lead Images Mapping (Real photos only) ───────────────────────────
const categoryFallbackPhotos: Record<string, string> = {
  'Appetizers': '/assets/dishes/angaraa_chicken_tikka_.webp',
  'Regional specials': '/assets/dishes/karvepaku_kodi_vepudu.webp',
  'Desserts': '/assets/dishes/lotus_biscoff_.webp',
  'Sandwiches & burgers': '/assets/dishes/jamicon_jerk_chicken_with_fires.webp',
  'Finger bites': '/assets/dishes/onion_rings.webp',
  'Quick Bites': '/assets/dishes/dsc05366.webp',
  'All day breakfast': '/assets/interior/tour-cafe.webp',
  'Biryani & rice': '/assets/interior/tour-lounge.webp',
  'South Indian': '/assets/interior/tour-entrance.webp',
  'Mains': '/assets/dishes/dsc03317.webp',
  'Pasta': '/assets/interior/tour-booth.webp',
  'Pizza': '/assets/interior/tour-high-tables.webp',
  'Cookies': '/assets/interior/tour-cafe.webp',
  'Healthy bowls': '/assets/interior/tour-lounge.webp',
  'Kids menu': '/assets/interior/tour-booth.webp',
  'Healthy Salads': '/assets/interior/tour-lounge.webp',
  'Soups': '/assets/interior/tour-booth.webp',
  'Asian mains': '/assets/interior/tour-lounge.webp',
  'Indian Breads': '/assets/interior/tour-entrance.webp',
  'Extras/Sides': '/assets/interior/tour-booth.webp',
  "Sreemukhi's special menu": '/assets/dishes/tandoori_prawns_.webp',
  // Bar categories fallback
  'Mocktails': '/assets/interior/tour-bar.webp',
  'Silly Classic': '/assets/interior/bar-front.webp',
  'The Classic': '/assets/interior/tour-bar.webp',
  'Long Island Iced Tea': '/assets/interior/bar-back.webp',
  'Shooters': '/assets/interior/tour-high-tables.webp',
  'Whisky': '/assets/interior/bar-front.webp',
  'Vodka': '/assets/interior/tour-bar.webp',
  'Gin': '/assets/interior/bar-front.webp',
  'Rum': '/assets/interior/tour-bar.webp',
  'Brandy': '/assets/interior/bar-back.webp',
  'Tequila': '/assets/interior/tour-high-tables.webp',
  'Liqueur': '/assets/interior/bar-front.webp',
  'Wines': '/assets/interior/tour-lounge.webp',
  'Beer': '/assets/interior/tour-high-tables.webp',
  'Soft Drinks': '/assets/interior/tour-cafe.webp',
  'Milk Shakes': '/assets/interior/tour-cafe.webp',
  'Smoothies': '/assets/interior/tour-cafe.webp',
  'Coffee': '/assets/interior/tour-cafe.webp',
  'Tea': '/assets/interior/tour-cafe.webp',
};

// ── Process Food and Drinks Server-Side ───────────────────────────────────────
const foodSections = (foodData as MenuSection[]).map((sec) => {
  const items = sec.items.map((it) => ({
    ...it,
    kind: 'food' as const,
    validImage: getValidDishImage(it.image),
  }));
  const directDishImg = items.map((it) => it.validImage).find(Boolean);
  const leadImage = directDishImg || categoryFallbackPhotos[sec.section] || '/assets/interior/tour-lounge.webp';
  return {
    title: sec.section,
    slug: slugify(sec.section),
    items,
    leadImage,
    isRealDishLead: !!directDishImg,
  };
});

const drinksSections = (drinksData as MenuSection[]).map((sec) => {
  const items = sec.items.map((it) => ({
    ...it,
    kind: 'drink' as const,
    validImage: getValidDishImage(it.image),
  }));
  const directDishImg = items.map((it) => it.validImage).find(Boolean);
  const leadImage = directDishImg || categoryFallbackPhotos[sec.section] || '/assets/interior/tour-bar.webp';
  return {
    title: sec.section,
    slug: slugify(sec.section),
    items,
    leadImage,
    isRealDishLead: !!directDishImg,
  };
});

const totalFoodCount = foodSections.reduce((sum, s) => sum + s.items.length, 0);
const totalDrinksCount = drinksSections.reduce((sum, s) => sum + s.items.length, 0);
---

<Base
  title="The Fursat Menu Book — Kitchen & Craft Bar | Madhapur, Hyderabad"
  description="Explore The Fursat Menu Book: 150+ authentic kitchen dishes and craft bar cocktails. Full server-rendered menu, dietary filters, and WhatsApp picks."
  canonical="https://fursatind.in/menu/"
  ogImage="https://fursatind.in/assets/fursat_space_07.webp"
  ogImageAlt="The Fursat Menu Book — Kitchen & Craft Bar"
>
  <SiteHeader active="menu" />

  <main class="mb-main" id="main">
    <!-- ── 1. Full-Screen Split Entry (Drinks | Food) ─────────────────────── -->
    <section class="mb-split-entry" id="mb-split-entry" aria-label="Menu selection">
      <div class="mb-split-half mb-split-half--drinks" id="half-drinks" role="button" tabindex="0" aria-label="Open Drinks Menu">
        <div class="mb-split-bg" style="background-image: url('/assets/interior/bar-back.webp')"></div>
        <div class="mb-split-overlay mb-split-overlay--drinks"></div>
        <div class="mb-split-content">
          <span class="mb-split-kicker">✦ CRAFT BAR &amp; CELLAR ✦</span>
          <h2 class="mb-split-title">Drinks &amp; Spirits</h2>
          <p class="mb-split-sub">Craft Cocktails, Single Malts, Draught Brews &amp; Mocktails ({totalDrinksCount} pours)</p>
          <div class="mb-split-btn">
            <span>Explore Bar Book →</span>
          </div>
        </div>
      </div>

      <div class="mb-split-half mb-split-half--food" id="half-food" role="button" tabindex="0" aria-label="Open Food Menu">
        <div class="mb-split-bg" style="background-image: url('/assets/interior/tour-lounge.webp')"></div>
        <div class="mb-split-overlay mb-split-overlay--food"></div>
        <div class="mb-split-content">
          <span class="mb-split-kicker">✦ KITCHEN &amp; DINING ✦</span>
          <h2 class="mb-split-title">Kitchen Dishes</h2>
          <p class="mb-split-sub">Hyderabadi Biryanis, Regional Tandoor, Appetizers &amp; Desserts ({totalFoodCount} recipes)</p>
          <div class="mb-split-btn">
            <span>Explore Food Book →</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2. Floating Top Switcher Bar (Always accessible once menu is open) ── -->
    <header class="mb-top-bar" id="mb-top-bar" aria-label="Menu controls">
      <div class="mb-top-bar-inner">
        <div class="mb-switch-pill" role="tablist" aria-label="Menu view switch">
          <button
            type="button"
            class="mb-switch-tab mb-switch-tab--food is-active"
            id="tab-switch-food"
            role="tab"
            aria-selected="true"
            data-target="food"
          >
            <span class="mb-switch-icon">🍲</span>
            <span class="mb-switch-label">Food Book</span>
            <span class="mb-switch-count">{totalFoodCount}</span>
          </button>
          <button
            type="button"
            class="mb-switch-tab mb-switch-tab--drinks"
            id="tab-switch-drinks"
            role="tab"
            aria-selected="false"
            data-target="drinks"
          >
            <span class="mb-switch-icon">🍸</span>
            <span class="mb-switch-label">Drinks Book</span>
            <span class="mb-switch-count">{totalDrinksCount}</span>
          </button>
        </div>

        <button type="button" class="mb-split-return-btn" id="mb-return-split" title="Return to split entry">
          ⤢ Split View
        </button>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="mb-toolbar">
        <div class="mb-search-wrap">
          <svg class="mb-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="mb-search-input"
            class="mb-search-input"
            placeholder="Search dishes, drinks, ingredients…"
            aria-label="Search menu"
          />
          <button type="button" id="mb-search-clear" class="mb-search-clear" aria-label="Clear search" hidden>✕</button>
        </div>

        <div class="mb-filter-chips" role="group" aria-label="Dietary filters">
          <button type="button" class="mb-filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="mb-filter-chip mb-filter-chip--veg" data-filter="veg" aria-pressed="false">
            <span class="mb-dot mb-dot--veg" aria-hidden="true"></span>
            <span>Veg</span>
          </button>
          <button type="button" class="mb-filter-chip mb-filter-chip--nonveg" data-filter="nonveg" aria-pressed="false">
            <span class="mb-dot mb-dot--nonveg" aria-hidden="true"></span>
            <span>Non-Veg</span>
          </button>
          <button type="button" class="mb-filter-chip mb-filter-chip--spicy" data-filter="spicy" aria-pressed="false">
            <span aria-hidden="true">🌶️</span>
            <span>Spicy</span>
          </button>
        </div>
      </div>
    </header>

    <!-- ── 3. Menu Book Shell: Sidebar Rail + Scroll Content ───────────────── -->
    <div class="mb-book-shell" id="mb-book-shell" data-active-pane="food">
      
      <!-- ── FOOD PANE ──────────────────────────────────────────────────── -->
      <div class="mb-pane mb-pane--food is-active" id="pane-food" role="region" aria-label="Food Menu Book">
        <div class="mb-pane-layout">
          <!-- Desktop Category Rail (Left column) -->
          <aside class="mb-cat-rail mb-cat-rail--desktop" aria-label="Food category index">
            <div class="mb-cat-rail-header">
              <span class="mb-cat-rail-title">CATEGORIES</span>
              <span class="mb-cat-rail-counter">{foodSections.length}</span>
            </div>
            <nav class="mb-cat-rail-list">
              {foodSections.map((sec, idx) => (
                <a
                  href={`#cat-food-${sec.slug}`}
                  class={`mb-cat-link${idx === 0 ? ' is-active' : ''}`}
                  data-cat-slug={`cat-food-${sec.slug}`}
                >
                  <span class="mb-cat-name">{sec.title}</span>
                  <span class="mb-cat-count">{sec.items.length}</span>
                </a>
              ))}
            </nav>
          </aside>

          <!-- Main Server-Rendered Food List -->
          <div class="mb-book-content">
            <div class="mb-book-header">
              <h1 class="mb-book-headline">The Kitchen Book</h1>
              <p class="mb-book-lead">
                Every dish crafted fresh with Telangana spices, slow-cooked gravies, and coastal recipes.
              </p>
            </div>

            {foodSections.map((sec) => (
              <section class="mb-category-spread mb-book-spread" id={`cat-food-${sec.slug}`} data-section-slug={sec.slug}>
                <!-- CSS 3D Book Spread Header: Left Page (Photo Leaf) + Right Page (Spread Info) -->
                <div class="mb-spread-book-turn" data-turn-target>
                  <div class="mb-spread-page mb-spread-page--left">
                    <div class="mb-spread-photo-wrap">
                      <img
                        src={sec.leadImage}
                        alt={sec.title}
                        class="mb-spread-lead-img"
                        width="480"
                        height="360"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="mb-spread-caption">
                        <span class="mb-spread-leaf-badge">Fursat Kitchen</span>
                        <p class="mb-spread-quote">Crafted with patience &amp; fire.</p>
                      </div>
                    </div>
                  </div>

                  <div class="mb-spread-page mb-spread-page--right">
                    <header class="mb-spread-header">
                      <div class="mb-spread-title-wrap">
                        <span class="mb-spread-kicker">Section</span>
                        <h2 class="mb-spread-title">{sec.title}</h2>
                      </div>
                      <span class="mb-spread-count">{sec.items.length} dishes</span>
                    </header>

                    <div class="mb-dishes-grid">
                      {sec.items.map((item) => {
                        const isVeg = item.veg === true;
                        const isNonVeg = item.veg === false;
                        const isSpicy = item.spicy === true;
                        const isChef = item.chefSpecial === true;
                        const hasValidImg = !!item.validImage;

                        return (
                          <article
                            class={`mb-dish-card${hasValidImg ? ' has-photo' : ''}`}
                            data-dish-name={item.name}
                            data-dish-price={item.price != null ? `₹${item.price}` : '—'}
                            data-dish-raw-price={item.price != null ? item.price : ''}
                            data-dish-img={hasValidImg ? item.validImage : ''}
                            data-dish-desc={item.description || ''}
                            data-dish-cat={sec.title}
                            data-veg={isVeg ? 'true' : isNonVeg ? 'false' : ''}
                            data-spicy={isSpicy ? 'true' : 'false'}
                            data-chef={isChef ? 'true' : 'false'}
                          >
                            <div class="mb-dish-card-main">
                              <div class="mb-dish-header">
                                <div class="mb-dish-badges">
                                  {isVeg && <span class="mb-dot mb-dot--veg" title="Vegetarian" aria-label="Vegetarian" />}
                                  {isNonVeg && <span class="mb-dot mb-dot--nonveg" title="Non-vegetarian" aria-label="Non-vegetarian" />}
                                  {isSpicy && <span class="mb-badge-spicy" title="Spicy">🌶️</span>}
                                  {isChef && <span class="mb-badge-chef">Chef's Special</span>}
                                </div>
                                <span class="mb-dish-price">
                                  {item.price != null ? `₹${item.price}` : '—'}
                                </span>
                              </div>

                              <h3 class="mb-dish-title">{item.name}</h3>
                              {item.description && <p class="mb-dish-desc">{item.description}</p>}
                            </div>

                            <div class="mb-dish-footer">
                              {hasValidImg ? (
                                <span class="mb-photo-pill" title="Hover on desktop to preview photo">✦ Photo</span>
                              ) : (
                                <span></span>
                              )}
                              <button
                                type="button"
                                class="mb-add-pick-btn fx-add"
                                data-name={item.name}
                                data-price={item.price != null ? item.price : ''}
                                aria-label={`Add ${item.name} to picks`}
                                aria-pressed="false"
                              >
                                <span class="mb-add-icon">+</span>
                                <span>Pick</span>
                              </button>
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </section>
            ))}

            <p class="mb-empty-alert" id="mb-empty-food" hidden>
              No dishes match your active filter. Try resetting dietary toggles or search keyword.
            </p>
          </div>
        </div>

        <!-- Phone Sticky Category Rail (Bottom thumb zone) -->
        <nav class="mb-cat-rail mb-cat-rail--mobile" aria-label="Mobile food category selector">
          <div class="mb-cat-scroll-track" id="track-food">
            {foodSections.map((sec, idx) => (
              <a
                href={`#cat-food-${sec.slug}`}
                class={`mb-cat-pill${idx === 0 ? ' is-active' : ''}`}
                data-cat-slug={`cat-food-${sec.slug}`}
              >
                {sec.title}
              </a>
            ))}
          </div>
        </nav>
      </div>

      <!-- ── DRINKS PANE ────────────────────────────────────────────────── -->
      <div class="mb-pane mb-pane--drinks" id="pane-drinks" role="region" aria-label="Drinks Menu Book">
        <div class="mb-pane-layout">
          <!-- Desktop Category Rail (Left column) -->
          <aside class="mb-cat-rail mb-cat-rail--desktop mb-cat-rail--bar" aria-label="Drinks category index">
            <div class="mb-cat-rail-header">
              <span class="mb-cat-rail-title">BAR SECTIONS</span>
              <span class="mb-cat-rail-counter">{drinksSections.length}</span>
            </div>
            <nav class="mb-cat-rail-list">
              {drinksSections.map((sec, idx) => (
                <a
                  href={`#cat-drinks-${sec.slug}`}
                  class={`mb-cat-link${idx === 0 ? ' is-active' : ''}`}
                  data-cat-slug={`cat-drinks-${sec.slug}`}
                >
                  <span class="mb-cat-name">{sec.title}</span>
                  <span class="mb-cat-count">{sec.items.length}</span>
                </a>
              ))}
            </nav>
          </aside>

          <!-- Main Server-Rendered Drinks List -->
          <div class="mb-book-content mb-book-content--bar">
            <div class="mb-book-header mb-book-header--bar">
              <span class="mb-bar-gate-badge">21+ Craft Cellar</span>
              <h1 class="mb-book-headline">The Bar &amp; Cellar Book</h1>
              <p class="mb-book-lead">
                Curated cocktails, rare single malts, aged rums, chilled beer buckets, and fresh artisanal brews.
              </p>
            </div>

            {drinksSections.map((sec) => (
              <section class="mb-category-spread mb-category-spread--bar mb-book-spread" id={`cat-drinks-${sec.slug}`} data-section-slug={sec.slug}>
                <div class="mb-spread-book-turn" data-turn-target>
                  <div class="mb-spread-page mb-spread-page--left mb-spread-page--bar-left">
                    <div class="mb-spread-photo-wrap">
                      <img
                        src={sec.leadImage}
                        alt={sec.title}
                        class="mb-spread-lead-img"
                        width="480"
                        height="360"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="mb-spread-caption mb-spread-caption--bar">
                        <span class="mb-spread-leaf-badge mb-spread-leaf-badge--bar">Fursat Cellar</span>
                        <p class="mb-spread-quote">Distilled to perfection.</p>
                      </div>
                    </div>
                  </div>

                  <div class="mb-spread-page mb-spread-page--right">
                    <header class="mb-spread-header mb-spread-header--bar">
                      <div class="mb-spread-title-wrap">
                        <span class="mb-spread-kicker mb-spread-kicker--bar">Bar Collection</span>
                        <h2 class="mb-spread-title">{sec.title}</h2>
                      </div>
                      <span class="mb-spread-count">{sec.items.length} pours</span>
                    </header>

                    <div class="mb-dishes-grid mb-dishes-grid--bar">
                      {sec.items.map((item) => {
                        const isAlc = item.alc === true;
                        const isVeg = item.veg === true;
                        const isSpirit = item.price30ml != null || (item.priceBottle != null && sec.title !== 'Wines' && sec.title !== 'Beer');
                        const isWine = sec.title === 'Wines' || item.priceGlass != null;

                        return (
                          <article
                            class="mb-dish-card mb-dish-card--bar"
                            data-dish-name={item.name}
                            data-dish-price={item.price != null ? `₹${item.price}` : item.priceBottle != null ? `₹${item.priceBottle}` : '—'}
                            data-dish-raw-price={item.price != null ? item.price : item.priceBottle != null ? item.priceBottle : ''}
                            data-dish-img=""
                            data-dish-desc={item.description || ''}
                            data-dish-cat={sec.title}
                            data-alc={isAlc ? 'true' : 'false'}
                            data-veg={isVeg ? 'true' : ''}
                          >
                            <div class="mb-dish-card-main">
                              <div class="mb-dish-header">
                                <div class="mb-dish-badges">
                                  {isAlc && <span class="mb-badge-alc">Alcohol</span>}
                                  {!isAlc && isVeg && <span class="mb-dot mb-dot--veg" title="Vegetarian Mocktail" />}
                                  {item.subCategory && <span class="mb-badge-sub">{item.subCategory}</span>}
                                </div>
                                <div class="mb-dish-price-wrap">
                                  {isSpirit ? (
                                    <div class="mb-spirit-prices">
                                      <span>30ml: {item.price30ml != null ? `₹${item.price30ml}` : '—'}</span>
                                      <span class="mb-price-bullet">·</span>
                                      <span>Btl: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                                    </div>
                                  ) : isWine ? (
                                    <div class="mb-spirit-prices">
                                      <span>Glass: {item.priceGlass != null ? `₹${item.priceGlass}` : '—'}</span>
                                      <span class="mb-price-bullet">·</span>
                                      <span>Btl: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                                    </div>
                                  ) : (
                                    <span class="mb-dish-price">
                                      {item.price != null ? `₹${item.price}` : item.priceBottle != null ? `₹${item.priceBottle}` : '—'}
                                    </span>
                                  )}
                                </div>
                              </div>

                              <h3 class="mb-dish-title mb-dish-title--bar">{item.name}</h3>
                              {item.description && <p class="mb-dish-desc mb-dish-desc--bar">{item.description}</p>}
                            </div>

                            <div class="mb-dish-footer mb-dish-footer--bar">
                              {item.priceBucket != null ? (
                                <span class="mb-bucket-pill">Bucket: ₹{item.priceBucket}</span>
                              ) : (
                                <span></span>
                              )}
                              <button
                                type="button"
                                class="mb-add-pick-btn mb-add-pick-btn--bar fx-add"
                                data-name={item.name}
                                data-price={item.price != null ? item.price : item.priceBottle != null ? item.priceBottle : ''}
                                aria-label={`Add ${item.name} to picks`}
                                aria-pressed="false"
                              >
                                <span class="mb-add-icon">+</span>
                                <span>Pick</span>
                              </button>
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </section>
            ))}

            <p class="mb-empty-alert mb-empty-alert--bar" id="mb-empty-drinks" hidden>
              No drinks match your search or filter.
            </p>
          </div>
        </div>

        <!-- Phone Sticky Category Rail (Bottom thumb zone) -->
        <nav class="mb-cat-rail mb-cat-rail--mobile mb-cat-rail--mobile-bar" aria-label="Mobile drinks category selector">
          <div class="mb-cat-scroll-track" id="track-drinks">
            {drinksSections.map((sec, idx) => (
              <a
                href={`#cat-drinks-${sec.slug}`}
                class={`mb-cat-pill mb-cat-pill--bar${idx === 0 ? ' is-active' : ''}`}
                data-cat-slug={`cat-drinks-${sec.slug}`}
              >
                {sec.title}
              </a>
            ))}
          </div>
        </nav>
      </div>

    </div>

    <!-- ── 4. Desktop Cursor Photo Reveal Floating Card (pointer: fine) ──── -->
    <div class="mb-cursor-reveal" id="mb-cursor-reveal" aria-hidden="true">
      <div class="mb-cursor-card">
        <img id="mb-cursor-img" class="mb-cursor-img" src="" alt="" width="260" height="195" />
        <div class="mb-cursor-info">
          <span class="mb-cursor-title" id="mb-cursor-title"></span>
          <span class="mb-cursor-price" id="mb-cursor-price"></span>
        </div>
      </div>
    </div>

    <!-- ── 5. Phone Dish Details Bottom Sheet ────────────────────────────── -->
    <div class="mb-sheet-backdrop" id="mb-sheet-backdrop" aria-hidden="true">
      <div class="mb-sheet-dialog" id="mb-sheet-dialog" role="dialog" aria-modal="true" aria-labelledby="mb-sheet-title">
        <div class="mb-sheet-handle-wrap" id="mb-sheet-handle">
          <span class="mb-sheet-drag-handle"></span>
        </div>
        <button type="button" class="mb-sheet-close" id="mb-sheet-close" aria-label="Close dish details">✕</button>

        <div class="mb-sheet-body">
          <div class="mb-sheet-img-wrap" id="mb-sheet-img-wrap">
            <img id="mb-sheet-img" class="mb-sheet-img" src="" alt="" width="480" height="320" />
          </div>

          <div class="mb-sheet-meta">
            <span class="mb-sheet-category" id="mb-sheet-cat"></span>
            <div class="mb-sheet-title-row">
              <h2 class="mb-sheet-title" id="mb-sheet-title"></h2>
              <span class="mb-sheet-price" id="mb-sheet-price"></span>
            </div>
            <p class="mb-sheet-desc" id="mb-sheet-desc"></p>

            <div class="mb-sheet-badges" id="mb-sheet-badges"></div>
          </div>

          <div class="mb-sheet-footer">
            <button type="button" class="mb-sheet-pick-btn" id="mb-sheet-pick-btn">
              <span class="mb-add-icon">+</span>
              <span id="mb-sheet-pick-label">Add to Picks</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── 6. Drinks 21+ Age Gate Modal ──────────────────────────────────── -->
    <div class="mb-age-gate-modal" id="mb-age-gate" aria-hidden="true" hidden>
      <div class="mb-age-gate-box">
        <span class="mb-age-gate-icon">🍸</span>
        <h3 class="mb-age-gate-title">Craft Bar &amp; Cellar</h3>
        <p class="mb-age-gate-text">
          Our craft bar showcases artisanal spirits and signature cocktails. Please confirm you are 21 years of age or older to enter.
        </p>
        <div class="mb-age-gate-actions">
          <button type="button" class="mb-age-btn mb-age-btn--yes" id="mb-age-yes">Yes, I am 21+</button>
          <button type="button" class="mb-age-btn mb-age-btn--no" id="mb-age-no">Return to Food Menu</button>
        </div>
      </div>
    </div>

    <!-- ── Picks Tray Component ─────────────────────────────────────────── -->
    <PicksTray />
  </main>

  <SiteFooter />
</Base>

<!-- ── Client Interactivity: Wow Layer, Page Turn, Cursor Reveal, Sheet ──── -->
<script>
  (function () {
    var splitEntry = document.getElementById('mb-split-entry');
    var halfDrinks = document.getElementById('half-drinks');
    var halfFood = document.getElementById('half-food');
    var topBar = document.getElementById('mb-top-bar');
    var bookShell = document.getElementById('mb-book-shell');
    var tabFood = document.getElementById('tab-switch-food');
    var tabDrinks = document.getElementById('tab-switch-drinks');
    var returnSplit = document.getElementById('mb-return-split');

    var paneFood = document.getElementById('pane-food');
    var paneDrinks = document.getElementById('pane-drinks');

    var searchInput = document.getElementById('mb-search-input') as HTMLInputElement | null;
    var searchClear = document.getElementById('mb-search-clear');
    var filterChips = Array.from(document.querySelectorAll('.mb-filter-chip'));

    var cursorReveal = document.getElementById('mb-cursor-reveal');
    var cursorImg = document.getElementById('mb-cursor-img') as HTMLImageElement | null;
    var cursorTitle = document.getElementById('mb-cursor-title');
    var cursorPrice = document.getElementById('mb-cursor-price');

    var sheetBackdrop = document.getElementById('mb-sheet-backdrop');
    var sheetDialog = document.getElementById('mb-sheet-dialog');
    var sheetClose = document.getElementById('mb-sheet-close');
    var sheetHandle = document.getElementById('mb-sheet-handle');
    var sheetImgWrap = document.getElementById('mb-sheet-img-wrap');
    var sheetImg = document.getElementById('mb-sheet-img') as HTMLImageElement | null;
    var sheetTitle = document.getElementById('mb-sheet-title');
    var sheetCat = document.getElementById('mb-sheet-cat');
    var sheetPrice = document.getElementById('mb-sheet-price');
    var sheetDesc = document.getElementById('mb-sheet-desc');
    var sheetBadges = document.getElementById('mb-sheet-badges');
    var sheetPickBtn = document.getElementById('mb-sheet-pick-btn');
    var sheetPickLabel = document.getElementById('mb-sheet-pick-label');

    var ageGate = document.getElementById('mb-age-gate');
    var ageYes = document.getElementById('mb-age-yes');
    var ageNo = document.getElementById('mb-age-no');

    var fxtray = document.getElementById('fxtray');
    var fxtrayText = document.getElementById('fxtray-t');
    var fxtrayGo = document.getElementById('fxtray-go');
    var fxtrayClear = document.getElementById('fxtray-x');

    var currentView: 'split' | 'food' | 'drinks' = 'split';
    var activeDietFilter: 'all' | 'veg' | 'nonveg' | 'spicy' = 'all';
    var currentQuery = '';
    var picks: Array<{ n: string; p: string }> = [];
    var activeSheetDish: { name: string; price: string } | null = null;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isFinePointer = window.matchMedia && window.matchMedia('(pointer: fine)').matches;

    // ── 1. Switch View (View Transition API) ────────────────────────────
    function checkAgeGate(onVerified: () => void) {
      try {
        var isAge21 = localStorage.getItem('fursat_age_gate') === '21';
        if (isAge21) {
          onVerified();
        } else if (ageGate) {
          ageGate.hidden = false;
          ageGate.setAttribute('aria-hidden', 'false');
          ageGate.classList.add('is-open');
        } else {
          onVerified();
        }
      } catch (_) {
        onVerified();
      }
    }

    if (ageYes) {
      ageYes.addEventListener('click', function () {
        try { localStorage.setItem('fursat_age_gate', '21'); } catch (_) {}
        if (ageGate) {
          ageGate.hidden = true;
          ageGate.setAttribute('aria-hidden', 'true');
          ageGate.classList.remove('is-open');
        }
        executeSetView('drinks');
      });
    }

    if (ageNo) {
      ageNo.addEventListener('click', function () {
        if (ageGate) {
          ageGate.hidden = true;
          ageGate.setAttribute('aria-hidden', 'true');
          ageGate.classList.remove('is-open');
        }
        executeSetView('food');
      });
    }

    function setView(view: 'split' | 'food' | 'drinks') {
      if (view === 'drinks') {
        checkAgeGate(function () {
          executeSetView('drinks');
        });
      } else {
        executeSetView(view);
      }
    }

    function executeSetView(view: 'split' | 'food' | 'drinks') {
      if (view === currentView) return;

      function updateDOM() {
        currentView = view;
        if (view === 'split') {
          splitEntry?.classList.remove('is-hidden');
          topBar?.classList.remove('is-visible');
          bookShell?.classList.remove('is-open');
          window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
        } else if (view === 'food') {
          splitEntry?.classList.add('is-hidden');
          topBar?.classList.add('is-visible');
          bookShell?.classList.add('is-open');
          bookShell?.setAttribute('data-active-pane', 'food');

          tabFood?.classList.add('is-active');
          tabFood?.setAttribute('aria-selected', 'true');
          tabDrinks?.classList.remove('is-active');
          tabDrinks?.setAttribute('aria-selected', 'false');

          paneFood?.classList.add('is-active');
          paneDrinks?.classList.remove('is-active');
          document.body.classList.remove('theme-bar-dark');
          applyFilters();
        } else if (view === 'drinks') {
          splitEntry?.classList.add('is-hidden');
          topBar?.classList.add('is-visible');
          bookShell?.classList.add('is-open');
          bookShell?.setAttribute('data-active-pane', 'drinks');

          tabDrinks?.classList.add('is-active');
          tabDrinks?.setAttribute('aria-selected', 'true');
          tabFood?.classList.remove('is-active');
          tabFood?.setAttribute('aria-selected', 'false');

          paneDrinks?.classList.add('is-active');
          paneFood?.classList.remove('is-active');
          document.body.classList.add('theme-bar-dark');
          applyFilters();
        }
      }

      if (document.startViewTransition && !prefersReduced) {
        document.startViewTransition(updateDOM);
      } else {
        updateDOM();
      }
    }

    if (halfFood) halfFood.addEventListener('click', function () { setView('food'); });
    if (halfDrinks) halfDrinks.addEventListener('click', function () { setView('drinks'); });
    if (tabFood) tabFood.addEventListener('click', function () { setView('food'); });
    if (tabDrinks) tabDrinks.addEventListener('click', function () { setView('drinks'); });
    if (returnSplit) returnSplit.addEventListener('click', function () { setView('split'); });

    halfFood?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setView('food'); }
    });
    halfDrinks?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setView('drinks'); }
    });

    // ── 2. Filters & Instant Search ────────────────────────────────────
    function applyFilters() {
      var activePane = currentView === 'drinks' ? paneDrinks : paneFood;
      if (!activePane) return;

      var q = currentQuery.trim().toLowerCase();
      var articles = Array.from(activePane.querySelectorAll('.mb-dish-card'));
      var matchCount = 0;

      articles.forEach(function (el) {
        var card = el as HTMLElement;
        var name = (card.dataset.dishName || '').toLowerCase();
        var desc = (card.dataset.dishDesc || '').toLowerCase();
        var isVeg = card.dataset.veg === 'true';
        var isNonVeg = card.dataset.veg === 'false';
        var isSpicy = card.dataset.spicy === 'true';

        var dietMatch = true;
        if (activeDietFilter === 'veg') dietMatch = isVeg;
        else if (activeDietFilter === 'nonveg') dietMatch = isNonVeg;
        else if (activeDietFilter === 'spicy') dietMatch = isSpicy;

        var queryMatch = !q || name.indexOf(q) !== -1 || desc.indexOf(q) !== -1;

        if (dietMatch && queryMatch) {
          card.style.display = '';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      var sections = Array.from(activePane.querySelectorAll('.mb-category-spread'));
      sections.forEach(function (sec) {
        var visibleCards = sec.querySelectorAll('.mb-dish-card:not([style*="display: none"])');
        (sec as HTMLElement).style.display = visibleCards.length > 0 ? '' : 'none';
      });

      var emptyEl = document.getElementById(currentView === 'drinks' ? 'mb-empty-drinks' : 'mb-empty-food');
      if (emptyEl) {
        emptyEl.hidden = matchCount > 0;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        currentQuery = searchInput.value;
        if (searchClear) searchClear.hidden = !currentQuery;
        applyFilters();
      });
    }

    if (searchClear && searchInput) {
      searchClear.addEventListener('click', function () {
        searchInput.value = '';
        currentQuery = '';
        searchClear.hidden = true;
        searchInput.focus();
        applyFilters();
      });
    }

    filterChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        filterChips.forEach(function (c) {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-pressed', 'true');
        activeDietFilter = (chip.getAttribute('data-filter') as any) || 'all';
        applyFilters();
      });
    });

    // ── 3. Category Rail Scroll-Spy ────────────────────────────────────
    function initScrollSpy() {
      var options = {
        root: null,
        rootMargin: '-15% 0px -70% 0px',
        threshold: 0
      };

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var id = entry.target.id;
            var links = Array.from(document.querySelectorAll(`.mb-cat-link[data-cat-slug="${id}"], .mb-cat-pill[data-cat-slug="${id}"]`));
            if (links.length > 0) {
              var parentPane = entry.target.closest('.mb-pane');
              if (parentPane) {
                parentPane.querySelectorAll('.mb-cat-link.is-active, .mb-cat-pill.is-active').forEach(function (el) {
                  el.classList.remove('is-active');
                });
                links.forEach(function (el) {
                  el.classList.add('is-active');
                  if (el.classList.contains('mb-cat-pill')) {
                    el.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
                  }
                });
              }
            }
          }
        });
      }, options);

      document.querySelectorAll('.mb-category-spread').forEach(function (sec) {
        observer.observe(sec);
      });
    }

    initScrollSpy();

    // ── 4. CSS 3D Page Turn on Book Spread Scroll Reveal ───────────────
    if (!prefersReduced) {
      var spreadObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var turnTarget = entry.target.querySelector('[data-turn-target]');
            if (entry.isIntersecting && turnTarget) {
              turnTarget.classList.add('is-turned');
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );

      document.querySelectorAll('.mb-category-spread').forEach(function (spread) {
        spreadObserver.observe(spread);
      });
    }

    // ── 5. Desktop Cursor Photo Reveal (pointer: fine) ─────────────────
    if (isFinePointer && !prefersReduced && cursorReveal) {
      var targetX = 0;
      var targetY = 0;
      var currentX = 0;
      var currentY = 0;
      var isCursorVisible = false;
      var cursorRaf: number | null = null;

      function renderCursor() {
        if (!isCursorVisible) return;
        currentX += (targetX - currentX) * 0.16;
        currentY += (targetY - currentY) * 0.16;
        if (cursorReveal) {
          cursorReveal.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
        }
        cursorRaf = requestAnimationFrame(renderCursor);
      }

      window.addEventListener('mousemove', function (e) {
        targetX = e.clientX + 22;
        targetY = e.clientY - 90;
      }, { passive: true });

      document.addEventListener('mouseover', function (e) {
        var card = (e.target as HTMLElement)?.closest('.mb-dish-card.has-photo') as HTMLElement | null;
        if (card && cursorReveal && cursorImg && cursorTitle && cursorPrice) {
          var imgUrl = card.dataset.dishImg;
          if (imgUrl) {
            cursorImg.src = imgUrl;
            cursorTitle.textContent = card.dataset.dishName || '';
            cursorPrice.textContent = card.dataset.dishPrice || '';
            cursorReveal.classList.add('is-visible');
            if (!isCursorVisible) {
              isCursorVisible = true;
              currentX = targetX;
              currentY = targetY;
              renderCursor();
            }
          }
        }
      });

      document.addEventListener('mouseout', function (e) {
        var card = (e.target as HTMLElement)?.closest('.mb-dish-card.has-photo');
        if (card && cursorReveal) {
          var related = (e as MouseEvent).relatedTarget as HTMLElement | null;
          if (!card.contains(related)) {
            cursorReveal.classList.remove('is-visible');
            isCursorVisible = false;
            if (cursorRaf) {
              cancelAnimationFrame(cursorRaf);
              cursorRaf = null;
            }
          }
        }
      });
    }

    // ── 6. Phone Dish Bottom Sheet (Touch / Mobile Tap) ────────────────
    function openDishSheet(card: HTMLElement) {
      if (!sheetBackdrop || !sheetDialog) return;
      var name = card.dataset.dishName || '';
      var price = card.dataset.dishPrice || '';
      var rawPrice = card.dataset.dishRawPrice || '';
      var desc = card.dataset.dishDesc || '';
      var cat = card.dataset.dishCat || '';
      var img = card.dataset.dishImg || '';
      var isVeg = card.dataset.veg === 'true';
      var isNonVeg = card.dataset.veg === 'false';
      var isSpicy = card.dataset.spicy === 'true';
      var isChef = card.dataset.chef === 'true';
      var isAlc = card.dataset.alc === 'true';

      activeSheetDish = { name: name, price: rawPrice };

      if (sheetTitle) sheetTitle.textContent = name;
      if (sheetCat) sheetCat.textContent = cat;
      if (sheetPrice) sheetPrice.textContent = price;
      if (sheetDesc) sheetDesc.textContent = desc;

      if (sheetImgWrap && sheetImg) {
        if (img) {
          sheetImg.src = img;
          sheetImg.alt = name;
          sheetImgWrap.style.display = 'block';
        } else {
          sheetImgWrap.style.display = 'none';
        }
      }

      if (sheetBadges) {
        sheetBadges.innerHTML = '';
        if (isVeg) sheetBadges.innerHTML += '<span class="mb-sheet-badge mb-sheet-badge--veg">Veg</span>';
        if (isNonVeg) sheetBadges.innerHTML += '<span class="mb-sheet-badge mb-sheet-badge--nonveg">Non-Veg</span>';
        if (isSpicy) sheetBadges.innerHTML += '<span class="mb-sheet-badge mb-sheet-badge--spicy">🌶️ Spicy</span>';
        if (isChef) sheetBadges.innerHTML += '<span class="mb-sheet-badge mb-sheet-badge--chef">Chef\'s Special</span>';
        if (isAlc) sheetBadges.innerHTML += '<span class="mb-sheet-badge mb-sheet-badge--alc">Alcohol</span>';
      }

      var isAlreadyPicked = picks.some(function (x) { return x.n === name; });
      updateSheetPickButton(isAlreadyPicked);

      sheetBackdrop.classList.add('is-open');
      sheetBackdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDishSheet() {
      if (!sheetBackdrop) return;
      sheetBackdrop.classList.remove('is-open');
      sheetBackdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      activeSheetDish = null;
    }

    function updateSheetPickButton(picked: boolean) {
      if (!sheetPickBtn || !sheetPickLabel) return;
      if (picked) {
        sheetPickBtn.classList.add('is-picked');
        sheetPickLabel.textContent = 'Picked ✓';
      } else {
        sheetPickBtn.classList.remove('is-picked');
        sheetPickLabel.textContent = 'Add to Picks';
      }
    }

    if (sheetClose) sheetClose.addEventListener('click', closeDishSheet);
    if (sheetBackdrop) {
      sheetBackdrop.addEventListener('click', function (e) {
        if (e.target === sheetBackdrop) closeDishSheet();
      });
    }

    // Touch swipe down to close bottom sheet
    var touchStartY = 0;
    sheetHandle?.addEventListener('touchstart', function (e) {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    sheetHandle?.addEventListener('touchmove', function (e) {
      var dy = e.touches[0].clientY - touchStartY;
      if (dy > 65) {
        closeDishSheet();
      }
    }, { passive: true });

    // Open sheet on phone when card body is tapped
    document.addEventListener('click', function (e) {
      var target = e.target as HTMLElement;
      if (target.closest('.fx-add')) return; // Ignore add button
      var card = target.closest('.mb-dish-card') as HTMLElement | null;
      if (card && window.innerWidth <= 768) {
        openDishSheet(card);
      }
    });

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (sheetBackdrop && sheetBackdrop.classList.contains('is-open')) {
          closeDishSheet();
        }
      }
    });

    // ── 7. Picks Tray & WhatsApp Flow ──────────────────────────────────
    var WA = '919059670033';

    function updatePicksUI() {
      if (!fxtray || !fxtrayText) return;
      var count = picks.length;
      fxtray.hidden = count === 0;
      fxtrayText.textContent = count + (count === 1 ? ' pick' : ' picks');

      // Sync all buttons on the page
      document.querySelectorAll('.fx-add').forEach(function (btn) {
        var name = btn.getAttribute('data-name');
        var isPicked = picks.some(function (x) { return x.n === name; });
        btn.setAttribute('aria-pressed', isPicked ? 'true' : 'false');
      });

      if (activeSheetDish) {
        var isSheetPicked = picks.some(function (x) { return x.n === activeSheetDish?.name; });
        updateSheetPickButton(isSheetPicked);
      }
    }

    function togglePick(name: string, price: string) {
      var idx = picks.findIndex(function (x) { return x.n === name; });
      if (idx > -1) {
        picks.splice(idx, 1);
      } else {
        picks.push({ n: name, p: price });
        try {
          if (navigator.vibrate) navigator.vibrate(12);
        } catch (_) {}
      }
      updatePicksUI();
    }

    document.addEventListener('click', function (e) {
      var btn = (e.target as HTMLElement)?.closest('.fx-add') as HTMLElement | null;
      if (!btn) return;
      e.stopPropagation();
      var name = btn.getAttribute('data-name') || '';
      var price = btn.getAttribute('data-price') || '';
      togglePick(name, price);
    });

    if (sheetPickBtn) {
      sheetPickBtn.addEventListener('click', function () {
        if (!activeSheetDish) return;
        togglePick(activeSheetDish.name, activeSheetDish.price);
      });
    }

    if (fxtrayClear) {
      fxtrayClear.addEventListener('click', function () {
        picks = [];
        updatePicksUI();
      });
    }

    if (fxtrayGo) {
      fxtrayGo.addEventListener('click', function () {
        if (picks.length === 0) return;
        var lines = ['Hi Fursat! 👋 I’d love to try:'].concat(
          picks.map(function (x) {
            return '• ' + x.n + (x.p ? ' (₹' + x.p + ')' : '');
          })
        );
        var url = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(lines.join('\n'));
        var a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener';
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }
  })();
</script>

<style is:global>
  /* ==========================================================================
     The Fursat Menu Book Styling Tokens (fk-*)
     Terracotta #CF4B37 | Forest #2E4E21 | Sand #ECDEC8 | Camel #B9946B
     ========================================================================== */

  :root {
    --fk-terracotta: #CF4B37;
    --fk-forest: #2E4E21;
    --fk-sand: #ECDEC8;
    --fk-camel: #B9946B;
    --fk-cream: #F2EEE4;
    --fk-paper: #F8F5EE;
    --fk-ink: #22251D;
    --fk-muted: #646B56;
    --fk-line: #E1DAC7;
    --fk-bar-dark: #0D140B;
    --fk-bar-surface: #141E11;
    --fk-bar-border: rgba(224, 166, 60, 0.28);
    --fk-gold: #E0A63C;
  }

  .mb-main {
    background: var(--fk-cream);
    color: var(--fk-ink);
    min-height: 100vh;
    font-family: 'Poppins', system-ui, sans-serif;
  }

  /* ── 1. Full-Screen Split Entry ─────────────────────────────────────── */
  .mb-split-entry {
    display: flex;
    flex-direction: row;
    min-height: calc(100vh - 72px);
    width: 100%;
    position: relative;
    overflow: hidden;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .mb-split-entry.is-hidden {
    display: none !important;
  }

  .mb-split-half {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    padding: 60px 40px;
    outline: none;
    transition: flex 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mb-split-half:hover {
    flex: 1.15;
  }
  .mb-split-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1.02);
  }
  .mb-split-half:hover .mb-split-bg {
    transform: scale(1.08);
  }

  .mb-split-overlay--drinks {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(13, 20, 11, 0.88) 0%, rgba(13, 20, 11, 0.94) 100%);
  }
  .mb-split-overlay--food {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(207, 75, 55, 0.84) 0%, rgba(46, 78, 33, 0.92) 100%);
  }

  .mb-split-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 480px;
    color: #F4ECDA;
  }
  .mb-split-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--fk-gold);
    display: inline-block;
    margin-bottom: 12px;
  }
  .mb-split-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 14px;
    color: #FFF;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
  }
  .mb-split-sub {
    font-size: 0.9375rem;
    color: rgba(244, 236, 218, 0.88);
    line-height: 1.5;
    margin: 0 0 28px;
  }
  .mb-split-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 30px;
    border-radius: 999px;
    background: #FFF;
    color: var(--fk-ink);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .mb-split-half--drinks .mb-split-btn {
    background: var(--fk-gold);
    color: #12190B;
  }
  .mb-split-half:hover .mb-split-btn {
    transform: translateY(-3px) scale(1.04);
  }

  @media (max-width: 768px) {
    .mb-split-entry {
      flex-direction: column;
      min-height: calc(100vh - 64px);
    }
    .mb-split-half {
      padding: 40px 24px;
    }
  }

  /* ── 2. Floating Top Switcher Bar ───────────────────────────────────── */
  .mb-top-bar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(242, 238, 228, 0.95);
    border-bottom: 1px solid var(--fk-line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 12px 24px 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  .mb-top-bar.is-visible {
    display: block;
  }
  body.theme-bar-dark .mb-top-bar {
    background: rgba(13, 20, 11, 0.96);
    border-bottom: 1px solid var(--fk-bar-border);
  }

  .mb-top-bar-inner {
    max-width: 1360px;
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mb-switch-pill {
    display: inline-flex;
    background: rgba(46, 78, 33, 0.08);
    border: 1px solid var(--fk-line);
    border-radius: 999px;
    padding: 4px;
  }
  body.theme-bar-dark .mb-switch-pill {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(224, 166, 60, 0.3);
  }

  .mb-switch-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    border-radius: 999px;
    border: none;
    background: transparent;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fk-muted);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  body.theme-bar-dark .mb-switch-tab {
    color: rgba(244, 236, 218, 0.7);
  }
  .mb-switch-tab.is-active {
    background: var(--fk-forest);
    color: #FFF;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(46, 78, 33, 0.3);
  }
  body.theme-bar-dark .mb-switch-tab.is-active {
    background: var(--fk-gold);
    color: #12190B;
    box-shadow: 0 4px 14px rgba(224, 166, 60, 0.4);
  }
  .mb-switch-count {
    font-size: 0.75rem;
    opacity: 0.75;
    background: rgba(0, 0, 0, 0.15);
    padding: 2px 7px;
    border-radius: 999px;
  }

  .mb-split-return-btn {
    border: 1px solid var(--fk-line);
    background: transparent;
    color: var(--fk-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .mb-split-return-btn:hover {
    border-color: var(--fk-forest);
    color: var(--fk-forest);
  }
  body.theme-bar-dark .mb-split-return-btn {
    border-color: var(--fk-bar-border);
    color: var(--fk-gold);
  }

  /* Toolbar: Search + Dietary Filters */
  .mb-toolbar {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .mb-search-wrap {
    position: relative;
    flex: 1;
    min-width: 220px;
    max-width: 440px;
  }
  .mb-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--fk-muted);
    pointer-events: none;
  }
  .mb-search-input {
    width: 100%;
    padding: 8px 36px 8px 36px;
    border-radius: 999px;
    border: 1px solid var(--fk-line);
    background: #FFF;
    font-size: 0.875rem;
    color: var(--fk-ink);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .mb-search-input:focus {
    border-color: var(--fk-forest);
    box-shadow: 0 0 0 3px rgba(46, 78, 33, 0.12);
  }
  body.theme-bar-dark .mb-search-input {
    background: var(--fk-bar-surface);
    border-color: var(--fk-bar-border);
    color: #F4ECDA;
  }
  body.theme-bar-dark .mb-search-input:focus {
    border-color: var(--fk-gold);
    box-shadow: 0 0 0 3px rgba(224, 166, 60, 0.2);
  }
  .mb-search-clear {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--fk-muted);
    cursor: pointer;
    font-size: 13px;
  }

  .mb-filter-chips {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mb-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--fk-line);
    background: #FFF;
    color: var(--fk-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .mb-filter-chip:hover {
    border-color: var(--fk-forest);
    color: var(--fk-forest);
  }
  .mb-filter-chip.is-active {
    background: var(--fk-terracotta);
    border-color: var(--fk-terracotta);
    color: #FFF;
    font-weight: 700;
  }
  body.theme-bar-dark .mb-filter-chip {
    background: var(--fk-bar-surface);
    border-color: var(--fk-bar-border);
    color: rgba(244, 236, 218, 0.8);
  }
  body.theme-bar-dark .mb-filter-chip.is-active {
    background: var(--fk-gold);
    border-color: var(--fk-gold);
    color: #12190B;
  }

  /* ── 3. Menu Book Shell & Category Rails ────────────────────────────── */
  .mb-book-shell {
    display: none;
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px clamp(16px, 4vw, 40px) 80px;
  }
  .mb-book-shell.is-open {
    display: block;
  }

  .mb-pane {
    display: none;
  }
  .mb-pane.is-active {
    display: block;
  }

  .mb-pane-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .mb-pane-layout {
      grid-template-columns: 1fr;
    }
    .mb-cat-rail--desktop {
      display: none !important;
    }
  }

  /* Desktop Sticky Rail (Left Column) */
  .mb-cat-rail--desktop {
    position: sticky;
    top: 130px;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
    padding-right: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--fk-camel) transparent;
  }
  .mb-cat-rail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom: 1.5px solid var(--fk-line);
  }
  .mb-cat-rail-title {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--fk-forest);
  }
  .mb-cat-rail--bar .mb-cat-rail-title {
    color: var(--fk-gold);
  }
  .mb-cat-rail-counter {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--fk-muted);
  }

  .mb-cat-rail-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mb-cat-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--fk-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .mb-cat-link:hover {
    background: rgba(46, 78, 33, 0.06);
    color: var(--fk-forest);
  }
  .mb-cat-link.is-active {
    background: var(--fk-forest);
    color: #FFF;
    font-weight: 700;
  }
  .mb-cat-rail--bar .mb-cat-link:hover {
    background: rgba(224, 166, 60, 0.1);
    color: var(--fk-gold);
  }
  .mb-cat-rail--bar .mb-cat-link.is-active {
    background: var(--fk-gold);
    color: #12190B;
  }
  .mb-cat-count {
    font-size: 0.75rem;
    opacity: 0.75;
  }

  /* Phone Sticky Category Rail (Bottom Thumb-Zone) */
  .mb-cat-rail--mobile {
    display: none;
  }
  @media (max-width: 900px) {
    .mb-cat-rail--mobile {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 45;
      background: rgba(242, 238, 228, 0.96);
      border-top: 1.5px solid var(--fk-line);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 10px 12px;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }
    .mb-cat-rail--mobile-bar {
      background: rgba(13, 20, 11, 0.98);
      border-top-color: var(--fk-bar-border);
    }
    .mb-cat-scroll-track {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
    }
    .mb-cat-scroll-track::-webkit-scrollbar {
      display: none;
    }
    .mb-cat-pill {
      flex: 0 0 auto;
      padding: 6px 14px;
      border-radius: 999px;
      background: #FFF;
      border: 1px solid var(--fk-line);
      color: var(--fk-muted);
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .mb-cat-pill.is-active {
      background: var(--fk-forest);
      border-color: var(--fk-forest);
      color: #FFF;
      font-weight: 700;
    }
    .mb-cat-pill--bar {
      background: var(--fk-bar-surface);
      border-color: var(--fk-bar-border);
      color: rgba(244, 236, 218, 0.8);
    }
    .mb-cat-pill--bar.is-active {
      background: var(--fk-gold);
      border-color: var(--fk-gold);
      color: #12190B;
    }
  }

  /* ── 4. CSS 3D Book Spread & Category Headers ───────────────────────── */
  .mb-book-content {
    min-width: 0;
  }
  .mb-book-header {
    margin-bottom: 36px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--fk-line);
  }
  .mb-book-headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    color: var(--fk-forest);
    margin: 0 0 8px;
    line-height: 1.15;
  }
  .mb-book-lead {
    font-size: 1rem;
    color: var(--fk-muted);
    margin: 0;
    line-height: 1.5;
  }
  .mb-book-content--bar .mb-book-headline {
    color: var(--fk-gold);
  }
  .mb-book-content--bar .mb-book-lead {
    color: rgba(244, 236, 218, 0.8);
  }
  .mb-bar-gate-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fk-gold);
    display: inline-block;
    margin-bottom: 6px;
  }

  /* Book Spread Layout */
  .mb-category-spread {
    margin-bottom: 56px;
    scroll-margin-top: 140px;
    perspective: 1200px;
  }
  .mb-spread-book-turn {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    background: #FAF8F2;
    border: 1px solid var(--fk-line);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }
  .mb-spread-book-turn.is-turned {
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
  }
  body.theme-bar-dark .mb-spread-book-turn {
    background: #111A0E;
    border-color: var(--fk-bar-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 1024px) {
    .mb-spread-book-turn {
      grid-template-columns: 1fr;
      padding: 18px;
    }
    .mb-spread-page--left {
      display: none !important;
    }
  }

  /* Left Page: Photo Leaf */
  .mb-spread-page--left {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: var(--fk-sand);
    display: flex;
    flex-direction: column;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--fk-line);
  }
  .mb-spread-page--bar-left {
    background: #090E07;
    border-color: var(--fk-bar-border);
  }
  .mb-spread-photo-wrap {
    height: 100%;
    min-height: 280px;
    position: relative;
    overflow: hidden;
  }
  .mb-spread-lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.92);
  }
  .mb-spread-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 16px 14px;
    background: linear-gradient(to top, rgba(34, 37, 29, 0.9) 0%, transparent 100%);
    color: #FFF;
  }
  .mb-spread-leaf-badge {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fk-gold);
    display: block;
    margin-bottom: 2px;
  }
  .mb-spread-quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 0.9375rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
  }

  /* Right Page: Category Info & Dish Grid */
  .mb-spread-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--fk-forest);
  }
  .mb-spread-header--bar {
    border-bottom-color: var(--fk-gold);
  }
  .mb-spread-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fk-terracotta);
    display: block;
    margin-bottom: 2px;
  }
  .mb-spread-kicker--bar {
    color: var(--fk-gold);
  }
  .mb-spread-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 700;
    color: var(--fk-ink);
    margin: 0;
  }
  body.theme-bar-dark .mb-spread-title {
    color: #F4ECDA;
  }
  .mb-spread-count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fk-muted);
  }

  /* Dishes Grid */
  .mb-dishes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  /* Dish Card */
  .mb-dish-card {
    background: #FFF;
    border: 1px solid var(--fk-line);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: default;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .mb-dish-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    border-color: var(--fk-camel);
  }
  .mb-dish-card.has-photo {
    cursor: pointer;
  }

  body.theme-bar-dark .mb-dish-card--bar {
    background: var(--fk-bar-surface);
    border-color: var(--fk-bar-border);
    color: #F4ECDA;
  }
  body.theme-bar-dark .mb-dish-card--bar:hover {
    border-color: var(--fk-gold);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .mb-dish-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 10px;
  }
  .mb-dish-badges {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mb-dot {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1.5px solid;
    display: inline-grid;
    place-items: center;
  }
  .mb-dot::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .mb-dot--veg {
    border-color: #2E7D32;
  }
  .mb-dot--veg::after {
    background: #2E7D32;
  }
  .mb-dot--nonveg {
    border-color: #C62828;
  }
  .mb-dot--nonveg::after {
    background: #C62828;
  }
  .mb-badge-spicy {
    font-size: 13px;
  }
  .mb-badge-chef {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(207, 75, 55, 0.12);
    color: var(--fk-terracotta);
  }
  .mb-badge-alc {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(224, 166, 60, 0.15);
    color: var(--fk-gold);
  }
  .mb-badge-sub {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(244, 236, 218, 0.7);
  }

  .mb-dish-price {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--fk-ink);
    white-space: nowrap;
  }
  body.theme-bar-dark .mb-dish-price {
    color: var(--fk-gold);
  }
  .mb-spirit-prices {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fk-gold);
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }
  .mb-price-bullet {
    opacity: 0.6;
  }

  .mb-dish-title {
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--fk-ink);
    line-height: 1.3;
  }
  .mb-dish-title--bar {
    color: #F4ECDA;
  }

  .mb-dish-desc {
    font-size: 0.8125rem;
    color: var(--fk-muted);
    margin: 0 0 12px;
    line-height: 1.45;
