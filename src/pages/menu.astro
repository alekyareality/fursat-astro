---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
import foodData from '../data/food.json';
import drinksData from '../data/drinks.json';

// ── Build-time data processing ──────────────────────────────────────────────
type MenuItem = {
  name: string;
  section: string;
  description?: string;
  price: number | null;
  veg?: boolean;
  spicy?: boolean;
  chefSpecial?: boolean;
  image?: string;
  alc?: boolean;
  price30ml?: number;
  priceBottle?: number;
  priceGlass?: number | null;
  priceBucket?: number;
  price500ml?: number;
  price330ml?: number;
  pricePitcher?: number;
  priceTower?: number;
  subCategory?: string;
  note?: string;
  kind: 'food' | 'drink';
};

type MenuSection = {
  section: string;
  items: MenuItem[];
};

const foodItems: MenuItem[] = (foodData as MenuSection[]).flatMap((sec) =>
  sec.items.map((it) => ({ ...it, kind: 'food' as const }))
);

const drinksItems: MenuItem[] = (drinksData as MenuSection[]).flatMap((sec) =>
  sec.items.map((it) => ({ ...it, kind: 'drink' as const }))
);

const allItems = [...foodItems, ...drinksItems];

const foodCategories = [
  'All',
  ...Array.from(new Set(foodItems.map((it) => it.section))),
];

const drinksCategories = [
  'All',
  ...Array.from(new Set(drinksItems.map((it) => it.section))),
];

// Slug helper for data-cat attributes and tab IDs (safe for HTML attrs)
function slug(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<Base
  title="Full Menu — Fursat Kitchen | Bar | Madhapur, Hyderabad"
  description="Explore our full menu: signature dishes, cocktails, mocktails, bites and desserts. 150+ items across Indian kitchen & craft bar. Order online or dine in."
  canonical="https://fursatind.in/menu/"
  ogImage="https://fursatind.in/assets/fursat_space_07.webp"
  ogImageAlt="Fursat menu — signature dishes and cocktails"
>
  <SiteHeader active="menu" />

  <main class="mn-main" id="main">

    <!-- ── Hero Header ─────────────────────────────────────────────────── -->
    <header class="mn-hero">
      <div class="mn-hero-inner">
        <p class="mn-hero-eyebrow">Fursat Kitchen | Bar · Madhapur, Hyderabad</p>
        <h1 class="mn-hero-title mot-headline">Our Menu</h1>
        <p class="mn-hero-sub">Café · Bar · Kitchen · Banquet — {allItems.length} dishes &amp; drinks</p>
      </div>
    </header>

    <!-- ── Food / Drinks Proportion Switch Bar ────────────────────────── -->
    <nav class="mn-switch-wrap" aria-label="Menu proportion switch">
      <div class="mn-switch-toggle" role="group" aria-label="Menu split toggle">
        <button
          class="mn-switch-btn mn-switch-btn--active"
          id="btn-food-view"
          data-view="food"
          type="button"
          aria-pressed="true"
        >
          <span class="mn-switch-icon">🍲</span>
          <span class="mn-switch-text">Food Menu</span>
          <span class="mn-switch-prop" id="food-prop-label">3/4 Screen</span>
        </button>
        <button
          class="mn-switch-btn"
          id="btn-drinks-view"
          data-view="drinks"
          type="button"
          aria-pressed="false"
        >
          <span class="mn-switch-icon">🍸</span>
          <span class="mn-switch-text">Drinks Menu</span>
          <span class="mn-switch-prop" id="drinks-prop-label">1/4 Screen</span>
        </button>
      </div>
    </nav>

    <!-- ── Split Menu Container (Food 3/4 & Drinks 1/4 by default) ──────── -->
    <div class="mn-split-container" id="mn-split-container" data-active="food">
      
      <!-- ── FOOD PANE ────────────────────────────────────────────────── -->
      <section class="mn-pane mn-pane--food" id="pane-food" aria-label="Food menu section">
        <div class="mn-pane-header">
          <div class="mn-pane-title-wrap">
            <h2 class="mn-pane-title">🍲 Food Menu</h2>
            <span class="mn-pane-count">{foodItems.length} dishes</span>
          </div>
          <span class="mn-pane-expand-hint" id="food-expand-hint">Click to expand (3/4) ↗</span>
        </div>

        <!-- ── Dish Showcase (MENU 7) ──────────────────────────────────── -->
        <div class="mn-dish-showcase" id="mn-dish-showcase" aria-label="Featured dish showcase">
          <!-- Data blob — read by dish-showcase script -->
          <script id="dish-showcase-data" type="application/json" set:html={JSON.stringify(
            foodItems
              .filter((it) => it.image)
              .map((it) => ({
                img: it.image,
                name: it.name,
                desc: it.description ?? '',
                price: it.price,
                section: it.section,
                veg: it.veg ?? false,
              }))
          )}></script>

          <div class="mn-ds-photo-wrap">
            <img id="mn-ds-img" class="mn-ds-img" src="" alt="" width="320" height="240" loading="lazy" />
            <div class="mn-ds-veg-dot" id="mn-ds-veg-dot" aria-hidden="true"></div>
          </div>

          <div class="mn-ds-info">
            <div class="mn-ds-topbar">
              <span class="mn-ds-section" id="mn-ds-section"></span>
              <select id="mn-ds-select" class="mn-ds-select" aria-label="Select dish">
                {foodItems
                  .filter((it) => it.image)
                  .map((it, idx) => (
                    <option value={idx}>{it.name}{it.price ? ` — ₹${it.price}` : ''}</option>
                  ))}
              </select>
            </div>
            <h3 class="mn-ds-name" id="mn-ds-name"></h3>
            <p class="mn-ds-desc" id="mn-ds-desc"></p>
            <span class="mn-ds-price" id="mn-ds-price"></span>
          </div>

          <div class="mn-ds-controls">
            <button class="mn-ds-btn" id="mn-ds-prev" type="button" aria-label="Previous dish">‹</button>
            <span class="mn-ds-counter" id="mn-ds-counter">1 / 1</span>
            <button class="mn-ds-btn" id="mn-ds-next" type="button" aria-label="Next dish">›</button>
          </div>
        </div>

        <!-- Sticky Food Category Tabs -->
        <nav class="mn-tabs-wrap mn-tabs-wrap--food" aria-label="Food categories">
          <div class="mn-tabs mn-tabs--food mot-tab-indicator" role="tablist">
            {foodCategories.map((cat, i) => (
              <button
                class={`mn-tab${i === 0 ? ' mn-tab--active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-cat={slug(cat)}
                type="button"
              >
                {cat}
              </button>
            ))}
          </div>
        </nav>

        <!-- Food Grid -->
        <div class="mn-grid mn-grid--food" id="mn-grid-food">
          {foodItems.map((item) => {
            const cat = item.section;
            const catSlug = slug(cat);
            const isVeg = item.veg === true;
            const isNonVeg = item.veg === false;
            const isChef = item.chefSpecial === true;
            const isSpicy = item.spicy === true;
            const hasImg = !!item.image;
            return (
              <article
                class="mn-card mot-card-lit"
                data-cat={catSlug}
                data-kind="food"
                aria-label={item.name}
              >
                {hasImg && (
                  <div class="mn-card-img-wrap">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="mn-card-img"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="220"
                    />
                  </div>
                )}
                <div class="mn-card-body">
                  <div class="mn-card-top">
                    <span class="mn-cat-badge">{cat}</span>
                    <div class="mn-badges">
                      {isVeg && <span class="mn-dot mn-dot--veg" title="Vegetarian" aria-label="Vegetarian" />}
                      {isNonVeg && <span class="mn-dot mn-dot--nonveg" title="Non-vegetarian" aria-label="Non-vegetarian" />}
                      {isChef && <span class="mn-badge-pill mn-badge-pill--opt" title="Chef's Special">Chef's Spl</span>}
                      {isSpicy && <span class="mn-spicy" title="Spicy" aria-label="Spicy">🌶</span>}
                    </div>
                  </div>
                  <h3 class="mn-dish-name">{item.name}</h3>
                  {item.description && <p class="mn-dish-desc">{item.description}</p>}
                  <div class="mn-card-footer">
                    <span class="mn-price">
                      {item.price != null ? `₹${item.price}` : '—'}
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <p class="mn-empty" id="mn-empty-food" hidden>No dishes found in this category.</p>
      </section>

      <!-- ── DRINKS PANE ──────────────────────────────────────────────── -->
      <section class="mn-pane mn-pane--drinks" id="pane-drinks" aria-label="Drinks menu section">
        
        <!-- ── Fursat Bar Counter Scene (TASK E) ───────────────────────── -->
        <div class="mn-bar-scene" id="mn-bar-scene" aria-label="Fursat Bar Counter Scene">
          <!-- Layer 1: Bar Back (full photo with bar shelves & ceiling reflection) -->
          <div class="mn-bar-layer mn-bar-layer--back" id="mn-bar-back" aria-hidden="true">
            <img
              src="/assets/interior/bar-back.webp"
              alt=""
              class="mn-bar-img mn-bar-img--back"
              width="1200"
              height="1600"
              loading="eager"
            />
          </div>

          <!-- Layer 2: Glowing round logo + CSS radial glow + Neon FURSAT wordmark -->
          <div class="mn-bar-layer mn-bar-layer--logo" id="mn-bar-logo" aria-hidden="true">
            <div class="mn-bar-logo-unit">
              <div class="mn-bar-logo-glow" aria-hidden="true"></div>
              <img
                src="/assets/interior/bar-logo.webp"
                alt="Fursat Bar Logo"
                class="mn-bar-logo-img"
                width="130"
                height="165"
                loading="eager"
              />
              <span class="mn-bar-neon-text">FURSAT</span>
            </div>
          </div>

          <!-- Optional 3D Hook: Lazy-loaded Three.js canvas if fursat-bar.glb exists -->
          <div class="mn-bar-3d-hook" id="mn-bar-3d-hook" aria-hidden="true"></div>

          <!-- Layer 3: Foreground bar counter strip cropped from same photo, same scale -->
          <div class="mn-bar-layer mn-bar-layer--front" id="mn-bar-front" aria-hidden="true">
            <img
              src="/assets/interior/bar-front.webp"
              alt=""
              class="mn-bar-img mn-bar-img--front"
              width="1200"
              height="420"
              loading="eager"
            />
          </div>

          <!-- Dark gradient overlay for text contrast -->
          <div class="mn-bar-overlay" aria-hidden="true"></div>

          <!-- Bar Scene Header Content -->
          <div class="mn-bar-header">
            <div class="mn-pane-title-wrap">
              <span class="mn-bar-badge">🍸 Fursat Bar Counter</span>
              <h2 class="mn-pane-title mn-bar-title">Craft Bar &amp; Cellar</h2>
              <span class="mn-pane-count">{drinksItems.length} drinks · Cocktails, Spirits &amp; Brews</span>
            </div>
            <span class="mn-pane-expand-hint" id="drinks-expand-hint">Click to expand (3/4) ↗</span>
          </div>

          <!-- Category tabs sit on the counter top -->
          <nav class="mn-tabs-wrap mn-tabs-wrap--drinks mn-bar-tabs-wrap" aria-label="Drinks categories">
            <div class="mn-tabs mn-tabs--drinks mot-tab-indicator" role="tablist">
              {drinksCategories.map((cat, i) => (
                <button
                  class={`mn-tab${i === 0 ? ' mn-tab--active' : ''}`}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  data-cat={slug(cat)}
                  type="button"
                >
                  {cat}
                </button>
              ))}
            </div>
          </nav>
        </div>

        <!-- Drinks Grid -->
        <div class="mn-grid mn-grid--drinks" id="mn-grid-drinks">
          {drinksItems.map((item) => {
            const cat = item.section;
            const catSlug = slug(cat);
            const isAlc = item.alc === true;
            const isChef = item.chefSpecial === true;
            const isVeg = item.veg === true;
            const hasImg = !!item.image;
            const isSpirit = item.price30ml != null || (item.priceBottle != null && cat !== 'Wines' && cat !== 'Beer');
            const isWine = cat === 'Wines' || item.priceGlass != null;
            return (
              <article
                class="mn-card mot-card-lit"
                data-cat={catSlug}
                data-kind="drink"
                aria-label={item.name}
              >
                {hasImg && (
                  <div class="mn-card-img-wrap">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="mn-card-img"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="220"
                    />
                  </div>
                )}
                <div class="mn-card-body">
                  <div class="mn-card-top">
                    <span class="mn-cat-badge">{cat}</span>
                    <div class="mn-badges">
                      {isAlc && <span class="mn-badge-pill mn-badge-pill--alc">Alcohol</span>}
                      {isChef && <span class="mn-badge-pill mn-badge-pill--opt" title="Chef's Special">Chef's Spl</span>}
                      {!isAlc && isVeg && <span class="mn-dot mn-dot--veg" title="Vegetarian" aria-label="Vegetarian" />}
                    </div>
                  </div>
                  <h3 class="mn-dish-name">{item.name}</h3>
                  {item.description && <p class="mn-dish-desc">{item.description}</p>}
                  <div class="mn-card-footer">
                    {isSpirit ? (
                      <div class="mn-price-portions">
                        <span class="mn-price-tag">30 ml: {item.price30ml != null ? `₹${item.price30ml}` : '—'}</span>
                        <span class="mn-price-sep">·</span>
                        <span class="mn-price-tag">Bottle: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                      </div>
                    ) : isWine ? (
                      <div class="mn-price-portions">
                        <span class="mn-price-tag">Glass: {item.priceGlass != null ? `₹${item.priceGlass}` : '—'}</span>
                        <span class="mn-price-sep">·</span>
                        <span class="mn-price-tag">Bottle: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                      </div>
                    ) : (
                      <span class="mn-price">
                        {item.price != null ? `₹${item.price}` : (item.priceBottle != null ? `₹${item.priceBottle} (Btl)` : '—')}
                      </span>
                    )}
                    {item.priceBucket != null && (
                      <span class="mn-flex-note">Bucket: ₹{item.priceBucket}</span>
                    )}
                    {item.subCategory && (
                      <span class="mn-flex-note">{item.subCategory}</span>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <p class="mn-empty" id="mn-empty-drinks" hidden>No drinks found in this category.</p>
      </section>

    </div>

    <!-- ── CTA Banner ────────────────────────────────────────────────────── -->
    <section class="mn-cta-wrap" aria-label="Reservation offer">
      <div class="mn-cta">
        <p class="mn-cta-label">Ready to dine?</p>
        <h2 class="mn-cta-heading">Reserve Your Table &amp; Get <span class="mn-cta-gold">15% OFF</span></h2>
        <p class="mn-cta-sub">Call us or walk in. Available for parties, banquets &amp; café seating.</p>
        <a
          href="tel:+918008009966"
          class="mn-cta-btn"
          aria-label="Call to reserve and get 15% off"
        >
          📞 Reserve &amp; Save 15%
        </a>
      </div>
    </section>

  </main>

  <MascotOfferModal />
  <SiteFooter />
<MobileBar active="menu" />
<script is:inline src="/js/motion-kit.js"></script>
</Base>

<!-- ── Split menu interaction script ─────────────────────────────────────── -->
<script is:inline>
(function () {
  // ── View state: 'food' (food=3/4, drinks=1/4) or 'drinks' (drinks=3/4, food=1/4)
  var container = document.getElementById('mn-split-container');
  var paneFood = document.getElementById('pane-food');
  var paneDrinks = document.getElementById('pane-drinks');
  var btnFood = document.getElementById('btn-food-view');
  var btnDrinks = document.getElementById('btn-drinks-view');
  var foodPropLabel = document.getElementById('food-prop-label');
  var drinksPropLabel = document.getElementById('drinks-prop-label');
  var foodExpandHint = document.getElementById('food-expand-hint');
  var drinksExpandHint = document.getElementById('drinks-expand-hint');

  function setView(view) {
    container.dataset.active = view;
    var isFoodBig = view === 'food';
    btnFood.classList.toggle('mn-switch-btn--active', isFoodBig);
    btnFood.setAttribute('aria-pressed', isFoodBig ? 'true' : 'false');
    btnDrinks.classList.toggle('mn-switch-btn--active', !isFoodBig);
    btnDrinks.setAttribute('aria-pressed', !isFoodBig ? 'true' : 'false');
    if (foodPropLabel) foodPropLabel.textContent = isFoodBig ? '3/4 Screen' : '1/4 Screen';
    if (drinksPropLabel) drinksPropLabel.textContent = isFoodBig ? '1/4 Screen' : '3/4 Screen';
    if (foodExpandHint) foodExpandHint.style.display = isFoodBig ? 'none' : 'inline';
    if (drinksExpandHint) drinksExpandHint.style.display = isFoodBig ? 'inline' : 'none';
  }

  if (btnFood) btnFood.addEventListener('click', function () { setView('food'); });
  if (btnDrinks) btnDrinks.addEventListener('click', function () { setView('drinks'); });

  // Click on the smaller pane header expands it
  if (paneFood) paneFood.querySelector('.mn-pane-header').addEventListener('click', function (e) {
    if (container.dataset.active !== 'food') setView('food');
  });
  if (paneDrinks) paneDrinks.querySelector('.mn-pane-header').addEventListener('click', function (e) {
    if (container.dataset.active !== 'drinks') setView('drinks');
  });

  // ── Per-pane tab filtering ──────────────────────────────────────────────
  function bindPaneTabs(tabsSelector, gridId, emptyId) {
    var paneTabs = document.querySelectorAll(tabsSelector);
    var paneCards = document.getElementById(gridId) ? document.getElementById(gridId).querySelectorAll('.mn-card') : [];
    var paneEmpty = document.getElementById(emptyId);

    function activate(catSlug) {
      paneTabs.forEach(function (t) {
        var active = t.dataset.cat === catSlug;
        t.classList.toggle('mn-tab--active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      var visible = 0;
      paneCards.forEach(function (card) {
        var show = catSlug === 'all' || card.dataset.cat === catSlug;
        card.hidden = !show;
        if (show) visible++;
      });
      if (paneEmpty) paneEmpty.hidden = visible > 0;
      var activeTab = document.querySelector(tabsSelector + '.mn-tab--active');
      if (activeTab) activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    paneTabs.forEach(function (tab) {
      tab.addEventListener('click', function () { activate(tab.dataset.cat); });
    });
  }

  bindPaneTabs('.mn-tabs--food .mn-tab', 'mn-grid-food', 'mn-empty-food');
  bindPaneTabs('.mn-tabs--drinks .mn-tab', 'mn-grid-drinks', 'mn-empty-drinks');

  // Initial state: food is bigger
  setView('food');

  // ── MENU 7: Floating dish photos + select option ────────────────────────
  (function () {
    var dataEl = document.getElementById('dish-showcase-data');
    if (!dataEl) return;
    var dishes;
    try { dishes = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }
    if (!dishes.length) return;

    var idx = 0;
    var imgEl    = document.getElementById('mn-ds-img');
    var vegDot   = document.getElementById('mn-ds-veg-dot');
    var secEl    = document.getElementById('mn-ds-section');
    var nameEl   = document.getElementById('mn-ds-name');
    var descEl   = document.getElementById('mn-ds-desc');
    var priceEl  = document.getElementById('mn-ds-price');
    var ctrEl    = document.getElementById('mn-ds-counter');
    var prevBtn  = document.getElementById('mn-ds-prev');
    var nextBtn  = document.getElementById('mn-ds-next');
    var selectEl = document.getElementById('mn-ds-select');

    function fmt(p) {
      if (p === null || p === undefined) return '';
      var s = String(Math.round(Math.abs(p)));
      var last3 = s.slice(-3), rest = s.slice(0, -3);
      var g = rest ? rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + ',' + last3 : last3;
      return '\u20B9' + g;
    }

    function show(i) {
      var d = dishes[i];
      if (!d) return;
      idx = i;
      imgEl.src = d.img;
      imgEl.alt = d.name;
      vegDot.style.background = d.veg ? '#22c55e' : '#ef4444';
      vegDot.title = d.veg ? 'Veg' : 'Non-Veg';
      secEl.textContent = d.section;
      nameEl.textContent = d.name;
      descEl.textContent = d.desc || '';
      priceEl.textContent = d.price != null ? fmt(d.price) : '—';
      ctrEl.textContent = (i + 1) + ' / ' + dishes.length;
      if (selectEl && selectEl.value != String(i)) {
        selectEl.value = String(i);
      }
    }

    prevBtn && prevBtn.addEventListener('click', function () {
      show((idx - 1 + dishes.length) % dishes.length);
    });
    nextBtn && nextBtn.addEventListener('click', function () {
      show((idx + 1) % dishes.length);
    });
    selectEl && selectEl.addEventListener('change', function () {
      var val = parseInt(selectEl.value, 10);
      if (!isNaN(val)) show(val);
    });

    // Auto-advance every 4.5 seconds when showcase is in viewport
    var autoTimer = null;
    var showcase = document.getElementById('mn-dish-showcase');
    if (showcase && 'IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          if (!autoTimer) {
            autoTimer = setInterval(function () {
              show((idx + 1) % dishes.length);
            }, 4500);
          }
        } else {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }, { threshold: 0.25 });
      obs.observe(showcase);
    }

    show(0);
  })();

  // ── TASK E: Bar Counter Parallax & 3D Hook ───────────────────────────────
  (function () {
    var scene = document.getElementById('mn-bar-scene');
    if (!scene) return;

    var isReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var back = document.getElementById('mn-bar-back');
    var logo = document.getElementById('mn-bar-logo');
    var front = document.getElementById('mn-bar-front');

    if (!isReduced && back && logo && front) {
      var targetX = 0, targetY = 0;
      var curX = 0, curY = 0;
      var running = false;

      function renderParallax() {
        if (!running) return;
        curX += (targetX - curX) * 0.08;
        curY += (targetY - curY) * 0.08;

        // Smooth, transform-only, different speeds
        back.style.transform = 'translate3d(' + (-curX * 10).toFixed(2) + 'px, ' + (-curY * 8).toFixed(2) + 'px, 0)';
        logo.style.transform = 'translate3d(calc(-50% + ' + (curX * 14).toFixed(2) + 'px), ' + (curY * 10).toFixed(2) + 'px, 0)';
        front.style.transform = 'translate3d(' + (curX * 24).toFixed(2) + 'px, ' + (curY * 12).toFixed(2) + 'px, 0)';

        requestAnimationFrame(renderParallax);
      }

      // Pointermove handler on scene
      scene.addEventListener('pointermove', function (e) {
        var rect = scene.getBoundingClientRect();
        var nx = (e.clientX - rect.left) / rect.width - 0.5;
        var ny = (e.clientY - rect.top) / rect.height - 0.5;
        targetX = Math.max(-0.5, Math.min(0.5, nx));
        targetY = Math.max(-0.5, Math.min(0.5, ny));
        if (!running) {
          running = true;
          requestAnimationFrame(renderParallax);
        }
      });

      scene.addEventListener('pointerleave', function () {
        targetX = 0;
        targetY = 0;
      });

      // Device orientation handler for mobile
      if (window.DeviceOrientationEvent) {
        window.addEventListener('deviceorientation', function (e) {
          if (e.gamma == null || e.beta == null) return;
          var gx = Math.max(-30, Math.min(30, e.gamma)) / 60;
          var gy = Math.max(15, Math.min(65, e.beta) - 40) / 50;
          targetX = gx;
          targetY = gy;
          if (!running) {
            running = true;
            requestAnimationFrame(renderParallax);
          }
        }, { passive: true });
      }
    }

    // ── Optional Hook: fursat-bar.glb ─────────────────────────────────────
    // If public/models/fursat-bar.glb exists, lazy-load with GLTFLoader on Drinks panel only
    fetch('/models/fursat-bar.glb', { method: 'HEAD' })
      .then(function (res) {
        if (res.ok && res.status === 200) {
          import('three').then(function (THREE) {
            import('three/examples/jsm/loaders/GLTFLoader.js').then(function (gltfMod) {
              var hook = document.getElementById('mn-bar-3d-hook');
              if (!hook) return;
              hook.style.display = 'block';
              var scene3d = new THREE.Scene();
              var camera = new THREE.PerspectiveCamera(40, hook.clientWidth / hook.clientHeight, 0.1, 100);
              camera.position.set(0, 1.2, 3.2);
              var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
              renderer.setSize(hook.clientWidth, hook.clientHeight);
              renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
              hook.appendChild(renderer.domElement);

              var amb = new THREE.AmbientLight(0xffffff, 1.2);
              scene3d.add(amb);
              var dir = new THREE.DirectionalLight(0xe0a63c, 2.2);
              dir.position.set(2, 4, 2);
              scene3d.add(dir);

              var loader = new gltfMod.GLTFLoader();
              loader.load('/models/fursat-bar.glb', function (gltf) {
                scene3d.add(gltf.scene);
                var clock = new THREE.Clock();
                function animate3d() {
                  requestAnimationFrame(animate3d);
                  var t = clock.getElapsedTime();
                  gltf.scene.rotation.y = Math.sin(t * 0.35) * 0.18; // limited orbit
                  renderer.render(scene3d, camera);
                }
                animate3d();
              });
            }).catch(function () {});
          }).catch(function () {});
        }
      })
      .catch(function () {});
  })();
})();
</script>

