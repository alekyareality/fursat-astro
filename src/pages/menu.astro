---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PicksTray from '../components/PicksTray.astro';
import foodData from '../data/food.json';
import drinksData from '../data/drinks.json';

// ── Types ────────────────────────────────────────────────────────────────────
type MenuItem = {
  name: string;
  section: string;
  description?: string;
  price: number | null;
  veg?: boolean;
  spicy?: boolean;
  chefSpecial?: boolean;
  image?: string;
  alc?: boolean;
  price30ml?: number;
  priceBottle?: number;
  priceGlass?: number | null;
  priceBucket?: number;
  price500ml?: number;
  price330ml?: number;
  pricePitcher?: number;
  priceTower?: number;
  subCategory?: string;
  note?: string;
  kind: 'food' | 'drink';
};

type MenuSection = {
  section: string;
  items: MenuItem[];
};

// ── Strict Photo Exclusion List (Per AGENTS.md rule) ──────────────────────────
// Never show these files as dishes: fursat_.webp, fursat_1_.webp, dsc08946.webp, dsc05389.webp, pandu_mirchi_kodi_kebab.webp
const excludedDishImages = new Set([
  'fursat_.webp',
  'fursat_1_.webp',
  'dsc08946.webp',
  'dsc05389.webp',
  'pandu_mirchi_kodi_kebab.webp',
]);

function getValidDishImage(img?: string): string | null {
  if (!img) return null;
  const basename = img.split('/').pop() || '';
  if (excludedDishImages.has(basename)) return null;
  return img;
}

function slugify(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

// ── Process Food and Drinks Server-Side ───────────────────────────────────────
const foodSections = (foodData as MenuSection[]).map((sec) => {
  const items = sec.items.map((it) => ({
    ...it,
    kind: 'food' as const,
    validImage: getValidDishImage(it.image),
  }));
  const leadImage = items.map((it) => it.validImage).find(Boolean) || null;
  return {
    title: sec.section,
    slug: slugify(sec.section),
    items,
    leadImage,
  };
});

const drinksSections = (drinksData as MenuSection[]).map((sec) => {
  const items = sec.items.map((it) => ({
    ...it,
    kind: 'drink' as const,
    validImage: getValidDishImage(it.image),
  }));
  const leadImage = items.map((it) => it.validImage).find(Boolean) || null;
  return {
    title: sec.section,
    slug: slugify(sec.section),
    items,
    leadImage,
  };
});

const totalFoodCount = foodSections.reduce((sum, s) => sum + s.items.length, 0);
const totalDrinksCount = drinksSections.reduce((sum, s) => sum + s.items.length, 0);
const totalItemsCount = totalFoodCount + totalDrinksCount;
---

<Base
  title="The Fursat Menu Book — Kitchen & Craft Bar | Madhapur, Hyderabad"
  description="Explore The Fursat Menu Book: 150+ authentic kitchen dishes and craft bar cocktails. Full server-rendered menu, dietary filters, and WhatsApp picks."
  canonical="https://fursatind.in/menu/"
  ogImage="https://fursatind.in/assets/fursat_space_07.webp"
  ogImageAlt="The Fursat Menu Book — Kitchen & Craft Bar"
>
  <SiteHeader active="menu" />

  <main class="mb-main" id="main">
    <!-- ── Full-Screen Split Entry (Drinks | Food) ────────────────────────── -->
    <section class="mb-split-entry" id="mb-split-entry" aria-label="Menu selection">
      <div class="mb-split-half mb-split-half--drinks" id="half-drinks" role="button" tabindex="0" aria-label="Open Drinks Menu">
        <div class="mb-split-bg" style="background-image: url('/assets/interior/bar-back.webp')"></div>
        <div class="mb-split-overlay mb-split-overlay--drinks"></div>
        <div class="mb-split-content">
          <span class="mb-split-kicker">✦ CRAFT BAR &amp; CELLAR ✦</span>
          <h2 class="mb-split-title">Drinks &amp; Spirits</h2>
          <p class="mb-split-sub">Craft Cocktails, Single Malts, Draught Brews &amp; Mocktails ({totalDrinksCount} pours)</p>
          <div class="mb-split-btn">
            <span>Explore Bar Book →</span>
          </div>
        </div>
      </div>

      <div class="mb-split-half mb-split-half--food" id="half-food" role="button" tabindex="0" aria-label="Open Food Menu">
        <div class="mb-split-bg" style="background-image: url('/assets/interior/tour-lounge.webp')"></div>
        <div class="mb-split-overlay mb-split-overlay--food"></div>
        <div class="mb-split-content">
          <span class="mb-split-kicker">✦ KITCHEN &amp; DINING ✦</span>
          <h2 class="mb-split-title">Kitchen Dishes</h2>
          <p class="mb-split-sub">Hyderabadi Biryanis, Regional Tandoor, Appetizers &amp; Desserts ({totalFoodCount} recipes)</p>
          <div class="mb-split-btn">
            <span>Explore Food Book →</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Floating Top Switcher Bar (Always accessible once menu is open) ── -->
    <header class="mb-top-bar" id="mb-top-bar" aria-label="Menu controls">
      <div class="mb-top-bar-inner">
        <div class="mb-switch-pill" role="tablist" aria-label="Menu view switch">
          <button
            type="button"
            class="mb-switch-tab mb-switch-tab--food is-active"
            id="tab-switch-food"
            role="tab"
            aria-selected="true"
            data-target="food"
          >
            <span class="mb-switch-icon">🍲</span>
            <span class="mb-switch-label">Food Book</span>
            <span class="mb-switch-count">{totalFoodCount}</span>
          </button>
          <button
            type="button"
            class="mb-switch-tab mb-switch-tab--drinks"
            id="tab-switch-drinks"
            role="tab"
            aria-selected="false"
            data-target="drinks"
          >
            <span class="mb-switch-icon">🍸</span>
            <span class="mb-switch-label">Drinks Book</span>
            <span class="mb-switch-count">{totalDrinksCount}</span>
          </button>
        </div>

        <button type="button" class="mb-split-return-btn" id="mb-return-split" title="Return to split entry">
          ⤢ Split View
        </button>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="mb-toolbar">
        <div class="mb-search-wrap">
          <svg class="mb-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="mb-search-input"
            class="mb-search-input"
            placeholder="Search dishes, drinks, ingredients…"
            aria-label="Search menu"
          />
          <button type="button" id="mb-search-clear" class="mb-search-clear" aria-label="Clear search" hidden>✕</button>
        </div>

        <div class="mb-filter-chips" role="group" aria-label="Dietary filters">
          <button type="button" class="mb-filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
          <button type="button" class="mb-filter-chip mb-filter-chip--veg" data-filter="veg" aria-pressed="false">
            <span class="mb-dot mb-dot--veg" aria-hidden="true"></span>
            <span>Veg</span>
          </button>
          <button type="button" class="mb-filter-chip mb-filter-chip--nonveg" data-filter="nonveg" aria-pressed="false">
            <span class="mb-dot mb-dot--nonveg" aria-hidden="true"></span>
            <span>Non-Veg</span>
          </button>
          <button type="button" class="mb-filter-chip mb-filter-chip--spicy" data-filter="spicy" aria-pressed="false">
            <span aria-hidden="true">🌶️</span>
            <span>Spicy</span>
          </button>
        </div>
      </div>
    </header>

    <!-- ── Menu Book Shell: Sidebar Rail + Scroll Content ───────────────── -->
    <div class="mb-book-shell" id="mb-book-shell" data-active-pane="food">
      
      <!-- ── FOOD PANE ──────────────────────────────────────────────────── -->
      <div class="mb-pane mb-pane--food is-active" id="pane-food" role="region" aria-label="Food Menu Book">
        <div class="mb-pane-layout">
          <!-- Desktop Category Rail (Left column) -->
          <aside class="mb-cat-rail mb-cat-rail--desktop" aria-label="Food category index">
            <div class="mb-cat-rail-header">
              <span class="mb-cat-rail-title">CATEGORIES</span>
              <span class="mb-cat-rail-counter">{foodSections.length}</span>
            </div>
            <nav class="mb-cat-rail-list">
              {foodSections.map((sec, idx) => (
                <a
                  href={`#cat-food-${sec.slug}`}
                  class={`mb-cat-link${idx === 0 ? ' is-active' : ''}`}
                  data-cat-slug={`cat-food-${sec.slug}`}
                >
                  <span class="mb-cat-name">{sec.title}</span>
                  <span class="mb-cat-count">{sec.items.length}</span>
                </a>
              ))}
            </nav>
          </aside>

          <!-- Main Server-Rendered Food List -->
          <div class="mb-book-content">
            <div class="mb-book-header">
              <h1 class="mb-book-headline">The Kitchen Book</h1>
              <p class="mb-book-lead">
                Every dish crafted fresh with Telangana spices, slow-cooked gravies, and coastal recipes.
              </p>
            </div>

            {foodSections.map((sec) => (
              <section class="mb-category-spread" id={`cat-food-${sec.slug}`} data-section-slug={sec.slug}>
                <header class="mb-spread-header">
                  <div class="mb-spread-title-wrap">
                    <span class="mb-spread-kicker">Section</span>
                    <h2 class="mb-spread-title">{sec.title}</h2>
                  </div>
                  <span class="mb-spread-count">{sec.items.length} dishes</span>
                </header>

                <div class="mb-dishes-grid">
                  {sec.items.map((item) => {
                    const isVeg = item.veg === true;
                    const isNonVeg = item.veg === false;
                    const isSpicy = item.spicy === true;
                    const isChef = item.chefSpecial === true;
                    const hasValidImg = !!item.validImage;

                    return (
                      <article
                        class="mb-dish-card"
                        data-dish-name={item.name}
                        data-dish-price={item.price != null ? item.price : ''}
                        data-dish-img={hasValidImg ? item.validImage : ''}
                        data-veg={isVeg ? 'true' : isNonVeg ? 'false' : ''}
                        data-spicy={isSpicy ? 'true' : 'false'}
                        data-chef={isChef ? 'true' : 'false'}
                      >
                        <div class="mb-dish-card-main">
                          <div class="mb-dish-header">
                            <div class="mb-dish-badges">
                              {isVeg && <span class="mb-dot mb-dot--veg" title="Vegetarian" aria-label="Vegetarian" />}
                              {isNonVeg && <span class="mb-dot mb-dot--nonveg" title="Non-vegetarian" aria-label="Non-vegetarian" />}
                              {isSpicy && <span class="mb-badge-spicy" title="Spicy">🌶️</span>}
                              {isChef && <span class="mb-badge-chef">Chef's Special</span>}
                            </div>
                            <span class="mb-dish-price">
                              {item.price != null ? `₹${item.price}` : '—'}
                            </span>
                          </div>

                          <h3 class="mb-dish-title">{item.name}</h3>
                          {item.description && <p class="mb-dish-desc">{item.description}</p>}
                        </div>

                        <div class="mb-dish-footer">
                          {hasValidImg ? (
                            <span class="mb-photo-pill" title="Has dish photograph">✦ Real Photo</span>
                          ) : (
                            <span></span>
                          )}
                          <button
                            type="button"
                            class="mb-add-pick-btn fx-add"
                            data-name={item.name}
                            data-price={item.price != null ? `₹${item.price}` : ''}
                            aria-label={`Add ${item.name} to picks`}
                            aria-pressed="false"
                          >
                            <span class="mb-add-icon">+</span>
                            <span>Pick</span>
                          </button>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}

            <p class="mb-empty-alert" id="mb-empty-food" hidden>
              No dishes match your active filter. Try resetting dietary toggles or search keyword.
            </p>
          </div>
        </div>

        <!-- Phone Sticky Category Rail (Bottom thumb zone) -->
        <nav class="mb-cat-rail mb-cat-rail--mobile" aria-label="Mobile food category selector">
          <div class="mb-cat-scroll-track" id="track-food">
            {foodSections.map((sec, idx) => (
              <a
                href={`#cat-food-${sec.slug}`}
                class={`mb-cat-pill${idx === 0 ? ' is-active' : ''}`}
                data-cat-slug={`cat-food-${sec.slug}`}
              >
                {sec.title}
              </a>
            ))}
          </div>
        </nav>
      </div>

      <!-- ── DRINKS PANE ────────────────────────────────────────────────── -->
      <div class="mb-pane mb-pane--drinks" id="pane-drinks" role="region" aria-label="Drinks Menu Book">
        <div class="mb-pane-layout">
          <!-- Desktop Category Rail (Left column) -->
          <aside class="mb-cat-rail mb-cat-rail--desktop mb-cat-rail--bar" aria-label="Drinks category index">
            <div class="mb-cat-rail-header">
              <span class="mb-cat-rail-title">BAR SECTIONS</span>
              <span class="mb-cat-rail-counter">{drinksSections.length}</span>
            </div>
            <nav class="mb-cat-rail-list">
              {drinksSections.map((sec, idx) => (
                <a
                  href={`#cat-drinks-${sec.slug}`}
                  class={`mb-cat-link${idx === 0 ? ' is-active' : ''}`}
                  data-cat-slug={`cat-drinks-${sec.slug}`}
                >
                  <span class="mb-cat-name">{sec.title}</span>
                  <span class="mb-cat-count">{sec.items.length}</span>
                </a>
              ))}
            </nav>
          </aside>

          <!-- Main Server-Rendered Drinks List -->
          <div class="mb-book-content mb-book-content--bar">
            <div class="mb-book-header mb-book-header--bar">
              <span class="mb-bar-gate-badge">21+ Craft Cellar</span>
              <h1 class="mb-book-headline">The Bar &amp; Cellar Book</h1>
              <p class="mb-book-lead">
                Curated cocktails, rare single malts, aged rums, chilled beer buckets, and fresh artisanal brews.
              </p>
            </div>

            {drinksSections.map((sec) => (
              <section class="mb-category-spread mb-category-spread--bar" id={`cat-drinks-${sec.slug}`} data-section-slug={sec.slug}>
                <header class="mb-spread-header mb-spread-header--bar">
                  <div class="mb-spread-title-wrap">
                    <span class="mb-spread-kicker mb-spread-kicker--bar">Bar Collection</span>
                    <h2 class="mb-spread-title">{sec.title}</h2>
                  </div>
                  <span class="mb-spread-count">{sec.items.length} pours</span>
                </header>

                <div class="mb-dishes-grid mb-dishes-grid--bar">
                  {sec.items.map((item) => {
                    const isAlc = item.alc === true;
                    const isVeg = item.veg === true;
                    const isSpirit = item.price30ml != null || (item.priceBottle != null && sec.title !== 'Wines' && sec.title !== 'Beer');
                    const isWine = sec.title === 'Wines' || item.priceGlass != null;

                    return (
                      <article
                        class="mb-dish-card mb-dish-card--bar"
                        data-dish-name={item.name}
                        data-dish-price={item.price != null ? item.price : item.priceBottle != null ? item.priceBottle : ''}
                        data-dish-img=""
                        data-alc={isAlc ? 'true' : 'false'}
                        data-veg={isVeg ? 'true' : ''}
                      >
                        <div class="mb-dish-card-main">
                          <div class="mb-dish-header">
                            <div class="mb-dish-badges">
                              {isAlc && <span class="mb-badge-alc">Alcohol</span>}
                              {!isAlc && isVeg && <span class="mb-dot mb-dot--veg" title="Vegetarian Mocktail" />}
                              {item.subCategory && <span class="mb-badge-sub">{item.subCategory}</span>}
                            </div>
                            <div class="mb-dish-price-wrap">
                              {isSpirit ? (
                                <div class="mb-spirit-prices">
                                  <span>30ml: {item.price30ml != null ? `₹${item.price30ml}` : '—'}</span>
                                  <span class="mb-price-bullet">·</span>
                                  <span>Btl: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                                </div>
                              ) : isWine ? (
                                <div class="mb-spirit-prices">
                                  <span>Glass: {item.priceGlass != null ? `₹${item.priceGlass}` : '—'}</span>
                                  <span class="mb-price-bullet">·</span>
                                  <span>Btl: {item.priceBottle != null ? `₹${item.priceBottle}` : '—'}</span>
                                </div>
                              ) : (
                                <span class="mb-dish-price">
                                  {item.price != null ? `₹${item.price}` : item.priceBottle != null ? `₹${item.priceBottle}` : '—'}
                                </span>
                              )}
                            </div>
                          </div>

                          <h3 class="mb-dish-title mb-dish-title--bar">{item.name}</h3>
                          {item.description && <p class="mb-dish-desc mb-dish-desc--bar">{item.description}</p>}
                        </div>

                        <div class="mb-dish-footer mb-dish-footer--bar">
                          {item.priceBucket != null ? (
                            <span class="mb-bucket-pill">Bucket: ₹{item.priceBucket}</span>
                          ) : (
                            <span></span>
                          )}
                          <button
                            type="button"
                            class="mb-add-pick-btn mb-add-pick-btn--bar fx-add"
                            data-name={item.name}
                            data-price={item.price != null ? `₹${item.price}` : item.priceBottle != null ? `₹${item.priceBottle}` : ''}
                            aria-label={`Add ${item.name} to picks`}
                            aria-pressed="false"
                          >
                            <span class="mb-add-icon">+</span>
                            <span>Pick</span>
                          </button>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}

            <p class="mb-empty-alert mb-empty-alert--bar" id="mb-empty-drinks" hidden>
              No drinks match your search or filter.
            </p>
          </div>
        </div>

        <!-- Phone Sticky Category Rail (Bottom thumb zone) -->
        <nav class="mb-cat-rail mb-cat-rail--mobile mb-cat-rail--mobile-bar" aria-label="Mobile drinks category selector">
          <div class="mb-cat-scroll-track" id="track-drinks">
            {drinksSections.map((sec, idx) => (
              <a
                href={`#cat-drinks-${sec.slug}`}
                class={`mb-cat-pill mb-cat-pill--bar${idx === 0 ? ' is-active' : ''}`}
                data-cat-slug={`cat-drinks-${sec.slug}`}
              >
                {sec.title}
              </a>
            ))}
          </div>
        </nav>
      </div>

    </div>

    <!-- ── Picks Tray Component ─────────────────────────────────────────── -->
    <PicksTray />
  </main>

  <SiteFooter />
</Base>

<!-- ── Client Interactivity: Split expand, Scroll-spy, Search & Filter ─────── -->
<script>
  (function () {
    var splitEntry = document.getElementById('mb-split-entry');
    var halfDrinks = document.getElementById('half-drinks');
    var halfFood = document.getElementById('half-food');
    var topBar = document.getElementById('mb-top-bar');
    var bookShell = document.getElementById('mb-book-shell');
    var tabFood = document.getElementById('tab-switch-food');
    var tabDrinks = document.getElementById('tab-switch-drinks');
    var returnSplit = document.getElementById('mb-return-split');

    var paneFood = document.getElementById('pane-food');
    var paneDrinks = document.getElementById('pane-drinks');

    var searchInput = document.getElementById('mb-search-input') as HTMLInputElement | null;
    var searchClear = document.getElementById('mb-search-clear');
    var filterChips = Array.from(document.querySelectorAll('.mb-filter-chip'));

    var currentView: 'split' | 'food' | 'drinks' = 'split';
    var activeDietFilter: 'all' | 'veg' | 'nonveg' | 'spicy' = 'all';
    var currentQuery = '';

    // ── Switch View Function (Supports View Transition API) ─────────────
    function setView(view: 'split' | 'food' | 'drinks') {
      if (view === currentView) return;

      function updateDOM() {
        currentView = view;
        if (view === 'split') {
          splitEntry?.classList.remove('is-hidden');
          topBar?.classList.remove('is-visible');
          bookShell?.classList.remove('is-open');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else if (view === 'food') {
          splitEntry?.classList.add('is-hidden');
          topBar?.classList.add('is-visible');
          bookShell?.classList.add('is-open');
          bookShell?.setAttribute('data-active-pane', 'food');

          tabFood?.classList.add('is-active');
          tabFood?.setAttribute('aria-selected', 'true');
          tabDrinks?.classList.remove('is-active');
          tabDrinks?.setAttribute('aria-selected', 'false');

          paneFood?.classList.add('is-active');
          paneDrinks?.classList.remove('is-active');
          document.body.classList.remove('theme-bar-dark');
          applyFilters();
        } else if (view === 'drinks') {
          splitEntry?.classList.add('is-hidden');
          topBar?.classList.add('is-visible');
          bookShell?.classList.add('is-open');
          bookShell?.setAttribute('data-active-pane', 'drinks');

          tabDrinks?.classList.add('is-active');
          tabDrinks?.setAttribute('aria-selected', 'true');
          tabFood?.classList.remove('is-active');
          tabFood?.setAttribute('aria-selected', 'false');

          paneDrinks?.classList.add('is-active');
          paneFood?.classList.remove('is-active');
          document.body.classList.add('theme-bar-dark');
          applyFilters();
        }
      }

      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(updateDOM);
      } else {
        updateDOM();
      }
    }

    if (halfFood) halfFood.addEventListener('click', function () { setView('food'); });
    if (halfDrinks) halfDrinks.addEventListener('click', function () { setView('drinks'); });
    if (tabFood) tabFood.addEventListener('click', function () { setView('food'); });
    if (tabDrinks) tabDrinks.addEventListener('click', function () { setView('drinks'); });
    if (returnSplit) returnSplit.addEventListener('click', function () { setView('split'); });

    // Keyboard support on split entry
    halfFood?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setView('food'); }
    });
    halfDrinks?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setView('drinks'); }
    });

    // ── Instant Filter & Search ────────────────────────────────────────
    function applyFilters() {
      var activePane = currentView === 'drinks' ? paneDrinks : paneFood;
      if (!activePane) return;

      var q = currentQuery.trim().toLowerCase();
      var articles = Array.from(activePane.querySelectorAll('.mb-dish-card'));
      var matchCount = 0;

      articles.forEach(function (el) {
        var card = el as HTMLElement;
        var name = (card.dataset.dishName || '').toLowerCase();
        var desc = (card.querySelector('.mb-dish-desc')?.textContent || '').toLowerCase();
        var isVeg = card.dataset.veg === 'true';
        var isNonVeg = card.dataset.veg === 'false';
        var isSpicy = card.dataset.spicy === 'true';

        // Dietary check
        var dietMatch = true;
        if (activeDietFilter === 'veg') dietMatch = isVeg;
        else if (activeDietFilter === 'nonveg') dietMatch = isNonVeg;
        else if (activeDietFilter === 'spicy') dietMatch = isSpicy;

        // Query check
        var queryMatch = !q || name.indexOf(q) !== -1 || desc.indexOf(q) !== -1;

        if (dietMatch && queryMatch) {
          card.style.display = '';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Hide category sections that have no visible cards
      var sections = Array.from(activePane.querySelectorAll('.mb-category-spread'));
      sections.forEach(function (sec) {
        var visibleCards = sec.querySelectorAll('.mb-dish-card:not([style*="display: none"])');
        (sec as HTMLElement).style.display = visibleCards.length > 0 ? '' : 'none';
      });

      // Show/hide empty state
      var emptyEl = document.getElementById(currentView === 'drinks' ? 'mb-empty-drinks' : 'mb-empty-food');
      if (emptyEl) {
        emptyEl.hidden = matchCount > 0;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        currentQuery = searchInput.value;
        if (searchClear) searchClear.hidden = !currentQuery;
        applyFilters();
      });
    }

    if (searchClear && searchInput) {
      searchClear.addEventListener('click', function () {
        searchInput.value = '';
        currentQuery = '';
        searchClear.hidden = true;
        searchInput.focus();
        applyFilters();
      });
    }

    filterChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        filterChips.forEach(function (c) {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-pressed', 'true');
        activeDietFilter = (chip.getAttribute('data-filter') as any) || 'all';
        applyFilters();
      });
    });

    // ── Category Rail Scroll-Spy ───────────────────────────────────────
    function initScrollSpy() {
      var options = {
        root: null,
        rootMargin: '-15% 0px -70% 0px',
        threshold: 0
      };

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var id = entry.target.id;
            // Highlight matching desktop link and mobile pill
            var links = Array.from(document.querySelectorAll(`.mb-cat-link[data-cat-slug="${id}"], .mb-cat-pill[data-cat-slug="${id}"]`));
            if (links.length > 0) {
              var parentPane = entry.target.closest('.mb-pane');
              if (parentPane) {
                parentPane.querySelectorAll('.mb-cat-link.is-active, .mb-cat-pill.is-active').forEach(function (el) {
                  el.classList.remove('is-active');
                });
                links.forEach(function (el) {
                  el.classList.add('is-active');
                  // Keep mobile pill in view
                  if (el.classList.contains('mb-cat-pill')) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                  }
                });
              }
            }
          }
        });
      }, options);

      document.querySelectorAll('.mb-category-spread').forEach(function (sec) {
        observer.observe(sec);
      });
    }

    initScrollSpy();
  })();
</script>

