---
import site from '../data/site.json';
// cafe.astro — Fursat Café (P6 restyle: shared ExperienceLayout on the baked plaster stage, mock "Café + Restaurant + Bar").
// Content is the page's existing copy, items, prices and photos; only the design changed.
import Base from '../layouts/Base.astro';
import ExperienceLayout from '../components/experience/ExperienceLayout.astro';
---
<Base
  title="Café Lounge — Fursat Kitchen | Bar | Madhapur"
  description="Fursat Café Lounge — artisan coffees, teas and light bites in a warm, creative setting. Work, unwind or catch up with friends in Madhapur's cosiest café."
  canonical="https://fursatind.in/cafe/"
  ogImage="https://fursatind.in/assets/fursat_space_09.webp"
  ogImageAlt="Fursat Café Lounge interior — cosy seating and warm lighting"
>
  <ExperienceLayout
    insta="fursatind.in"
    active="cafe"
    kicker="Slow mornings · Artisan roasts"
    h1a="Seasonal Sips &"
    h1b="Slow Bakes"
    lead="Inspired by the rhythm of unhurried mornings. Specialty coffee roasted with single-origin beans, ceremonial matcha, house-whipped thick shakes, and oven-fresh pastries."
    ctas={[
      { label: 'Explore Café Menu', href: '#cafe-menu', primary: true },
      { label: 'Book a Café Booth', href: '/reserve', book: true },
    ]}
    hero={{ src: '/assets/dishes/dsc08774.webp', alt: 'Latte art coffee at Fursat Café', w: 1200, h: 1200, pos: '50% 60%' }}
    pillars={[
      { icon: 'coffee', title: 'Single-Origin Espresso', line: 'Arabica, roasted light-medium.' },
      { icon: 'leaf', title: 'Ceremonial Grade Matcha', line: 'Stone-ground, whisked by hand.' },
      { icon: 'bake', title: 'House-Baked Daily', line: 'Small morning batches.' },
      { icon: 'shake', title: 'Signature Thick Shakes', line: 'Churned with artisanal gelato.' },
    ]}
    momentsA="Spaces Designed"
    momentsB="to Unwind"
    momentsText="Quiet lunch breaks, afternoon meetings and evening desserts. Café booths and high tables with power plugs and Wi-Fi."
    momentsCta={{ label: 'Book a Café Booth', href: '/reserve', book: true }}
    big={{ src: '/assets/interior/fursat_space_05.webp', alt: 'Café interior with natural light', w: 1920, h: 2560 }}
    top={{ src: '/assets/interior/fursat_space_15.webp', alt: 'Artisan coffee bar counter', w: 1920, h: 2560 }}
    bottom={{ src: '/assets/interior/fursat_space_06.webp', alt: 'Cosy seating corner', w: 1920, h: 2560 }}
    cardsId="cafe-menu"
    cardsKicker="The café selection"
    cardsTitle="Favorites from the Counter"
    cards={[
      { tag: 'Bestseller', name: 'Lotus Biscoff Shake', price: '₹345', text: 'Caramelized Biscoff spread blended with vanilla bean cream, crowned with crushed biscuits.', img: { src: '/assets/dishes/lotus_biscoff_.webp', alt: 'Lotus Biscoff Shake' } },
      { tag: 'Cold Brew', name: 'Amber Cold Brew', price: '₹265', text: 'Slow-steeped for 18 hours for deep chocolate notes, served over clear crystal ice.', img: { src: '/assets/dishes/dsc08774.webp', alt: 'Artisan Cold Brew' } },
      { tag: 'Bakes', name: 'Belgian Chocolate Waffle', price: '₹315', text: 'Crisp golden waffle drizzled with warm dark ganache, toasted almonds, and vanilla gelato.', img: { src: '/assets/dishes/dsc08852.webp', alt: 'Classic Belgian Waffle' } },
      { tag: 'Breakfast', name: 'Smashed Avocado Sourdough', price: '₹365', text: 'Toasted country sourdough with Hass avocado, cherry tomatoes, feta crumble, and chili flakes.', img: { src: '/assets/dishes/dsc08919.webp', alt: 'Avocado Toast & Sourdough' } },
    ]}
    cardsLink={{ label: 'See the full menu', href: '/menu' }}
    faqTitle="Café FAQs"
    faq={[
      { q: 'What are the café opening hours?', a: `Our café is open ${site.hours.display}. Perfect for quiet lunch breaks, afternoon meetings, and evening desserts.` },
      { q: 'Is high-speed Wi-Fi and power available for remote working?', a: 'Yes, our café booths and high-table areas are equipped with convenient power plugs and complimentary high-speed Wi-Fi for remote work or meetings.' },
      { q: 'Can I order café items along with the main restaurant menu?', a: 'Yes, all café beverages, shakes, and desserts can be ordered from any table across Fursat.' },
    ]}
  />
</Base>
