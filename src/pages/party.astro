---
import Base from '../layouts/Base.astro';
import data from '../data/party.json';
import PartyStage from '../components/party/PartyStage';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import HyWindows from '../components/hybrid/HyWindows.astro';
import pDesk from '../../scripts/bg-specs/party-desk.out.json';
// wide desktop hero: the plain plaster band of the hero art is stretched so the hero fits a laptop screen at full width
import pDeskW from '../../scripts/bg-specs/party-deskw.out.json';
import pPhone from '../../scripts/bg-specs/party-phone.out.json';
import '../styles/fk-tokens.css';
// v4 hybrid: textless background art (public/assets/bg/party-*) + live HTML; motion in src/scripts/fk-motion.ts.
// P5 restyle: one real photo per package group (TODO(client): real banquet-hall and party photos).
const heroPhoto = { src: '/assets/interior/fursat_space_07.webp', alt: 'The Fursat dining hall set for guests', w: 1920, h: 2560, pos: '50% 60%', eager: true };
const closePhoto = { src: '/assets/interior/tour-high-tables.webp', alt: 'High tables at Fursat ready for a party', w: 1050, h: 1400, pos: '50% 55%' };
const elephant = 'M109.5 10.2 L100.2 6.0 L81.5 4.0 L70.5 8.0 L61.0 18.5 L60.0 24.2 L62.8 30.5 L69.5 34.8 L76.2 34.8 L81.8 31.2 L83.5 27.2 L79.5 24.0 L76.2 27.0 L71.8 25.2 L71.8 22.5 L79.5 16.8 L88.2 16.8 L92.5 18.8 L98.0 25.5 L98.0 32.2 L88.2 44.0 L73.5 52.0 L64.5 58.0 L55.0 67.5 L51.0 74.5 L48.0 83.5 L48.0 98.2 L52.2 108.5 L57.5 112.8 L69.5 118.8 L80.2 119.8 L88.2 116.8 L92.8 110.2 L92.8 105.5 L94.5 104.0 L96.0 106.5 L96.0 114.2 L89.2 123.0 L82.2 126.0 L66.5 126.0 L56.5 122.0 L50.2 118.0 L43.8 110.2 L40.2 102.0 L29.5 107.0 L20.2 114.2 L14.0 123.5 L5.2 139.2 L13.2 138.0 L13.0 150.2 L12.0 160.2 L13.0 166.2 L14.5 170.8 L35.2 170.8 L35.8 163.5 L39.8 157.2 L48.2 155.8 L53.0 160.5 L54.5 170.8 L74.2 170.8 L74.8 161.5 L78.2 157.0 L86.2 155.8 L92.0 161.5 L92.5 170.8 L117.8 170.2 L116.8 159.5 L115.8 142.5 L117.8 127.5 L125.8 114.2 L130.8 103.2 L133.8 94.2 L135.8 81.2 L135.8 64.5 L133.8 55.2 L128.8 39.2 L121.8 24.5Z';
const why = [
  { t: 'Exquisite Cuisine', i: '<path d="M3 20h18"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4M10 4h4"/>' },
  { t: 'Elegant Ambience', i: '<path d="M9 3h6l2 6H7z"/><path d="M12 9v9M8 21h8"/><path d="M5 9h14"/>' },
  { t: 'Warm Hospitality', i: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { t: 'Prime Location', i: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>' },
];
const cardPhotos: Record<string, string[]> = {
  bar: ['/assets/interior/bar-front.webp', '/assets/interior/bar-back.webp', '/assets/interior/tour-bar.webp', '/assets/tour/img/sm/bar.webp'],
  elite: ['/assets/tour/img/sm/dining.webp', '/assets/tour/img/sm/lounge.webp'],
  banquet: ['/assets/tour/img/sm/booths.webp', '/assets/tour/img/sm/high-tables.webp', '/assets/tour/img/sm/sofa-corner.webp', '/assets/tour/img/sm/table-for-two.webp', '/assets/tour/img/sm/garden-window.webp'],
};
const groupIcon: Record<string, string> = {
  bar: '<path d="M4 4h16l-8 9z"/><path d="M12 13v7M8 20h8"/>',
  elite: '<path d="M3 20h18"/><path d="M20 16a8 8 0 1 0-16 0"/><path d="M12 4v4M10 4h4"/>',
  banquet: '<path d="M8 21h8M12 15v6M7 3h10l-1 7a4 4 0 0 1-8 0z"/>',
};
const cardPhoto = (g: string, i: number) => (cardPhotos[g] || [])[i % (cardPhotos[g] || ['']).length] || groupPhoto[g];
const groupPhoto: Record<string, string> = { bar: '/assets/tour/img/sm/bar.webp', elite: '/assets/tour/img/sm/dining.webp', banquet: '/assets/tour/img/sm/booths.webp' };
// CLIENT/LEGAL TO CONFIRM: liquor brand names stay off the public page until cleared (Telangana excise advertising rules).
const SHOW_LIQUOR_BRANDS = false;
// ASSUMPTION TO CONFIRM: the printed prices ("4999+Taxes") read as per guest.
const UNIT = 'per guest';
const WA = '919059670033';
const inr = (n: number) => '\u20b9' + n.toLocaleString('en-IN');
const lead = (p: any) => p.sections.slice(0, 4).map((s: any) => [s.h, s.rule || (s.lines || []).join(' \u00b7 ')]);
const waBase = 'https://wa.me/' + WA + '?text=';
const waHi = waBase + encodeURIComponent('Hi Fursat! I would like to plan a party.');
// "Pick your occasion": text comes from party.json group blurbs and prices only (no extra claims).
const groupOf = (id: string) => data.groups.find((g: any) => g.id === id)!;
const fromPrice = (id: string) => Math.min(...data.packages.filter((p: any) => p.group === id).map((p: any) => p.price));
const occasions = [
  { id: 'birthday', t: 'Birthdays & anniversaries', g: 'elite', base: '/assets/venue/interior/long-table-dining', sized: true, w: 1200, h: 1600, alt: 'A long table set for a group celebration at Fursat' },
  { id: 'corporate', t: 'Corporate gatherings', g: 'banquet', base: '/assets/venue/banquet/banquet-tables-03', sized: true, w: 1200, h: 1600, alt: 'The banquet hall in a U-shaped layout for a corporate meeting', link: { href: '/banquet#enquire', label: 'Enquire about the hall' } },
  { id: 'kitty', t: 'Kitty parties', g: 'elite', base: '/assets/venue/interior/mural-booths', sized: true, w: 1200, h: 1600, alt: 'Booths beside the Hyderabad mural wall at Fursat' },
  { id: 'barbash', t: 'Bar bashes', g: 'bar', base: '/assets/interior/fursat_space_08', sized: false, w: 1280, h: 1706, alt: 'The bar counter at Fursat', note: 'Alcohol is served to guests aged 21 and above only.' },
];
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title="Parties & Events — Fursat Kitchen | Bar, Madhapur" description="Birthdays, corporate gatherings, kitty parties and bar bashes at Fursat, Madhapur. Pick your occasion, choose a package: bar parties, elite buffet or banquet. We confirm on WhatsApp." canonical="https://fursatind.in/party/">
<a class="skip" href="#pk-main">Skip to main content</a>
<div class="pa">
  <SiteHeader active="celebrate" variant="plaster" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('fx-pre'); setTimeout(function () { document.documentElement.classList.remove('fx-pre'); }, 3500); }</script>
  <div class="hy pa-hy">
    <div class="hy-slice hy-top" aria-hidden="true"></div><div class="hy-slice hy-mid" aria-hidden="true"></div><div class="hy-slice hy-bot" aria-hidden="true"></div>
    <HyWindows data={pDeskW} slice={0} photos={[heroPhoto, { src: '/assets/interior/tour-lounge.webp', alt: '', w: 1050, h: 1400 }]} view="d" />
    <HyWindows data={pPhone} slice={0} photos={[{ ...heroPhoto, pos: '50% 70%' }, { src: '/assets/interior/tour-lounge.webp', alt: '', w: 1050, h: 1400 }]} view="m" />
    <HyWindows data={pDesk} slice={2} photos={[closePhoto]} view="d" anchor="bottom" />

    <div class="pa-hero" data-fx-hero>
      <p class="hy-kicker" data-fx-step>Parties &amp; Events</p>
      <h1 class="hy-h1 pa-h1" id="pa-h1" data-fx-step data-fx-words>Plan your party <span class="hl">at Fursat</span></h1>
      <svg class="hy-orn--draw pa-orn" viewBox="0 0 260 24" aria-hidden="true" data-fx-step data-fx-draw>
        <path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /><path d="M110 12 C116 6 122 6 126 12 M150 12 C144 6 138 6 134 12" />
      </svg>
      <p class="hy-lead pa-lead" data-fx-step>Pick a package, tell us how many are coming, and we will confirm the rest on WhatsApp.</p>
      <div class="hy-btns pa-ctas" data-fx-step>
        <a class="fk-btn fk-btn--solid" href="#pk-main"><span>Explore our packages</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="fk-btn fk-btn--line" href={waHi} target="_blank" rel="noopener"><span>Chat on WhatsApp</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>

    <div class="hy-flow pa-flow">
      <div class="pa-intro-m hy-m">
        <p class="hy-lead">Pick a package, tell us how many are coming, and we will confirm the rest on WhatsApp.</p>
        <div class="hy-btns">
          <a class="fk-btn fk-btn--solid" href="#pk-main"><span>Explore packages</span></a>
          <a class="fk-btn fk-btn--line" href={waHi} target="_blank" rel="noopener"><span>WhatsApp us</span></a>
        </div>
      </div>
  <section class="pa-occ" aria-labelledby="pa-occ-h">
    <h2 class="pa-sec-h" id="pa-occ-h">Pick your occasion</h2>
    <p class="pa-blurb">Choose what you are celebrating. We open the package type that fits.</p>
    <div class="fk-cards pa-occ-grid">
      {occasions.map((o) => (
        <article class="fk-card pa-oc" id={o.id}>
          <div class="fk-card__ph">
            <img
              src={o.sized ? `${o.base}-720.webp` : `${o.base}.webp`}
              srcset={o.sized ? `${o.base}-480.webp 480w, ${o.base}-720.webp 720w, ${o.base}.webp 1200w` : undefined}
              sizes="(max-width: 599px) 92vw, (max-width: 999px) 46vw, 24vw"
              alt={o.alt} width={o.w} height={o.h} loading="lazy" decoding="async" />
          </div>
          <div class="fk-card__b">
            <span class="fk-card__tag">{groupOf(o.g).label}</span>
            <h3 class="fk-card__t">{o.t}</h3>
            <p class="fk-card__p">{groupOf(o.g).blurb}{o.note ? ' ' + o.note : ''}</p>
            <p class="fk-card__price"><span>From {inr(fromPrice(o.g))}</span><small>+ taxes, {UNIT}</small></p>
            <div class="pa-oc-act">
              <button type="button" class="fk-btn fk-btn--solid" data-occ={o.g}><span>See {groupOf(o.g).label} packages</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} /></button>
              {o.link && <a class="fk-btn fk-btn--line" href={o.link.href}><span>{o.link.label}</span></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <main id="pk-main" tabindex="-1" class="pa-main">
    <div class="pa-host" id="pa-host" data-pose="idle"><div class="pa-stage"><img class="pa-p pa-idle" src="/assets/ask-mascot-md.webp" alt="Fursat&rsquo;s elephant host in a gold crown and sunglasses" width="400" height="400" decoding="async"><img class="pa-p pa-cheer" src="/assets/ask-mascot-cheer-md.webp" alt="" width="400" height="400" decoding="async"></div></div>
    <h2 class="pa-sec-h">Our Party Packages</h2>
    <div class="pa-tabs" role="group" aria-label="Choose a package type">
      {data.groups.map((g, i) => <button type="button" data-tab={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>)}
    </div>
    {data.groups.map((g, gi) => (
      <section class="pa-group" data-group={g.id} hidden={gi !== 0 ? true : undefined} aria-label={g.label}>
        <p class="pa-blurb">{g.blurb}</p>
        <div class="pk-row">
          {data.packages.filter((p: any) => p.group === g.id).map((p: any, i: number) => (
            <article class="pk fk-card" style={`--i:${i}`} data-id={p.id} data-price={p.price} data-name={p.name}>
              <div class="pk-ph fk-card__ph" aria-hidden="true"><img src={cardPhoto(p.group, i)} alt="" width="540" height="720" loading="lazy" decoding="async" /><span class="fk-card__badge"><svg viewBox="0 0 24 24" set:html={groupIcon[p.group]} /></span></div>
              <div class="pk-face fk-card__b" data-tone={p.tone}>
                <h2 class="pk-name fk-card__t">{p.name}</h2>
                <dl class="pk-sum">
                  {lead(p).map(([h, v]: string[]) => <div><dt>{h}</dt><dd>{v}</dd></div>)}
                  {p.drinks && <div><dt>Drinks{p.drinks.serve ? ' \u00b7 ' + p.drinks.serve : ''}</dt><dd>{p.drinks.lines.join(' \u00b7 ')}</dd></div>}
                </dl>
                <details class="pk-more">
                  <summary>Everything included</summary>
                  {p.sections.map((s: any) => (
                    <div class="pk-sec">
                      <h3>{s.h}{s.rule ? ' \u2013 ' + s.rule : ''}</h3>
                      <p>{(s.items || s.lines).join(' \u00b7 ')}</p>
                    </div>
                  ))}
                  {p.drinks && (
                    <div class="pk-sec">
                      <h3>Drinks{p.drinks.serve ? ' \u2013 serving ' + p.drinks.serve : ''}</h3>
                      <p>{[...(SHOW_LIQUOR_BRANDS ? p.drinks.brands : []), ...p.drinks.lines].join(' \u00b7 ')}</p>
                      {p.group === 'bar' && <p class="pk-age">Alcohol is served to guests aged 21 and above only.</p>}
                    </div>
                  )}
                </details>
                <div class="fk-card__foot">
                  <p class="pk-price fk-card__price"><span class="pk-amt" data-fx-count>{inr(p.price)}</span><small class="pk-unit">+ taxes, {UNIT}</small></p>
                  <button class="pk-plan fk-card__go" type="button" data-plan={p.id} aria-label={`Plan this party: ${p.name}`} title="Plan this party"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <div class="pa-lower">
    <section class="pa-plan" id="pa-plan" aria-labelledby="pa-plan-h">
      <h2 id="pa-plan-h">Estimate your party</h2>
      <PartyStage client:visible poster="/assets/party-stage-poster.webp" />
      <div class="pa-fields">
        <label for="pa-pkg">Package</label>
        <select id="pa-pkg">{data.packages.map((p: any) => <option value={p.id} data-price={p.price}>{p.name} &ndash; {inr(p.price)}</option>)}</select>
        <label for="pa-n">Guests</label>
        <div class="pa-step"><button type="button" id="pa-minus" aria-label="Fewer guests">&minus;</button><input id="pa-n" type="number" inputmode="numeric" min="1" max="500" value="25"><button type="button" id="pa-plus" aria-label="More guests">+</button></div>
      </div>
      <p class="pa-total" id="pa-total" aria-live="polite"></p>
      <p class="pa-fine">Estimate before taxes, {UNIT}. Your final quote is confirmed by the Fursat team.</p>
      <a class="pa-wa" id="pa-wa" href={waHi} target="_blank" rel="noopener">Send this plan on WhatsApp</a>
    </section>

    <div class="pa-right">
    <section class="pa-choices" aria-labelledby="pa-ch-h">
      <h2 id="pa-ch-h">Choose your dishes</h2>
      <p class="pa-blurb">For Platinum, Gold, Silver and the Elite packages. Banquet menus list their dishes on the card.</p>
      {data.choices.map((c: any) => (
        <details class="pa-acc">
          <summary>{c.h}</summary>
          <div class="pa-cols">{c.cols.map((col: any) => <div>{col.h && <h3>{col.h}</h3>}<ul>{col.items.map((it: string) => <li>{it}</li>)}</ul></div>)}</div>
        </details>
      ))}
    </section>

    <section class="pa-add" aria-labelledby="pa-ad-h">
      <h2 id="pa-ad-h">Add-ons</h2>
      <ul class="pa-addlist">{data.addons.map((a: any) => <li><span>{a.n}</span><b>{inr(0).replace('0', a.p)}</b></li>)}</ul>
      <p class="pa-fine">Add-on prices are as printed on the Fursat party menu.</p>
    </section>
    </div>
    </div>
  </main>
    </div>

    <figure class="pa-quote" data-fx-reveal>
      <svg class="pa-qm" viewBox="0 0 40 32" aria-hidden="true"><path d="M0 32V18C0 8 6 2 16 0l2 5c-6 2-9 6-9 11h8v16zm22 0V18c0-10 6-16 16-18l2 5c-6 2-9 6-9 11h8v16z"/></svg>
      <blockquote>Good food, great company and unforgettable moments.</blockquote>
      <div class="hy-orn pa-q-orn" aria-hidden="true"><i></i><svg viewBox="0 0 140 176"><path d={elephant} /></svg><i></i></div>
    </figure>

    <div class="pa-why">
      <h2 class="hy-h2 pa-why-h" data-fx-reveal>Why Choose FURSAT?</h2>
      <ul class="pa-plates" data-fx-pop>
        {why.map((w, i) => (
          <li class={`pa-plate pa-plate--${i + 1}`} data-fx-tilt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={w.i} /><span>{w.t}</span></li>
        ))}
      </ul>
    </div>

    <div class="pa-close" data-fx-reveal>
      <h2 id="pa-close-h">Let&rsquo;s Celebrate <em>Together</em></h2>
      <p>Pick a package above and send your plan on WhatsApp. We confirm every party personally.</p>
      <a class="fk-btn fk-btn--gold" href={waHi} target="_blank" rel="noopener"><span>Plan on WhatsApp</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</div>
<SiteFooter />
<MobileBar active="celebrate" />
<script>import '../scripts/fk-motion';</script>
<style is:global>
:root{--pk-red:#A83A26;--pk-green:#34522A;--pk-cream:#F6EBD3}
.pa{min-height:100svh;background:var(--rl-bg);color:var(--rl-ink)}
.pa-top{padding:max(16px,env(safe-area-inset-top)) var(--pad,clamp(20px,5vw,84px)) 0}
.pa-back{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:var(--rl-ink);text-decoration:none;font:600 1rem/1 var(--sans,"Manrope",system-ui,sans-serif)}
.pa-back svg{width:20px;height:20px;transition:transform .15s var(--rl-ease)}
.pa-back:focus-visible,.pa-wa:focus-visible,.pk-plan:focus-visible,.pa-tabs button:focus-visible,.pk-more summary:focus-visible,.pa-acc summary:focus-visible,.pa-fields select:focus-visible,.pa-step button:focus-visible,.pa-step input:focus-visible{outline:2px solid var(--rl-gold);outline-offset:3px}
.pa-main{max-width:1180px;margin:0 auto;padding:clamp(16px,4vw,48px) var(--pad,clamp(20px,5vw,84px)) clamp(56px,8vw,112px);outline:0}
.pa-host{display:grid;justify-items:center;margin:0 0 8px}
.pa-stage{position:relative;isolation:isolate;width:clamp(112px,32vw,148px);aspect-ratio:1;display:grid}
.pa-stage::after{content:"";position:absolute;left:18%;right:18%;bottom:-2px;height:9px;border-radius:50%;background:color-mix(in srgb,var(--rl-deep) 70%,transparent);transform:scaleY(.6);z-index:-1}
@media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){.pa-stage{transform:perspective(560px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .2s var(--rl-ease)}.pa-stage::after{translate:var(--sh,0px) 0;transition:translate .2s var(--rl-ease)}}
.pa-p{grid-area:1/1;width:100%;height:100%;object-fit:contain;opacity:0;transform-origin:50% 100%;transition:opacity .15s var(--rl-ease)}
.pa-host[data-pose="idle"] .pa-idle,.pa-host[data-pose="cheer"] .pa-cheer{opacity:1}
.pa-host[data-pose="cheer"] .pa-cheer{animation:pa-hop .6s var(--rl-ease) 2}
@keyframes pa-hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-12px) scale(.97,1.04)}70%{transform:translateY(0) scale(1.04,.96)}}
.pa-star{position:absolute;left:50%;top:42%;width:12px;height:12px;margin:-6px 0 0 -6px;background:var(--rl-gold);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);pointer-events:none;animation:pa-star .9s var(--rl-ease) forwards}
@keyframes pa-star{from{opacity:1;transform:translate(0,0) scale(.5)}to{opacity:0;transform:translate(var(--sx),var(--sy)) scale(1.1)}}
.pa-h{margin:0 0 12px;text-align:center;font:500 clamp(2rem,6.5vw,4rem)/1.08 var(--serif,"Playfair Display",Georgia,serif);letter-spacing:-.02em;text-wrap:balance}
.pa-sub{margin:0 auto 28px;max-width:52ch;text-align:center;font:400 1.0625rem/1.5 var(--sans,"Manrope",system-ui,sans-serif);color:var(--rl-dim)}
.pa-tabs{display:flex;width:max-content;max-width:100%;margin:0 auto 20px;gap:4px;padding:4px;border:1px solid var(--rl-line);border-radius:999px;overflow-x:auto}
.pa-tabs button{min-height:44px;padding:0 16px;border:0;border-radius:999px;background:transparent;color:var(--rl-ink);white-space:nowrap;font:600 .9375rem/1 var(--sans,"Manrope",system-ui,sans-serif);cursor:pointer;touch-action:manipulation;transition:transform .15s var(--rl-ease),background-color .15s var(--rl-ease),color .15s var(--rl-ease)}
.pa-tabs button:active{transform:scale(.97)}
.pa-tabs button[aria-pressed="true"]{background:var(--rl-gold);color:var(--rl-deep)}
.pa-blurb{margin:0 0 20px;text-align:center;font:400 1rem/1.5 var(--sans,"Manrope",system-ui,sans-serif);color:var(--rl-dim)}
.pa-group[hidden]{display:none}
.pk-row{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 4px 28px;margin:0 calc(var(--pad,20px)*-1);padding-inline:var(--pad,20px);scroll-padding-inline:var(--pad,20px);align-items:flex-start;overscroll-behavior-x:contain}
.pk{flex:0 0 min(84vw,330px);scroll-snap-align:center;perspective:900px;animation:pk-in .5s var(--rl-ease) backwards;animation-delay:calc(min(var(--i),5)*60ms)}
@keyframes pk-in{from{opacity:0;transform:scale(.95) translateY(8px)}}
.pk-face{position:relative;transform-style:preserve-3d;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .2s var(--rl-ease);padding:72px 24px 24px;border-radius:165px 165px 24px 24px;color:var(--pk-cream);text-align:center;box-shadow:0 16px 28px color-mix(in srgb,var(--rl-deep) 55%,transparent)}
.pk-face[data-tone="red"]{background:var(--pk-red)}
.pk-face[data-tone="green"]{background:var(--pk-green)}
.pk-name{margin:0 0 8px;transform:translateZ(18px);font:700 clamp(1.5rem,5vw,1.875rem)/1.1 var(--sans,"Manrope",system-ui,sans-serif);text-wrap:balance}
.pk-price{margin:0 0 20px;display:grid;gap:2px;transform:translateZ(34px)}
.pk-unit{font:500 .875rem/1.3 var(--sans,"Manrope",system-ui,sans-serif)}
.pk-sum{margin:0 0 16px;text-align:left;display:grid;gap:10px}
.pk-sum div{padding-top:10px;border-top:1px solid color-mix(in srgb,var(--pk-cream) 40%,transparent)}
.pk-sum dt{font:700 .9375rem/1.3 var(--sans,"Manrope",system-ui,sans-serif)}
.pk-sum dd{margin:2px 0 0;font:400 .9375rem/1.4 var(--sans,"Manrope",system-ui,sans-serif)}
.pk-more{margin:0 0 16px;text-align:left}
