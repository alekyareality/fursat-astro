.pk-sec p{margin:0;font:400 .9375rem/1.5 var(--sans,"Manrope",system-ui,sans-serif)}
.pk-sec .pk-age{margin-top:6px;font-weight:700}
.pk-plan{min-height:48px;width:100%;border:2px solid var(--pk-cream);border-radius:999px;background:var(--pk-cream);color:var(--rl-deep);font:700 1rem/1 var(--sans,"Manrope",system-ui,sans-serif);cursor:pointer;touch-action:manipulation;transition:transform .15s var(--rl-ease),background-color .15s var(--rl-ease)}
.pk-plan:active,.pa-wa:active,.pa-step button:active{transform:scale(.97)}
.pk-plan:focus-visible{outline-color:var(--pk-cream);outline-offset:3px}
.pa-plan,.pa-choices,.pa-add{margin-top:clamp(32px,6vw,64px);max-width:720px;margin-inline:auto}
.pa-plan h2,.pa-choices h2,.pa-add h2{margin:0 0 16px;font:500 clamp(1.5rem,4vw,2.25rem)/1.15 var(--serif,"Playfair Display",Georgia,serif);text-wrap:balance}
.pa-fields{display:grid;grid-template-columns:auto 1fr;gap:12px 16px;align-items:center}
