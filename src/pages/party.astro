.pa-fields select option{color:#1A1608}
.pa-step{display:grid;grid-template-columns:48px 1fr 48px;gap:8px}
.pa-step button{min-height:48px;border:1px solid var(--rl-line);border-radius:12px;background:transparent;color:var(--rl-ink);font:600 1.25rem/1 var(--sans,"Manrope",system-ui,sans-serif);cursor:pointer;touch-action:manipulation;transition:transform .15s var(--rl-ease)}
.pa-step input{text-align:center}
.pa-total{margin:20px 0 4px;font:500 clamp(1.75rem,6vw,2.5rem)/1.1 var(--serif,"Playfair Display",Georgia,serif)}
.pa-fine{margin:0 0 16px;font:400 .875rem/1.4 var(--sans,"Manrope",system-ui,sans-serif);color:var(--rl-dim)}
.pa-wa{display:inline-flex;align-items:center;min-height:52px;padding:0 32px;border-radius:999px;background:var(--rl-gold);color:var(--rl-deep);font:700 1rem/1 var(--sans,"Manrope",system-ui,sans-serif);text-decoration:none;touch-action:manipulation;transition:transform .15s var(--rl-ease),background-color .15s var(--rl-ease)}
.pa-acc{border-top:1px solid var(--rl-track)}
.pa-acc:last-of-type{border-bottom:1px solid var(--rl-track)}
.pa-acc summary{min-height:56px;display:flex;align-items:center;cursor:pointer;font:500 1.25rem/1.25 var(--serif,"Playfair Display",Georgia,serif)}
.pa-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px 24px;padding:0 0 20px}
