---
// catering.astro - Outdoor Catering by Fursat
// Royal Deccan feasts delivered & live-cooked at your venue
import Base from '../layouts/Base.astro';
import '../styles/fk-tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import MascotOfferModal from '../components/MascotOfferModal.astro';
---
<Base
  title="Catering & Buffets — Fursat Kitchen | Bar | Hyderabad"
  description="Fursat off-site catering for weddings, corporate lunches and private parties. Full buffet setups, live counters, bar service. Hyderabad-wide delivery."
  canonical="https://fursatind.in/catering/"
  ogImage="https://fursatind.in/assets/fursat_space_14.webp"
  ogImageAlt="Fursat catering — buffet and live counter service"
>
  <SiteHeader active="celebrate" variant="plaster" />

  <main class="ct-page" id="main">
    <!-- Hero Section -->
    <section class="ct-hero">
      <div class="ct-hero-wrap">
        <span class="ct-kicker">GOURMET EXPERIENCES AT YOUR VENUE</span>
        <h1 class="ct-title mot-headline">Fursat Outdoor Catering</h1>
        <p class="ct-sub">
          Bring the signature flavors, live tandoor artistry, and royal hospitality of Fursat to your farmhouse, villa, convention hall, or corporate campus across Hyderabad.
        </p>
        <div class="ct-hero-btns">
          <a href="#quote" class="ct-btn-gold">Request Catering Menu & Quote</a>
          <a href="tel:+919059670033" class="ct-btn-ghost">Call Catering Chef: +91 90596 70033</a>
        </div>
      </div>
    </section>

    <!-- Catering Capabilities -->
    <section class="ct-services">
      <div class="ct-container">
        <div class="ct-sec-head text-center">
          <span class="ct-kicker">LIVE COUNTERS & SETUPS</span>
          <h2 class="ct-sec-title mot-headline">What We Bring to Your Gathering</h2>
        </div>

        <div class="ct-grid">
          <div class="ct-card">
            <div class="ct-card-icon">🔥</div>
            <h3>Live Charcoal Tandoor</h3>
            <p>Hot, sizzling Angaraa Tikka, Tandoori Prawns, Paneer Kebabs, and crisp rotis & naans rolled and baked on-site.</p>
          </div>

          <div class="ct-card">
            <div class="ct-card-icon">🍲</div>
            <h3>Dum Biryani Handis</h3>
            <p>Sealed clay and copper handis of Hyderabadi Mutton & Chicken Dum Biryani, unsealed live before your guests for peak aroma.</p>
          </div>

          <div class="ct-card">
            <div class="ct-card-icon">🍹</div>
            <h3>Mocktail & Mixology Bar</h3>
            <p>Bespoke mobile bar setups with flair mixologists serving botanical mocktails, smoked coolers, and cold brews.</p>
          </div>

          <div class="ct-card">
            <div class="ct-card-icon">🧁</div>
            <h3>Live Chaat & Dessert Island</h3>
            <p>Interactive street-food chaats, live jalebi counters, Lotus Biscoff dessert pots, and artisanal ice cream rolls.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Service Scale Section -->
    <section class="ct-scale">
      <div class="ct-container">
        <div class="ct-sec-head text-center">
          <span class="ct-kicker">OUR CATERING SCALE</span>
          <h2 class="ct-sec-title">From Intimate Dinners to Grand Weddings</h2>
        </div>
        <div class="ct-scale-grid">
          <div class="ct-stat-card">
            <div class="ct-stat-number">30–80</div>
            <div class="ct-stat-unit">Guests</div>
            <div class="ct-stat-label">Intimate Gatherings</div>
          </div>
          <div class="ct-stat-card">
            <div class="ct-stat-number">80–300</div>
            <div class="ct-stat-unit">Guests</div>
            <div class="ct-stat-label">Corporate &amp; Social Events</div>
          </div>
          <div class="ct-stat-card">
            <div class="ct-stat-number">300–1500</div>
            <div class="ct-stat-unit">Guests</div>
            <div class="ct-stat-label">Grand Weddings &amp; Conventions</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery Strip -->
    <section class="ct-gallery-strip">
      <div class="ct-gallery-scroll">
        <div class="ct-gallery-item">
          <img src="/assets/interior/fursat_space_02.webp" alt="Fursat Interior Space" loading="lazy" />
        </div>
        <div class="ct-gallery-item">
          <img src="/assets/interior/fursat_space_05.webp" alt="Fursat Dining Area" loading="lazy" />
        </div>
        <div class="ct-gallery-item">
          <img src="/assets/interior/fursat_space_10.webp" alt="Fursat Ambiance" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Catering Quote Form -->
    <section class="ct-quote" id="quote">
      <div class="ct-container ct-quote-wrap">
        <div class="ct-form-card">
          <div class="ct-fc-head">
            <span class="ct-kicker">GET AN ESTIMATE</span>
            <h2>Book Fursat Outdoor Catering</h2>
            <p>Provide your event details below. Our Catering Director will connect with a curated sample menu and per-head pricing.</p>
          </div>

          <form class="ct-form" action="https://wa.me/919059670033" target="_blank" data-wa-form data-wa-intro="Hi Fursat! 👋 I would like a catering quote:" novalidate>
            <p class="ct-req">Fields marked * are required.</p>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f1">Host name <span aria-hidden="true">*</span></label>
                <input type="text" id="ct-f1" name="name" autocomplete="name" maxlength="40" data-l="Name" data-v="text" aria-required="true" aria-describedby="ct-f1-e" data-msg="Please enter your name." placeholder="e.g. Dr. S. Rao" />
                <p class="ct-err" id="ct-f1-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f2">Contact number <span aria-hidden="true">*</span></label>
                <input type="tel" id="ct-f2" name="phone" autocomplete="tel-national" inputmode="numeric" maxlength="14" data-l="Phone" data-v="phone" aria-required="true" aria-describedby="ct-f2-e" placeholder="e.g. 98483 60033" />
                <p class="ct-err" id="ct-f2-e" role="alert"></p>
              </div>
            </div>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f3">Event area in Hyderabad <span aria-hidden="true">*</span></label>
                <input type="text" id="ct-f3" name="area" maxlength="80" data-l="Area" data-v="text" aria-required="true" aria-describedby="ct-f3-e" data-msg="Please enter the event area." placeholder="e.g. Moinabad Farmhouse / Jubilee Hills" />
                <p class="ct-err" id="ct-f3-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f4">Guest count (minimum 30) <span aria-hidden="true">*</span></label>
                <input type="number" id="ct-f4" name="guests" inputmode="numeric" min="30" max="1500" data-l="Guests" data-v="count" aria-required="true" aria-describedby="ct-f4-e" placeholder="e.g. 75" />
                <p class="ct-err" id="ct-f4-e" role="alert"></p>
              </div>
            </div>
            <div class="ct-row">
              <div class="ct-field">
                <label for="ct-f5">Event date <span aria-hidden="true">*</span></label>
                <input type="date" id="ct-f5" name="date" data-l="Date" data-v="date" aria-required="true" aria-describedby="ct-f5-e" />
                <p class="ct-err" id="ct-f5-e" role="alert"></p>
              </div>
              <div class="ct-field">
                <label for="ct-f6">Preferred cuisine mix (optional)</label>
                <select id="ct-f6" name="cuisine" data-l="Cuisine">
                  <option value="North Indian + Royal Hyderabadi">North Indian + Royal Hyderabadi</option>
                  <option value="Pan-Asian + Continental">Pan-Asian + Continental</option>
                  <option value="Pure Vegetarian Feast">Pure Vegetarian Feast</option>
                  <option value="Barbecue & Kebabs Special">Barbecue & Kebabs Special</option>
                </select>
              </div>
            </div>
            <button type="submit" class="ct-submit-btn">
              <span>Request Catering Proposal via WhatsApp</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <MascotOfferModal />
  <SiteFooter />
<MobileBar active="celebrate" />
<script is:inline src="/js/motion-kit.js"></script>
<script>
  const form = document.querySelector('form[data-wa-form]');
  if (form) {
    const fields = Array.from(form.querySelectorAll('input, select'));
    const digits = (v) => { let x = v.replace(/\D/g, ''); if (x.length > 10 && x.startsWith('91')) x = x.slice(2); if (x.length === 11 && x[0] === '0') x = x.slice(1); return x; };
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const errOf = (el) => document.getElementById(el.getAttribute('aria-describedby') || '');
    const check = (el) => {
      const v = el.value.trim(), t = el.dataset.v;
      if (t === 'text') return v.length < 2 ? el.dataset.msg : '';
      if (t === 'phone') return /^[6-9]\d{9}$/.test(digits(v)) ? '' : 'Please enter a valid 10-digit mobile number.';
      if (t === 'count') { const n = Number(v), lo = Number(el.min), hi = Number(el.max); return n >= lo && n <= hi ? '' : 'Please enter ' + lo + ' to ' + hi + ' guests.'; }
      if (t === 'date') return v && v >= today() ? '' : 'Please choose today or a later date.';
      return '';
    };
    const show = (el, msg) => { const e = errOf(el); if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); if (e) e.textContent = msg; };
    const dateEl = form.querySelector('input[type="date"]');
    if (dateEl) dateEl.min = today();
    fields.forEach((el) => {
      if (!el.dataset.v) return;
      el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
      el.addEventListener('change', () => { if (el.hasAttribute('aria-invalid')) show(el, ''); });
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let first = null;
      fields.forEach((el) => { if (!el.dataset.v) return; const m = check(el); show(el, m); if (m && !first) first = el; });
      if (first) { first.focus(); return; }
      const lines = [form.dataset.waIntro];
      fields.forEach((el) => {
        const t = el.dataset.v; let v = el.value.trim();
        if (t === 'phone') { const x = digits(v); v = '+91 ' + x.slice(0, 5) + ' ' + x.slice(5); }
        else if (t === 'date') v = new Date(v + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        else if (el.tagName === 'SELECT') v = el.selectedOptions[0].textContent.trim();
        lines.push('\u2022 ' + el.dataset.l + ': ' + v);
      });
      window.open('https://wa.me/919059670033?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
    });
  }
</script>
</Base>

<style is:global>
  .ct-page {
    background: transparent;
    color: #1f2a1a;
    font-family:var(--fk-sans)}
  .ct-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px)}
  .ct-hero {
    position: relative;
    background: url('/assets/interior/fursat_space_14.webp') center/cover no-repeat;
    padding: clamp(60px, 8vw, 100px) 0;
    text-align: center;
    border-bottom: 1px solid rgba(201,154,67,0.40)}
  .ct-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(238,212,178,.82) 0%, rgba(238,212,178,.95) 100%)}
  .ct-hero-wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1}
  .ct-kicker {
    font-size: 0.8125rem;
    font-weight:600;
    letter-spacing: 0.16em;
    color: #74501a;
    display: block;
    margin-bottom: 10px}
  .ct-title {
    font-family:var(--fk-serif);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 600;
    color: #1f2a1a;
    margin: 0 0 16px;
    line-height: 1.15}
  .ct-sub {
    font-size: 1.05rem;
    color: #4a4232;
    line-height: 1.6;
    margin: 0 0 32px}
  .ct-hero-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px}
  .ct-btn-gold {
    padding: 14px 28px;
    border-radius: 999px;
    background: var(--fk-action-bg);
    color: #fbf3e6;
    font-weight:600;
    text-decoration: none;border-color:var(--fk-action-rim);box-shadow:var(--fk-action-shadow);color:var(--fk-action-fg)}
  .ct-btn-ghost {
    padding: 14px 26px;
    border-radius: 999px;
    background: rgba(255,250,242,0.87);
    border: 1px solid rgba(201,154,67,0.55);
    color: #1f2a1a;
    font-weight: 700;
    text-decoration: none}

  /* Services Grid */
  .ct-services {
    padding: clamp(60px, 8vw, 110px) 0}
  .ct-sec-title {
    font-family:var(--fk-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #1f2a1a;
    margin: 0 0 40px}
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 24px}
  .ct-card {
    background: rgba(255,250,242,0.71);
    border: 1px solid rgba(201,154,67,0.45);
    border-radius: 24px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px}
  .ct-card-icon {
    font-size: 2.2rem}
  .ct-card h3 {
    font-family:var(--fk-serif);
    font-size: 1.35rem;
    color: #1f2a1a;
    margin: 0}
  .ct-card p {
    font-size: 0.925rem;
    color: #4a4232;
    margin: 0;
    line-height: 1.5}

  /* Quote Form */
  .ct-quote {
    padding: clamp(60px, 8vw, 100px) 0;
    background: #efd8b8}
  .ct-quote-wrap {
    max-width: 820px}
  .ct-form-card {
    background: transparent;
    border: 2px solid rgba(201,154,67,0.60);
    border-radius: 28px;
    padding: clamp(28px, 5vw, 48px)}
  .ct-fc-head {
    margin-bottom: 28px}
  .ct-fc-head h2 {
    font-family:var(--fk-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: #1f2a1a;
    margin: 6px 0 10px}
  .ct-fc-head p {
    font-size: 0.95rem;
    color: #4a4232;
    margin: 0}
  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 18px}
  .ct-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px}
  @media (min-width: 640px) {
    .ct-row { grid-template-columns: 1fr 1fr}
  }
  .ct-field {
    display: flex;
    flex-direction: column;
    gap: 6px}
  .ct-field label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #74501a}
  .ct-field input, .ct-field select {
    background: #e9cfab;
    border: 1px solid rgba(201,154,67,0.50);
    border-radius: 10px;
    padding: 12px 14px;
    color: #1f2a1a;
    font-family:var(--fk-sans);
    font-size: 0.9375rem}
  .ct-field input:focus, .ct-field select:focus {
    outline: none;
    border-color: #d6aa5a}
  .ct-submit-btn {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    border-radius: 999px;
    background: var(--fk-action-bg);
    color: #fbf3e6;
    font-weight:600;
    font-size: 1rem;
    margin-top: 10px;
    box-shadow: 0 6px 20px rgba(201,154,67,0.28);border-color:var(--fk-action-rim);box-shadow:var(--fk-action-shadow);color:var(--fk-action-fg)}
  .ct-submit-btn svg { width: 18px; height: 18px}

  /* Scale / Stats Section */
  .ct-scale {
    padding: clamp(50px, 7vw, 90px) 0;
    background: #efd8b8;
    border-top: 1px solid rgba(201,154,67,0.35);
    border-bottom: 1px solid rgba(201,154,67,0.35)}
  .ct-sec-head {
    margin-bottom: 40px}
  .ct-scale-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px}
  .ct-stat-card {
    background: rgba(214,170,90,0.13);
    border: 1px solid rgba(201,154,67,0.50);
    border-radius: 24px;
    padding: 36px 28px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: transform 0.2s ease, box-shadow 0.2s ease}
  .ct-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(201,154,67,0.14)}
  .ct-stat-number {
    font-family:var(--fk-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #74501a;
    line-height: 1}
  .ct-stat-unit {
    font-size: 0.875rem;
    font-weight: 700;
    color: #4a4232;
    letter-spacing: 0.08em;
    text-transform: uppercase}
  .ct-stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: #1f2a1a;
    margin-top: 4px}

  /* Gallery Strip */
  .ct-gallery-strip {
    padding: clamp(40px, 6vw, 70px) 0;
    overflow: hidden}
  .ct-gallery-scroll {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 0 clamp(16px, 4vw, 40px) 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(201,154,67,.5) transparent}
  .ct-gallery-scroll::-webkit-scrollbar {
    height: 4px}
  .ct-gallery-scroll::-webkit-scrollbar-thumb {
    background: rgba(214,170,90,0.35);
    border-radius: 999px}
  .ct-gallery-item {
    flex: 0 0 clamp(260px, 30vw, 420px);
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 64px 8px 64px 8px;
    box-shadow: 0 12px 40px rgba(90,60,20,0.20)}
  .ct-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease}
  .ct-gallery-item:hover img {
    transform: scale(1.06)}

  .ct-req { margin: 0 0 4px; font-size: 0.8125rem; color: #74501a}
  .ct-field input, .ct-field select { min-height: 48px; font-size: 1rem}
  .ct-field input:focus-visible, .ct-field select:focus-visible { outline: 3px solid #12803C; outline-offset: 2px}
  .ct-field [aria-invalid="true"] { border-color: #C4161C; box-shadow: 0 0 0 3px rgba(196,22,28,0.14)}
  .ct-err { margin: 0; min-height: 0; font-size: 0.8125rem; font-weight: 700; line-height: 1.4; color: #A8141A}
  .ct-submit-btn { min-height: 48px}
</style>
