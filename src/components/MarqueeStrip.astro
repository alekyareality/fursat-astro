---
/**
 * MarqueeStrip.astro — Fursat Kitchen | Bar
 * Horizontal CSS marquee strip. No JS required for animation.
 * Pauses on hover and focus-within for accessibility.
 *
 * Props:
 *   items     — Array of strings to display
 *   speed     — Animation duration in seconds (default 32)
 *   direction — 'left' (default) | 'right'
 *
 * CSS prefix: mq-
 */
interface Props {
  items?: string[];
  speed?: number;
  direction?: 'left' | 'right';
}

const {
  items = [
    'Hyderabadi Biryani',
    'Tandoor Specials',
    'Craft Cocktails',
    'Continental',
    'North Indian',
    'Asian',
    'Street Food',
    'Desserts',
  ],
  speed = 32,
  direction = 'left',
} = Astro.props;

const animDir = direction === 'right' ? 'mq-scroll-right' : 'mq-scroll-left';
---

<div class="mq-strip mot-marquee" aria-hidden="true">
  <div class="mq-skew-wrap">
    <!-- Two copies of items for seamless loop -->
    <div class:list={['mq-track', animDir]} style={`--mq-speed:${speed}s`}>
      {items.map(item => (
        <span class="mq-item">
          <span class="mq-dot" aria-hidden="true">✦</span>
          {item}
        </span>
      ))}
      {/* Duplicate for seamless wrap */}
      {items.map(item => (
        <span class="mq-item" aria-hidden="true">
          <span class="mq-dot">✦</span>
          {item}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  /* ── Keyframes ─────────────────────────────────────────────────────────── */
  @keyframes mq-scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes mq-scroll-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  /* ── Strip Container ───────────────────────────────────────────────────── */
  .mq-strip {
    width: 100%;
    overflow: hidden;
    background: linear-gradient(135deg, #1A1200 0%, #2A1E00 100%);
    border-top: 1px solid rgba(224, 166, 60, 0.2);
    border-bottom: 1px solid rgba(224, 166, 60, 0.2);
    padding: 14px 0;
    /* Pause on hover */
  }
  .mq-strip:hover .mq-track,
  .mq-strip:focus-within .mq-track {
    animation-play-state: paused;
  }

  /* ── Skew Wrapper (Driven by scroll velocity) ─────────────────────────── */
  .mq-skew-wrap {
    display: block;
    width: 100%;
    transform: skewX(var(--mq-skew, 0deg));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* ── Scrolling Track ───────────────────────────────────────────────────── */
  .mq-track {
    display: inline-flex;
    align-items: center;
    gap: 0;
    white-space: nowrap;
    will-change: transform;
  }
  .mq-track.mq-scroll-left {
    animation: mq-scroll-left var(--mq-speed, 32s) linear infinite;
  }
  .mq-track.mq-scroll-right {
    animation: mq-scroll-right var(--mq-speed, 32s) linear infinite;
  }

  /* ── Individual Items ──────────────────────────────────────────────────── */
  .mq-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 28px;
    font-family: var(--sans, 'Manrope', system-ui, sans-serif);
    font-size: clamp(0.8125rem, 1.2vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(244, 236, 218, 0.82);
    text-transform: uppercase;
  }

  .mq-dot {
    color: #E0A63C;
    font-size: 0.6rem;
    flex-shrink: 0;
  }

  /* ── Reduced Motion: Stop animation ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .mq-skew-wrap {
      transform: none !important;
    }
    .mq-track {
      animation: none !important;
    }
    /* Show items wrapped instead */
    .mq-strip {
      overflow: visible;
    }
    .mq-track {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      padding: 0 24px;
    }
  }
</style>

<script is:inline>
  // ── BATCH 1.1: Velocity-skewed kinetic marquee ─────────────────────────
  (function initVelocityMarquee() {
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (calm) return;

    var strip = document.querySelector('.mq-strip');
    if (!strip) return;

    var inView = false;
    var lastY = window.scrollY || window.pageYOffset;
    var currentSkew = 0;
    var targetSkew = 0;
    var rAFId = null;

    // Pause off-screen via IntersectionObserver
    var obs = new IntersectionObserver(function (entries) {
      inView = entries[0].isIntersecting;
      if (inView) {
        lastY = window.scrollY || window.pageYOffset;
      } else if (rAFId) {
        cancelAnimationFrame(rAFId);
        rAFId = null;
        currentSkew = 0;
        targetSkew = 0;
        strip.style.setProperty('--mq-skew', '0deg');
      }
    }, { threshold: 0.05 });
    obs.observe(strip);

    function onScroll() {
      if (!inView) return;
      var curY = window.scrollY || window.pageYOffset;
      var delta = curY - lastY;
      lastY = curY;

      // Clamped skewX between -8deg and +8deg
      targetSkew = Math.max(-8, Math.min(8, delta * -0.18));

      if (!rAFId) {
        rAFId = requestAnimationFrame(tick);
      }
    }

    function tick() {
      rAFId = null;
      if (!inView) return;

      // Smooth ease back
      currentSkew += (targetSkew - currentSkew) * 0.12;
      // Decay targetSkew towards 0 on every tick
      targetSkew *= 0.85;

      if (Math.abs(currentSkew) < 0.02 && Math.abs(targetSkew) < 0.02) {
        currentSkew = 0;
        targetSkew = 0;
        strip.style.setProperty('--mq-skew', '0deg');
        return;
      }

      strip.style.setProperty('--mq-skew', currentSkew.toFixed(2) + 'deg');
      rAFId = requestAnimationFrame(tick);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
