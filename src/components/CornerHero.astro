---
// CornerHero — cream plaster hero with the gold corner art. The real Fursat photo is already baked into the art's
// window (scripts/make-heroes.py), so the page loads ONE image: no empty brown window while photos load.
// A tiny blurred copy (LQIP) shows instantly, the sharp image fades over it. Text sits on the calm side of the art.
import heroes from '../data/heroes.json';
interface Cta { label: string; href: string; primary?: boolean; book?: boolean; external?: boolean }
interface Props { page: 'cafe' | 'bar' | 'party' | 'banquet'; kicker: string; h1a: string; h1b?: string; lead: string; ctas: Cta[]; alt: string; id?: string }
const { page, kicker, h1a, h1b, lead, ctas, alt, id = 'ch-h1' } = Astro.props;
const h = (heroes as any)[page];
const textRight = h.windows[0][0] < 20; // window on the left (banquet art) -> text on the right
const src = (w: number) => `/assets/heroes/${page}-${w}.webp`;
---
<section class:list={['ch', { 'ch--right': textRight }]} aria-labelledby={id} style={`--ch-ar:${h.w}/${h.h};--ch-lqip:url('${h.lqip}')`}>
  <div class="ch-art">
    <img class="ch-img" src={src(1024)} srcset={`${src(768)} 768w, ${src(1024)} 1024w, ${src(1536)} 1536w`} sizes="100vw"
      width={h.w} height={h.h} alt={alt} fetchpriority="high" loading="eager" decoding="async"
      onload="this.classList.add('is-in')" />
  </div>
  <div class="ch-copy">
    <p class="ch-kick">{kicker}</p>
    <h1 class="ch-h1" id={id}>{h1a}{h1b && <> <span class="ch-hl">{h1b}</span></>}</h1>
    <svg class="ch-orn" viewBox="0 0 260 24" aria-hidden="true"><path d="M2 12 H104" /><path d="M156 12 H258" /><path d="M130 3 C122 9 122 15 130 21 C138 15 138 9 130 3 Z" /></svg>
    <p class="ch-lead">{lead}</p>
    <div class="ch-btns">
      {ctas.map((c) => (
        <a class:list={['fk-btn', c.primary ? 'fk-btn--solid' : 'fk-btn--line']} href={c.href} data-open={c.book ? 'book' : undefined}
          target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
          <span>{c.label}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      ))}
    </div>
  </div>
</section>
<script is:inline>document.querySelectorAll('.ch-img').forEach(function (i) { if (i.complete && i.naturalWidth) i.classList.add('is-in'); });</script>
<style>
.ch { position: relative; display: grid; align-items: center; min-height: min(100svh, calc(var(--sh-h, 84px) + 100vw * 941 / 1672)); padding-top: var(--sh-h, 84px); overflow: hidden; background: #f6e4c9 var(--ch-lqip) center / cover no-repeat; isolation: isolate; }
.ch-art { position: absolute; inset: var(--sh-h, 84px) 0 0 0; z-index: -1; }
.ch-img { width: 100%; height: 100%; object-fit: cover; object-position: right center; display: block; opacity: 0; transition: opacity 600ms cubic-bezier(.23,1,.32,1); }
.ch--right .ch-img { object-position: left center; }
.ch-img.is-in { opacity: 1; }
.ch-copy { width: min(52%, 640px); margin-left: clamp(20px, 6vw, 96px); padding: clamp(24px, 4vw, 48px) 0; color: #1f2a1a; }
.ch--right .ch-copy { margin-left: auto; margin-right: clamp(20px, 6vw, 96px); width: min(50%, 600px); }
.ch-kick { margin: 0 0 12px; font: 600 .8rem/1.2 var(--fk-sans, Poppins, sans-serif); letter-spacing: .18em; text-transform: uppercase; color: #8a5a22; }
.ch-h1 { margin: 0; font: 500 clamp(2.3rem, 4.6vw, 4.2rem)/1.05 var(--fk-serif, 'Playfair Display', Georgia, serif); letter-spacing: -.02em; text-wrap: balance; color: #18301f; }
.ch-hl { color: #9c4f1c; font-style: italic; }
.ch-orn { width: 180px; height: 18px; margin: 18px 0 14px; fill: none; stroke: #c99a43; stroke-width: 1.4; }
.ch-lead { margin: 0 0 24px; max-width: 46ch; font: 400 clamp(1rem, 1.2vw, 1.12rem)/1.6 var(--fk-sans, Poppins, sans-serif); color: #4d4434; }
.ch-btns { display: flex; flex-wrap: wrap; gap: 12px; }
.ch-btns .fk-btn { padding: 0 24px; min-height: 48px; }
@media (max-width: 820px) {
  .ch { display: block; min-height: 0; padding-top: var(--sh-h, 72px); background-image: none; }
  .ch-art { position: relative; inset: auto; z-index: auto; aspect-ratio: 16 / 9; background: var(--ch-lqip) right center / cover no-repeat; }
  .ch-img { object-position: right center; }
  .ch--right .ch-art { background-position: left center; }
  .ch-copy, .ch--right .ch-copy { width: auto; margin: 0; padding: 20px clamp(16px, 5vw, 28px) 32px; }
}
@media (prefers-reduced-motion: reduce) { .ch-img { transition: none; } }
</style>
