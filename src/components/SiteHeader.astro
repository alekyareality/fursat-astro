  .sh-header.sh-plaster.sh-scrolled { background: rgba(250, 243, 233, .9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom-color: rgba(201, 154, 67, .28); box-shadow: 0 10px 28px rgba(60, 40, 10, .1); }
  .sh-header.sh-plaster.sh-scrolled .sh-logo img { height: clamp(40px, 4.2vw, 54px); }
