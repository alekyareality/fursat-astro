---
// ExperienceCards.astro — "Choose Your Experience". Photos are real venue shots (tour/img/sm) + gradient.
// GAPS (no real photo exists yet): celebration/cake setup, people at a group table, banquet hall. See delivery note.
const cards = [
  { id: 'date-night', title: 'Date Night', text: 'Intimate dining & drinks.', cta: 'Reserve a Table', img: 'table-for-two', icon: 'glasses' },
  { id: 'birthday', title: 'Birthday & Celebrations', text: 'Birthdays, anniversaries and special moments.', cta: 'Plan Your Celebration', img: 'sofa-corner', icon: 'cake' },
  { id: 'groups', title: 'Friends & Groups', text: 'Group dining, get-togethers and reunions.', cta: 'Book for a Group', img: 'booths', icon: 'group' },
  { id: 'private', title: 'Private Events & Corporate', text: 'Business dinners, private events and banquet enquiries.', cta: 'Enquire Now', img: 'high-tables', icon: 'briefcase', href: '/banquet' },
];
const icons: Record<string,string> = {
  glasses: '<path d="M8 3h5l-1 6a2.5 2.5 0 0 1-5 0zM10.5 11.5V19M7.5 19h6M16 8.5h4l-.8 4.4a2 2 0 0 1-3.4 0zM18 14.5V20M15.5 20h5"/>',
  cake: '<path d="M4 20h16M5 20v-6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6M5 15c2 1.5 3.5 1.5 5 0s3-1.5 4 0 3 1.5 5 0M9 12V9M12 12V8M15 12V9M9 6.5v-1M12 5.5v-1M15 6.5v-1"/>',
  group: '<circle cx="12" cy="8" r="2.5"/><circle cx="5.5" cy="10" r="2"/><circle cx="18.5" cy="10" r="2"/><path d="M7.5 19c0-3 2-5 4.5-5s4.5 2 4.5 5M2.5 18c0-2.3 1.4-3.8 3-3.8M21.5 18c0-2.3-1.4-3.8-3-3.8"/>',
  briefcase: '<rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v1.5M3.5 13h17M11 13v1.5h2V13"/>',
};
---
<section aria-labelledby="rs-x-h">
  <div class="rs-title"><i aria-hidden="true"></i><h2 id="rs-x-h">Choose Your Experience</h2><i aria-hidden="true"></i></div>
  <div class="rs-xrow fk-cards">
    {cards.map((c, i) => (
      <article class="rs-xcard rs-card-in fk-card" style={`--i:${i}`}>
        <div class="fk-card__ph">
          <img src={`/assets/tour/img/sm/${c.img}.webp`} alt="" width="540" height="405" loading="lazy" decoding="async" />
          <span class="fk-card__badge" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[c.icon]}></svg></span>
        </div>
        <div class="fk-card__b">
          <h3 class="fk-card__t">{c.title}</h3>
          <p class="fk-card__p">{c.text}</p>
          <div class="fk-card__foot">
            <span class="fk-card__more">{c.cta}</span>
            {c.href
              ? <a class="fk-card__go" href={c.href} aria-label={c.cta}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
              : <button class="fk-card__go" type="button" data-xp={c.id} aria-label={c.cta}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
