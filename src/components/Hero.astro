---
import slots from '../data/slots.json';
import site from '../data/site.json';
---
<section class="fxhero" id="top" aria-label="Fursat Kitchen | Bar">
 <!-- ambient background, anchored to the viewport edges -->
 <div class="fx-bg" aria-hidden="true">
  <svg class="fx-leaf" viewBox="0 0 1536 1024" preserveAspectRatio="xMinYMin slice"><g filter="url(#fxLeafBlur)" fill="#6a6a34" opacity=".22">
    <g transform="translate(-40 40) rotate(28)"><path d="M0,0 C60,-18 120,-18 190,6 C120,22 60,22 0,0Z"/><path d="M20,80 C70,52 130,52 200,84 C130,104 70,104 20,80Z"/><path d="M-10,170 C50,140 120,142 186,176 C120,196 50,198 -10,170Z"/><path d="M30,260 C80,232 140,236 196,270 C140,288 80,288 30,260Z"/></g>
    <g transform="translate(70 -30) rotate(52)"><path d="M0,0 C46,-14 92,-12 140,6 C92,18 46,18 0,0Z"/><path d="M10,64 C52,42 100,44 150,70 C100,86 52,86 10,64Z"/><path d="M0,130 C44,110 92,114 136,140 C92,152 44,152 0,130Z"/></g>
    <path d="M-20,330 C30,300 70,320 80,360 C50,352 20,352 -20,372Z"/><path d="M0,440 C40,420 80,440 84,480 C54,470 24,470 0,490Z"/>
    <g transform="translate(1330 -20) rotate(-12)"><path d="M0,0 C46,-14 92,-12 140,6 C92,18 46,18 0,0Z"/><path d="M60,60 C102,38 150,40 200,66 C150,82 102,82 60,60Z"/></g></g></svg>
  <svg class="fx-olive fx-olive-l" viewBox="0 0 340 280" preserveAspectRatio="none"><path d="M0,0 C70,0 130,25 190,70 C240,102 300,106 340,108 C262,120 192,130 140,170 C90,210 40,240 0,262 Z" fill="url(#gOlive)"/></svg>
  <svg class="fx-olive fx-olive-b" viewBox="0 0 100 64" preserveAspectRatio="none"><path d="M0,0 C40,14 82,30 100,64 L0,64 Z" fill="#46411B"/></svg>
 </div>

 <div class="fx-stage" id="fxstage"><div class="fx-pl" id="fxpl"><video class="fx-pl-rv" id="fxplv" aria-hidden="true" muted loop disablepictureinpicture disableremoteplayback playsinline webkit-playsinline preload="none" poster="/assets/51db3af80d.webp" data-src="/assets/hero-master-v2.mp4" data-src-sm="/assets/hero-master-v2-sm.mp4"></video><div class="fx-dn" id="fxdn" data-dish="" aria-hidden="true" hidden><b class="fx-dn-n" id="fxdn-n"></b><span class="fx-dn-bar" aria-hidden="true"><i id="fxdn-b"></i></span></div><div class="hx-ctl" role="group" aria-label="Background music and video"><button class="snd nudge" id="snd" type="button" aria-pressed="false" aria-label="Toggle background music"><span class="vz-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="snd-t">Set the mood</span></button><button class="fx-pv" id="fxpv" type="button" data-s="playing" aria-label="Pause background video"><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg></button></div></div>

  <div class="txt">
   <p class="fx-eye rv" style="--d:.25s"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" fill="currentColor"/></svg>Good food <i>·</i> Great drinks <i>·</i> Better days</p>
   <h1 class="fx-h1" aria-label="Your Moment to Pause."><b class="l1"><u>Your</u></b><b class="l2"><u>Moment</u></b><b class="l3"><u>to Pause<s>.</s></u></b></h1>
   <p class="fx-p rv" style="--d:.55s">Café, kitchen, bar and banquet at Capital Park, Madhapur.</p>
   <div class="fx-btns rv" style="--d:.7s"><button class="pill" type="button" data-open="book">Reserve a table <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><a class="fx-ghost" href="/menu">Explore the menu <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
  </div>

  <aside class="fx-info rv" style="--d:1.05s" aria-label="Visit Fursat"><i class="fi-d" aria-hidden="true"></i><span class="fi-a"><b>Table slots {slots[0].time} – {slots[slots.length - 1].time}</b><small>Capital Park, Madhapur · {site.phone}</small></span></aside>


  <nav class="fx-igcol" aria-label="Fursat on Instagram"><span class="fx-igcol-h">Follow along</span><div class="fx-igwin"><div class="fx-igtrk"><a class="igx-i" href="https://www.instagram.com/fursatind.in" target="_blank" rel="noopener"><i class="igx-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg></i><b>Kitchen &amp; Bar</b><small>@fursatind.in</small></a><a class="igx-i" href="https://www.instagram.com/fursat_bitesandbuffet" target="_blank" rel="noopener"><i class="igx-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg></i><b>Bites &amp; Buffet</b><small>@fursat_bitesandbuffet</small></a><a class="igx-i" href="https://www.instagram.com/fursatbanquets" target="_blank" rel="noopener"><i class="igx-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg></i><b>Banquets &amp; Events</b><small>@fursatbanquets</small></a><a class="igx-i" href="https://www.instagram.com/fursatsocialclub" target="_blank" rel="noopener"><i class="igx-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg></i><b>Social Club</b><small>@fursatsocialclub</small></a></div></div></nav>
  
 </div>
</section>
