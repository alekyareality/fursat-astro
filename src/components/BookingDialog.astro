<dialog class="fx-book" id="fxbook" aria-labelledby="fxbook-h"><form method="dialog" id="fxbook-f"><button class="fx-book-x" type="button" id="fxbook-x" aria-label="Close">×</button><h3 id="fxbook-h">Reserve a table</h3><p>Two taps and we continue on WhatsApp.</p><label>Name<input id="bk-n" name="name" type="text" autocomplete="name" placeholder="e.g. Ananya…"></label><div class="bk-row"><label>Date<input id="bk-d" name="date" type="date" autocomplete="off"></label><label>Time<select id="bk-t" name="time"><option>12:00 PM</option><option>1:00 PM</option><option>2:00 PM</option><option>4:00 PM</option><option>6:00 PM</option><option>7:00 PM</option><option selected>8:00 PM</option><option>9:00 PM</option><option>10:00 PM</option></select></label></div><div class="bk-row"><label>Guests<div class="bk-g"><button type="button" id="bk-m" aria-label="Fewer guests">−</button><output id="bk-c">2</output><button type="button" id="bk-p" aria-label="More guests">+</button></div></label><label>Zone<select id="bk-z" name="zone"><option>Café</option><option>Kitchen</option><option selected>Bar</option><option>Banquets</option></select></label></div><button class="bk-go" type="submit" id="bk-go">Send on WhatsApp</button></form></dialog>
