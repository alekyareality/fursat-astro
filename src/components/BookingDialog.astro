<dialog class="fx-book" id="fxbook" aria-labelledby="fxbook-h" aria-describedby="fxbook-s"><form method="dialog" id="fxbook-f" novalidate><button class="fx-book-x" type="button" id="fxbook-x" aria-label="Close booking form">×</button><h3 id="fxbook-h">Reserve a table</h3><p id="fxbook-s">Fill in your details and we open WhatsApp with them ready to send.</p><div class="bk-f"><label>Name<input id="bk-n" name="name" type="text" autocomplete="name" maxlength="40" required aria-required="true" aria-describedby="bk-en" placeholder="e.g. Ananya…"></label><p class="bk-e" id="bk-en" role="alert"></p></div><div class="bk-f"><label>Mobile number<input id="bk-ph" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" required aria-required="true" aria-describedby="bk-eph" placeholder="10-digit number"></label><p class="bk-e" id="bk-eph" role="alert"></p></div><div class="bk-row"><div class="bk-f"><label>Date<input id="bk-d" name="date" type="date" autocomplete="off" required aria-describedby="bk-ed"></label><p class="bk-e" id="bk-ed" role="alert"></p></div><label>Time<select id="bk-t" name="time"><option>12 PM</option><option>1 PM</option><option>2 PM</option><option>3 PM</option><option>4 PM</option><option>5 PM</option><option>6 PM</option><option>7 PM</option><option selected>8 PM</option><option>9 PM</option><option>10 PM</option><option>11 PM</option></select></label></div><div class="bk-row"><div class="bk-lab" role="group" aria-labelledby="bk-gl"><span id="bk-gl">Guests</span><div class="bk-g"><button type="button" id="bk-m" aria-label="Fewer guests">−</button><output id="bk-c" aria-live="polite">2</output><button type="button" id="bk-p" aria-label="More guests">+</button></div></div><label>Zone<select id="bk-z" name="zone"><option>Café</option><option>Kitchen</option><option selected>Bar</option><option>Banquets</option></select></label></div><button class="bk-go" type="submit" id="bk-go">Send on WhatsApp</button></form></dialog>
<style is:global>
.fx-book .bk-lab{display:grid;gap:6px;font:600 11px/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:#6a5f40}
.fx-book form input,.fx-book form select,.fx-book .bk-g{height:48px;font-size:16px}
.fx-book .bk-g{padding:0}
.fx-book .bk-g button{width:48px;height:46px;border-radius:12px}
.fx-book .fx-book-x{width:44px;height:44px;right:10px;top:8px}
.fx-book form input:focus-visible,.fx-book form select:focus-visible,.fx-book form button:focus-visible{outline:3px solid #12803C;outline-offset:2px}
.fx-book [aria-invalid="true"]{border-color:#C4161C;box-shadow:0 0 0 4px rgba(196,22,28,.12)}
.fx-book .bk-f{display:grid;gap:6px;align-content:start}
.fx-book .bk-e{margin:0;font:700 13px/1.4 var(--sans);color:#C4161C}
.fx-book .bk-go{background:#12803C;font-size:15px}
</style>
