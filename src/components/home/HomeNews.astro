---
// HomeNews — "What's new at Fursat": offers, new things on the site, packages, owner announcements and dated wishes.
// Only real data: slots.json (online booking discount), party.json (package prices), news.json (owner-approved items).
import slots from '../../data/slots.json';
import party from '../../data/party.json';
import news from '../../data/news.json';
const inr = (n: number) => '₹' + n.toLocaleString('en-IN');
const maxOff = Math.max(0, ...(slots as any[]).map((s) => s.discount || 0));
const from = (g: string) => Math.min(...(party as any).packages.filter((p: any) => p.group === g).map((p: any) => p.price));
type Item = { tag: string; icon: string; title: string; line: string; href: string; cta: string };
const items: Item[] = [
  ...(news as any).announcements.map((a: any) => ({ tag: a.tag || 'News', icon: 'spark', title: a.title, line: a.line || '', href: a.href || '/', cta: a.cta || 'Read more' })),
  ...(maxOff ? [{ tag: 'Offer', icon: 'tag', title: `Up to ${maxOff}% off your table`, line: 'Book your table online and pick a time slot with the offer.', href: '/reserve', cta: 'Book a table' }] : []),
  { tag: 'New', icon: 'plate', title: 'Build your banquet menu', line: `Choose every dish course by course and send it on WhatsApp. From ${inr(from('banquet'))} per guest.`, href: '/banquet#packages', cta: 'Start building' },
  { tag: 'Packages', icon: 'glass', title: 'Party packages', line: `Bar parties from ${inr(from('bar'))}, elite buffets from ${inr(from('elite'))} per guest.`, href: '/party', cta: 'See packages' },
  { tag: 'New', icon: 'chat', title: 'Ask Fursat', line: 'Tell us what you feel like and see matching dishes and drinks from our menu.', href: '/ask', cta: 'Ask now' },
];
const ICON: Record<string, string> = {
  tag: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>',
  plate: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/>',
  glass: '<path d="M6 3h12l-1.5 7a4.5 4.5 0 0 1-9 0z"/><path d="M12 14.5V21M8.5 21h7"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
};
const wishes = JSON.stringify((news as any).wishes || []);
---
<section class="hn" id="whats-new" aria-labelledby="hn-h">
  <div class="hn-in">
    <div class="hn-head" data-fk-reveal>
      <p class="hn-kick">Latest at Fursat</p>
      <h2 id="hn-h" class="hn-title">What's new</h2>
    </div>
    <p class="hn-wish" id="hn-wish" hidden></p>
    <ul class="hn-row" data-fk-stagger="80">
      {items.map((it) => (
        <li class="hn-card">
          <span class="hn-ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ICON[it.icon] || ICON.spark} /></span>
          <span class={`hn-tag hn-tag--${it.tag.toLowerCase()}`}>{it.tag}</span>
          <h3 class="hn-t">{it.title}</h3>
          <p class="hn-l">{it.line}</p>
          <a class="hn-a" href={it.href}>{it.cta} <span aria-hidden="true">→</span><span class="hn-sr"> — {it.title}</span></a>
        </li>
      ))}
    </ul>
  </div>
</section>
<script is:inline define:vars={{ wishes }}>
(function () {
  var list = []; try { list = JSON.parse(wishes); } catch (e) {}
  var d = new Date(), today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  var w = list.filter(function (x) { return x.text && (!x.from || x.from <= today) && (!x.to || today <= x.to); })[0];
  var el = document.getElementById('hn-wish'); if (w && el) { el.textContent = w.text; el.hidden = false; }
})();
</script>
<style>
.hn { padding: clamp(48px, 6vw, 88px) 0; background: #f6e4c9 url(/assets/surface/plaster-tile.webp) 0 0 / 900px 900px; background-blend-mode: multiply; }
.hn-in { max-width: 1300px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
.hn-head { text-align: center; margin-bottom: clamp(20px, 3vw, 32px); }
.hn-kick { margin: 0 0 8px; font: 600 .78rem/1 Poppins, system-ui, sans-serif; letter-spacing: .18em; text-transform: uppercase; color: #8a5a22; }
.hn-title { margin: 0; font: 500 clamp(2rem, 3.6vw, 3rem)/1.1 "Playfair Display", Georgia, serif; color: #18301f; }
.hn-wish { margin: 0 auto clamp(20px, 3vw, 28px); max-width: 760px; padding: 14px 20px; border-radius: 999px; text-align: center; background: linear-gradient(90deg, rgba(243,211,140,.45), rgba(227,171,74,.3)); box-shadow: inset 0 0 0 1px rgba(201,154,67,.5); font: italic 500 1.1rem/1.4 "Playfair Display", Georgia, serif; color: #6a3a10; }
.hn-row { list-style: none; margin: 0; padding: 4px 2px 12px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 1fr); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
.hn-card { position: relative; scroll-snap-align: start; display: grid; align-content: start; gap: 8px; padding: 22px 20px 20px; border-radius: 22px; background: rgba(255,251,244,.88); box-shadow: inset 0 0 0 1px rgba(201,154,67,.45), 0 16px 30px -22px rgba(90,60,20,.45); }
.hn-ico { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: #fbf3e7; box-shadow: 0 0 0 1px #d6aa5a; }
.hn-ico svg { width: 22px; height: 22px; fill: none; stroke: #8a5a22; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.hn-tag { justify-self: start; padding: 3px 10px; border-radius: 999px; font: 600 .7rem/1.4 Poppins, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; background: #f3e6cf; color: #5a3f12; }
.hn-tag--offer { background: #14321e; color: #f6ecd8; }
.hn-tag--new { background: rgba(156,79,28,.12); color: #8a3a12; }
.hn-t { margin: 0; font: 600 1.15rem/1.25 "Playfair Display", Georgia, serif; color: #1f2a1a; }
.hn-l { margin: 0; font: 400 .92rem/1.55 Poppins, system-ui, sans-serif; color: #5b5240; }
.hn-a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font: 600 .9rem/1 Poppins, system-ui, sans-serif; color: #14321e; text-decoration: none; }
.hn-a::after { content: ""; position: absolute; inset: 0; border-radius: 22px; }
.hn-a:focus-visible { outline: none; } .hn-a:focus-visible::after { outline: 3px solid #1d5a32; outline-offset: 3px; }
.hn-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
@media (hover: hover) and (pointer: fine) { .hn-card { transition: transform 200ms cubic-bezier(.23,1,.32,1); } .hn-card:hover { transform: translateY(-3px); } }
@media (prefers-reduced-motion: reduce) { .hn-card { transition: none; } }
</style>
