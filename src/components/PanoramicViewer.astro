---
// PanoramicViewer.astro - Interactive 3D Panoramic Space Explorer
// Uses authentic Fursat interior photography with drag-to-pan perspective & interactive hotspots
const spaces = [
  {
    id: 'bar-lounge',
    title: 'The Grand Bar & Mixology Lounge',
    tagline: 'Artisanal cocktails, mood lighting & high-energy conversations.',
    image: '/assets/interior/fursat_space_08.webp',
    badge: 'Bar (21+)',
    capacity: '120 Guests',
    hotspots: [
      { x: '28%', y: '48%', title: 'Artisanal Cocktail Bar', desc: 'Curated mixology, barrel-aged spirits & craft beers on tap.' },
      { x: '72%', y: '52%', title: 'High-Top Social Tables', desc: 'Spacious communal seating ideal for bar bashes and groups.' }
    ]
  },
  {
    id: 'cafe-veranda',
    title: 'The Sunlit Café & Coffee Bar',
    tagline: 'Bespoke brews, calm morning light and handcrafted shakes.',
    image: '/assets/interior/fursat_space_11.webp',
    badge: 'Café',
    capacity: '60 Guests',
    hotspots: [
      { x: '35%', y: '58%', title: 'Specialty Espresso Bar', desc: 'Single-origin beans, matcha rituals & freshly whipped shakes.' },
      { x: '78%', y: '42%', title: 'Private Window Booths', desc: 'Natural sunlight, comfortable velvet upholstery & charging docks.' }
    ]
  },
  {
    id: 'dining-hall',
    title: 'The Royal Family Dining Hall',
    tagline: 'Expansive marble tables, warm brass finishes and unhurried feasts.',
    image: '/assets/interior/fursat_space_02.webp',
    badge: 'Fine Dining',
    capacity: '180 Guests',
    hotspots: [
      { x: '45%', y: '65%', title: 'Grand Dining Tables', desc: 'Generous 8-to-12 seater tables engineered for shared thalis & platters.' },
      { x: '82%', y: '35%', title: 'Ambient Acoustic Lighting', desc: 'Custom warmth balance tuned for comfortable dinner conversations.' }
    ]
  },
  {
    id: 'banquet-hall',
    title: 'The Royal Banquet & Celebrations',
    tagline: 'A seamless hall for birthdays, anniversaries, corporate galas & weddings.',
    image: '/assets/interior/fursat_space_18.webp',
    badge: 'Banquet Hall',
    capacity: '50 – 350 Guests',
    hotspots: [
      { x: '50%', y: '38%', title: 'Dedicated Event Stage & AV', desc: 'High-definition projection, pro audio and customized decor backdrops.' },
      { x: '22%', y: '62%', title: 'Custom Buffet Spread Counter', desc: 'Live chaat counters, tandoor stations and gourmet dessert islands.' }
    ]
  }
];
---

<section class="pv-section" id="spaces" aria-labelledby="pv-heading">
  <div class="pv-container">
    <!-- Section Header -->
    <div class="pv-head">
      <div class="pv-head-text">
        <span class="pv-kicker">STEP INSIDE FURSAT</span>
        <h2 class="pv-title" id="pv-heading">Immerse Yourself in Our Spaces</h2>
        <p class="pv-desc">Drag or move your mouse to explore the 3D panoramic ambiance of Capital Park, Madhapur.</p>
      </div>

      <!-- Space Switcher Tabs -->
      <div class="pv-tabs" role="tablist" aria-label="Fursat Spaces">
        {spaces.map((sp, idx) => (
          <button 
            type="button" 
            role="tab" 
            class:list={["pv-tab", { active: idx === 0 }]} 
            data-space-id={sp.id}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`pv-pane-${sp.id}`}
          >
            <span>{sp.title.split('&')[0].trim()}</span>
            <small>{sp.badge}</small>
          </button>
        ))}
      </div>
    </div>

    <!-- 3D Panoramic Viewer Canvas -->
    <div class="pv-stage-wrapper">
      <div class="pv-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>
        <span>Drag or hover to pan 360°</span>
      </div>

      <div class="pv-viewport" id="pv-viewport">
        {spaces.map((sp, idx) => (
          <div 
            class:list={["pv-space-canvas", { active: idx === 0 }]} 
            id={`pv-pane-${sp.id}`} 
            role="tabpanel"
            data-bg={sp.image}
            style={`--bg-img: url('${sp.image}')`}
          >
            <!-- High-Res Panoramic Layer -->
            <div class="pv-pan-layer" id={`pv-pan-${sp.id}`}>
              <img src={sp.image} alt={sp.title} class="pv-pan-img" loading="lazy" />
              
              <!-- Interactive Hotspots -->
              {sp.hotspots.map((hs) => (
                <div class="pv-hotspot" style={`left: ${hs.x}; top: ${hs.y};`}>
                  <button type="button" class="pv-hs-pin" aria-label={`View detail: ${hs.title}`}>
                    <span class="pv-hs-pulse"></span>
                    <span class="pv-hs-dot"></span>
                  </button>
                  <div class="pv-hs-card">
                    <b>{hs.title}</b>
                    <p>{hs.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Foreground Ambient Card Overlay -->
            <div class="pv-info-card">
              <span class="pv-ic-badge">{sp.badge} · {sp.capacity}</span>
              <h3 class="pv-ic-title">{sp.title}</h3>
              <p class="pv-ic-text">{sp.tagline}</p>
              <div class="pv-ic-actions">
                <a href="/reserve" class="pv-ic-btn" data-open="book">Book a Table Here</a>
                <a href={`/${sp.id === 'banquet-hall' ? 'banquet' : sp.id === 'cafe-veranda' ? 'cafe' : 'restaurant-bar'}`} class="pv-ic-link">
                  <span>Explore Details</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .pv-section {
    background: #12190B;
    color: #F4ECDA;
    padding: clamp(64px, 8vw, 120px) 0;
    position: relative;
    overflow: hidden;
  }
  .pv-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .pv-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 32px;
  }
  @media (min-width: 900px) {
    .pv-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .pv-kicker {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #E0A63C;
    display: block;
    margin-bottom: 8px;
  }
  .pv-title {
    font-family: var(--serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 600;
    color: #F4ECDA;
    margin: 0;
    line-height: 1.15;
  }
  .pv-desc {
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
    font-size: 1rem;
    color: rgba(244, 236, 218, 0.7);
    margin: 8px 0 0;
    max-width: 540px;
  }
  .pv-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: none;
  }
  .pv-tabs::-webkit-scrollbar { display: none; }
  .pv-tab {
    all: unset;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 18px;
    border-radius: 12px;
    background: rgba(244, 236, 218, 0.05);
    border: 1px solid rgba(244, 236, 218, 0.15);
    color: rgba(244, 236, 218, 0.8);
    font-family: var(--sans, "Manrope", system-ui, sans-serif);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .pv-tab span {
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .pv-tab small {
    font-size: 0.75rem;
    color: rgba(224, 166, 60, 0.8);
  }
  .pv-tab:hover {
    background: rgba(224, 166, 60, 0.12);
    border-color: rgba(224, 166, 60, 0.4);
    color: #F4ECDA;
  }
  .pv-tab.active {
    background: #E0A63C;
    border-color: #E0A63C;
    color: #1A1608;
    box-shadow: 0 4px 16px rgba(224, 166, 60, 0.35);
  }
  .pv-tab.active small {
    color: #4A3508;
    font-weight: 800;
  }

  /* 3D Stage Viewport */
  .pv-stage-wrapper {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: #090D05;
    border: 2px solid rgba(224, 166, 60, 0.3);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
  }
  .pv-hint {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(13, 19, 8, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(224, 166, 60, 0.3);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #E0A63C;
    pointer-events: none;
  }
  .pv-hint svg {
    width: 16px;
    height: 16px;
    animation: pv-pan-hint 2.5s infinite ease-in-out;
  }
  @keyframes pv-pan-hint {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }

  .pv-viewport {
    position: relative;
    height: clamp(440px, 65vh, 680px);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .pv-viewport:active {
    cursor: grabbing;
  }
  .pv-space-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-out;
    overflow: hidden;
  }
  .pv-space-canvas.active {
    opacity: 1;
    pointer-events: auto;
  }
  .pv-pan-layer {
    position: absolute;
    top: -5%;
    left: -15%;
    width: 130%;
    height: 110%;
    will-change: transform;
    transition: transform 0.12s ease-out;
  }
  .pv-pan-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.92) contrast(1.05);
  }

  /* Hotspot Pins */
  .pv-hotspot {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, -50%);
  }
  .pv-hs-pin {
    all: unset;
    cursor: pointer;
    position: relative;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
  }
  .pv-hs-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #E0A63C;
    box-shadow: 0 0 10px #E0A63C;
    position: relative;
    z-index: 2;
    transition: transform 0.2s ease;
  }
  .pv-hs-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #E0A63C;
    animation: pv-pulse 2s infinite ease-out;
  }
  @keyframes pv-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .pv-hs-card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 220px;
    background: rgba(13, 19, 8, 0.94);
    border: 1.5px solid #E0A63C;
    border-radius: 12px;
    padding: 12px 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 8;
  }
  .pv-hs-pin:hover ~ .pv-hs-card,
  .pv-hotspot:focus-within .pv-hs-card {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .pv-hs-card b {
    display: block;
    color: #E0A63C;
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }
  .pv-hs-card p {
    font-size: 0.8125rem;
    color: rgba(244, 236, 218, 0.85);
    margin: 0;
    line-height: 1.35;
  }

  /* Info Card Overlay */
  .pv-info-card {
    position: absolute;
    left: clamp(16px, 3.5vw, 40px);
    bottom: clamp(16px, 3.5vw, 40px);
    z-index: 6;
    max-width: 440px;
    background: rgba(13, 19, 8, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(224, 166, 60, 0.4);
    border-radius: 20px;
    padding: clamp(20px, 3vw, 28px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
  }
  .pv-ic-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(224, 166, 60, 0.15);
    border: 1px solid rgba(224, 166, 60, 0.4);
    color: #E0A63C;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .pv-ic-title {
    font-family: var(--serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    font-weight: 700;
    color: #F4ECDA;
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .pv-ic-text {
    font-size: 0.9rem;
    color: rgba(244, 236, 218, 0.75);
    margin: 0 0 18px;
    line-height: 1.4;
  }
  .pv-ic-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .pv-ic-btn {
    padding: 10px 20px;
    border-radius: 999px;
    background: #E0A63C;
    color: #1A1608;
    font-weight: 800;
    font-size: 0.875rem;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .pv-ic-btn:hover {
    background: #F4ECDA;
    transform: scale(1.03);
  }
  .pv-ic-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #F4ECDA;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 236, 218, 0.3);
    padding-bottom: 2px;
  }
  .pv-ic-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  .pv-ic-link:hover svg {
    transform: translateX(4px);
  }
  /* ── Reduced motion safety ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .pv-tab,
    .pv-ic-btn,
    .pv-ic-link svg,
    .pv-pan-layer,
    .pv-pin-pulse,
    .pv-pin-tooltip {
      transition: none !important;
      animation: none !important;
    }
    .pv-pin-pulse {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.pv-tab');
    const canvases = document.querySelectorAll('.pv-space-canvas');
    const viewport = document.getElementById('pv-viewport');

    // Tab Switching
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-space-id');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        canvases.forEach(c => c.classList.remove('active'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const activeCanvas = document.getElementById(`pv-pane-${targetId}`);
        if (activeCanvas) activeCanvas.classList.add('active');
      });
    });

    // Skip pan animation if reduced motion is preferred
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 3D Panoramic Pan Effect on Mouse Move / Touch Drag
    let isDragging = false;
    let startX = 0;

    const updatePan = (pct) => {
      if (prefersReducedMotion) return; // skip all pan transforms
      // pct is -1 to 1
      const maxOffset = 60; // px
      const activeLayer = document.querySelector('.pv-space-canvas.active .pv-pan-layer');
      if (activeLayer) {
        activeLayer.style.transform = `translate3d(${pct * maxOffset}px, ${Math.abs(pct) * 8}px, 0) scale(${1.02 + Math.abs(pct) * 0.02})`;
      }
    };

    if (viewport) {
      // Desktop mouse pan
      viewport.addEventListener('mousemove', (e) => {
        const rect = viewport.getBoundingClientRect();
        const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1; // -1 to 1
        updatePan(-normX);
      });

      viewport.addEventListener('mouseleave', () => {
        updatePan(0);
      });

      // Mobile Touch pan
      viewport.addEventListener('touchstart', (e) => {
        isDragging = true;
        startX = e.touches[0].clientX;
      }, { passive: true });

      viewport.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const diffX = e.touches[0].clientX - startX;
        const normX = Math.max(-1, Math.min(1, diffX / 150));
        updatePan(normX);
      }, { passive: true });

      viewport.addEventListener('touchend', () => {
        isDragging = false;
        setTimeout(() => updatePan(0), 400);
      });
    }
  });
</script>
