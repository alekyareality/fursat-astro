        }

        // ── Resize Handler ─────────────────────────────────────────────────
        function onResize() {
          if (!webglWrap) return;
          var w = webglWrap.clientWidth;
          var h = webglWrap.clientHeight;
          camera.aspect = w / h;
          updateCameraFOV();
          renderer.setSize(w, h);
        }
        window.addEventListener('resize', onResize, { passive: true });

        // ── Render Loop ───────────────────────────────────────────────────
        var isSectionVisible = true;
        var visibilityObserver = new IntersectionObserver(function (entries) {
          isSectionVisible = entries[0].isIntersecting;
        });
        visibilityObserver.observe(section);

        function animate(now: number) {
          requestAnimationFrame(animate);
          if (!isSectionVisible) return;

          var t = now * 0.001;

          // Smooth Camera position interpolation (rest vs zoom)
          camera.position.lerp(targetCamPos, 0.08);

          // Apply subtle gyro pitch & yaw offset
          if (gyroEnabled) {
            camera.position.x += gyroYaw * 20;
            camera.position.y += gyroPitch * 15;
          }

          // Camera looks directly towards the active panel area along -Z
          camera.lookAt(0, 0, -350);

          // Smooth rotunda rotation
          if (!isDragging) {
            var diff = targetRotY - currentRotY;
            if (Math.abs(diff) > 0.0005) {
              currentRotY += diff * 0.12;
            } else {
