---
// PanoramicViewer.astro - "Step inside Fursat" Panoramic Walkthrough
// WebGL 3D Curved Cylindrical Rotunda & 360° Equirectangular Spherical Experience
// Real photography only (true 3:4 aspect ratio panels + optional public/panos/ 360 images)
import fs from 'node:fs';
import path from 'node:path';

const tourSpaces = [
  {
    id: 'entrance',
    title: 'Entrance & Elephant Mural',
    kicker: 'Arrival Area',
    desc: 'Handcrafted elephant wall mural, warm wall sconce lighting, and carved wooden doors welcoming you to Fursat.',
    img: '/assets/interior/tour-entrance.webp',
    width: 1050,
    height: 1400,
    tag: 'Entrance',
  },
  {
    id: 'bar',
    title: 'The Bar Counter',
    kicker: 'Bar Counter',
    desc: 'Backlit liquor bottle shelving, illuminated circular Fursat wall sign, and dark bar counter top for cocktail evenings.',
    img: '/assets/interior/tour-bar.webp',
    width: 1050,
    height: 1400,
    tag: 'Bar',
  },
  {
    id: 'high-tables',
    title: 'High-Top Tables & Stools',
    kicker: 'Lounge Seating',
    desc: 'High-top wooden tables with black-frame high bar stools and overhead warm pendant lights for casual gatherings.',
    img: '/assets/interior/tour-high-tables.webp',
    width: 1050,
    height: 1400,
    tag: 'High tables',
  },
  {
    id: 'lounge',
    title: 'Sofa & Table Dining',
    kicker: 'Dining Room',
    desc: 'Green patterned sofa seating, dark square dining tables, indoor potted greenery, and partition screens for group dinners.',
    img: '/assets/interior/tour-lounge.webp',
    width: 1050,
    height: 1400,
    tag: 'Lounge',
  },
  {
    id: 'cafe',
    title: 'Café Logo Wall',
    kicker: 'Café Area',
    desc: 'White wall with black Fursat lettering, track lighting, and quiet dining tables for afternoon coffee and conversations.',
    img: '/assets/interior/tour-cafe.webp',
    width: 1050,
    height: 1400,
    tag: 'Cafe',
  },
  {
    id: 'booth',
    title: 'Red Booth Seating & Wall Posters',
    kicker: 'Booth Seating',
    desc: 'Red banquette booth seating with framed retro wall posters and hanging warm lamps for cozy private meals.',
    img: '/assets/interior/tour-booth.webp',
    width: 1050,
    height: 1400,
    tag: 'Booth',
  },
];

// Check if any equirectangular 360° panoramas exist in public/panos/
let availablePanos360: string[] = [];
try {
  const panosDir = path.resolve('./public/panos');
  if (fs.existsSync(panosDir)) {
    availablePanos360 = fs
      .readdirSync(panosDir)
      .filter((file) => /\.(webp|jpg|jpeg|png)$/i.test(file))
      .map((file) => `/panos/${file}`);
  }
} catch (_) {}
const has360Panos = availablePanos360.length > 0;
---

<section class="tour-section" id="tour" aria-labelledby="tour-heading">
  <div class="tour-container">
    <!-- Header -->
    <div class="tour-header">
      <div class="tour-kicker-row">
        <span class="tour-kicker">STEP INSIDE FURSAT</span>
        {has360Panos && (
          <button
            type="button"
            class="tour-360-toggle"
            id="tour-360-toggle"
            aria-label="Toggle between Rotunda and 360 Spherical View"
            aria-pressed="false"
          >
            <span class="tour-360-icon">🌐</span>
            <span class="tour-360-label">360° View</span>
          </button>
        )}
      </div>
      <h2 class="tour-title mot-headline" id="tour-heading">A Panoramic Walkthrough</h2>
      <p class="tour-sub">
        Drag or swipe to rotate through the space. Tap any interior to fly in and explore.
      </p>
    </div>

    <!-- Space-Name Navigation Chips -->
    <nav class="tour-chips-bar" id="tour-chips" aria-label="Interior spaces quick select">
      {tourSpaces.map((item, index) => (
        <button
          type="button"
          class={`tour-chip${index === 0 ? ' is-active' : ''}`}
          data-index={index}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          {item.tag}
        </button>
      ))}
    </nav>

    <!-- 3D Panoramic Stage Wrapper -->
    <div
      class="tour-stage-wrapper"
      id="tour-stage-wrapper"
      role="region"
      aria-label="3D Panoramic tour"
      tabindex="0"
    >
      <!-- WebGL Canvas Container -->
      <div class="tour-webgl-wrap" id="tour-webgl-wrap">
        <!-- Poster placeholder: displayed immediately until Three.js renders first frame -->
        <div class="tour-poster" id="tour-poster" aria-hidden="true">
          <img
            src="/assets/interior/tour-entrance.webp"
            alt="Fursat Entrance"
            class="tour-poster-img"
            width="1050"
            height="1400"
            loading="eager"
            decoding="async"
          />
          <div class="tour-poster-overlay">
            <span class="tour-poster-badge">✦ 3D Rotunda</span>
            <span class="tour-poster-text">Loading Walkthrough…</span>
          </div>
        </div>

        <canvas id="tour-webgl-canvas" class="tour-webgl-canvas"></canvas>

        <!-- In-Scene Focus Details Drawer -->
        <div class="tour-focus-drawer" id="tour-focus-drawer" aria-hidden="true">
          <button
            type="button"
            class="tour-focus-close"
            id="tour-focus-close"
            aria-label="Close details and fly back out (or press Esc)"
            title="Fly back out (Esc)"
          >
            ✕
          </button>
          <span class="tour-focus-kicker" id="tour-focus-kicker"></span>
          <h3 class="tour-focus-title" id="tour-focus-title"></h3>
          <p class="tour-focus-desc" id="tour-focus-desc"></p>
          <div class="tour-focus-actions">
            <a href="/reserve" class="tour-focus-cta">Reserve a Table →</a>
            <button type="button" class="tour-focus-back-btn" id="tour-focus-back-btn">← Back to Overview</button>
          </div>
        </div>

        <!-- iOS Gyroscope Permission Prompt Pill -->
        <button type="button" class="tour-gyro-btn" id="tour-gyro-btn" aria-label="Enable motion look-around" style="display: none;">
          <span class="tour-gyro-icon">⟳</span>
          <span>Enable Motion Look-Around</span>
        </button>
      </div>

      <!-- Resilient Fallback: Clean Horizontal Scroll-Snap Gallery (No-WebGL / Reduced Motion) -->
      <div class="tour-fallback-gallery" id="tour-fallback-gallery" role="region" aria-label="Interior spaces gallery">
        <div class="tour-fallback-track" id="tour-fallback-track">
          {tourSpaces.map((item, index) => (
            <article class={`tour-fallback-card${index === 0 ? ' is-active' : ''}`} data-index={index}>
              <div class="tour-fallback-img-wrap">
                <img
                  src={item.img}
                  alt={item.title}
                  class="tour-fallback-img"
                  loading="lazy"
                  decoding="async"
                  width={item.width}
                  height={item.height}
                />
                <span class="tour-fallback-badge">{item.tag}</span>
              </div>
              <div class="tour-fallback-info">
                <span class="tour-fallback-kicker">{item.kicker}</span>
                <h3 class="tour-fallback-name">{item.title}</h3>
                <p class="tour-fallback-desc">{item.desc}</p>
                <a href="/reserve" class="tour-fallback-cta">Reserve a Table →</a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Controls Overlay -->
      <div class="tour-controls">
        <button
          type="button"
          class="tour-nav-btn tour-nav-btn--prev"
          id="tour-prev"
          aria-label="Rotate to previous space"
          title="Previous space"
        >
          ‹
        </button>

        <div class="tour-dots" role="tablist" aria-label="Spaces list">
          {tourSpaces.map((sp, i) => (
            <button
              type="button"
              role="tab"
              class={`tour-dot${i === 0 ? ' is-active' : ''}`}
              data-index={i}
              aria-label={`Go to ${sp.title}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>

        <button
          type="button"
          class="tour-nav-btn tour-nav-btn--next"
          id="tour-next"
          aria-label="Rotate to next space"
          title="Next space"
        >
          ›
        </button>
      </div>

      <!-- Drag & Keyboard Hint -->
      <div class="tour-hint" aria-hidden="true">
        <span>↔ Drag or swipe to spin · Tap space to fly in · Esc to zoom out · Arrow keys to navigate</span>
      </div>
    </div>
  </div>

  <!-- Hidden JSON blob of 360 panoramas if present -->
  {has360Panos && (
    <script id="panos-360-data" type="application/json" set:html={JSON.stringify(availablePanos360)}></script>
  )}

  <!-- ARIA live region for screen-reader announcements -->
  <div id="tour-live" aria-live="polite" aria-atomic="true" class="tour-sr-only"></div>
</section>

<!-- ── Tour Interactivity Script (Bundled by Astro/Vite) ─────────────────────── -->
<script>
  (function () {
    var section = document.getElementById('tour');
    var wrapper = document.getElementById('tour-stage-wrapper');
    var fallbackGallery = document.getElementById('tour-fallback-gallery');
    var fallbackTrack = document.getElementById('tour-fallback-track');
    var fallbackCards = Array.from(document.querySelectorAll('.tour-fallback-card'));
    var webglWrap = document.getElementById('tour-webgl-wrap');
    var canvas = document.getElementById('tour-webgl-canvas') as HTMLCanvasElement;
    var poster = document.getElementById('tour-poster');
    var gyroBtn = document.getElementById('tour-gyro-btn');
    var prevBtn = document.getElementById('tour-prev');
    var nextBtn = document.getElementById('tour-next');
    var chips = Array.from(document.querySelectorAll('.tour-chip'));
    var dots = Array.from(document.querySelectorAll('.tour-dot'));
    var toggle360Btn = document.getElementById('tour-360-toggle');

    // In-Scene Focus Drawer Elements
    var focusDrawer = document.getElementById('tour-focus-drawer');
    var focusClose = document.getElementById('tour-focus-close');
    var focusBackBtn = document.getElementById('tour-focus-back-btn');
    var focusTitle = document.getElementById('tour-focus-title');
    var focusKicker = document.getElementById('tour-focus-kicker');
    var focusDesc = document.getElementById('tour-focus-desc');
    var liveRegion = document.getElementById('tour-live');

    if (!section || !wrapper) return;

    var spacesData = [
      {
        id: 'entrance',
        title: 'Entrance & Elephant Mural',
        kicker: 'Arrival Area',
        desc: 'Handcrafted elephant wall mural, warm wall sconce lighting, and carved wooden doors welcoming you to Fursat.',
        img: '/assets/interior/tour-entrance.webp'
      },
      {
        id: 'bar',
        title: 'The Bar Counter',
        kicker: 'Bar Counter',
        desc: 'Backlit liquor bottle shelving, illuminated circular Fursat wall sign, and dark bar counter top for cocktail evenings.',
        img: '/assets/interior/tour-bar.webp'
      },
      {
        id: 'high-tables',
        title: 'High-Top Tables & Stools',
        kicker: 'Lounge Seating',
        desc: 'High-top wooden tables with black-frame high bar stools and overhead warm pendant lights for casual gatherings.',
        img: '/assets/interior/tour-high-tables.webp'
      },
      {
        id: 'lounge',
        title: 'Sofa & Table Dining',
        kicker: 'Dining Room',
        desc: 'Green patterned sofa seating, dark square dining tables, indoor potted greenery, and partition screens for group dinners.',
        img: '/assets/interior/tour-lounge.webp'
      },
      {
        id: 'cafe',
        title: 'Café Logo Wall',
        kicker: 'Café Area',
        desc: 'White wall with black Fursat lettering, track lighting, and quiet dining tables for afternoon coffee and conversations.',
        img: '/assets/interior/tour-cafe.webp'
      },
      {
        id: 'booth',
        title: 'Red Booth Seating & Wall Posters',
        kicker: 'Booth Seating',
        desc: 'Red banquette booth seating with framed retro wall posters and hanging warm lamps for cozy private meals.',
        img: '/assets/interior/tour-booth.webp'
      }
    ];

    // Read available 360 panoramas if provided
    var panos360List: string[] = [];
    var panoDataScript = document.getElementById('panos-360-data');
    if (panoDataScript) {
      try { panos360List = JSON.parse(panoDataScript.textContent || '[]'); } catch (_) {}
    }

    var N = spacesData.length; // 6 spaces
    var stepAngle = (Math.PI * 2) / N; // 60 degrees in radians
    var activeIndex = 0;
    var targetSlot = 0;
    var is360Mode = false;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Check WebGL Support
    function hasWebGLSupport() {
      try {
        var testCanvas = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (testCanvas.getContext('webgl2') || testCanvas.getContext('webgl') || testCanvas.getContext('experimental-webgl')));
      } catch (e) {
        return false;
      }
    }

    function updateActiveUI(idx: number) {
      activeIndex = idx;
      chips.forEach(function (c, i) {
        if (i === activeIndex) {
          c.classList.add('is-active');
          c.setAttribute('aria-selected', 'true');
        } else {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        }
      });
      dots.forEach(function (d, i) {
        if (i === activeIndex) {
          d.classList.add('is-active');
          d.setAttribute('aria-selected', 'true');
        } else {
          d.classList.remove('is-active');
          d.setAttribute('aria-selected', 'false');
        }
      });
      fallbackCards.forEach(function (card, i) {
        if (i === activeIndex) {
          card.classList.add('is-active');
        } else {
          card.classList.remove('is-active');
        }
      });
      if (liveRegion && spacesData[idx]) {
        liveRegion.textContent = 'Viewing: ' + spacesData[idx].title;
      }
    }

    // In-Scene Focus Drawer UI Handler
    function showFocusDrawer(idx: number) {
      var d = spacesData[idx];
      if (!d || !focusDrawer) return;
      if (focusTitle) focusTitle.textContent = d.title;
      if (focusKicker) focusKicker.textContent = d.kicker;
      if (focusDesc) focusDesc.textContent = d.desc;
      focusDrawer.classList.add('is-open');
      focusDrawer.setAttribute('aria-hidden', 'false');
    }

    function hideFocusDrawer() {
      if (!focusDrawer) return;
      focusDrawer.classList.remove('is-open');
      focusDrawer.setAttribute('aria-hidden', 'true');
    }

    // ── Fallback Handler ──────────────────────────────────────────────
    function enableFallback(reason: string) {
      console.warn('[Tour] Fallback chosen: ' + reason);
      wrapper?.classList.remove('has-webgl');
      wrapper?.classList.add('is-fallback');
      if (poster) poster.style.display = 'none';
      initFallbackGallery();
    }

    var webglAvailable = !prefersReduced && hasWebGLSupport();

    if (!webglAvailable) {
      enableFallback(prefersReduced ? 'prefers-reduced-motion is active' : 'WebGL is not supported');
      return;
    }

    // ── WebGL Engine Initializer (Lazy Loaded) ─────────────────────────
    var webglInitialized = false;

    var observer = new IntersectionObserver(
      function (entries) {
        if (entries[0].isIntersecting && !webglInitialized) {
          webglInitialized = true;
          observer.disconnect();
          startWebGLTour();
        }
      },
      { rootMargin: '300px 0px' }
    );

    observer.observe(section);

    function startWebGLTour() {
      import('three').then(function (THREE) {
        if (!canvas || !webglWrap) {
          enableFallback('Canvas or webglWrap element missing');
          return;
        }

        wrapper?.classList.add('has-webgl');
        wrapper?.classList.remove('is-fallback');

        var width = webglWrap.clientWidth || window.innerWidth;
        var height = webglWrap.clientHeight || 520;

        var scene = new THREE.Scene();
        scene.fog = new THREE.Fog(0x0d1308, 420, 950);

        var camera = new THREE.PerspectiveCamera(52, width / height, 1, 3000);

        function updateCameraFOV() {
          var aspect = camera.aspect;
          var targetHFOV = 88 * (Math.PI / 180);
          var vfovRad = 2 * Math.atan(Math.tan(targetHFOV / 2) / Math.max(0.55, aspect));
          camera.fov = Math.min(95, Math.max(46, vfovRad * (180 / Math.PI)));
          camera.updateProjectionMatrix();
        }
        updateCameraFOV();

        var overviewCamPos = new THREE.Vector3(0, 0, 165);
        var flyInCamPos = new THREE.Vector3(0, -6, 75);
        var targetCamPos = overviewCamPos.clone();
        camera.position.copy(overviewCamPos);

        var renderer: any;
        try {
          renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            antialias: true,
            alpha: false,
            powerPreference: 'high-performance'
          });
        } catch (err: any) {
          enableFallback('WebGLRenderer instantiation error: ' + (err && err.message));
          return;
        }

        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
        renderer.setSize(width, height);
        renderer.setClearColor(0x0d1308, 1);

        canvas.addEventListener('webglcontextlost', function (e) {
          e.preventDefault();
          enableFallback('WebGL context lost');
        }, false);

        window.addEventListener('beforeunload', function () {
          renderer.dispose();
        }, { once: true });

        // ── 3D Rotunda Amphitheater Setup ─────────────────────────────
        var rotundaGroup = new THREE.Group();
        scene.add(rotundaGroup);

        var radius = 360;
        var panelHeight = 330;
        var thetaLength = 0.6875; // 3:4 aspect ratio panels

        var cylinderGeo = new THREE.CylinderGeometry(
          radius,
          radius,
          panelHeight,
          32,
          1,
          true,
          -thetaLength / 2,
          thetaLength
        );
        cylinderGeo.scale(-1, 1, 1);

        // Panel Shader: Photographic sharpness, soft edge vignette, subtle RGB split & ripple
        var panelVertexShader = `
          varying vec2 vUv;
          varying vec3 vNormal;
          void main() {
            vUv = uv;
            vNormal = normalize(normalMatrix * normal);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `;

        var panelFragmentShader = `
          uniform sampler2D uMap;
          uniform float uActive;
          uniform float uVelocity;
          uniform float uTime;
          uniform float uRgbEnabled;
          varying vec2 vUv;
          varying vec3 vNormal;

          void main() {
            vec2 uv = vUv;

            // Very subtle dynamic ripple on motion (max ~1px displacement)
            if (uRgbEnabled > 0.5) {
              float speed = abs(uVelocity);
              float ripple = clamp(speed * 0.0003, 0.0, 0.0025);
              uv.y += ripple * sin(uv.x * 12.0 + uTime * 4.0);
              uv.x += ripple * 0.5 * sin(uv.y * 10.0 + uTime * 3.0);
            }

            // Very subtle RGB chromatic aberration (max 2px displacement)
            float split = 0.0;
            if (uRgbEnabled > 0.5) {
              split = clamp(abs(uVelocity) * 0.0005, 0.0, 0.0045);
            }
            float dir = sign(uVelocity);
            vec2 rOffset = vec2(split * dir, 0.0);
            vec2 bOffset = vec2(-split * dir, 0.0);

            float r = texture2D(uMap, clamp(uv + rOffset, 0.001, 0.999)).r;
            float g = texture2D(uMap, clamp(uv,           0.001, 0.999)).g;
            float b = texture2D(uMap, clamp(uv + bOffset, 0.001, 0.999)).b;

            // Soft refined edge vignette falloff at panel boundaries
            float vx = smoothstep(0.0, 0.045, vUv.x) * smoothstep(1.0, 0.955, vUv.x);
            float vy = smoothstep(0.0, 0.045, vUv.y) * smoothstep(1.0, 0.955, vUv.y);
            float edge = vx * vy;

            // Warm light falloff: active space 100%, peripheral 76%
            float luminosity = mix(0.76, 1.0, uActive);
            vec3 bgCol = vec3(0.051, 0.075, 0.031); // #0d1308
            vec3 warmRim = vec3(0.88, 0.65, 0.24); // #E0A63C gold rim

            vec3 rgb = vec3(r, g, b) * luminosity;
            rgb = mix(bgCol, rgb, edge);
            rgb += warmRim * (1.0 - edge) * 0.12 * luminosity;

            gl_FragColor = vec4(rgb, 1.0);
          }
        `;

        var textureLoader = new THREE.TextureLoader();
        var maxAnisotropy = renderer.capabilities ? renderer.capabilities.getMaxAnisotropy() : 4;
        var panelMeshes: any[] = [];
        var panelMaterials: any[] = [];

        spacesData.forEach(function (space, index) {
          var texture = textureLoader.load(space.img);
          texture.colorSpace = THREE.SRGBColorSpace;
          texture.generateMipmaps = true;
          texture.minFilter = THREE.LinearMipmapLinearFilter;
          texture.magFilter = THREE.LinearFilter;
          texture.anisotropy = maxAnisotropy;

          var material = new THREE.ShaderMaterial({
            vertexShader: panelVertexShader,
            fragmentShader: panelFragmentShader,
            uniforms: {
              uMap:        { value: texture },
              uActive:     { value: index === 0 ? 1.0 : 0.0 },
              uVelocity:   { value: 0.0 },
              uTime:       { value: 0.0 },
              uRgbEnabled: { value: 1.0 }
            },
            side: THREE.DoubleSide
          });

          var mesh = new THREE.Mesh(cylinderGeo, material);
          mesh.userData = { index: index, space: space };

          var angle = index * stepAngle + Math.PI;
          mesh.rotation.y = angle;

          rotundaGroup.add(mesh);
          panelMeshes.push(mesh);
          panelMaterials.push(material);
        });

        // ── Real 360° Equirectangular Sphere Mode (public/panos/) ─────
        var sphere360Group = new THREE.Group();
        sphere360Group.visible = false;
        scene.add(sphere360Group);

        var sphere360Mesh: any = null;
        var sphereLon = 0;
        var sphereLat = 0;
        var sphereTargetLon = 0;
        var sphereTargetLat = 0;
        var sphereHotspots: any[] = [];

        if (panos360List.length > 0) {
          var pano360Texture = textureLoader.load(panos360List[0]);
          pano360Texture.colorSpace = THREE.SRGBColorSpace;
          pano360Texture.minFilter = THREE.LinearFilter;
          var sphereGeo = new THREE.SphereGeometry(600, 60, 40);
          sphereGeo.scale(-1, 1, 1);
          var sphereMat = new THREE.MeshBasicMaterial({ map: pano360Texture });
          sphere360Mesh = new THREE.Mesh(sphereGeo, sphereMat);
          sphere360Group.add(sphere360Mesh);

          // Add interactive 3D hotspots inside the 360 sphere
          var hotspotDefs = [
            { title: 'The Bar Counter', pos: new THREE.Vector3(380, -20, -320), idx: 1 },
            { title: 'Lounge Seating', pos: new THREE.Vector3(-360, 10, -340), idx: 3 },
            { title: 'Booth Dining', pos: new THREE.Vector3(120, -10, 480), idx: 5 }
          ];

          hotspotDefs.forEach(function (h) {
            var canvasH = document.createElement('canvas');
            canvasH.width = 128;
            canvasH.height = 128;
            var ctx = canvasH.getContext('2d');
            if (ctx) {
              ctx.fillStyle = '#E0A63C';
              ctx.beginPath();
              ctx.arc(64, 64, 40, 0, Math.PI * 2);
              ctx.fill();
              ctx.strokeStyle = '#FFFFFF';
              ctx.lineWidth = 8;
              ctx.stroke();
            }
            var hTex = new THREE.CanvasTexture(canvasH);
            var hMat = new THREE.SpriteMaterial({ map: hTex, transparent: true, opacity: 0.88 });
            var sprite = new THREE.Sprite(hMat);
            sprite.position.copy(h.pos);
            sprite.scale.set(40, 40, 1);
            sprite.userData = { hotspot: true, title: h.title, index: h.idx };
            sphere360Group.add(sprite);
            sphereHotspots.push(sprite);
          });
        }

        function toggle360View() {
          is360Mode = !is360Mode;
          if (toggle360Btn) {
            toggle360Btn.setAttribute('aria-pressed', is360Mode ? 'true' : 'false');
            toggle360Btn.classList.toggle('is-active', is360Mode);
          }
          rotundaGroup.visible = !is360Mode;
          sphere360Group.visible = is360Mode;
          if (is360Mode) {
            hideFocusDrawer();
            camera.position.set(0, 0, 0.1);
          } else {
            camera.position.copy(overviewCamPos);
          }
        }

        if (toggle360Btn) {
          toggle360Btn.addEventListener('click', toggle360View);
        }

        // Ambient Gold Bokeh Particles drifting in 3D depth
        var moteCount = 36;
        var motePositions = new Float32Array(moteCount * 3);
        for (var mi = 0; mi < moteCount; mi++) {
          var moteAngle = Math.random() * Math.PI * 2;
          var moteR = 60 + Math.random() * 260;
          motePositions[mi * 3]     = Math.cos(moteAngle) * moteR;
          motePositions[mi * 3 + 1] = (Math.random() - 0.5) * panelHeight * 1.1;
          motePositions[mi * 3 + 2] = Math.sin(moteAngle) * moteR;
        }
        var moteBufGeo = new THREE.BufferGeometry();
        moteBufGeo.setAttribute('position', new THREE.BufferAttribute(motePositions.slice(), 3));
        var moteMat = new THREE.PointsMaterial({
          color: 0xE0A63C,
          size: 2.4,
          transparent: true,
          opacity: 0.45,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          sizeAttenuation: true
        });
        var motePoints = new THREE.Points(moteBufGeo, moteMat);
        scene.add(motePoints);
        var moteOrigPos = motePositions.slice();

        // ── State & Interaction Management ────────────────────────────
        var isZoomed = false;
        var isDragging = false;
        var hasMoved = false;
        var pointerStartX = 0;
        var pointerStartY = 0;
        var lastPointerX = 0;
        var lastPointerTime = 0;
        var angularVelocity = 0;
        var currentRotY = 0;
        var targetRotY = 0;
        var isPointerOver = false;
        var dragThresholdMet = false;
        var lastInteractionTime = performance.now();

        var raycaster = new THREE.Raycaster();
        var mouseNDC = new THREE.Vector2();

        function flyInToSpace(idx: number) {
          isZoomed = true;
          targetCamPos.copy(flyInCamPos);
          showFocusDrawer(idx);
        }

        function zoomOutToOverview() {
          isZoomed = false;
          targetCamPos.copy(overviewCamPos);
          hideFocusDrawer();
        }

        if (focusClose) focusClose.addEventListener('click', zoomOutToOverview);
        if (focusBackBtn) focusBackBtn.addEventListener('click', zoomOutToOverview);

        // ── Smooth Navigation & Nearest Space Snap ─────────────────────
        function snapToSlot(slot: number, openDrawer: boolean) {
          targetSlot = slot;
          targetRotY = -targetSlot * stepAngle;
          var normIdx = ((targetSlot % N) + N) % N;
          updateActiveUI(normIdx);
          if (openDrawer) {
            flyInToSpace(normIdx);
          } else if (isZoomed) {
            showFocusDrawer(normIdx);
          }
          lastInteractionTime = performance.now();
        }

        function snapToIndex(idx: number, openDrawer: boolean) {
          var curNorm = ((targetSlot % N) + N) % N;
          var delta = idx - curNorm;
          if (delta > N / 2) delta -= N;
          if (delta < -N / 2) delta += N;
          snapToSlot(targetSlot + delta, openDrawer);
        }

        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            var idx = parseInt((chip as HTMLElement).dataset.index || '0', 10);
            snapToIndex(idx, false);
          });
        });

        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            var idx = parseInt((dot as HTMLElement).dataset.index || '0', 10);
            snapToIndex(idx, false);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            snapToSlot(targetSlot - 1, false);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            snapToSlot(targetSlot + 1, false);
          });
        }

        wrapper?.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            e.preventDefault();
            if (is360Mode) {
              toggle360View();
            } else {
              zoomOutToOverview();
            }
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            snapToSlot(targetSlot - 1, false);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            snapToSlot(targetSlot + 1, false);
          } else if (e.key === 'Home') {
            e.preventDefault();
            snapToIndex(0, false);
          } else if (e.key === 'End') {
            e.preventDefault();
            snapToIndex(N - 1, false);
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (isZoomed) {
              zoomOutToOverview();
            } else {
              flyInToSpace(activeIndex);
            }
          }
        });

        // ── Drag & Inertia Physics ─────────────────────────────────────
        canvas.addEventListener('pointerdown', function (e) {
          isDragging = true;
          hasMoved = false;
          dragThresholdMet = false;
          pointerStartX = e.clientX;
          pointerStartY = e.clientY;
          lastPointerX = e.clientX;
          lastPointerTime = performance.now();
          angularVelocity = 0;
          lastInteractionTime = performance.now();
          try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
        });

        canvas.addEventListener('pointermove', function (e) {
          var rect = canvas.getBoundingClientRect();
          var px = ((e.clientX - rect.left) / rect.width - 0.5) * 16;
          var py = ((e.clientY - rect.top) / rect.height - 0.5) * 10;
          if (focusDrawer) {
            focusDrawer.style.setProperty('--prx', px.toFixed(1) + 'px');
            focusDrawer.style.setProperty('--pry', py.toFixed(1) + 'px');
          }

          if (!isDragging) return;

          var dx = e.clientX - lastPointerX;
          var dy = e.clientY - pointerStartY;
          var totalX = e.clientX - pointerStartX;

          if (!dragThresholdMet) {
            if (Math.abs(totalX) > 6 && Math.abs(totalX) >= Math.abs(dy)) {
              dragThresholdMet = true;
              hasMoved = true;
            } else if (Math.abs(dy) > 12) {
              isDragging = false;
              return;
            }
          }

          if (dragThresholdMet) {
            var now = performance.now();
            var dt = Math.max(1, now - lastPointerTime);

            if (is360Mode) {
              sphereTargetLon -= dx * 0.2;
              sphereTargetLat += (e.clientY - lastPointerX) * 0.1;
              sphereTargetLat = Math.max(-85, Math.min(85, sphereTargetLat));
            } else {
              currentRotY += dx * 0.0035;
              targetRotY = currentRotY;
              angularVelocity = (dx / dt) * 0.0035;
            }

            lastPointerX = e.clientX;
            lastPointerTime = now;
            lastInteractionTime = now;
          }
        });

        function endDrag(e: PointerEvent) {
          if (!isDragging) return;
          isDragging = false;
          try { canvas.releasePointerCapture(e.pointerId); } catch (err) {}

          if (hasMoved && !is360Mode) {
            var projected = currentRotY + angularVelocity * 100;
            var nearestSlot = Math.round(-projected / stepAngle);
            snapToSlot(nearestSlot, false);
          }
          lastInteractionTime = performance.now();
        }

        canvas.addEventListener('pointerup', endDrag);
        canvas.addEventListener('pointercancel', endDrag);
        canvas.addEventListener('pointerenter', function () { isPointerOver = true; });
        canvas.addEventListener('pointerleave', function () {
          isPointerOver = false;
          if (isDragging) isDragging = false;
        });

        // ── Tap-to-Fly-In Raycasting ───────────────────────────────────
        canvas.addEventListener('click', function (e) {
          var moveDist = Math.hypot(e.clientX - pointerStartX, e.clientY - pointerStartY);
          if (moveDist > 7) return;

          var rect = canvas.getBoundingClientRect();
          mouseNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
          mouseNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

          raycaster.setFromCamera(mouseNDC, camera);

          if (is360Mode && sphereHotspots.length > 0) {
            var hitsH = raycaster.intersectObjects(sphereHotspots);
            if (hitsH.length > 0) {
              var targetIdx = hitsH[0].object.userData.index;
              toggle360View();
              snapToIndex(targetIdx, true);
              return;
            }
          }

          var hits = raycaster.intersectObjects(panelMeshes);
          if (hits.length > 0) {
            var hitMesh = hits[0].object;
            var hitIdx = hitMesh.userData.index;

            if (isZoomed && hitIdx === activeIndex) {
              zoomOutToOverview();
            } else {
              snapToIndex(hitIdx, true);
            }
          } else if (isZoomed) {
            zoomOutToOverview();
          }
        });

        // ── Gyroscope Look-Around ─────────────────────────────────────
        var gyroYaw = 0.0;
        var gyroPitch = 0.0;
        var gyroEnabled = false;

        function applyOrientation(e: DeviceOrientationEvent) {
          if (e.gamma == null || e.beta == null) return;
          var gx = Math.max(-20, Math.min(20, e.gamma as number)) / 20;
          var gy = Math.max(20, Math.min(60, (e.beta as number))) - 40;
          gyroYaw = gx * 0.12;
          gyroPitch = -gy * 0.003;
        }

        function enableGyro() {
          gyroEnabled = true;
          window.addEventListener('deviceorientation', applyOrientation, { passive: true });
          if (gyroBtn) gyroBtn.style.display = 'none';
        }

        var isIOS = /iP(hone|ad|od)/.test(navigator.userAgent) ||
                    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
          if (gyroBtn) {
            gyroBtn.style.display = '';
            gyroBtn.addEventListener('click', function () {
              (DeviceOrientationEvent as any).requestPermission().then(function (state: string) {
                if (state === 'granted') enableGyro();
              }).catch(function () {});
            });
          }
        } else if (window.DeviceOrientationEvent && !isIOS) {
          enableGyro();
        }

        // ── Resize Handler ─────────────────────────────────────────────
        function onResize() {
          if (!webglWrap) return;
          var w = webglWrap.clientWidth;
          var h = webglWrap.clientHeight;
          camera.aspect = w / h;
          updateCameraFOV();
          renderer.setSize(w, h);
        }
        window.addEventListener('resize', onResize, { passive: true });

        // ── Performance / FPS Monitor (Disables RGB split if mobile FPS drops) ──
        var isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth < 768;
        var lastFpsCheckTime = performance.now();
        var frameCount = 0;
        var rgbShaderActive = true;

        // ── Render Loop & Poster Fade ──────────────────────────────────
        var isSectionVisible = true;
        var hasFadedPoster = false;
        var visibilityObserver = new IntersectionObserver(function (entries) {
          isSectionVisible = entries[0].isIntersecting;
        });
        visibilityObserver.observe(section);

        function animate(now: number) {
          requestAnimationFrame(animate);
          if (!isSectionVisible) return;

          var t = now * 0.001;

          // FPS monitor: protect 60 fps on mobile
          frameCount++;
          if (now - lastFpsCheckTime >= 1000) {
            var currentFps = (frameCount * 1000) / (now - lastFpsCheckTime);
            frameCount = 0;
            lastFpsCheckTime = now;
            if (isMobile && currentFps < 50 && rgbShaderActive) {
              rgbShaderActive = false;
              panelMaterials.forEach(function (mat) {
                mat.uniforms.uRgbEnabled.value = 0.0;
              });
            }
          }

          if (is360Mode) {
            // 360 Spherical Look-Around
            sphereLon += (sphereTargetLon - sphereLon) * 0.1;
            sphereLat += (sphereTargetLat - sphereLat) * 0.1;
            var phi = THREE.MathUtils.degToRad(90 - sphereLat);
            var theta = THREE.MathUtils.degToRad(sphereLon);
            var targetX = 500 * Math.sin(phi) * Math.cos(theta);
            var targetY = 500 * Math.cos(phi);
            var targetZ = 500 * Math.sin(phi) * Math.sin(theta);
            camera.lookAt(targetX, targetY, targetZ);
          } else {
            // Rotunda mode
            camera.position.lerp(targetCamPos, 0.08);

            if (gyroEnabled) {
              camera.position.x += gyroYaw * 18;
              camera.position.y += gyroPitch * 12;
            }

            camera.lookAt(0, 0, -360);

            if (!isDragging) {
              var diff = targetRotY - currentRotY;
              if (Math.abs(diff) > 0.0005) {
                currentRotY += diff * 0.1;
              } else {
                currentRotY = targetRotY;

                var idleElapsed = now - lastInteractionTime;
                if (!isPointerOver && !isZoomed && idleElapsed > 3000) {
                  targetRotY -= 0.00035;
                  currentRotY = targetRotY;
                  var curSlot = Math.round(-currentRotY / stepAngle);
                  var norm = ((curSlot % N) + N) % N;
                  if (norm !== activeIndex) {
                    updateActiveUI(norm);
                  }
                }
              }
            }

            rotundaGroup.rotation.y = currentRotY;

            var activeFloat = -currentRotY / stepAngle;
            var activeNorm = ((Math.round(activeFloat) % N) + N) % N;
            if (activeNorm !== activeIndex && !isDragging) {
              updateActiveUI(activeNorm);
            }

            // Update shader uniforms: subtle velocity-based RGB split & ripple
            angularVelocity *= 0.9;
            panelMaterials.forEach(function (mat, i) {
              var isActive = (i === activeNorm) ? 1.0 : 0.0;
              mat.uniforms.uActive.value += (isActive - mat.uniforms.uActive.value) * 0.1;
              mat.uniforms.uVelocity.value = angularVelocity * 60.0;
              mat.uniforms.uTime.value = t;
            });
          }

          // Gentle ambient gold mote drift
          var posArr = moteBufGeo.attributes.position.array as Float32Array;
          for (var mi2 = 0; mi2 < moteCount; mi2++) {
            posArr[mi2 * 3 + 1] = moteOrigPos[mi2 * 3 + 1] + Math.sin(t * 0.5 + mi2 * 0.8) * 14;
          }
          moteBufGeo.attributes.position.needsUpdate = true;

          renderer.render(scene, camera);

          if (!hasFadedPoster && poster) {
            hasFadedPoster = true;
            poster.classList.add('is-hidden');
            setTimeout(function () {
              if (poster) poster.style.display = 'none';
            }, 500);
          }
        }

        requestAnimationFrame(animate);
      }).catch(function (err) {
        enableFallback('Three.js failed to load: ' + (err && err.message));
      });
    }

    // ── Fallback Gallery implementation ───────────────────────────────
    function initFallbackGallery() {
      if (!fallbackTrack) return;

      fallbackTrack.addEventListener('scroll', function () {
        var cardW = (fallbackCards[0] as HTMLElement)?.offsetWidth || 300;
        var scrollLeft = fallbackTrack.scrollLeft;
        var idx = Math.min(N - 1, Math.max(0, Math.round(scrollLeft / (cardW + 16))));
        if (idx !== activeIndex) {
          updateActiveUI(idx);
        }
      }, { passive: true });

      function scrollFallbackTo(idx: number) {
        var card = fallbackCards[idx] as HTMLElement;
        if (!card || !fallbackTrack) return;
        fallbackTrack.scrollTo({
          left: card.offsetLeft - 16,
          behavior: prefersReduced ? 'auto' : 'smooth'
        });
        updateActiveUI(idx);
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var idx = parseInt((chip as HTMLElement).dataset.index || '0', 10);
          scrollFallbackTo(idx);
        });
      });

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          var idx = parseInt((dot as HTMLElement).dataset.index || '0', 10);
          scrollFallbackTo(idx);
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          var prevIdx = Math.max(0, activeIndex - 1);
          scrollFallbackTo(prevIdx);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          var nextIdx = Math.min(N - 1, activeIndex + 1);
          scrollFallbackTo(nextIdx);
        });
      }
    }
  })();
</script>

