---
// PanoramicViewer.astro - "Step inside Fursat" Panoramic Tour
// WebGL 3D Curved Cylindrical Rotunda with Three.js & Resilient CSS 3D Fallback
// Real photography only from raw_assets/interior_named/

const tourSpaces = [
  {
    id: 'entrance',
    title: 'Entrance & Elephant Mural',
    kicker: 'Arrival Area',
    desc: 'Handcrafted elephant wall mural, warm wall sconce lighting, and carved wooden doors.',
    img: '/assets/interior/tour-entrance.webp',
    width: 1050,
    height: 1400,
    tag: 'Entrance',
  },
  {
    id: 'bar',
    title: 'The Bar Counter',
    kicker: 'Bar Counter',
    desc: 'Backlit liquor bottle shelving, illuminated circular Fursat wall sign, and dark bar counter top.',
    img: '/assets/interior/tour-bar.webp',
    width: 1050,
    height: 1400,
    tag: 'Bar',
  },
  {
    id: 'high-tables',
    title: 'High-Top Tables & Stools',
    kicker: 'Lounge Seating',
    desc: 'High-top wooden tables with black-frame high bar stools and overhead pendant lights.',
    img: '/assets/interior/tour-high-tables.webp',
    width: 1050,
    height: 1400,
    tag: 'High tables',
  },
  {
    id: 'lounge',
    title: 'Sofa & Table Dining',
    kicker: 'Dining Room',
    desc: 'Green patterned sofa seating, dark square dining tables, indoor potted plants, and partition screens.',
    img: '/assets/interior/tour-lounge.webp',
    width: 1050,
    height: 1400,
    tag: 'Lounge',
  },
  {
    id: 'cafe',
    title: 'Café Logo Wall',
    kicker: 'Café Area',
    desc: 'White wall with black Fursat lettering, track lighting, and dining tables.',
    img: '/assets/interior/tour-cafe.webp',
    width: 1050,
    height: 1400,
    tag: 'Cafe',
  },
  {
    id: 'booth',
    title: 'Red Booth Seating & Wall Posters',
    kicker: 'Booth Seating',
    desc: 'Red banquette booth seating with framed wall posters and hanging warm lamps.',
    img: '/assets/interior/tour-booth.webp',
    width: 1050,
    height: 1400,
    tag: 'Booth',
  },
];
---

<section class="tour-section" id="tour" aria-labelledby="tour-heading">
  <div class="tour-container">
    <!-- Header -->
    <div class="tour-header">
      <span class="tour-kicker">STEP INSIDE FURSAT</span>
      <h2 class="tour-title mot-headline" id="tour-heading">A Panoramic Walkthrough</h2>
      <p class="tour-sub">
        Drag or swipe to rotate. Tap any space to explore details.
      </p>
    </div>

    <!-- Space-Name Navigation Chips -->
    <nav class="tour-chips-bar" id="tour-chips" aria-label="Interior spaces quick select">
      {tourSpaces.map((item, index) => (
        <button
          type="button"
          class={`tour-chip${index === 0 ? ' is-active' : ''}`}
          data-index={index}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          {item.tag}
        </button>
      ))}
    </nav>

    <!-- 3D Panoramic Stage Wrapper -->
    <div
      class="tour-stage-wrapper"
      id="tour-stage-wrapper"
      role="region"
      aria-label="3D Panoramic tour"
      tabindex="0"
    >
      <!-- WebGL Canvas Container -->
      <div class="tour-webgl-wrap" id="tour-webgl-wrap">
        <canvas id="tour-webgl-canvas" class="tour-webgl-canvas"></canvas>

        <!-- "Step Inside" Fly-In Button Overlay -->
        <div class="tour-flyin-overlay" id="tour-flyin-overlay">
          <button type="button" class="tour-flyin-btn" id="tour-flyin-btn" aria-label="Step inside Fursat 3D Rotunda">
            <span class="tour-flyin-icon" aria-hidden="true">✦</span>
            <span class="tour-flyin-text">Step Inside Fursat</span>
          </button>
        </div>

        <!-- iOS Gyroscope Permission Prompt Pill -->
        <button type="button" class="tour-gyro-btn" id="tour-gyro-btn" aria-label="Enable motion look-around" style="display: none;">
          <span class="tour-gyro-icon">⟳</span>
          <span>Enable Motion Look-Around</span>
        </button>
      </div>

      <!-- CSS 3D Ring (Fallback for No-WebGL / Reduced Motion) -->
      <div class="tour-stage" id="tour-stage">
        <div class="tour-ring" id="tour-ring">
          {tourSpaces.map((item, index) => {
            const theta = index * 60; // 360 / 6 = 60 deg
            return (
              <article
                class={`tour-card${index === 0 ? ' is-active' : ''}`}
                data-index={index}
                data-id={item.id}
                data-title={item.title}
                data-kicker={item.kicker}
                data-desc={item.desc}
                data-img={item.img}
                style={`--card-angle: ${theta}deg;`}
                aria-label={item.title}
              >
                <div class="tour-card-inner">
                  <div class="tour-card-img-wrap">
                    <img
                      src={item.img}
                      alt={item.title}
                      class="tour-card-img"
                      loading="lazy"
                      decoding="async"
                      width={item.width}
                      height={item.height}
                    />
                    <div class="tour-card-dimmer" aria-hidden="true"></div>
                    <span class="tour-card-badge">{item.tag}</span>
                    <button
                      type="button"
                      class="tour-card-expand-btn"
                      aria-label={`Expand view of ${item.title}`}
                      title="Expand View"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                      </svg>
                    </button>
                  </div>
                  <div class="tour-card-info">
                    <span class="tour-card-kicker">{item.kicker}</span>
                    <h3 class="tour-card-name">{item.title}</h3>
                    <p class="tour-card-desc">{item.desc}</p>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Controls Overlay -->
      <div class="tour-controls">
        <button
          type="button"
          class="tour-nav-btn tour-nav-btn--prev"
          id="tour-prev"
          aria-label="Rotate to previous space"
          title="Previous space"
        >
          ‹
        </button>

        <div class="tour-dots" role="tablist" aria-label="Spaces list">
          {tourSpaces.map((sp, i) => (
            <button
              type="button"
              role="tab"
              class={`tour-dot${i === 0 ? ' is-active' : ''}`}
              data-index={i}
              aria-label={`Go to ${sp.title}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>

        <button
          type="button"
          class="tour-nav-btn tour-nav-btn--next"
          id="tour-next"
          aria-label="Rotate to next space"
          title="Next space"
        >
          ›
        </button>
      </div>

      <!-- Drag & Keyboard Hint -->
      <div class="tour-hint" aria-hidden="true">
        <span>↔ Drag to spin · Arrow keys to navigate · Tap to explore</span>
      </div>
    </div>
  </div>

  <!-- ARIA live region for screen-reader announcements -->
  <div id="tour-live" aria-live="polite" aria-atomic="true" class="tour-sr-only"></div>

  <!-- Expand Lightbox Modal / Drawer -->
  <dialog class="tour-modal" id="tour-modal" aria-labelledby="tour-modal-title">
    <div class="tour-modal-backdrop" id="tour-modal-backdrop"></div>
    <div class="tour-modal-box">
      <button
        type="button"
        class="tour-modal-close"
        id="tour-modal-close"
        aria-label="Close details"
      >
        ✕
      </button>
      <div class="tour-modal-img-wrap">
        <img id="tour-modal-img" src="" alt="" class="tour-modal-img" />
      </div>
      <div class="tour-modal-meta">
        <span class="tour-modal-kicker" id="tour-modal-kicker"></span>
        <h3 class="tour-modal-title" id="tour-modal-title"></h3>
        <p class="tour-modal-desc" id="tour-modal-desc"></p>
        <div class="tour-modal-actions">
          <a href="/reserve" class="tour-modal-cta">Reserve a Table →</a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<!-- ── Tour Interactivity Script (Bundled by Astro/Vite) ─────────────────────── -->
<script>
  (function () {
    var section = document.getElementById('tour');
    var wrapper = document.getElementById('tour-stage-wrapper');
    var stage = document.getElementById('tour-stage');
    var ring = document.getElementById('tour-ring');
    var webglWrap = document.getElementById('tour-webgl-wrap');
    var canvas = document.getElementById('tour-webgl-canvas') as HTMLCanvasElement;
    var flyinOverlay = document.getElementById('tour-flyin-overlay');
    var flyinBtn = document.getElementById('tour-flyin-btn');
    var gyroBtn = document.getElementById('tour-gyro-btn');
    var prevBtn = document.getElementById('tour-prev');
    var nextBtn = document.getElementById('tour-next');
    var chips = Array.from(document.querySelectorAll('.tour-chip'));
    var dots = Array.from(document.querySelectorAll('.tour-dot'));
    var cards = Array.from(document.querySelectorAll('.tour-card'));

    var modal = document.getElementById('tour-modal') as HTMLDialogElement;
    var modalClose = document.getElementById('tour-modal-close');
    var modalBackdrop = document.getElementById('tour-modal-backdrop');
    var modalImg = document.getElementById('tour-modal-img') as HTMLImageElement;
    var modalTitle = document.getElementById('tour-modal-title');
    var modalKicker = document.getElementById('tour-modal-kicker');
    var modalDesc = document.getElementById('tour-modal-desc');

    if (!section || !wrapper) return;

    var spacesData = [
      {
        id: 'entrance',
        title: 'Entrance & Elephant Mural',
        kicker: 'Arrival Area',
        desc: 'Handcrafted elephant wall mural, warm wall sconce lighting, and carved wooden doors.',
        img: '/assets/interior/tour-entrance.webp'
      },
      {
        id: 'bar',
        title: 'The Bar Counter',
        kicker: 'Bar Counter',
        desc: 'Backlit liquor bottle shelving, illuminated circular Fursat wall sign, and dark bar counter top.',
        img: '/assets/interior/tour-bar.webp'
      },
      {
        id: 'high-tables',
        title: 'High-Top Tables & Stools',
        kicker: 'Lounge Seating',
        desc: 'High-top wooden tables with black-frame high bar stools and overhead pendant lights.',
        img: '/assets/interior/tour-high-tables.webp'
      },
      {
        id: 'lounge',
        title: 'Sofa & Table Dining',
        kicker: 'Dining Room',
        desc: 'Green patterned sofa seating, dark square dining tables, indoor potted plants, and partition screens.',
        img: '/assets/interior/tour-lounge.webp'
      },
      {
        id: 'cafe',
        title: 'Café Logo Wall',
        kicker: 'Café Area',
        desc: 'White wall with black Fursat lettering, track lighting, and dining tables.',
        img: '/assets/interior/tour-cafe.webp'
      },
      {
        id: 'booth',
        title: 'Red Booth Seating & Wall Posters',
        kicker: 'Booth Seating',
        desc: 'Red banquette booth seating with framed wall posters and hanging warm lamps.',
        img: '/assets/interior/tour-booth.webp'
      }
    ];

    var N = spacesData.length; // 6
    var stepAngle = (Math.PI * 2) / N; // 60 deg in radians
    var activeIndex = 0;
    var targetIndex = 0;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Lightbox Modal
    function openModalForIndex(idx: number) {
      if (!modal) return;
      var d = spacesData[idx];
      if (!d) return;
      if (modalImg) { modalImg.src = d.img; modalImg.alt = d.title; }
      if (modalTitle) modalTitle.textContent = d.title;
      if (modalKicker) modalKicker.textContent = d.kicker;
      if (modalDesc) modalDesc.textContent = d.desc;
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
      document.body.style.overflow = '';
    }

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
      modal.addEventListener('cancel', function (e) {
        e.preventDefault();
        closeModal();
      });
    }

    function updateActiveUI(idx: number) {
      activeIndex = idx;
      chips.forEach(function (c, i) {
        if (i === activeIndex) {
          c.classList.add('is-active');
          c.setAttribute('aria-selected', 'true');
        } else {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        }
      });
      dots.forEach(function (d, i) {
        if (i === activeIndex) {
          d.classList.add('is-active');
          d.setAttribute('aria-selected', 'true');
        } else {
          d.classList.remove('is-active');
          d.setAttribute('aria-selected', 'false');
        }
      });
      cards.forEach(function (card, i) {
        if (i === activeIndex) {
          card.classList.add('is-active');
        } else {
          card.classList.remove('is-active');
        }
      });
      // Announce space name to screen readers
      var liveRegion = document.getElementById('tour-live');
      if (liveRegion && spacesData[idx]) {
        liveRegion.textContent = 'Viewing: ' + spacesData[idx].title;
      }
    }

    // ── Check WebGL Support ───────────────────────────────────────────
    function hasWebGLSupport() {
      try {
        var testCanvas = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (testCanvas.getContext('webgl2') || testCanvas.getContext('webgl') || testCanvas.getContext('experimental-webgl')));
      } catch (e) {
        return false;
      }
    }

    var webglAvailable = !prefersReduced && hasWebGLSupport();

    if (!webglAvailable) {
      // Use CSS 3D fallback
      initCSS3DFallback();
      return;
    }

    // ── WebGL Engine Initializer (Lazy Loaded) ─────────────────────────
    var webglInitialized = false;

    var observer = new IntersectionObserver(
      function (entries) {
        if (entries[0].isIntersecting && !webglInitialized) {
          webglInitialized = true;
          observer.disconnect();
          startWebGLTour();
        }
      },
      { rootMargin: '300px 0px' }
    );

    observer.observe(section);

    function startWebGLTour() {
      import('three').then(function (THREE) {
        if (!canvas || !webglWrap) return;

        // Mark as WebGL active
        wrapper?.classList.add('has-webgl');

        var width = webglWrap.clientWidth || 1000;
        var height = webglWrap.clientHeight || 520;

        var scene = new THREE.Scene();
        // Cheap atmospheric fog (matching #0d1308 background)
        scene.fog = new THREE.FogExp2(0x0d1308, 0.0012);

        var camera = new THREE.PerspectiveCamera(54, width / height, 1, 3000);
        // Start camera at outside fly-in position
        var startCamPos = new THREE.Vector3(0, 48, 820);
        var centerCamPos = new THREE.Vector3(0, 0, 0);
        camera.position.copy(startCamPos);

        var renderer = new THREE.WebGLRenderer({
          canvas: canvas,
          antialias: true,
          alpha: false,
          powerPreference: 'high-performance'
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
        renderer.setSize(width, height);
        renderer.setClearColor(0x0d1308, 1);

        // ── WebGL Context Loss: graceful fallback to CSS 3D ───────────────
        canvas.addEventListener('webglcontextlost', function (e) {
          e.preventDefault();
          // Switch back to CSS 3D ring
          wrapper?.classList.remove('has-webgl');
          initCSS3DFallback();
        }, false);

        // ── Dispose renderer on page navigation ───────────────────────────
        window.addEventListener('beforeunload', function () {
          renderer.dispose();
        }, { once: true });

        // Cylindrical amphitheater setup
        var rotundaGroup = new THREE.Group();
        scene.add(rotundaGroup);

        var radius = 430;
        var panelHeight = 350;
        var thetaLength = 0.62; // ~35.5 degrees per panel arc

        var cylinderGeo = new THREE.CylinderGeometry(
          radius,
          radius,
          panelHeight,
          32,
          4,
          true,
          -thetaLength / 2,
          thetaLength
        );
        cylinderGeo.scale(-1, 1, 1); // inside faces camera

        // ── Custom Panel ShaderMaterial (RGB split + ripple + Ken Burns) ──
        var panelVertexShader = `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `;

        var panelFragmentShader = `
          uniform sampler2D uMap;
          uniform float uVelocity;   // signed angular velocity for RGB split direction
          uniform float uTime;       // seconds since scene start
          uniform float uActive;     // 1.0 when this panel is centered
          varying vec2 vUv;

          void main() {
            vec2 uv = vUv;

            // ── Ken Burns: slow UV pan/zoom on active panel ──────────────
            // Ramps from 0 to 1 over 1.5s to avoid snapping
            float kb = uActive * 0.05;
            // Oscillate scale factor between 1.0 and 1.05
            float kbScale = 1.0 + kb * (0.5 + 0.5 * sin(uTime * 0.18));
            // Translate center slowly
            vec2 kbOffset = vec2(
              kb * sin(uTime * 0.09) * 0.6,
              kb * cos(uTime * 0.12) * 0.4
            );
            uv = (uv - 0.5) / kbScale + 0.5 + kbOffset;

            // ── Ripple / bend distortion (scales with |velocity|) ────────
            float speed = abs(uVelocity);
            float rippleAmp = clamp(speed * 0.0012, 0.0, 0.025);
            uv.y += rippleAmp * sin(uv.x * 14.0 + uTime * 6.0);
            uv.x += rippleAmp * 0.5 * sin(uv.y * 10.0 + uTime * 5.0);

            // ── RGB chromatic aberration (scales with velocity) ──────────
            float rgbSplit = clamp(abs(uVelocity) * 0.0018, 0.0, 0.028);
            float dir = sign(uVelocity);
            vec2 rOffset = vec2(rgbSplit * dir, 0.0);
            vec2 bOffset = vec2(-rgbSplit * dir, 0.0);

            float r = texture2D(uMap, clamp(uv + rOffset, 0.001, 0.999)).r;
            float g = texture2D(uMap, clamp(uv,           0.001, 0.999)).g;
            float b = texture2D(uMap, clamp(uv + bOffset, 0.001, 0.999)).b;

            gl_FragColor = vec4(r, g, b, 1.0);
          }
        `;

        var textureLoader = new THREE.TextureLoader();
        var panelMeshes: any[] = [];
        var panelMaterials: any[] = [];

        spacesData.forEach(function (space, index) {
          var texture = textureLoader.load(space.img);
          texture.colorSpace = THREE.SRGBColorSpace;
          texture.generateMipmaps = true;
          texture.minFilter = THREE.LinearMipmapLinearFilter;

          var material = new THREE.ShaderMaterial({
            vertexShader: panelVertexShader,
            fragmentShader: panelFragmentShader,
            uniforms: {
              uMap:      { value: texture },
              uVelocity: { value: 0.0 },
              uTime:     { value: 0.0 },
              uActive:   { value: index === 0 ? 1.0 : 0.0 }
            },
            side: THREE.DoubleSide
          });

          var mesh = new THREE.Mesh(cylinderGeo, material);
          mesh.userData = { index: index, space: space };

          // Position around circle
          var angle = index * stepAngle + Math.PI;
          mesh.rotation.y = angle;

          rotundaGroup.add(mesh);
          panelMeshes.push(mesh);
          panelMaterials.push(material);
        });

        // ── Ambient Gold Bokeh Dust Motes ─────────────────────────────────
        var moteCount = 48;
        var motePositions = new Float32Array(moteCount * 3);
        for (var mi = 0; mi < moteCount; mi++) {
          var moteAngle = Math.random() * Math.PI * 2;
          var moteR = 60 + Math.random() * 320;
          motePositions[mi * 3]     = Math.cos(moteAngle) * moteR;
          motePositions[mi * 3 + 1] = (Math.random() - 0.5) * panelHeight * 1.3;
          motePositions[mi * 3 + 2] = Math.sin(moteAngle) * moteR;
        }
        var moteBufGeo = new THREE.BufferGeometry();
        moteBufGeo.setAttribute('position', new THREE.BufferAttribute(motePositions.slice(), 3));
        var moteMat = new THREE.PointsMaterial({
          color: 0xE0A63C,
          size: 2.8,
          transparent: true,
          opacity: 0.55,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          sizeAttenuation: true
        });
        var motePoints = new THREE.Points(moteBufGeo, moteMat);
        scene.add(motePoints);

        // Store mote original positions for drift animation
        var moteOrigPos = motePositions.slice();

        // ── Camera Fly-In Logic ───────────────────────────────────────────
        var hasSteppedInside = false;
        var flyinStartTime = 0;
        var flyinDuration = 1600; // 1.6s

        function stepInside() {
          if (hasSteppedInside) return;
          hasSteppedInside = true;
          flyinStartTime = performance.now();
          if (flyinOverlay) {
            flyinOverlay.style.opacity = '0';
            flyinOverlay.style.pointerEvents = 'none';
          }
        }

        if (flyinBtn) {
          flyinBtn.addEventListener('click', stepInside);
        }

        // ── Drag & Inertia Physics ─────────────────────────────────────────
        var isDragging = false;
        var pointerStartX = 0;
        var lastPointerX = 0;
        var lastTime = 0;
        var angularVelocity = 0;
        var targetRotY = 0;
        var currentRotY = 0;
        var isPointerOver = false;

        // Interaction intent thresholds for scroll safety
        var startClientY = 0;
        var dragThresholdMet = false;

        canvas.addEventListener('pointerdown', function (e) {
          isDragging = true;
          dragThresholdMet = false;
          pointerStartX = e.clientX;
          lastPointerX = e.clientX;
          startClientY = e.clientY;
          lastTime = performance.now();
          angularVelocity = 0;
          try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
          if (!hasSteppedInside) stepInside();
        });

        canvas.addEventListener('pointermove', function (e) {
          if (!isDragging) return;
          var dx = e.clientX - lastPointerX;
          var dy = e.clientY - startClientY;

          // Check if horizontal intent is clear before trapping
          if (!dragThresholdMet) {
            if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 6) {
              dragThresholdMet = true;
            } else if (Math.abs(dy) > 10) {
              // User intended vertical scroll; release
              isDragging = false;
              return;
            }
          }

          var now = performance.now();
          var dt = Math.max(1, now - lastTime);
          angularVelocity = (dx / dt) * 0.003;
          currentRotY -= dx * 0.0038;
          targetRotY = currentRotY;
          lastPointerX = e.clientX;
          lastTime = now;
        });

        function endDrag(e?: PointerEvent) {
          if (!isDragging) return;
          isDragging = false;

          // Project momentum
          var projectedRot = currentRotY - angularVelocity * 80;
          var rawIndex = Math.round(projectedRot / stepAngle);
          targetIndex = ((rawIndex % N) + N) % N;
          targetRotY = rawIndex * stepAngle;
          updateActiveUI(targetIndex);
        }

        canvas.addEventListener('pointerup', endDrag);
        canvas.addEventListener('pointercancel', endDrag);

        canvas.addEventListener('pointerenter', function () { isPointerOver = true; });
        canvas.addEventListener('pointerleave', function () {
          isPointerOver = false;
          if (isDragging) endDrag();
        });

        // ── Navigation Buttons & Chips ─────────────────────────────────────
        function snapToIndex(idx: number) {
          if (!hasSteppedInside) stepInside();
          var rawIndex = Math.round(currentRotY / stepAngle);
          var currentNorm = ((rawIndex % N) + N) % N;
          var delta = idx - currentNorm;
          if (delta > N / 2) delta -= N;
          if (delta < -N / 2) delta += N;
          targetRotY = (rawIndex + delta) * stepAngle;
          targetIndex = idx;
          updateActiveUI(targetIndex);
        }

        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            var idx = parseInt((chip as HTMLElement).dataset.index || '0', 10);
            snapToIndex(idx);
          });
        });

        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            var idx = parseInt((dot as HTMLElement).dataset.index || '0', 10);
            snapToIndex(idx);
          });
        });

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            var cur = Math.round(targetRotY / stepAngle);
            targetRotY = (cur - 1) * stepAngle;
            var norm = (((cur - 1) % N) + N) % N;
            updateActiveUI(norm);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            var cur = Math.round(targetRotY / stepAngle);
            targetRotY = (cur + 1) * stepAngle;
            var norm = (((cur + 1) % N) + N) % N;
            updateActiveUI(norm);
          });
        }

        // Keyboard navigation
        wrapper?.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            var cur = Math.round(targetRotY / stepAngle);
            targetRotY = (cur - 1) * stepAngle;
            updateActiveUI((((cur - 1) % N) + N) % N);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            var cur2 = Math.round(targetRotY / stepAngle);
            targetRotY = (cur2 + 1) * stepAngle;
            updateActiveUI((((cur2 + 1) % N) + N) % N);
          } else if (e.key === 'Home') {
            e.preventDefault();
            targetRotY = 0;
            updateActiveUI(0);
          } else if (e.key === 'End') {
            e.preventDefault();
            targetRotY = (N - 1) * stepAngle;
            updateActiveUI(N - 1);
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModalForIndex(targetIndex);
          }
        });

        // Click on Canvas to Expand details of focused panel
        canvas.addEventListener('click', function (e) {
          if (Math.abs(lastPointerX - pointerStartX) > 8) return; // was a drag
          openModalForIndex(targetIndex);
        });

        // ── Camera Fly-To on Space Selection ──────────────────────────────
        // When a space is focused, ease camera slightly forward (z: -50) for drama,
        // then spring back to center. Avoids clipping into panels.
        var flyToCamZ = 0.0;         // current z offset for fly-to
        var flyToTargetZ = 0.0;      // target z offset

        function triggerFlyTo() {
          flyToTargetZ = -55.0;
          // Schedule spring back after 650ms
          setTimeout(function () { flyToTargetZ = 0.0; }, 650);
        }

        // Trigger fly-to when active space changes from chip/button click
        var prevActiveForFlyTo = -1;
        function maybeFireFlyTo(idx: number) {
          if (idx !== prevActiveForFlyTo) {
            prevActiveForFlyTo = idx;
            triggerFlyTo();
          }
        }

        // ── Gyroscope Look-Around ─────────────────────────────────────────
        // Camera yaw/pitch offset driven by device orientation
        var gyroYaw = 0.0;
        var gyroPitch = 0.0;
        var gyroEnabled = false;

        function applyOrientation(e: DeviceOrientationEvent) {
          if (e.gamma == null || e.beta == null) return;
          var gx = Math.max(-20, Math.min(20, e.gamma as number)) / 20; // -1..1
          var gy = Math.max(20, Math.min(60, (e.beta as number))) - 40; // center ~40°
          gyroYaw   = gx * 0.18;    // radians, clamped
          gyroPitch = -gy * 0.004;  // radians
        }

        function enableGyro() {
          gyroEnabled = true;
          window.addEventListener('deviceorientation', applyOrientation, { passive: true });
          if (gyroBtn) gyroBtn.style.display = 'none';
        }

        // iOS 13+: needs user gesture to call requestPermission
        var isIOS = /iP(hone|ad|od)/.test(navigator.userAgent) ||
                    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
          // iOS 13+: show the pill
          if (gyroBtn) {
            gyroBtn.style.display = '';
            gyroBtn.addEventListener('click', function () {
              (DeviceOrientationEvent as any).requestPermission().then(function (state: string) {
                if (state === 'granted') enableGyro();
              }).catch(function () {});
            });
          }
        } else if (window.DeviceOrientationEvent && !isIOS) {
          // Android / desktop — passive listener, no prompt needed
          enableGyro();
        }

        // ── public/panos/ Equirectangular Skybox Detection ────────────────
        // Panos are named pano-{name}.webp. Probe HEAD for the first candidate.
        // If found, attach a "Full 360°" button to the drawer for future use.
        var panosToProbe = ['/panos/pano-entrance.webp', '/panos/pano-bar.webp', '/panos/pano.webp'];
        var skyboxAvailable = false;
        var skyboxTexture: any = null;
        var skyboxMesh: any = null;

        (function probePanos() {
          var checked = 0;
          panosToProbe.forEach(function (url) {
            fetch(url, { method: 'HEAD' }).then(function (r) {
              if (r.ok && !skyboxAvailable) {
                skyboxAvailable = true;
                // Lazy-load texture only if pano exists
                var panoTex = textureLoader.load(url);
                panoTex.colorSpace = THREE.SRGBColorSpace;
                panoTex.mapping = THREE.EquirectangularReflectionMapping;
                // Build interior sphere (inverted normals)
                var sphereGeo = new THREE.SphereGeometry(900, 60, 40);
                sphereGeo.scale(-1, 1, 1);
                var sphereMat = new THREE.MeshBasicMaterial({ map: panoTex });
                skyboxMesh = new THREE.Mesh(sphereGeo, sphereMat);
                skyboxMesh.visible = false;
                scene.add(skyboxMesh);
                // Expose a toggle on the modal CTA area (future-ready)
                var cta = document.querySelector('.tour-modal-cta');
                if (cta && cta.parentElement) {
                  var panoBtn = document.createElement('button');
                  panoBtn.type = 'button';
                  panoBtn.textContent = '360° View';
                  panoBtn.className = 'tour-modal-cta';
                  panoBtn.style.cssText = 'background:#17200F;color:#E0A63C;border:1px solid rgba(224,166,60,0.5);';
                  panoBtn.addEventListener('click', function () {
                    if (skyboxMesh) {
                      skyboxMesh.visible = !skyboxMesh.visible;
                      rotundaGroup.visible = !skyboxMesh.visible;
                    }
                  });
                  cta.parentElement.appendChild(panoBtn);
                }
              }
            }).catch(function () {});
          });
        })();

        // ── Resize Handler ─────────────────────────────────────────────────
        function onResize() {
          if (!webglWrap) return;
          var w = webglWrap.clientWidth;
          var h = webglWrap.clientHeight;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }
        window.addEventListener('resize', onResize, { passive: true });

        // ── Render Loop ───────────────────────────────────────────────────
        var isSectionVisible = true;
        var visibilityObserver = new IntersectionObserver(function (entries) {
          isSectionVisible = entries[0].isIntersecting;
        });
        visibilityObserver.observe(section);

        function animate(now: number) {
          requestAnimationFrame(animate);
          if (!isSectionVisible) return;

          var t = now * 0.001; // seconds

          // Camera Fly-In Tween (~1.6s)
          if (hasSteppedInside) {
            var elapsed = now - flyinStartTime;
            if (elapsed < flyinDuration) {
              var p = Math.min(1, elapsed / flyinDuration);
              // easeOutCubic
              var eased = 1 - Math.pow(1 - p, 3);
              camera.position.lerpVectors(startCamPos, centerCamPos, eased);
            } else {
              camera.position.copy(centerCamPos);
            }
          }

          // Smooth rotunda rotation
          if (!isDragging) {
            var diff = targetRotY - currentRotY;
            if (Math.abs(diff) > 0.0005) {
              currentRotY += diff * 0.12;
            } else {
              currentRotY = targetRotY;
              // Very subtle ambient idle drift when untouched
              if (!isPointerOver && hasSteppedInside) {
                targetRotY += 0.0003;
                currentRotY += 0.0003;
              }
            }
          }

          rotundaGroup.rotation.y = currentRotY;

          // Sync active space index from current angle
          var computedIndex = Math.round(currentRotY / stepAngle);
          var normIndex = ((computedIndex % N) + N) % N;
          if (normIndex !== activeIndex && !isDragging) {
            updateActiveUI(normIndex);
            maybeFireFlyTo(normIndex);
          }

          // Camera fly-to z spring (ease forward on space focus, spring back)
          flyToCamZ += (flyToTargetZ - flyToCamZ) * 0.07;

          // Camera gyro offset: apply as quaternion rotation around scene center
          var basePos = centerCamPos.clone();
          if (gyroEnabled) {
            // Rotate camera position on gyro pitch (X axis) and yaw (Y axis)
            basePos.applyEuler(new THREE.Euler(gyroPitch, gyroYaw, 0, 'YXZ'));
          }
          // Apply fly-to z only when stepped inside
          if (hasSteppedInside) {
            var flyInComplete = (now - flyinStartTime) >= flyinDuration;
            if (flyInComplete) {
              camera.position.set(basePos.x, basePos.y, basePos.z + flyToCamZ);
            }
          }
          camera.lookAt(0, 0, 0);

          // Update shader uniforms per panel
          // Decay velocity smoothly toward zero
          angularVelocity *= 0.88;
          panelMaterials.forEach(function (mat, i) {
            mat.uniforms.uVelocity.value = angularVelocity * 60.0;
            mat.uniforms.uTime.value = t;
            // Smooth active fade: ramp uActive toward target
            var targetActive = (i === normIndex) ? 1.0 : 0.0;
            mat.uniforms.uActive.value += (targetActive - mat.uniforms.uActive.value) * 0.06;
          });

          // Drift ambient gold motes gently
          var posArr = moteBufGeo.attributes.position.array as Float32Array;
          for (var mi2 = 0; mi2 < moteCount; mi2++) {
            posArr[mi2 * 3 + 1] = moteOrigPos[mi2 * 3 + 1] + Math.sin(t * 0.4 + mi2 * 0.7) * 18;
          }
          moteBufGeo.attributes.position.needsUpdate = true;

          renderer.render(scene, camera);
        }

        requestAnimationFrame(animate);
      });
    }

    // ── CSS 3D Fallback implementation ─────────────────────────────────
    function initCSS3DFallback() {
      if (!stage || !ring) return;
      var currentAngle = 0;
      var targetAngle = 0;
      var isDragging = false;
      var lastX = 0;
      var lastTime = 0;
      var velocity = 0;
      var stepDeg = 360 / N;

      function tickCSS() {
        if (!isDragging) {
          var diff = targetAngle - currentAngle;
          if (Math.abs(diff) > 0.05) {
            currentAngle += diff * 0.12;
          } else {
            currentAngle = targetAngle;
          }
        }
        ring.style.transform = 'rotateY(' + currentAngle.toFixed(2) + 'deg)';
        var rawIdx = Math.round(-currentAngle / stepDeg);
        var norm = ((rawIdx % N) + N) % N;
        updateActiveUI(norm);
        requestAnimationFrame(tickCSS);
      }
      requestAnimationFrame(tickCSS);

      wrapper?.addEventListener('pointerdown', function (e) {
        if ((e.target as HTMLElement).closest('button, a, dialog')) return;
        isDragging = true;
        lastX = e.clientX;
        lastTime = performance.now();
        velocity = 0;
      });

      wrapper?.addEventListener('pointermove', function (e) {
        if (!isDragging) return;
        var dx = e.clientX - lastX;
        var now = performance.now();
        var dt = Math.max(1, now - lastTime);
        velocity = dx / dt;
        currentAngle += dx * 0.45;
        targetAngle = currentAngle;
        lastX = e.clientX;
        lastTime = now;
      });

      function endCSSDrag() {
        if (!isDragging) return;
        isDragging = false;
        var projected = currentAngle + velocity * 160;
        var snappedIdx = Math.round(-projected / stepDeg);
        targetAngle = snappedIdx * -stepDeg;
      }

      wrapper?.addEventListener('pointerup', endCSSDrag);
      wrapper?.addEventListener('pointercancel', endCSSDrag);

      cards.forEach(function (card, idx) {
        card.addEventListener('click', function () {
          if (card.classList.contains('is-active')) {
            openModalForIndex(idx);
          } else {
            var raw = Math.round(-currentAngle / stepDeg);
            var curNorm = ((raw % N) + N) % N;
            var delta = idx - curNorm;
            if (delta > N / 2) delta -= N;
            if (delta < -N / 2) delta += N;
            targetAngle = (raw - delta) * -stepDeg;
          }
        });
      });
    }
  })();
</script>

