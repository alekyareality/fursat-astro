---
// PanoramicViewer.astro - "Step Inside Fursat" (reference layout, 9 Nov 2026)
// Header + four zones, a wide glowing panorama window (12 real photos as one curved strip, story mode inside),
// zone thumbnails and "Explore the Space" (full screen). Logic: ./tour/panorama.js, data: ./tour/spaces.js.
// Real Fursat photos and clips only (public/assets/tour/). Exception approved by the owner (9 Nov): the corner leaf
// cut-outs in public/assets/tour/leaves/ come from the owner's reference design image (decoration only, not the venue).
// Optional: drop an equirectangular 360 photo into public/panos/ and a 360° button appears (kept from d2f7515).
import fs from 'node:fs';
import path from 'node:path';
import { SPACES, IMGS, smallImg, ZONES } from './tour/spaces.js';

let panos: string[] = [];
try {
  const dir = path.resolve('./public/panos');
  if (fs.existsSync(dir)) {
    panos = fs.readdirSync(dir).filter((f) => /\.(webp|jpe?g|png)$/i.test(f)).map((f) => `/panos/${f}`);
  }
} catch (_) {}

const icon = (k: string) =>
  k === 'diamond'
    ? '<path d="M12 3l9 9-9 9-9-9z" fill="none" stroke="currentColor" stroke-width="1.6"/>'
    : k === 'gem'
      ? '<path d="M12 2l10 10-10 10L2 12z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 7l5 5-5 5-5-5z" fill="currentColor"/>'
      : '<path d="M12 1C13 8 16 11 23 12 16 13 13 16 12 23 11 16 8 13 1 12 8 11 11 8 12 1z" fill="currentColor"/>';
const thumbFor = (id: string) => smallImg(IMGS[id]);
---

<section class="pv pv-nojs" id="tour" aria-labelledby="pv-heading">
  <div class="pv-bg" aria-hidden="true"></div>
  <svg class="pv-defs" aria-hidden="true" width="0" height="0">
    <defs>
      <linearGradient id="pv-ornL" x1="0" x2="1"><stop offset="0" stop-color="#E0A63C" stop-opacity="0"/><stop offset="1" stop-color="#E0A63C"/></linearGradient>
      <linearGradient id="pv-ornR" x1="0" x2="1"><stop offset="0" stop-color="#E0A63C"/><stop offset="1" stop-color="#E0A63C" stop-opacity="0"/></linearGradient>
    </defs>
  </svg>
  <div class="pv-leaves" aria-hidden="true">
    <img class="pv-leaf pv-tl" src="/assets/tour/leaves/leaf-tl.webp" alt="" width="268" height="222" decoding="async" loading="lazy" />
    <img class="pv-leaf pv-tr" src="/assets/tour/leaves/leaf-tr.webp" alt="" width="272" height="236" decoding="async" loading="lazy" />
    <img class="pv-leaf pv-bl" src="/assets/tour/leaves/leaf-bl.webp" alt="" width="164" height="267" decoding="async" loading="lazy" />
    <img class="pv-leaf pv-br" src="/assets/tour/leaves/leaf-br.webp" alt="" width="205" height="151" decoding="async" loading="lazy" />
  </div>

  <div class="pv-inner">
    <div class="pv-head pv-reveal">
      <svg class="pv-orn" viewBox="0 0 480 24" aria-hidden="true"><rect x="0" y="11.3" width="222" height="1.4" fill="url(#pv-ornL)"/><rect x="258" y="11.3" width="222" height="1.4" fill="url(#pv-ornR)"/><path d="M240 3l9 9-9 9-9-9z" fill="none" stroke="#E0A63C" stroke-width="1.4"/><circle cx="240" cy="12" r="2.6" fill="#E0A63C"/></svg>
      <h2 class="pv-title" id="pv-heading">Step Inside <span>Fursat.</span></h2>
      <p class="pv-sub">More than a place. An entire experience.</p>
    </div>

    <div class="pv-zones pv-reveal" role="group" aria-label="Spaces at Fursat">
      {ZONES.map((z, k) => (
        <button type="button" class="pv-zone" data-z={k} aria-current="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon(z.icon)} />
          <span><b>{z.name}</b><small>{z.line}</small></span>
        </button>
      ))}
    </div>

    <div class="pv-wrap pv-reveal" id="pv-wrap">
      <div class="pv-win" id="pv-win" tabindex="-1">
        <canvas id="pv-gl" aria-label="Panoramic tour of Fursat. Drag to look around, or use the space buttons."></canvas>

        <div class="pv-fallback" aria-label="Fursat spaces">
          {SPACES.map((s) => (
            <figure>
              <img src={smallImg(IMGS[s.id])} alt={`${s.t} at Fursat`} width="840" height="1120" loading="lazy" decoding="async" />
              <figcaption><b>{s.t}</b><span>{s.d}</span></figcaption>
            </figure>
          ))}
        </div>

        <div class="pv-vig" aria-hidden="true"></div>
        <div class="pv-shade" aria-hidden="true"></div>
        <div class="pv-pins" id="pv-pins"></div>

        <div class="pv-stories" id="pv-stories" aria-label="Story progress"></div>
        <div class="pv-pausetag">Paused</div>

        <div class="pv-tools">
          <button type="button" class="pv-hunt" id="pv-hunt" aria-label="Find the Fursat elephants" title="Find the elephants"><em id="pv-huntDots"></em><span id="pv-huntN">0/6</span></button>
          <button type="button" class="pv-tool" id="pv-sound" aria-pressed="false" aria-label="Sound on" title="Sound on"><svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path class="pv-wave" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
          <button type="button" class="pv-tool" id="pv-lights" aria-pressed="false" aria-label="Lights down" title="Lights down"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
          {panos.length > 0 && (
            <button type="button" class="pv-tool" id="pv-b360" aria-pressed="false" aria-label="360 degree photo" title="360° photo"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><ellipse cx="12" cy="12" rx="3.5" ry="8" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></button>
          )}
          <button type="button" class="pv-tool pv-povbtn" id="pv-povBtn" aria-label="Play the POV walk-through" title="POV walk-through"><svg viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg><span>POV</span></button>
        </div>

        <button type="button" class="pv-closeimm" id="pv-closeImm" aria-label="Close full screen"><svg viewBox="0 0 16 16"><path d="M2 2l12 12M14 2L2 14"/></svg></button>

        <div class="pv-caption" aria-live="polite">
          <div class="pv-cap-k" id="pv-capK"></div>
          <div class="pv-cap-t"><span id="pv-capT"></span></div>
          <p class="pv-cap-d" id="pv-capD"></p>
          <div class="pv-cap-live" id="pv-capLive">Real footage</div>
        </div>
        <div class="pv-drag" aria-hidden="true">360° <i></i> Drag to explore</div>

        <div class="pv-toast" id="pv-toast" role="status" aria-live="polite"></div>
        <div class="pv-flash" id="pv-flash"></div>
        <div class="pv-povlayer" id="pv-povlayer" aria-live="polite"></div>
        <button type="button" class="pv-povexit" id="pv-povExit">Exit POV</button>
        <div class="pv-povhint" aria-hidden="true">Tap or scroll to continue</div>
        <div class="pv-endcard" id="pv-endcard"><div class="pv-in">
          <p class="pv-endk">Capital Park · Madhapur</p>
          <p class="pv-endtitle">This table could be yours.</p>
          <p>Reserve ahead, then come and see the room for real.</p>
          <div class="pv-row"><a class="pv-btn pv-p" href="/reserve">Reserve a table</a><button type="button" class="pv-btn pv-g" id="pv-endBack">Keep exploring</button></div>
        </div></div>

        <aside class="pv-drawer" id="pv-drawer" aria-hidden="true" inert>
          <button type="button" class="pv-close" id="pv-close" aria-label="Back to the room"><svg viewBox="0 0 16 16"><path d="M2 2l12 12M14 2L2 14"/></svg></button>
          <div class="pv-stagger">
            <div class="pv-cap-k" id="pv-dK"></div>
            <h3 id="pv-dT"></h3>
            <p id="pv-dD"></p>
            <div class="pv-row">
              <a class="pv-btn pv-p" href="/reserve">Reserve a table</a>
              <button type="button" class="pv-btn pv-g" id="pv-back">Back to the room</button>
            </div>
          </div>
        </aside>

        <div class="pv-loader" id="pv-loader" aria-hidden="true">
          <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="54" stroke="rgba(224,166,60,.18)"/><circle id="pv-lp" cx="60" cy="60" r="54" stroke="#E0A63C" stroke-dasharray="339.3" stroke-dashoffset="339.3" stroke-linecap="round"/></svg>
          <span class="pv-lt">Setting the room</span>
        </div>
      </div>
      <button type="button" class="pv-arrow pv-prev" id="pv-prev" aria-label="Previous space"><svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <button type="button" class="pv-arrow pv-next" id="pv-next" aria-label="Next space"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>

    <div class="pv-foot pv-reveal">
      <div class="pv-thumbs" role="group" aria-label="Choose a space">
        {ZONES.map((z, k) => (
          <button type="button" class="pv-thumb" data-z={k} aria-current="false">
            <img src={thumbFor(z.pin)} alt="" width="840" height="1120" loading="lazy" decoding="async" style={`object-position:50% ${z.fy}%`} />
            <span>{z.name.replace(/^The /, 'The ')}</span>
            <i class="pv-tbar"><b></b></i>
          </button>
        ))}
      </div>
      <div class="pv-cta-wrap">
        <button type="button" class="pv-explore" id="pv-explore" aria-expanded="false" aria-controls="pv-wrap">Explore the Space <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <p class="pv-feel">Feel the Fursat.</p>
        <svg class="pv-orn pv-orn-s" viewBox="0 0 260 16" aria-hidden="true"><rect x="0" y="7.4" width="120" height="1.2" fill="url(#pv-ornL)"/><rect x="140" y="7.4" width="120" height="1.2" fill="url(#pv-ornR)"/><path d="M130 2l6 6-6 6-6-6z" fill="none" stroke="#E0A63C" stroke-width="1.2"/></svg>
      </div>
    </div>

    <svg class="pv-orn pv-orn-b pv-reveal" viewBox="0 0 1200 30" aria-hidden="true"><rect x="60" y="14.3" width="520" height="1.4" fill="url(#pv-ornL)"/><rect x="620" y="14.3" width="520" height="1.4" fill="url(#pv-ornR)"/><path d="M600 3l12 12-12 12-12-12z" fill="none" stroke="#E0A63C" stroke-width="1.4"/><path d="M600 9l6 6-6 6-6-6z" fill="#E0A63C"/></svg>
  </div>
  <div class="pv-cursor" id="pv-cursor" aria-hidden="true"></div>
  {panos.length > 0 && (
    <script type="application/json" id="pv-panos" set:html={JSON.stringify(panos)}></script>
  )}
</section>

<script>
  import { initTour } from './tour/panorama.js';
  initTour(document.getElementById('tour'));
</script>

<style is:global>
/* All rules are prefixed pv- so nothing leaks in or out of the site styles. */
.pv{
  --pv-green:#17200F; --pv-deep:#050c00; --pv-gold:#E0A63C; --pv-gold2:#f3c56b; --pv-terra:#C2431A; --pv-cream:#F2EEE4;
  --pv-panel:rgba(10,14,7,.82); --ease:cubic-bezier(0.16,1,0.3,1); --ease-exit:cubic-bezier(0.7,0,0.84,0);
  --pv-serif:'Playfair Display',Georgia,serif; --pv-sans:Poppins,system-ui,sans-serif;
  position:relative; overflow:hidden; color:var(--pv-cream); font-family:var(--pv-sans);
  padding:clamp(20px,1.9vw,32px) 0 clamp(22px,2.4vw,40px); background:var(--pv-deep);
  -webkit-font-smoothing:antialiased; scroll-margin-top:70px;
}
.pv *{box-sizing:border-box;margin:0;padding:0}
.pv :where(button){font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
.pv :where(button,a):focus-visible{outline:2px solid var(--pv-gold);outline-offset:3px}
.pv-defs{position:absolute}
html.pv-lock{overflow:hidden}

/* background: deep forest green with soft gold bokeh */
.pv-bg{position:absolute;inset:0;
  background:
    radial-gradient(5px 5px at 12% 22%,rgba(243,197,107,.5),transparent 70%),
    radial-gradient(4px 4px at 86% 30%,rgba(243,197,107,.4),transparent 70%),
    radial-gradient(7px 7px at 78% 74%,rgba(243,197,107,.28),transparent 70%),
    radial-gradient(6px 6px at 20% 82%,rgba(243,197,107,.3),transparent 70%),
    radial-gradient(40px 40px at 30% 12%,rgba(224,166,60,.08),transparent 70%),
    radial-gradient(60px 60px at 70% 90%,rgba(224,166,60,.07),transparent 70%),
    radial-gradient(60% 40% at 50% 50%,rgba(120,90,10,.32) 0%,transparent 70%),
    radial-gradient(75% 60% at 50% 45%,#13230a 0%,transparent 72%),
    radial-gradient(120% 90% at 50% 50%,#0d1a04 0%,#040a00 78%)}
.pv-leaves{position:absolute;inset:0;pointer-events:none}
.pv-leaf{position:absolute;height:auto;pointer-events:none;user-select:none;animation:pvSway 10s ease-in-out infinite alternate}
.pv-tl{left:0;top:0;width:clamp(150px,16.7vw,340px);transform-origin:0 0}
.pv-tr{right:0;top:0;width:clamp(150px,16.9vw,345px);transform-origin:100% 0;animation-name:pvSwayR;animation-duration:12s}
.pv-bl{left:0;bottom:0;width:clamp(96px,10.2vw,210px);transform-origin:0 100%;animation-name:pvSwayB;animation-duration:11s}
.pv-br{right:0;bottom:0;width:clamp(120px,12.8vw,260px);transform-origin:100% 100%;animation-name:pvSwayBR;animation-duration:13s}
@keyframes pvSway{to{transform:rotate(1.6deg)}}
@keyframes pvSwayR{to{transform:rotate(-1.6deg)}}
@keyframes pvSwayB{to{transform:rotate(-1.4deg)}}
@keyframes pvSwayBR{to{transform:rotate(1.4deg)}}

.pv-inner{width:min(1380px,calc(100% - 2*clamp(16px,4vw,48px)));margin:0 auto;position:relative}
/* no z-index on the section or .pv-inner: the full-screen window must stack above the site header and mobile bar */

/* reveal on scroll (JS only; without JS everything is visible) */
.pv.pv-js .pv-reveal{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform 1.1s var(--ease)}
.pv.pv-js.is-seen .pv-reveal{opacity:1;transform:none}
.pv.is-seen .pv-zones{transition-delay:.12s}
.pv.is-seen .pv-wrap{transition-delay:.22s}
.pv.is-seen .pv-foot{transition-delay:.34s}
.pv.is-seen .pv-orn-b{transition-delay:.44s}

/* header */
.pv-head{text-align:center}
.pv-orn{display:block;width:min(480px,80%);height:auto;margin:0 auto}
.pv-title{font-family:var(--pv-serif);font-weight:600;font-size:clamp(2.2rem,4.7vw,4.6rem);line-height:1.04;letter-spacing:-.012em;color:#fbf7ee;margin-top:clamp(4px,.6vw,10px);text-shadow:0 4px 24px rgba(0,0,0,.4)}
.pv-title span{background:linear-gradient(100deg,#f7d48a 0%,#E0A63C 45%,#f3c56b 70%,#c98a2a 100%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:pvGold 8s ease-in-out infinite alternate}
@keyframes pvGold{to{background-position:100% 0}}
.pv-sub{font-family:var(--pv-serif);font-style:italic;font-size:clamp(1.05rem,1.7vw,1.5rem);color:var(--pv-gold2);margin-top:.05em}

/* four zones */
.pv-zones{display:grid;grid-template-columns:repeat(4,1fr);margin:clamp(8px,1vw,14px) auto clamp(10px,.8vw,14px);max-width:1240px}
.pv-zone{display:flex;align-items:center;justify-content:center;gap:clamp(10px,1.2vw,16px);padding:4px clamp(8px,1.4vw,22px);text-align:left;position:relative;transition:transform .25s var(--ease)}
.pv-zone + .pv-zone::before{content:"";position:absolute;left:0;top:4%;bottom:4%;width:1.5px;background:linear-gradient(180deg,rgba(243,197,107,.15),#f3c56b 30%,#f3c56b 70%,rgba(243,197,107,.15))}
.pv-zone svg{width:clamp(20px,2.1vw,32px);height:auto;color:var(--pv-gold);flex:none;transition:transform .5s var(--ease),filter .4s}
.pv-zone b{display:block;font-family:var(--pv-serif);font-weight:500;font-size:clamp(.95rem,1.55vw,1.5rem);letter-spacing:.06em;text-transform:uppercase;color:var(--pv-cream);transition:color .3s}
.pv-zone small{display:block;font-size:clamp(.72rem,1vw,.98rem);color:rgba(242,238,228,.85);margin-top:3px}
.pv-zone.is-active svg{transform:rotate(45deg) scale(1.15);filter:drop-shadow(0 0 8px rgba(243,197,107,.9))}
.pv-zone:active{transform:scale(.97)}
@media (hover:hover){.pv-zone:hover b{color:var(--pv-gold2)}}

/* the panorama window */

.pv-wrap{--pv-ww:min(1512px,calc(100vw - 2*clamp(30px,3vw,48px)));position:relative;width:var(--pv-ww);margin-inline:calc((100% - var(--pv-ww)) / 2)}
.pv-wrap::before{content:"";position:absolute;inset:-14% -4%;z-index:0;pointer-events:none;background:radial-gradient(50% 50% at 50% 50%,rgba(215,145,20,.42),rgba(200,130,15,.12) 55%,transparent 76%)}
.pv-win{position:relative;isolation:isolate;height:clamp(280px,25vw,420px);border-radius:clamp(18px,2.4vw,30px);overflow:hidden;background:#0a0f06;outline:none;
  border:2px solid #ffe2a6;
  box-shadow:0 0 3px #fff4d6,0 0 12px rgba(255,176,56,.95),0 0 30px rgba(238,140,20,.7),0 0 70px rgba(220,120,10,.4),0 0 140px rgba(200,110,10,.2)}
.pv-win::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:2;box-shadow:inset 0 0 0 1px rgba(255,236,190,.55),inset 0 0 10px rgba(255,170,50,.55),inset 0 0 30px rgba(120,60,0,.45)}
#pv-gl{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:pan-y;cursor:grab}
#pv-gl.drag{cursor:grabbing}
@media (hover:hover) and (pointer:fine){.pv.is-inside:not(.is-360) #pv-gl{cursor:none}}
.pv-shade{position:absolute;inset:0;pointer-events:none;z-index:1;opacity:0;transition:opacity .8s;
  background:radial-gradient(60% 70% at 0% 100%,rgba(6,8,4,.7),transparent 70%),linear-gradient(180deg,rgba(6,8,4,.35) 0%,transparent 12%)}
.pv.is-overview .pv-shade{opacity:.35!important}
.pv-vig{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(70% 85% at 50% 48%,transparent 52%,rgba(18,8,0,.38) 82%,rgba(10,4,0,.62) 100%)}
.pv.is-inside .pv-shade{opacity:1}

.pv-arrow{position:absolute;top:50%;z-index:4;width:clamp(44px,4vw,56px);height:clamp(44px,4vw,56px);margin-top:calc(clamp(44px,4vw,56px) / -2);border-radius:50%;display:grid;place-items:center;
  background:radial-gradient(circle at 50% 35%,#1f2a14,#0b1006);border:1.5px solid rgba(243,197,107,.85);box-shadow:0 0 14px rgba(240,170,70,.45),0 8px 20px rgba(0,0,0,.5);transition:transform .25s var(--ease),background .25s}
.pv-arrow svg{width:46%;height:46%;stroke:var(--pv-gold2);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pv-prev{left:calc(clamp(44px,4vw,56px) / -2)}
.pv-next{right:calc(clamp(44px,4vw,56px) / -2)}
.pv-arrow:active{transform:scale(.92)}
@media (hover:hover){.pv-arrow:hover{background:radial-gradient(circle at 50% 35%,#d4562e,#9f3313);border-color:#f3c56b}}

/* pins on the photos */
.pv-pins{position:absolute;inset:0;z-index:3;pointer-events:none}
.pv-pin{position:absolute;left:0;top:0;display:flex;align-items:center;gap:0;opacity:0;margin:-26px 0 0 -26px;transition:opacity .35s;will-change:transform}
.pv-pin i{width:52px;height:52px;border-radius:50%;flex:none;position:relative;background:radial-gradient(circle,#ffd77a 0 6px,#140d02 6.5px 11px,#f5b94a 11.5px 23px,rgba(245,185,74,0) 25px);box-shadow:0 0 18px rgba(255,190,80,.85);z-index:1}
.pv-pin i::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:1px solid rgba(243,197,107,.7);animation:pvPing 2.4s var(--ease) infinite}
@keyframes pvPing{0%{transform:scale(.8);opacity:.9}100%{transform:scale(1.5);opacity:0}}
.pv-pin span{margin-left:-12px;padding:11px 20px 11px 24px;border-radius:999px;background:rgba(10,9,4,.9);border:1px solid rgba(243,197,107,.35);box-shadow:0 4px 14px rgba(0,0,0,.45);font-size:.95rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;color:var(--pv-cream)}
.pv-pin.is-active span{border-color:var(--pv-gold2);color:var(--pv-gold2)}

.pv-drag{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);z-index:3;display:flex;align-items:center;gap:12px;padding:10px 24px;border-radius:999px;background:rgba(10,9,4,.88);border:1.5px solid rgba(243,197,107,.75);font-size:.86rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;pointer-events:none;transition:opacity .6s}
.pv-drag i{width:5px;height:5px;border-radius:50%;background:var(--pv-gold2)}
.pv.is-dragged:not(.is-overview) .pv-drag,.pv.is-pov .pv-drag,.pv.is-focus .pv-drag,.pv:not(.is-inside) .pv-drag{opacity:0}

/* story bars, tools, caption (inside the window) */
.pv-stories{position:absolute;left:18px;right:18px;top:8px;z-index:3;display:flex;gap:4px;opacity:0;pointer-events:none;transition:opacity .5s}
.pv.is-inside .pv-stories{opacity:.7;pointer-events:auto}
.pv.is-overview .pv-stories{opacity:0}
.pv.is-pov .pv-stories{opacity:0;pointer-events:none}
.pv-stories button{flex:1;height:14px;padding:6px 0}
