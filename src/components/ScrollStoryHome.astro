---
/**
 * ScrollStoryHome.astro — Fursat Kitchen | Bar
 * Pinned scroll scene for the Home page: "table-spread" scene.
 *
 * Primary: CSS scroll-driven animations (animation-timeline: view()).
 * Enhancement: GSAP ScrollTrigger for browsers without native support.
 * Fallback: prefers-reduced-motion — show all items at once, no pin.
 *
 * CSS prefix: ss-
 * Dish images from /assets/dishes/ (.webp)
 */

const dishes = [
  { src: '/assets/dishes/angaraa_chicken_tikka_.webp', alt: 'Angaraa Chicken Tikka', label: 'Angaraa Chicken Tikka' },
  { src: '/assets/dishes/tandoori_prawns_.webp',       alt: 'Tandoori Prawns',        label: 'Tandoori Prawns' },
  { src: '/assets/dishes/karvepaku_kodi_vepudu.webp',  alt: 'Karvepaku Kodi Vepudu', label: 'Karvepaku Kodi Vepudu' },
  { src: '/assets/dishes/pandu_mirchi_kodi_kebab.webp', alt: 'Pandu Mirchi Kodi Kebab', label: 'Pandu Mirchi Kodi Kebab' },
  { src: '/assets/dishes/lotus_biscoff_.webp',          alt: 'Lotus Biscoff Dessert',   label: 'Lotus Biscoff' },
];

const paras = [
  'Every plate is a love letter to Hyderabad — slow-cooked, wood-fired, and plated with intention.',
  'From aromatic biryanis to charcoal-kissed kebabs, each dish carries the soul of Fursat\'s kitchen.',
  'Your table awaits. Reserve today and experience the story on every plate.',
];
---

<!-- Spacer so the section has scroll-distance for the pinned scene -->
<section class="ss-section" aria-label="Fursat Table Story">
  <div class="ss-sticky">
    <div class="ss-scene">
      <!-- Table surface -->
      <div class="ss-table" aria-hidden="true"></div>

      <!-- Dish grid -->
      <div class="ss-dishes-grid">
        {dishes.map((dish, i) => (
          <figure
            class="ss-dish"
            style={`--ss-delay:${i * 0.14}s; --ss-i:${i}`}
            aria-label={dish.label}
          >
            <img
              src={dish.src}
              alt={dish.alt}
              loading="lazy"
              decoding="async"
              width="300"
              height="300"
            />
            <figcaption class="ss-dish-label">{dish.label}</figcaption>
          </figure>
        ))}
      </div>

      <!-- Text reveal -->
      <div class="ss-text-col">
        <span class="ss-kicker">THE FURSAT TABLE</span>
        <h2 class="ss-heading mot-headline">A Feast Worth Every Moment</h2>
        {paras.map((p, i) => (
          <p class="ss-para" style={`--ss-p-delay:${i * 0.12}s; --ss-pi:${i}`}>{p}</p>
        ))}
        <a href="/menu" class="ss-cta mot-btn-press mot-magnetic">Explore the Menu →</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section & Sticky Shell ──────────────────────────────────────────────── */
  .ss-section {
    background: #12190B;
    /* Extra height for scroll-driven pin */
    min-height: 300vh;
    position: relative;
  }

  .ss-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Scene Layout ──────────────────────────────────────────────────────── */
  .ss-scene {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr;
    gap: 32px;
    align-items: center;
  }

  /* ── Table Surface (decorative top-view oval) ───────────────────────────── */
  .ss-table {
    display: none; /* decorative only on large screens */
  }

  /* ── Dish Grid ──────────────────────────────────────────────────────────── */
  .ss-dishes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start;
  }

  /* ── Individual Dish ────────────────────────────────────────────────────── */
  .ss-dish {
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(244, 236, 218, 0.04);
    border: 1px solid rgba(224, 166, 60, 0.15);
    transform-origin: center bottom;

    /* CSS scroll-driven animation — appears as section scrolls into view */
    opacity: 0;
    transform: scale(0.82) translateY(24px);
    animation:
      ss-dish-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--ss-delay, 0s);

    /* scroll-driven: tied to the section's view progress */
    animation-timeline: view();
    animation-range: entry 10% entry 60%;
  }

  @keyframes ss-dish-in {
    from {
      opacity: 0;
      transform: scale(0.82) translateY(24px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .ss-dish img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .ss-dish-label {
    font-family: var(--sans, 'Manrope', system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(244, 236, 218, 0.7);
    text-align: center;
    padding: 10px 8px;
  }

  /* ── Text Column ────────────────────────────────────────────────────────── */
  .ss-text-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-left: clamp(0px, 2vw, 32px);
  }

  .ss-kicker {
    display: block;
    font-family: var(--sans, 'Manrope', system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #E0A63C;
    text-transform: uppercase;
  }

  .ss-heading {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    color: #F4ECDA;
    line-height: 1.15;
    margin: 0;

    /* CSS scroll-driven reveal */
    opacity: 0;
    transform: translateY(28px);
    animation: ss-text-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-timeline: view();
    animation-range: entry 15% entry 55%;
  }

  .ss-para {
    font-family: var(--sans, 'Manrope', system-ui, sans-serif);
    font-size: clamp(0.9rem, 1.3vw, 1.0625rem);
    color: rgba(244, 236, 218, 0.78);
    line-height: 1.65;
    margin: 0;

    /* Staggered scroll-driven reveal */
    opacity: 0;
    transform: translateY(20px);
    animation: ss-text-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.1s + var(--ss-p-delay, 0s));
    animation-timeline: view();
    animation-range: entry 20% entry 65%;
  }

  @keyframes ss-text-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── CTA Button ─────────────────────────────────────────────────────────── */
  .ss-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #E0A63C 0%, #C88D25 100%);
    color: #1A1608;
    font-family: var(--sans, 'Manrope', system-ui, sans-serif);
    font-size: 0.9375rem;
    font-weight: 800;
    text-decoration: none;
    align-self: flex-start;
    box-shadow: 0 4px 14px rgba(224, 166, 60, 0.3);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .ss-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(224, 166, 60, 0.45);
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .ss-section {
      min-height: auto; /* no pin on mobile */
    }
    .ss-sticky {
      position: static;
      height: auto;
      padding: clamp(48px, 8vw, 80px) 0;
    }
    .ss-scene {
      grid-template-columns: 1fr;
    }
    .ss-dishes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .ss-text-col {
      padding-left: 0;
    }
  }

  /* ══ prefers-reduced-motion: show everything immediately, no pin ══════════ */
  @media (prefers-reduced-motion: reduce) {
    .ss-section {
      min-height: auto;
    }
    .ss-sticky {
      position: static;
      height: auto;
      padding: clamp(48px, 8vw, 80px) 0;
    }
    .ss-dish,
    .ss-heading,
    .ss-para {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script is:inline>
  /* GSAP ScrollTrigger enhancement for browsers without animation-timeline:view() support */
  (function () {
    var hasNative =
      CSS.supports('animation-timeline', 'view()') ||
      CSS.supports('animation-timeline', 'scroll()');

    if (hasNative) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // If no native support, make items visible and let GSAP handle it
    // (motion-kit.js initScrollStory('home') handles this via initGSAP)
    document.querySelectorAll('.ss-dish, .ss-heading, .ss-para').forEach(function (el) {
      el.style.animationName = 'none';
      el.style.opacity = '0';
      el.style.transform = el.classList.contains('ss-dish')
        ? 'scale(0.82) translateY(24px)'
        : 'translateY(20px)';
    });

    // Load GSAP from motion-kit namespace if available, else script tag
    function withGSAP(cb) {
      if (window.gsap && window.ScrollTrigger) { cb(); return; }
      var s = document.createElement('script');
      s.src = '/js/gsap.min.js';
      s.onload = function () {
        if (window.gsap && window.ScrollTrigger) {
          window.gsap.registerPlugin(window.ScrollTrigger);
        }
        cb();
      };
      document.head.appendChild(s);
    }

    withGSAP(function () {
      var gsap = window.gsap;
      var ST = window.ScrollTrigger;
      if (!gsap || !ST) return;

      var scene = document.querySelector('.ss-scene');
      if (!scene) return;

      var dishes = scene.querySelectorAll('.ss-dish');
      var heading = scene.querySelector('.ss-heading');
      var paras = scene.querySelectorAll('.ss-para');

      gsap.to(Array.from(dishes), {
        opacity: 1,
        scale: 1,
        y: 0,
        stagger: 0.12,
        duration: 0.65,
        ease: 'expo.out',
        scrollTrigger: { trigger: scene, start: 'top 75%', toggleActions: 'play none none none' }
      });
      if (heading) {
        gsap.to(heading, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'expo.out',
          scrollTrigger: { trigger: scene, start: 'top 72%', toggleActions: 'play none none none' }
        });
      }
      gsap.to(Array.from(paras), {
        opacity: 1,
        y: 0,
        stagger: 0.1,
        duration: 0.6,
        ease: 'expo.out',
        scrollTrigger: { trigger: scene, start: 'top 68%', toggleActions: 'play none none none' }
      });
    });
  })();
</script>
