---
// HyWindows — real photos clipped into the dark frame holes of a prepped background slice
// (scripts/prep-bg.py → scripts/bg-specs/<name>.out.json), plus the inner-shadow layer above them.
// Positions come straight from the traced data, so photos sit exactly inside the carved gold lips.
interface Photo { src: string; alt: string; pos?: string; w?: number; h?: number; eager?: boolean }
interface Props {
  data: { name: string; h: number; slices: { file: string; kind: string; y0: number; h: number; shade: boolean; windows: { l: number; t: number; w: number; h: number; path: string }[] }[] };
  slice?: number;
  photos: (Photo | null)[];      // one per window, in the slice's window order (null = leave the frame empty)
  view: 'd' | 'm';               // d = desktop only, m = phone only
  anchor?: 'top' | 'bottom';     // bottom = slice sits at the bottom of a stretchable stage
}
const { data, slice = 0, photos, view, anchor = 'top' } = Astro.props;
const s = data.slices[slice];
const id = (k: number) => `hy-${data.name}-${slice}-${k}`;
const pos = (w: { l: number; t: number; w: number; h: number }) =>
  anchor === 'top'
    ? `left:calc(${w.l} * var(--u));top:calc(${w.t} * var(--u));width:calc(${w.w} * var(--u));height:calc(${w.h} * var(--u))`
    : `left:calc(${w.l} * var(--u));bottom:calc(${(s.h - w.t - w.h).toFixed(2)} * var(--u));width:calc(${w.w} * var(--u));height:calc(${w.h} * var(--u))`;
---
<svg class="hy-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {s.windows.map((w, k) => <clipPath id={id(k)} clipPathUnits="objectBoundingBox"><path d={w.path} /></clipPath>)}
  </defs>
</svg>
{s.windows.map((w, k) => photos[k] && (
  <figure class={`hy-win hy-${view}`} style={`${pos(w)};clip-path:url(#${id(k)})`}>
    <img src={photos[k]!.src} alt={photos[k]!.alt} width={photos[k]!.w ?? 1200} height={photos[k]!.h ?? 1600}
      style={photos[k]!.pos ? `object-position:${photos[k]!.pos}` : undefined}
      loading={photos[k]!.eager ? 'eager' : 'lazy'} fetchpriority={photos[k]!.eager ? 'high' : undefined} decoding="async" data-fx-par onload="this.parentNode.classList.add('is-loaded')" />
  </figure>
))}
{s.shade && (
  <div class={`hy-shade hy-${view}`} aria-hidden="true"
    style={`${anchor === 'top' ? 'top:0' : 'bottom:0'};height:calc(${s.h} * var(--u));background-image:url(/assets/bg/${s.file}-shade.webp)`}></div>
)}
